#!/usr/bin/env bash
# The commit gate of the config repo (the instance directory's config/, docs/design/new-user.md 3.1): the staged config
# must be valid (bin/config-check --staged). hub init points the config repo's core.hooksPath at this folder; the
# platform is two levels above it.
hub="$(cd "$(dirname "$0")/../.." && pwd)"
exec "$hub/bin/py" "$hub/bin/config-check" --staged
