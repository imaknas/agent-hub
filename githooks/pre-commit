#!/usr/bin/env bash
# agent-hub's commit gate (git config core.hooksPath githooks):
#   code changed → all tests pass with the platform's Python (bin/test-gate, which only covers "the code passes the
#   tests")
#   config changed (hub.json, registry, models.env…) → the config is valid (bin/config-check --staged; passes at once
#   when no config changed)
# Both check the index, not the working tree.
root="$(git rev-parse --show-toplevel)"
"$root/bin/test-gate" || exit 1
exec "$root/bin/py" "$root/bin/config-check" --staged
