#!/usr/bin/env bash
# Catches commits that skipped the gate (git commit --no-verify): when code (or config) changed but the tree is not the
# one bin/test-gate (or bin/config-check) just validated, writes a line to .state/test-gate-bypassed.log and warns.
# It doesn't block (the commit already exists), it only makes it visible.
root="$(git rev-parse --show-toplevel)" || exit 0
tree="$(git rev-parse 'HEAD^{tree}')"
files="$(git diff-tree --no-commit-id --name-only -r HEAD)"
CODE='^(bin|tests|contracts|templates|githooks|launchd|capabilities|agent-jobs)/|^hub\.json$'
CONFIG='^(hub\.json|models\.env|mirror-list\.txt|services\.tsv|schedule\.yaml|projects/)'
bypassed=()
if echo "$files" | grep -Eq "$CODE" && [ "$(cat "$(git rev-parse --git-path test-gate-passed)" 2>/dev/null)" != "$tree" ]; then
  bypassed+=("bin/test-gate --all")
fi
if echo "$files" | grep -Eq "$CONFIG" && [ "$(cat "$(git rev-parse --git-path config-check-passed)" 2>/dev/null)" != "$tree" ]; then
  bypassed+=("bin/config-check")
fi
[ ${#bypassed[@]} -eq 0 ] && exit 0
# the machine's .state, in the main checkout also when this commit is in a linked worktree (bin/hubpaths.sh)
source "$root/bin/hubpaths.sh"
mkdir -p "$HUB_STATE"
echo "$(date '+%Y-%m-%dT%H:%M:%S') $(git rev-parse --short HEAD) $(git log -1 --format=%s) (not run: ${bypassed[*]})" >>"$HUB_STATE/test-gate-bypassed.log"
echo "post-commit: this commit did not pass the gate (recorded in .state/test-gate-bypassed.log). Please run: ${bypassed[*]}." >&2
exit 0
