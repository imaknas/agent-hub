{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "records-project.v1",
  "title": "專案登錄 <registry_dir>/<name>.yaml",
  "description": "bin/registry.py 才是完整的驗證(檔案系統檢查:run 解析得到、目錄存在、after 指到存在的 job);這份是給其他程式讀的形狀。",
  "type": "object",
  "required": ["v", "name"],
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "type": {"enum": ["project", "idea"]},
    "purpose": {"type": "string", "minLength": 1},
    "paths": {"type": "object", "properties": {"workspace": {"type": "string"}, "memory_bare": {"type": "string"}, "origin": {"type": ["string", "null"]}}},
    "memory": {"type": "boolean"},
    "privacy": {"type": "object", "properties": {"reflection": {"enum": ["include", "stats_only", "exclude"]}}},
    "runtime": {"type": "object", "properties": {"deploy": {"type": "string"}, "test": {"type": "string"}}},
    "push_on_merge": {"type": "boolean"},
    "commits": {"enum": ["conventional"], "description": "commit 標題用 Conventional Commits,合併閘門檢查;沒寫 = 不檢查"},
    "mailbox": {"type": "object", "properties": {"escalate": {"type": "boolean"}}},
    "publishes": {"type": "array", "items": {"type": "object", "required": ["kind", "path"]}},
    "provides": {"type": "array", "items": {"type": "object", "required": ["contract", "v", "schema"]}},
    "consumes": {"type": "array", "items": {"type": "object", "required": ["contract", "v", "copy"]}},
    "services": {"type": "array", "items": {"type": "object", "required": ["name", "run"]}},
    "jobs": {"type": "array", "items": {"type": "object", "required": ["name"]}},
    "secrets": {"type": "array", "description": "這個專案用的憑證:只有名稱、位置、到期,沒有值", "items": {"type": "object", "required": ["name", "path"], "additionalProperties": false, "properties": {
      "name": {"type": "string"}, "path": {"type": "string"}, "env_key": {"type": "string"},
      "expires": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "max_age_days": {"type": "integer", "minimum": 1},
      "warn_days": {"type": "integer", "minimum": 1}, "backup": {"type": "boolean"}, "why": {"type": "string"}, "rotate": {"type": "string"}}}},
    "enforce": {"type": "object", "properties": {"sandbox": {"type": "boolean"}, "capabilities": {"type": "array", "items": {"type": "string"}, "description": "平台的能力(hub.json capabilities,例 gpu);沙盒裡用 hub-run --cap <能力> 透過平台代跑"},
        "work": {"type": "boolean", "description": "深談(租約)能寫入專案;要搭配 sandbox: true(OS sandbox 擋資料夾外的寫入)。owner 直接確認才開"}}, "additionalProperties": false},
    "network": {"type": "array", "items": {"type": "string"}},
    "allow_write": {"type": "array", "items": {"type": "string"}},
    "gate": {"enum": ["strict", "detect"]}
  }
}
