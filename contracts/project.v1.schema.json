{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "records-project.v1",
  "title": "Project registry entry <registry_dir>/<name>.yaml",
  "description": "bin/registry.py is the full validation (file system checks: run resolves, directories exist, after points to existing jobs); this is the shape for other programs to read.",
  "type": "object",
  "required": ["v", "name"],
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "type": {"enum": ["project", "idea"]},
    "purpose": {"type": "string", "minLength": 1},
    "paths": {"type": "object", "properties": {"workspace": {"type": "string"}, "memory_bare": {"type": "string"}, "origin": {"type": ["string", "null"]}}},
    "memory": {"type": "boolean"},
    "privacy": {"type": "object", "properties": {"reflection": {"enum": ["include", "stats_only", "exclude"]}}},
    "runtime": {"type": "object", "properties": {"deploy": {"type": "string"}, "test": {"type": "string"}}},
    "push_on_merge": {"type": "boolean"},
    "commits": {"enum": ["conventional"], "description": "commit titles follow Conventional Commits, checked by the merge gate; absent = not checked"},
    "mailbox": {"type": "object", "properties": {"escalate": {"type": "boolean"}}},
    "publishes": {"type": "array", "items": {"type": "object", "required": ["kind", "path"]}},
    "provides": {"type": "array", "items": {"type": "object", "required": ["contract", "v", "schema"]}},
    "consumes": {"type": "array", "items": {"type": "object", "required": ["contract", "v", "copy"]}},
    "services": {"type": "array", "items": {"type": "object", "required": ["name", "run"]}},
    "jobs": {"type": "array", "items": {"type": "object", "required": ["name"]}},
    "secrets": {"type": "array", "description": "the credentials this project uses: only names, locations, expiry, no values", "items": {"type": "object", "required": ["name", "path"], "additionalProperties": false, "properties": {
      "name": {"type": "string"}, "path": {"type": "string"}, "env_key": {"type": "string"},
      "expires": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "max_age_days": {"type": "integer", "minimum": 1},
      "warn_days": {"type": "integer", "minimum": 1}, "backup": {"type": "boolean"}, "why": {"type": "string"}, "rotate": {"type": "string"}}}},
    "enforce": {"type": "object", "properties": {"sandbox": {"type": "boolean"}, "capabilities": {"type": "array", "items": {"type": "string"}, "description": "platform capabilities (hub.json capabilities, e.g. gpu); inside the sandbox, hub-run --cap <capability> runs through the platform runner"},
        "work": {"type": "boolean", "description": "a discuss session (lease) may write to the project; requires sandbox: true (the OS sandbox blocks writes outside the folder). Turned on only when the owner confirms directly"}}, "additionalProperties": false},
    "network": {"type": "array", "items": {"type": "string"}},
    "allow_write": {"type": "array", "items": {"type": "string"}},
    "gate": {"enum": ["strict", "detect"]}
  }
}
