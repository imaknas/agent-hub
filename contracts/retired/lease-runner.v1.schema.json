{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "records-lease-runner.v1",
  "title": "Channel lease runner API v1",
  "description": "Local HTTP (127.0.0.1, Bearer token). $defs are the shapes of the requests, events and errors. Adding a field keeps the version.",
  "$defs": {
    "create": {
      "type": "object",
      "required": [
        "project",
        "session_id",
        "thread"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "project": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "discuss",
            "work"
          ],
          "description": "discuss = read-only discussion; work = may change this project's files and run commands, asking the user first every time (only for the policy's work_projects)"
        },
        "session_id": {
          "type": "string",
          "minLength": 8
        },
        "thread": {
          "type": "string"
        },
        "resume": {
          "type": "boolean"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "message": {
      "type": "object",
      "required": [
        "text",
        "client_msg_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "text": {
          "type": "string"
        },
        "client_msg_id": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "description": "attachments: saved in that project folder as attachments/<YYYYMMDD-HHMMSS>-<name> (file name cleaned, never overwritten, not in git); images (image/jpeg|png|gif|webp) are also shown to the model directly; the text gets a line with the saved path appended. At most 10 MB each after decoding; at most 100 MB for the whole request.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "media_type",
              "data"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "media_type": {
                "type": "string",
                "minLength": 1
              },
              "data": {
                "type": "string",
                "description": "base64"
              }
            }
          }
        }
      },
      "description": "POST /v1/leases/<id>/messages. At least one of text and attachments is required (text can be an empty string when only attachments are sent)."
    },
    "detach": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "reason": {
          "enum": [
            "user",
            "idle",
            "done",
            "budget"
          ]
        }
      }
    },
    "lease": {
      "type": "object",
      "required": [
        "lease_id",
        "project",
        "mode",
        "state"
      ],
      "properties": {
        "lease_id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "thread": {
          "type": "string"
        },
        "state": {
          "enum": [
            "attaching",
            "running",
            "idle_stopped",
            "resuming",
            "terminal",
            "detaching",
            "detached",
            "crashed"
          ]
        },
        "last_activity": {
          "type": "string"
        },
        "waiting": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "v",
        "seq",
        "lease_id",
        "ts",
        "type"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer"
        },
        "lease_id": {
          "type": "string"
        },
        "ts": {
          "type": "string"
        },
        "type": {
          "enum": [
            "state",
            "text_delta",
            "assistant",
            "tool_use",
            "tool_result",
            "turn_end",
            "rate_limit",
            "idle_warning",
            "question",
            "permission",
            "handover",
            "error"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "v",
        "error"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "detail": {
          "type": "string"
        },
        "error": {
          "enum": [
            "not_registered",
            "cap_reached",
            "busy",
            "not_found",
            "bad_request",
            "auth",
            "rate_limit",
            "process_crashed",
            "resume_failed",
            "handover_failed",
            "unauthorized",
            "internal",
            "bad_name",
            "exists",
            "too_many",
            "create_failed",
            "work_not_allowed",
            "not_idea",
            "dirty",
            "name_taken",
            "upgrade_failed"
          ]
        },
        "limit": {
          "type": "integer",
          "description": "too_many: the maximum number of idea sandboxes at once"
        },
        "current": {
          "type": "integer",
          "description": "too_many: how many there are now"
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "v",
        "no_session_domains",
        "attachable"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "no_session_domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "domains (including subdomains) WebFetch can never \"allow for the whole lease\""
        },
        "attachable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "names of the projects that can be leased"
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "work_projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "projects that can use work mode (idea sandboxes whose settings already have the OS sandbox written in)"
        }
      }
    },
    "terminal": {
      "type": "object",
      "required": [
        "v",
        "command"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "command": {
          "type": "string",
          "description": "the command to continue this session in a terminal, displayed as is"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "v",
        "leased",
        "cap"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "leased": {
          "type": "integer"
        },
        "cap": {
          "type": "integer"
        },
        "rate_limit": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "five_hour": {
              "type": [
                "number",
                "null"
              ]
            },
            "seven_day": {
              "type": [
                "number",
                "null"
              ]
            },
            "at": {
              "type": "string"
            },
            "five_hour_resets_at": {
              "type": [
                "integer",
                "null"
              ]
            },
            "seven_day_resets_at": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "rate_limit_event": {
      "type": "object",
      "description": "the content of a type=rate_limit event; resets_at is in epoch seconds",
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "five_hour": {
          "type": [
            "number",
            "null"
          ]
        },
        "seven_day": {
          "type": [
            "number",
            "null"
          ]
        },
        "five_hour_resets_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "seven_day_resets_at": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "sandbox_create": {
      "type": "object",
      "required": [
        "v",
        "name",
        "purpose"
      ],
      "description": "POST /v1/sandboxes: opens an exploration project for an idea (read-only by default). Sending the same name and purpose again returns the same project (200) instead of opening another.",
      "properties": {
        "v": {
          "const": 1
        },
        "name": {
          "type": "string",
          "pattern": "^idea-[0-9]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "the idea itself"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "required": [
        "v",
        "name",
        "created"
      ],
      "description": "201 (created) or 200 (already exists, resent). After that the name appears in the policy's attachable and can be leased like any project. Errors: 400 bad_name, 409 exists (same name but a different purpose, or the name is taken by a real project), 429 too_many (with limit, current), 500 create_failed.",
      "properties": {
        "v": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        }
      }
    },
    "mode": {
      "type": "object",
      "required": [
        "v",
        "mode"
      ],
      "description": "POST /v1/leases/<id>/mode: switches discuss / work midway through a discussion (sent only after the user allows hands-on work on the card). Success returns 200 + lease; 409 busy while answering or waiting for the user's reply; 400 work_not_allowed when not in work_projects. Switching stops the process and resumes the same session, and the permission relay starts over too (domains previously \"allowed for the whole lease\" and file writes must be allowed again).",
      "properties": {
        "v": {
          "const": 1
        },
        "mode": {
          "enum": [
            "discuss",
            "work"
          ]
        }
      }
    },
    "sandbox_upgrade": {
      "type": "object",
      "required": [
        "v"
      ],
      "description": "POST /v1/sandboxes/<name>/upgrade: upgrades an idea sandbox to a real project (history, files and memory all kept; creates a private GitHub repo). Sent only after the user agrees in the conversation. Sending it again for one already upgraded returns 200 + upgraded:false and the current name (safe to resend, found even after a rename).",
      "properties": {
        "v": {
          "const": 1
        },
        "rename": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "rename while upgrading"
        }
      }
    },
    "sandbox_upgraded": {
      "type": "object",
      "required": [
        "v",
        "name",
        "origin",
        "upgraded"
      ],
      "description": "200. Errors: 404 not_found (no such sandbox), 409 not_idea (not an idea sandbox), 409 dirty (uncommitted changes), 409 name_taken (the new name or GitHub repo already exists), 500 upgrade_failed.",
      "properties": {
        "v": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "upgraded": {
          "type": "boolean"
        }
      }
    }
  }
}
