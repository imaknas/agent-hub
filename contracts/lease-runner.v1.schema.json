{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "records-lease-runner.v1",
  "title": "通道租借 runner API v1",
  "description": "本機 HTTP(127.0.0.1,Bearer token)。$defs 是各個請求、事件、錯誤的形狀。加欄位不升版。",
  "$defs": {
    "create": {
      "type": "object",
      "required": [
        "project",
        "session_id",
        "thread"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "project": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "discuss"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 8
        },
        "thread": {
          "type": "string"
        },
        "resume": {
          "type": "boolean"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "message": {
      "type": "object",
      "required": [
        "text",
        "client_msg_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "client_msg_id": {
          "type": "string"
        }
      }
    },
    "detach": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "reason": {
          "enum": [
            "user",
            "idle",
            "done",
            "budget"
          ]
        }
      }
    },
    "lease": {
      "type": "object",
      "required": [
        "lease_id",
        "project",
        "mode",
        "state"
      ],
      "properties": {
        "lease_id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "thread": {
          "type": "string"
        },
        "state": {
          "enum": [
            "attaching",
            "running",
            "idle_stopped",
            "resuming",
            "terminal",
            "detaching",
            "detached",
            "crashed"
          ]
        },
        "last_activity": {
          "type": "string"
        },
        "waiting": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "v",
        "seq",
        "lease_id",
        "ts",
        "type"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer"
        },
        "lease_id": {
          "type": "string"
        },
        "ts": {
          "type": "string"
        },
        "type": {
          "enum": [
            "state",
            "text_delta",
            "assistant",
            "tool_use",
            "tool_result",
            "turn_end",
            "rate_limit",
            "idle_warning",
            "question",
            "permission",
            "handover",
            "error"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "v",
        "error"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "detail": {
          "type": "string"
        },
        "error": {
          "enum": [
            "not_registered",
            "cap_reached",
            "busy",
            "not_found",
            "bad_request",
            "auth",
            "rate_limit",
            "process_crashed",
            "resume_failed",
            "handover_failed",
            "unauthorized",
            "internal",
            "bad_name",
            "exists",
            "too_many",
            "create_failed"
          ]
        },
        "limit": {
          "type": "integer",
          "description": "too_many:同時最多幾個想法沙盒"
        },
        "current": {
          "type": "integer",
          "description": "too_many:現在有幾個"
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "v",
        "no_session_domains",
        "attachable"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "no_session_domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "WebFetch 不能「整個租約都允許」的網域(含子網域)"
        },
        "attachable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "可以借用的專案名稱"
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "terminal": {
      "type": "object",
      "required": [
        "v",
        "command"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "command": {
          "type": "string",
          "description": "在終端機接續這個 session 的指令,照原樣顯示"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "v",
        "leased",
        "cap"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "leased": {
          "type": "integer"
        },
        "cap": {
          "type": "integer"
        },
        "rate_limit": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "five_hour": {
              "type": [
                "number",
                "null"
              ]
            },
            "seven_day": {
              "type": [
                "number",
                "null"
              ]
            },
            "at": {
              "type": "string"
            },
            "five_hour_resets_at": {
              "type": [
                "integer",
                "null"
              ]
            },
            "seven_day_resets_at": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "rate_limit_event": {
      "type": "object",
      "description": "type=rate_limit 的事件內容;resets_at 是 epoch 秒",
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "five_hour": {
          "type": [
            "number",
            "null"
          ]
        },
        "seven_day": {
          "type": [
            "number",
            "null"
          ]
        },
        "five_hour_resets_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "seven_day_resets_at": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "sandbox_create": {
      "type": "object",
      "required": [
        "v",
        "name",
        "purpose"
      ],
      "description": "POST /v1/sandboxes:替一個想法開探討用的專案(預設唯讀)。同名、同 purpose 再送一次回同一個專案(200),不另開新的。",
      "properties": {
        "v": {
          "const": 1
        },
        "name": {
          "type": "string",
          "pattern": "^idea-[0-9]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "想法本身"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "required": [
        "v",
        "name",
        "created"
      ],
      "description": "201(新建)或 200(已存在,重送)。之後這個名稱出現在 policy 的 attachable,可以照一般專案借用。錯誤:400 bad_name、409 exists(同名但 purpose 不同,或名稱已被正式專案用掉)、429 too_many(帶 limit、current)、500 create_failed。",
      "properties": {
        "v": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        }
      }
    }
  }
}
