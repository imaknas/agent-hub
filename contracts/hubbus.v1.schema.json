{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "records-hubbus.v1",
  "title": "hubbus event (one row of .state/bus.db; bin/hubbus)",
  "description": "Append-only event log. payload is the object decoded from the JSON string and always carries \"v\": 1 (events before 2026-10-22 have none; read as 1). Adding a field keeps the version; renaming/changing a meaning bumps it, with both versions side by side.",
  "type": "object",
  "required": ["seq", "id", "ts", "type", "source", "payload"],
  "properties": {
    "seq": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "minLength": 1, "description": "unique id given by the sender; resending the same id = does nothing"},
    "ts": {"type": "string"},
    "type": {"enum": ["message", "message.delivered", "message.done", "job.failed", "merge.done", "merge.failed", "session.report", "config.applied", "record"]},
    "source": {"type": "string", "description": "sender address: a project name, the platform, or owner (or the owner's configured alias)"},
    "to_project": {"type": ["string", "null"], "description": "the recipient address of a message"},
    "ref": {"type": ["string", "null"], "description": "which event this event is about (delivered/done → the letter id; reply → the original letter)"},
    "payload": {"type": "object", "properties": {"v": {"const": 1}}}
  },
  "if": {"properties": {"type": {"const": "message"}}},
  "then": {"properties": {"payload": {"$ref": "#/$defs/message"}}},
  "else": {"if": {"properties": {"type": {"const": "config.applied"}}},
           "then": {"properties": {"payload": {"$ref": "#/$defs/config_applied"}}},
           "else": {"if": {"properties": {"type": {"const": "record"}}},
                    "then": {"properties": {"payload": {"$ref": "#/$defs/record"}}}}},
  "$defs": {
    "record": {
      "type": "object",
      "description": "one Principal Handoff 0.3 record (written by hubbus record-publish, exchanged with the assistant by bridge v2; event id = rec:<ext>:<project>:<record id>). The record's full format follows the agent-ops-specs core/acts/decisions schemas and is validated before it is written to the bus; here only the envelope is checked",
      "required": ["record"],
      "properties": {
        "v": {"const": 1},
        "record": {"type": "object", "required": ["ph", "ext", "id", "type", "project"],
          "properties": {"ph": {"type": "string"}, "ext": {"type": "string"}, "id": {"type": "string", "minLength": 1},
                         "type": {"type": "string", "minLength": 1}, "project": {"type": "string", "minLength": 1}}}
      }
    },
    "config_applied": {
      "type": "object",
      "description": "bin/hub config apply applied a version of the config (docs/design/new-user.md 3.7): commit = the commit that last changed the config files, changes = the changes each applier actually made",
      "required": ["commit", "changes"],
      "properties": {
        "v": {"const": 1},
        "commit": {"type": "string", "minLength": 1},
        "source": {"type": "string"},
        "changes": {"type": "array", "items": {"type": "object", "required": ["op", "target"],
          "properties": {"op": {"enum": ["add", "update", "remove"]}, "target": {"type": "string", "minLength": 1},
                         "detail": {"type": "string"}}}}
      }
    },
    "message": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "v": {"const": 1},
        "type": {"enum": ["request", "question", "info", "progress", "done", "task", "drop", "handoff", "manifest.update"]},
        "text": {"type": "string"},
        "from_session": {"type": ["string", "null"]},
        "to_session": {"type": ["string", "null"]},
        "reply_to": {"type": ["string", "null"]},
        "handoff_id": {"type": ["integer", "null"]},
        "task": {"type": "string"},
        "due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "context": {"type": "string"},
        "new_reason": {"type": "string"},
        "inferred": {"type": "boolean"},
        "effect": {"type": ["string", "null"]},
        "handoff": {"type": "object"}
      }
    }
  }
}
