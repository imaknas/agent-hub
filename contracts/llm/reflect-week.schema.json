{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "headline",
  "summary",
  "insights",
  "projects",
  "rhythm",
  "fluency",
  "next_week"
 ],
 "properties": {
  "headline": {
   "type": "string",
   "description": "一句話講這週最重要的事,≤ 30 字"
  },
  "summary": {
   "type": "string",
   "description": "3–4 句總評:這週的重心、做成了什麼、最大的問題"
  },
  "insights": {
   "type": "array",
   "minItems": 3,
   "maxItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "title",
     "analysis",
     "evidence",
     "so_what"
    ],
    "properties": {
     "title": {
      "type": "string",
      "description": "洞察的結論句,≤ 22 字"
     },
     "analysis": {
      "type": "string",
      "description": "2–3 句分析:看到什麼模式、為什麼會這樣"
     },
     "evidence": {
      "type": "string",
      "description": "具體證據:統計數字或摘要內容"
     },
     "so_what": {
      "type": "string",
      "description": "這代表什麼、該怎麼看待,1 句"
     }
    }
   }
  },
  "projects": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "focus",
     "assessment",
     "status",
     "next"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "focus": {
      "type": "string",
      "description": "這週在做什麼(有摘要就具體到功能/決定,沒有就講投入樣貌)"
     },
     "assessment": {
      "type": "string",
      "description": "進展評估:推進得如何、投入跟產出是否相稱"
     },
     "status": {
      "type": "string",
      "enum": [
       "推進",
       "穩定",
       "卡住",
       "發散",
       "收尾"
      ]
     },
     "next": {
      "type": "string",
      "description": "下一步最該做的一件事"
     }
    }
   }
  },
  "rhythm": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "verdict",
    "analysis",
    "pattern"
   ],
   "properties": {
    "verdict": {
     "type": "string",
     "description": "作息一句話結論"
    },
    "analysis": {
     "type": "string",
     "description": "2–3 句:時段、深夜、連續工作代表什麼,對產出/判斷品質可能的影響"
    },
    "pattern": {
     "type": "string",
     "description": "最明顯的一個節奏模式"
    }
   }
  },
  "fluency": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "dimension",
     "level",
     "observation",
     "evidence",
     "suggestion"
    ],
    "properties": {
     "dimension": {
      "type": "string",
      "enum": [
       "交辦",
       "描述",
       "判斷",
       "把關"
      ]
     },
     "level": {
      "type": "string",
      "enum": [
       "強項",
       "穩定",
       "可改進"
      ]
     },
     "observation": {
      "type": "string",
      "description": "2 句觀察"
     },
     "evidence": {
      "type": "string",
      "description": "根據的統計數字或摘要內容;撐不起判斷就直說"
     },
     "suggestion": {
      "type": "string",
      "description": "具體做法,1 句"
     }
    }
   }
  },
  "next_week": {
   "type": "array",
   "minItems": 2,
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "action",
     "why"
    ],
    "properties": {
     "action": {
      "type": "string",
      "description": "可以直接照做的一件事"
     },
     "why": {
      "type": "string",
      "description": "對應哪個觀察、預期效果"
     }
    }
   }
  }
 }
}
