{
 "type": "object",
 "properties": {
  "folded": {
   "type": "array",
   "description": "這次整理完、可以 git rm 的日期檔(只能是這次給的那幾個)",
   "items": {
    "type": "object",
    "properties": {
     "file": {
      "type": "string",
      "description": "例如 memory/2026-09-25.md"
     },
     "destinations": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "內容放在哪些檔案(memory/reference/<主題>.md 或 STATE.md);內容本來就已經在那裡也列"
     },
     "dropped": {
      "type": "string",
      "description": "沒有保留的內容跟原因(純流程雜訊/重複/被較新紀錄推翻);全部保留就寫空字串"
     }
    },
    "required": [
     "file",
     "destinations",
     "dropped"
    ]
   }
  },
  "kept": {
   "type": "array",
   "description": "這次給的日期檔裡,還不能刪的,跟原因",
   "items": {
    "type": "object",
    "properties": {
     "file": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "file",
     "reason"
    ]
   }
  },
  "corrections": {
   "type": "array",
   "description": "reference/ 或 STATE.md 裡因為被較新紀錄推翻/取代而改掉的敘述",
   "items": {
    "type": "object",
    "properties": {
     "file": {
      "type": "string",
      "description": "改的是哪個檔案"
     },
     "before": {
      "type": "string",
      "description": "原本的敘述(逐字)"
     },
     "after": {
      "type": "string",
      "description": "改成的敘述(逐字)"
     },
     "evidence_file": {
      "type": "string",
      "description": "根據哪個檔案(通常是較新的日期檔)"
     },
     "evidence_quote": {
      "type": "string",
      "description": "從 evidence_file 逐字複製、能證明要這樣改的句子"
     }
    },
    "required": [
     "file",
     "before",
     "after",
     "evidence_file",
     "evidence_quote"
    ]
   }
  },
  "summary": {
   "type": "string",
   "description": "這次做了什麼,三句話內,給人抽查用"
  }
 },
 "required": [
  "folded",
  "kept",
  "corrections",
  "summary"
 ]
}
