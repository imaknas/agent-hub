{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "records-reflect-week.v2",
  "title": "Weekly activity analysis <YYYY-Www>.json",
  "description": "A week's cross-project activity statistics plus the model's analysis. Carries \"v\": 2. v2 = v1 plus fixed, language-neutral values for the analysis's classifications (a project's status, each fluency dimension and its level); v1 files carried them as zh-Hant words, mapped to the v2 values in x-v1-values so a reader can take both. analysis may be only {error, meta}.",
  "type": "object",
  "required": [
    "week",
    "start",
    "end",
    "generated",
    "totals",
    "projects",
    "rhythm",
    "delegation"
  ],
  "properties": {
    "v": {
      "const": 2
    },
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "start": {
      "type": "string"
    },
    "end": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "timezone": {
      "description": "the time zone the hours are counted in (hub.json owner.timezone); weeks written before it was added were counted in Asia/Taipei",
      "type": "string"
    },
    "totals": {
      "type": "object",
      "required": [
        "prompts",
        "prompts_prev",
        "sessions",
        "projects",
        "days"
      ]
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "prompts"
        ]
      }
    },
    "matrix": {
      "type": "array"
    },
    "rhythm": {
      "type": "object",
      "required": [
        "late",
        "late_share",
        "longest_hours",
        "last_per_day"
      ]
    },
    "delegation": {
      "type": "object",
      "required": [
        "agents",
        "peer"
      ]
    },
    "changes": {
      "type": "object"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object"
        },
        "error": {
          "type": "string"
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "advancing",
                  "stable",
                  "stuck",
                  "diverging",
                  "wrapping_up"
                ]
              }
            }
          }
        },
        "fluency": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dimension": {
                "enum": [
                  "delegation",
                  "description",
                  "discernment",
                  "diligence"
                ]
              },
              "level": {
                "enum": [
                  "strength",
                  "stable",
                  "needs_work"
                ]
              }
            }
          }
        }
      }
    },
    "unsupported": {
      "type": "string",
      "description": "This runtime has no transcripts: conversation statistics (messages, daily rhythm, how work was handed off) were not computed or sent for analysis; the value is the reason"
    }
  },
  "x-v1-values": {
    "status": {
      "推進": "advancing",
      "穩定": "stable",
      "卡住": "stuck",
      "發散": "diverging",
      "收尾": "wrapping_up"
    },
    "dimension": {
      "交辦": "delegation",
      "描述": "description",
      "判斷": "discernment",
      "把關": "diligence"
    },
    "level": {
      "強項": "strength",
      "穩定": "stable",
      "可改進": "needs_work"
    }
  }
}
