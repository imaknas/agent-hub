{
  "$comment": "The platform settings hub.json (read by bin/hubconf.py; template hub.example.json). bin/config-check validates it with minischema and also rejects unknown top-level keys (except explanation keys starting with _), so a misspelled key is never silently ignored. Adding a field keeps the version.",
  "type": "object",
  "required": [
    "v",
    "registry_dir",
    "owner"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "registry_dir": {
      "type": "string",
      "minLength": 1
    },
    "services_root": {
      "type": "string"
    },
    "workspace_root": {
      "type": "string"
    },
    "memory_copies": {
      "type": "string"
    },
    "git_origin": {
      "type": "string"
    },
    "memory_host": {
      "type": "string"
    },
    "bus_dir": {
      "type": "string"
    },
    "evals_dir": {
      "type": "string"
    },
    "language": {
      "type": "object",
      "description": "ui: what the platform shows the owner; content: what models and agents write (docs/design/i18n.md). Default en.",
      "additionalProperties": false,
      "properties": {
        "ui": {"enum": ["en", "zh-Hant"]},
        "content": {"enum": ["en", "zh-Hant"]}
      }
    },
    "owner": {
      "type": "object",
      "required": [
        "address",
        "tag"
      ],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string"
        },
        "principal_id": {
          "description": "Principal Handoff: the principal identifier (core R6), the same on every system that exchanges records with this deployment",
          "type": "string",
          "pattern": "^\\S{1,256}$"
        },
        "legal_person": {
          "description": "Principal Handoff: the principal is a legal person (settlements then name a representative)",
          "type": "boolean"
        }
      }
    },
    "assistant": {
      "type": "object",
      "required": [
        "project",
        "api"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "type": "string",
          "pattern": "^https?://"
        },
        "ingest_token": {
          "type": "string"
        },
        "cli": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "party_id": {
          "description": "Principal Handoff: the principal side's party identifier",
          "type": "string",
          "pattern": "^\\S{1,256}$"
        }
      }
    },
    "alerts": {
      "type": "object",
      "properties": {
        "discord_token_file": {
          "type": "string"
        },
        "discord_channel_file": {
          "type": "string"
        },
        "ntfy": {"type": "object", "required": ["topic"], "properties": {"topic": {"type": "string"}, "base_url": {"type": "string"}, "token_file": {"type": "string"}}},
        "email": {"type": "object", "required": ["host", "to"], "properties": {"host": {"type": "string"}, "port": {"type": "integer"}, "user": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "password_file": {"type": "string"}, "ssl": {"type": "boolean"}}},
        "macos": {"type": "boolean"}
      }
    },
    "owner_side": {
      "enum": ["assistant", "builtin"],
      "description": "the principal side of Principal Handoff: assistant = the assistant in hub.json assistant (through its API); builtin = the platform's built-in minimal owner side (bin/owner.py). Absent: assistant if assistant.api is set, otherwise builtin"
    },
    "backup": {
      "type": "object",
      "required": [
        "repo"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "sqlite": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "bare_repos": {
          "type": "string"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keep": {
          "type": "object",
          "properties": {
            "daily": {
              "type": "integer",
              "minimum": 0
            },
            "weekly": {
              "type": "integer",
              "minimum": 0
            },
            "monthly": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "github": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string"
        },
        "remote": {
          "type": "string"
        }
      }
    },
    "ideas": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hosts": {
      "type": "object",
      "properties": {
        "mbp_home": {
          "type": "string"
        },
        "mini_home": {
          "type": "string"
        },
        "server": {
          "type": "string"
        }
      }
    },
    "mailbox": {
      "type": "object",
      "properties": {
        "handler": {"enum": ["agent", "propose"], "description": "how a request nobody picks up is dispatched: agent = the runtime's agent handles it directly (needs the tool's permissions; only Claude Code for now); propose = any agent runs in a throwaway worktree, the platform adopts only the memory notes and sends the letters for it (bin/propose_apply.py). Default agent"},
        "mcp_presence_min": {"type": "integer", "minimum": 1, "description": "minutes a session using the mailbox only through the platform's MCP server counts as using its project after its last agenthub tool call (docs/design/mailbox-runtimes.md A3). Default 30"},
        "mcp_hold_max_min": {"type": "integer", "minimum": 1, "description": "while such a session uses the project, a request/question to it not yet delivered to any session is held at most this many minutes from the letter's time, then dispatched as usual. Default 120"}
      }
    },
    "credentials": {
      "type": "object",
      "properties": {
        "dirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "object"
    },
    "service_sandbox_exempt": {
      "type": "array",
      "items": {"type": "string"},
      "description": "sandboxed projects whose own services and command jobs still run unsandboxed, temporarily, until they stop reading platform credentials themselves (bin/sandboxed-run, seatbelt.sandboxed). Only the owner adds to it; a project can't (hub.json is the platform's)"
    },
    "cap_runner": {
      "type": "object"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        },
        "acp": {
          "type": "object",
          "description": "Agent Client Protocol agents (bin/runtime_acp.py header; docs/design/runtime-acp.md): agent names the entry of agents the acp runtime uses",
          "additionalProperties": false,
          "properties": {
            "_comment": {"type": "string"},
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "agents": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["command"],
                "additionalProperties": false,
                "properties": {
                  "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                  "env": {"type": "object", "additionalProperties": {"type": "string"}},
                  "models": {"type": "object"},
                  "credential": {"type": "object", "additionalProperties": false, "required": ["env", "file"], "properties": {"env": {"type": "string"}, "file": {"type": "string"}}},
                  "auth_method": {"type": "string"},
                  "mode": {"type": "string"},
                  "login": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "config_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "env"],
            "properties": {
              "file": {"type": "string"},
              "env": {"type": "string"}
            }
          }
        }
      }
    },
    "lease": {
      "type": "object",
      "properties": {
        "no_session_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "modules": {
      "type": "object"
    },
    "llm": {
      "type": "object",
      "description": "which LLM provider and model the judgment points use, and where the key is (bin/completion.py header; docs/design/llm-providers.md). No providers = judgment points go to runtime.default, models from the runtime's group table; points can be set on their own (the model of individual judgment points). How models are chosen lives only in llm.model_for / completion.resolve; semantic checks in completion.config_errors()",
      "properties": {
        "_comment": {"type": "string"},
        "providers": {"type": "object"},
        "use": {"type": "object"},
        "points": {"type": "object"},
        "budget": {"type": "object", "properties": {"daily_usd": {"type": "number", "minimum": 0}}}
      }
    }
  }
}
