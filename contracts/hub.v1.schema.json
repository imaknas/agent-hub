{
  "$comment": "平台設定 hub.json(bin/hubconf.py 讀;範本 hub.example.json)。bin/config-check 用 minischema 驗證,另外擋「不認得的頂層鍵」(_ 開頭的說明鍵除外)——打錯字的鍵不會被默默忽略。加欄位不升版。",
  "type": "object",
  "required": [
    "v",
    "registry_dir",
    "owner"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "registry_dir": {
      "type": "string",
      "minLength": 1
    },
    "services_root": {
      "type": "string"
    },
    "workspace_root": {
      "type": "string"
    },
    "memory_copies": {
      "type": "string"
    },
    "git_origin": {
      "type": "string"
    },
    "memory_host": {
      "type": "string"
    },
    "bus_dir": {
      "type": "string"
    },
    "owner": {
      "type": "object",
      "required": [
        "address",
        "tag"
      ],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string"
        },
        "principal_id": {
          "description": "Principal Handoff: the principal identifier (core R6), the same on every system that exchanges records with this deployment",
          "type": "string",
          "pattern": "^\\S{1,256}$"
        },
        "legal_person": {
          "description": "Principal Handoff: the principal is a legal person (settlements then name a representative)",
          "type": "boolean"
        }
      }
    },
    "assistant": {
      "type": "object",
      "required": [
        "project",
        "api"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "type": "string",
          "pattern": "^https?://"
        },
        "ingest_token": {
          "type": "string"
        },
        "cli": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "party_id": {
          "description": "Principal Handoff: the principal side's party identifier",
          "type": "string",
          "pattern": "^\\S{1,256}$"
        }
      }
    },
    "alerts": {
      "type": "object",
      "properties": {
        "discord_token_file": {
          "type": "string"
        },
        "discord_channel_file": {
          "type": "string"
        },
        "ntfy": {"type": "object", "required": ["topic"], "properties": {"topic": {"type": "string"}, "base_url": {"type": "string"}, "token_file": {"type": "string"}}},
        "email": {"type": "object", "required": ["host", "to"], "properties": {"host": {"type": "string"}, "port": {"type": "integer"}, "user": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "password_file": {"type": "string"}, "ssl": {"type": "boolean"}}},
        "macos": {"type": "boolean"}
      }
    },
    "owner_side": {
      "enum": ["assistant", "builtin"],
      "description": "Principal Handoff 的 principal 端:assistant = hub.json assistant 的助理(例:Muninn,透過它的 API);builtin = 平台內建的最小 owner 端(bin/owner.py)。沒寫:有 assistant.api 就是 assistant,否則 builtin"
    },
    "backup": {
      "type": "object",
      "required": [
        "repo"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "sqlite": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "bare_repos": {
          "type": "string"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keep": {
          "type": "object",
          "properties": {
            "daily": {
              "type": "integer",
              "minimum": 0
            },
            "weekly": {
              "type": "integer",
              "minimum": 0
            },
            "monthly": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "github": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string"
        },
        "remote": {
          "type": "string"
        }
      }
    },
    "ideas": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hosts": {
      "type": "object",
      "properties": {
        "mbp_home": {
          "type": "string"
        },
        "mini_home": {
          "type": "string"
        },
        "server": {
          "type": "string"
        }
      }
    },
    "mailbox": {
      "type": "object"
    },
    "credentials": {
      "type": "object",
      "properties": {
        "dirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "object"
    },
    "cap_runner": {
      "type": "object"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lease": {
      "type": "object",
      "properties": {
        "no_session_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "modules": {
      "type": "object"
    },
    "llm": {
      "type": "object",
      "description": "判斷點用哪一家 LLM、哪個模型、key 在哪(bin/completion.py 檔頭;docs/design/llm-providers.md)。沒有 = 判斷點照舊交給 runtime.default。語意檢查在 completion.config_errors()",
      "required": ["providers", "use"],
      "properties": {
        "_comment": {"type": "string"},
        "providers": {"type": "object"},
        "use": {"type": "object"},
        "points": {"type": "object"},
        "budget": {"type": "object", "properties": {"daily_usd": {"type": "number", "minimum": 0}}}
      }
    }
  }
}
