#!/bin/sh
# 建(或檢查)平台的 Python 環境:uv 管的 Python 3.13 venv + 平台用到的套件。重跑安全(已經好了就只檢查)。
# 新機器、或 bin/py 說找不到時跑一次。位置跟覆蓋方式看 bin/py。
#   setup-python           建好/補齊,最後驗證
#   setup-python --check   只驗證(版本 ≥ 3.13、套件 import 得到),不動任何東西;不合格 exit 1
set -eu
MIN="3.13"
PKGS="pyyaml==6.0.3"            # 平台腳本唯一的第三方套件(bin/ 全部 import 盤點過,10-25)
dir="${AGENT_HUB_PYTHON:+$(dirname "$(dirname "$AGENT_HUB_PYTHON")")}"
dir="${dir:-$HOME/.local/share/agent-hub/python}"
py="$dir/bin/python3"

check() {
  "$py" -c "
import sys
assert sys.version_info >= (3, 13), f'Python {sys.version.split()[0]} 太舊(最低 $MIN)'
import yaml
print(f'平台的 Python:{sys.version.split()[0]}({sys.executable}),PyYAML {yaml.__version__}')
"
}

if [ "${1:-}" = "--check" ]; then
  [ -x "$py" ] || { echo "沒有 $py(跑 bin/setup-python)" >&2; exit 1; }
  check
  exit
fi

uv="$(command -v uv || echo "$HOME/.local/bin/uv")"
[ -x "$uv" ] || { echo "要先裝 uv(https://docs.astral.sh/uv/;裝在 ~/.local/bin)" >&2; exit 1; }
if [ ! -x "$py" ] || ! "$py" -c "import sys; sys.exit(sys.version_info < (3, 13))" 2>/dev/null; then
  "$uv" python install "$MIN"
  "$uv" venv --python "$MIN" --allow-existing "$dir"
fi
"$uv" pip install --quiet --python "$py" $PKGS
check
