#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""agent-hub's single entry point (docs/design/new-user.md 3.4). A thin dispatch layer; it does not rewrite the existing scripts.

The name is `agenthub` (2026-10-29: `hub` clashed with GitHub's old hub CLI; `bin/hub` stays and forwards here). `agenthub install-cli`
puts a small forwarding script in ~/.local/bin, so any coding agent's session can type `agenthub …` directly and the rules
files need no local paths.

Getting started:
  agenthub init [--home <instance dir>] [--owner <name>] [--timezone <tz>] [--workspace <folder>] [--modules a,b] [--yes]
           [--llm runtime|anthropic|openai|ollama|none] [--llm-model <name>] [--llm-base-url <url>] [--no-launchd] [--dry-run]
                        with no hub.json, creates the instance directory (default ~/.agent-hub: config/ is a git repo, data/,
                        secrets/), writes config/hub.json from hub.example.json (asks a few questions; --yes takes the defaults),
                        and last writes <hub>/.hub-home pointing there; creates the folders it needs; asks which model the
                        platform's decisions go to (= agenthub llm setup); installs the scheduler and watchdog (the launchd/
                        templates; left alone when unchanged); applies the config. With a hub.json already there, leaves it alone
  agenthub doctor            everything that is broken, at a glance: the platform's Python, config, logins, scheduler, watchdog,
                        background services, commit gate
config:
  agenthub config check | plan | apply [--only <applier>,...]
                        validate the config / what would change / apply (check → apply → plan again must be empty → record)
  agenthub llm setup [--llm …] [--llm-model …] [--llm-base-url …]
                        who handles the platform's decisions (nightly tidy-up, weekly report): the coding agent's own login,
                        an Anthropic / OpenAI (or compatible) API key, a local Ollama; the key is not shown and goes into the
                        secrets directory; the model is picked from the list that provider actually has (the platform does not
                        guess names)
  agenthub llm set-key <provider>   write the API key of hub.json llm.providers.<provider> from stdin into the platform's
                        secrets directory (chmod 600; not read from arguments, so it stays out of the shell history)
  agenthub llm health        whether each provider works (= bin/llm.py health)
  agenthub modules [enable|disable <name>]
                        which optional features exist and which are on; switching changes hub.json and applies it (remember
                        to commit hub.json)
  agenthub move-instance --to <instance dir> [--apply]
                        move the old layout (everything in the hub root) to an instance directory: copies only, validates the
                        new layout, writes .hub-home last (delete it to go back)
projects:
  agenthub onboard …         = bin/onboard-project.sh (start a new project / connect a folder)
  agenthub recover <name>    = bin/recover-project.sh (new machine / the folder is gone)
  agenthub rename <old> <new>  = bin/rename-project.sh (dry-run first, then add --apply)
  agenthub status [project]  = bin/overview.sh
scheduling:
  agenthub jobs              = schedulectl list
  agenthub run <job>         = schedulectl run (run it once now)
owner (you; not commands for project sessions):
  agenthub owner list | done/drop/already-done <key> | answer <question id> "answer"
                        = bin/owner.py: the built-in owner side (hub.json owner_side: builtin; with an assistant, list only)
for project sessions (these are what the rules files name; the permission rules allow only these, not the admin commands above):
  agenthub send | inbox | show | ack | done | thread | open-questions …   = the project mailbox (bin/hubbus subcommands of the
                        same name)
  agenthub merge-branch …    = bin/merge-branch (the merge gate for parallel sessions)
  agenthub cap-run --cap <capability> -- <command…>   = bin/hub-run (the platform runs a program the sandbox blocks)
  agenthub install-cli [--dir <folder>]   put agenthub's forwarding script in <folder> (default ~/.local/bin; must be on PATH)
  agenthub mcp               the platform's MCP server (stdio): any coding agent with MCP can use the mailbox and write notes
                        (= bin/mcp_server.py)
  agenthub mcp config        print the snippet to register in the tool's MCP settings (the platform does not change your
                        tool's settings for you; docs/mcp.md)
"""
from __future__ import annotations

import datetime
import getpass
import hashlib
import json
import os
import pathlib
import plistlib
import shutil
import subprocess
import sys

BIN = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(BIN))
import hubconf  # noqa: E402
import i18n  # noqa: E402

_ = i18n.domain(__file__)

ROOT = hubconf.ROOT   # 跟 hubconf 同一個(AGENT_HUB_ROOT 可覆蓋),路徑比對才一致

AGENTS = pathlib.Path.home() / "Library" / "LaunchAgents"
# 排程器跟看門狗不經過 render-services(它是排程器跑的 job;排程器壞了正是看門狗要報的事),由 init 從樣板裝
CORE_PLISTS = ("local.agent-hub-scheduler", "local.agent-hub-scheduler-watchdog")


# ---------- config ----------

def show(plans: dict) -> int:
    n = 0
    for name, changes in plans.items():
        for c in changes:
            print(f"{name:15} {c.line()}")
            n += 1
    if not n:
        print(_("nothing to change (the machine matches the config)"))
    return n


def cmd_config(argv: list[str]) -> int:
    import appliers
    sub = argv[0] if argv else ""
    only = argv[argv.index("--only") + 1].split(",") if "--only" in argv else None
    if sub == "check":
        return subprocess.run(hubconf.launch(BIN / "config-check")).returncode
    if sub == "plan":
        show(appliers.plan_all(only=only))
        return 0
    if sub == "apply":
        if subprocess.run(hubconf.launch(BIN / "config-check")).returncode != 0:
            print(_("hub config apply: the config is invalid, nothing applied"), file=sys.stderr)
            return 1
        done = appliers.apply_all(only=only)
        show(done)
        left = {n: c for n, c in appliers.plan_all(only=only).items() if c}
        if left:  # verify:套用完再 plan 應該是空的
            print(_("hub config apply: ⚠️ still out of line after applying:"), file=sys.stderr)
            show(left)
        record(done, ok=not left)
        return 1 if left else 0
    print(_(__doc__), file=sys.stderr)
    return 2


def record(done: dict, ok: bool) -> None:
    """記下套用了哪個 config commit:.state/config-applied.json(狀態頁讀)+ 匯流排 config.applied(有改東西才發)。"""
    import appliers
    commit = appliers.config_commit()
    applied = appliers.applied_path()
    changes = [{"op": c.op, "target": c.target, "detail": c.detail} for cs in done.values() for c in cs]
    applied.parent.mkdir(parents=True, exist_ok=True)
    applied.write_text(json.dumps({"commit": commit, "ok": ok, "changes": len(changes),
                                   "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds")},
                                  ensure_ascii=False, indent=1) + "\n")
    if not changes:
        return
    payload = {"commit": commit, "changes": changes, "source": "hub config apply"}
    eid = "config-" + hashlib.sha1(json.dumps(payload, sort_keys=True).encode()).hexdigest()[:16]  # 同樣的套用重送不重記
    r = subprocess.run([str(BIN / "py"), str(BIN / "hubbus"), "publish", "config.applied", "--source", hubconf.hub_project(),
                        "--payload", json.dumps(payload, ensure_ascii=False), "--id", eid], capture_output=True, text=True)
    if r.returncode != 0:
        print(_("hub config apply: recording on the bus failed (.state/config-applied.json was written): {error}",
                error=r.stderr.strip()[:200]), file=sys.stderr)


# ---------- modules ----------

def read_hub_json() -> dict:
    return json.loads(hubconf.config_file("hub.json").read_text())


def write_hub_json(d: dict) -> None:
    hubconf.config_file("hub.json").write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")


def cmd_modules(argv: list[str]) -> int:
    import registry
    import yaml
    on = set(registry.enabled_modules())
    if not argv:
        for f in sorted(registry.MODULES_DIR.glob("*.yaml")):
            doc = yaml.safe_load(f.read_text()) or {}
            print(f"{'✓' if f.stem in on else ' '} {f.stem:12} {doc.get('description', '')}")
        print(_("\nswitch: hub modules enable|disable <name> (changes modules in hub.json, then applies)"))
        return 0
    if len(argv) != 2 or argv[0] not in ("enable", "disable"):
        print(_(__doc__), file=sys.stderr)
        return 2
    name = argv[1]
    if not (registry.MODULES_DIR / f"{name}.yaml").exists():
        print(_("hub modules: no module {name} (modules/ has: {available})", name=name,
                available=', '.join(sorted(p.stem for p in registry.MODULES_DIR.glob('*.yaml')))), file=sys.stderr)
        return 1
    d = read_hub_json()
    d.setdefault("modules", {})[name] = argv[0] == "enable"
    write_hub_json(d)
    print(f"hub.json:modules.{name} = {str(argv[0] == 'enable').lower()}")
    rc = subprocess.run([*hubconf.launch(BIN / "agenthub"), "config", "apply"]).returncode
    print(_("remember to commit hub.json (config as code)."))
    return rc


# ---------- init ----------

def ask(question: str, default: str, yes: bool) -> str:
    if yes or not sys.stdin.isatty():
        return default
    a = input(_("{question} [{default}]: ", question=question, default=default)).strip()
    return a or default


def render_plist(label: str) -> bytes:
    return (ROOT / "launchd" / f"{label}.plist").read_text().replace("{{hub}}", str(ROOT)).encode()


def install_core_plists(dry: bool) -> list[str]:
    """排程器 + 看門狗:樣板的內容跟已經裝的一樣就不動(不會無故重載排程器)。"""
    sm = hubconf.service_manager()
    if sm is None:
        return [_("⚠️ {reason}; to run the nightly flow, schedule `bin/py bin/scheduler.py` yourself (every 15 minutes)",
                  reason=hubconf.NO_SERVICE_MANAGER)]
    if sm == "systemd":   # 同一份 launchd/ 樣板翻成 user unit(bin/systemd_units.py)
        import systemd_units
        done = []
        for label in CORE_PLISTS:
            plist = plistlib.loads(render_plist(label))
            if systemd_units.installed(label) == systemd_units.files(plist) and systemd_units.state(label) == "running":
                continue
            done.append(_("{dry}{label}: {action} (systemd)", dry="(dry-run) " if dry else "", label=label,
                           action=_("update") if systemd_units.installed(label) else _("install")))
            if not dry:
                r = systemd_units.install(plist)
                if r.returncode != 0:
                    done.append(_("  ⚠️ systemctl enable failed: {error}", error=r.stderr.strip()[:200]))
        if systemd_units.linger() is False:
            done.append(_("  ⚠️ user units stop after logout: `loginctl enable-linger $USER` (needs sudo)"))
        return done
    done = []
    for label in CORE_PLISTS:
        want = render_plist(label)
        path = AGENTS / f"{label}.plist"
        cur = path.read_bytes() if path.exists() else None
        loaded = subprocess.run(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"], capture_output=True).returncode == 0
        if cur is not None and plistlib.loads(cur) == plistlib.loads(want) and loaded:
            continue
        done.append(_("{dry}{label}: {action}", dry="(dry-run) " if dry else "", label=label,
                       action=_("install") if cur is None else _("update") if cur else _("load")))
        if dry:
            continue
        AGENTS.mkdir(parents=True, exist_ok=True)
        if loaded:
            subprocess.run(["/bin/launchctl", "bootout", f"gui/{os.getuid()}/{label}"], capture_output=True)
        path.write_bytes(want)
        r = subprocess.run(["/bin/launchctl", "bootstrap", f"gui/{os.getuid()}", str(path)], capture_output=True, text=True)
        if r.returncode != 0:
            done.append(_("  ⚠️ bootstrap failed: {error}", error=r.stderr.strip()[:200]))
    return done


def new_hub_json(args: dict, yes: bool) -> dict:
    d = json.loads((ROOT / "hub.example.json").read_text())
    try:
        default_tz = os.path.realpath("/etc/localtime").split("zoneinfo/")[1]
    except IndexError:
        default_tz = "UTC"
    d["owner"]["tag"] = args.get("owner") or ask(_("your name (in the owner to-do tag, and what agents call you)"), getpass.getuser(), yes)
    d["owner"]["timezone"] = args.get("timezone") or ask(_("time zone"), default_tz, yes)
    d["workspace_root"] = args.get("workspace") or ask(_("where projects live"), d.get("workspace_root", "~/workspace"), yes)
    shipped = [k for k, v in d.get("modules", {}).items() if not k.startswith("_")]
    import shutil
    # 照這台有什麼決定預設(docs/design/tool-agnostic.md):有 Claude Code 才開它的維護模組;沒有助理就用內建的 owner 端
    if "claude" in d["modules"]:
        d["modules"]["claude"] = bool(shutil.which("claude"))
    if "owner" in d["modules"]:
        d["modules"]["owner"] = not (d.get("assistant") or {}).get("api")
    if (d.get("runtime") or {}).get("default", "claude") == "claude" and not shutil.which("claude"):
        d["runtime"] = {"default": "none"}   # 沒有 coding agent:agent 的功能明確關掉(doctor 的功能表會說)
    default_on = ",".join(k for k in shipped if d["modules"][k] is True)
    picked = args.get("modules") or ask(_("which modules to turn on (available: {modules})", modules=', '.join(shipped)), default_on, yes)
    want = {m.strip() for m in picked.split(",") if m.strip()}
    for k in shipped:
        d["modules"][k] = k in want
    # 沒開的功能,它的設定段也拿掉(留著範本的佔位值反而會被當成真的設定)
    for module, section in (("assistant", "assistant"), ("backup", "backup")):
        if module not in want:
            d.pop(section, None)
    d.pop("alerts", None)  # 警報要先有 Discord bot;要的時候照 hub.example.json 加回 alerts 段
    gh = shutil.which("gh") and subprocess.run(["gh", "api", "user", "--jq", ".login"], capture_output=True, text=True)
    if gh and gh.returncode == 0 and gh.stdout.strip():
        d["github"]["owner"] = gh.stdout.strip()
    else:
        d.pop("github", None)  # onboard 時用 --no-remote;要建 GitHub repo 就先 gh auth login,再補 github.owner
    return d


def cmd_init(argv: list[str]) -> int:
    flags = {a for a in argv if a in ("--yes", "--no-launchd", "--dry-run")}
    args = {k.lstrip("-"): argv[i + 1] for i, k in enumerate(argv[:-1])
            if k in ("--owner", "--timezone", "--workspace", "--modules", "--home", "--llm", "--llm-model", "--llm-base-url")}
    dry, yes = "--dry-run" in flags, "--yes" in flags
    created = False
    legacy = hubconf.instance_home() is None and hubconf.config_file("hub.json").exists()
    if legacy:
        # 舊的擺法(hub.json 在 hub 根目錄,搬家前的樣子):不動,搬家另外做(docs/design/new-user.md 第 6 步)
        print(_("✓ {path} already exists (the old layout); leaving it alone", path=hubconf.config_file('hub.json')))
    elif hubconf.config_file("hub.json").exists():
        print(_("✓ {path} already exists; leaving it alone (to change it, edit it, then hub config apply)",
                path=hubconf.config_file('hub.json')))
    else:
        home = pathlib.Path(os.path.expanduser(args.get("home") or os.environ.get("AGENT_HUB_HOME")
                                               or ask(_("instance directory (your config, data and credentials live here)"),
                                                       "~/.agent-hub", yes)))
        d = new_hub_json(args, yes)
        d["registry_dir"] = "projects"   # 相對 config/
        if dry:
            print(_("(dry-run) would create the instance directory {home}/{{config,data,secrets}}, write config/hub.json, "
                    "write {pointer}:\n", home=home, pointer=hubconf.POINTER) + json.dumps(d, ensure_ascii=False, indent=2))
            return 0
        for sub in ("config/projects", "data", "secrets"):
            (home / sub).mkdir(parents=True, exist_ok=True)
        (home / "secrets").chmod(0o700)
        (home / "config" / "hub.json").write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")
        if shutil.which("git") and not (home / "config" / ".git").exists():  # config as code:config 是自己的 repo
            subprocess.run(["git", "init", "-q", str(home / "config")])
            subprocess.run(["git", "-C", str(home / "config"), "config", "core.hooksPath", str(ROOT / "githooks" / "config")])
        hubconf.POINTER.write_text(str(home) + "\n")   # 最後才寫:有了它,平台才改用這個實例
        hubconf._cfg = None
        created = True
        print(_("✓ instance directory {home} (config is a git repo; owner {owner}, modules {modules})", home=home,
                owner=d['owner']['tag'], modules=', '.join(k for k, v in d['modules'].items() if v is True)))
    if dry and not hubconf.config_file("hub.json").exists():
        return 0
    dirs = [hubconf.registry_dir(), hubconf.STATE, hubconf.LOGS, hubconf.secrets_dir(), hubconf.data_dir(),
            hubconf.p("workspace_root", "~/workspace"), hubconf.p("git_origin", "~/git-origin"),
            hubconf.p("memory_copies", "~/.memory-copies")]
    for d in dirs:
        if d and not d.exists():
            print(_("{dry}create folder {path}", dry="(dry-run) " if dry else "", path=d))
            if not dry:
                d.mkdir(parents=True, exist_ok=True)
    if not dry and hubconf.secrets_dir().exists():
        hubconf.secrets_dir().chmod(0o700)
    if (ROOT / ".git").exists():
        cur = subprocess.run(["git", "-C", str(ROOT), "config", "core.hooksPath"], capture_output=True, text=True).stdout.strip()
        if cur != "githooks":
            print(_("{dry}git config core.hooksPath githooks (the platform's commit gate)", dry="(dry-run) " if dry else ""))
            if not dry:
                subprocess.run(["git", "-C", str(ROOT), "config", "core.hooksPath", "githooks"])
    if created and not dry:
        llm_setup(args, yes)   # 失敗不擋 init:doctor 會說判斷點沒地方跑,之後 agenthub llm setup
    if "--no-launchd" in flags:
        print(_("--no-launchd: not installing the scheduler, not applying services"))
        return 0
    for line in install_core_plists(dry) or [_("✓ the scheduler and watchdog are already installed")]:
        print(line)
    if not dry:
        rc = subprocess.run([*hubconf.launch(BIN / "agenthub"), "config", "apply"]).returncode
        if rc != 0:
            return rc
    print(_("\nnext: bin/hub doctor shows what is missing; bin/hub onboard ~/workspace/<project> connects the first project"))
    return 0


# ---------- move-instance(舊的擺法 → 實例目錄,docs/design/new-user.md 第 6 步)----------

CONFIG_FILES = ["hub.json", "models.env", "mirror-list.txt", "services.tsv", "schedule.yaml"]
DATA_FILES = ["digest", "reflect", "todo.md", "index.md", "review-log.md", "openclaw-migration-status.md", "legacy-paths.tsv"]


def move_plan(home: pathlib.Path) -> list[tuple[pathlib.Path, pathlib.Path]]:
    """(來源, 目的)。只在舊的擺法跑,所以來源就是 hubconf 現在指的位置。平台自己的登錄(projects/agent-hub.yaml)
    留在平台;.state、.logs 是這台機器的,不搬。"""
    out = [(hubconf.config_file(f), home / "config" / f) for f in CONFIG_FILES if hubconf.config_file(f).exists()]
    reg = hubconf.registry_dir()
    out += [(f, home / "config" / "projects" / f.name) for f in sorted(reg.iterdir())
            if f.name != hubconf.platform_registry().name and f.name != "__pycache__"]
    out += [(hubconf.data_file(f), home / "data" / f) for f in DATA_FILES if hubconf.data_file(f).exists()]
    sec = hubconf.secrets_dir()
    out += [(f, home / "secrets" / f.name) for f in sorted(sec.iterdir())] if sec.is_dir() else []
    return out


def cmd_move_instance(argv: list[str]) -> int:
    """hub move-instance --to <實例目錄> [--apply]:複製(不刪來源)、驗證新擺法、最後才寫 <hub>/.hub-home。"""
    if "--to" not in argv:
        print(_("usage: hub move-instance --to <instance directory> [--apply] (without --apply it only lists what it would do)"),
              file=sys.stderr)
        return 2
    home = pathlib.Path(os.path.expanduser(argv[argv.index("--to") + 1])).resolve()
    apply = "--apply" in argv
    if hubconf.POINTER.exists() or os.environ.get("AGENT_HUB_HOME"):
        print(_("already in the instance-directory layout ({home}); nothing to move", home=hubconf.instance_home()), file=sys.stderr)
        return 1
    if not hubconf.config_file("hub.json").exists():
        print(_("no hub.json: nothing to move"), file=sys.stderr)
        return 1
    if home.exists() and any(home.iterdir()):
        print(_("{path} is not empty; not overwriting", path=home), file=sys.stderr)
        return 1
    plan = move_plan(home)
    for src, dst in plan:
        print(_("copy {src} → {dst}", src=src, dst=dst) if apply else _("(would copy) {src} → {dst}", src=src, dst=dst))
    if not apply:
        print(_("\n{count} items; add --apply to do it (copies only, the sources in the hub stay; {pointer} is written last)",
                count=len(plan), pointer=hubconf.POINTER))
        return 0
    for src, dst in plan:
        dst.parent.mkdir(parents=True, exist_ok=True)
        (shutil.copytree if src.is_dir() else shutil.copy2)(src, dst)
    for sub in ("config/projects", "data", "secrets"):
        (home / sub).mkdir(parents=True, exist_ok=True)
    (home / "secrets").chmod(0o700)
    # 備份範圍:舊的 .secrets 換成新的 secrets,config/、data/ 加進去(它們離開 git 之後只剩備份這一份)
    cfg_path = home / "config" / "hub.json"
    cfg = json.loads(cfg_path.read_text())
    b = cfg.get("backup")
    if isinstance(b, dict):
        inc = [x for x in b.get("include", []) if os.path.expanduser(x) != str(hubconf.secrets_dir())]
        b["include"] = inc + [str(home / "config"), str(home / "data"), str(home / "secrets")]
    cfg_path.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")
    env = {**os.environ, "AGENT_HUB_HOME": str(home)}
    # 驗證新擺法(還沒寫指標檔:用 AGENT_HUB_HOME 指過去)
    r = subprocess.run(hubconf.launch(BIN / "config-check"), env=env, capture_output=True, text=True)
    print(r.stdout.strip() or r.stderr.strip())
    if r.returncode != 0:
        print(_("the config in the new layout is invalid; not writing {pointer} (the copies are in {home}; delete them and "
                "start over)", pointer=hubconf.POINTER, home=home), file=sys.stderr)
        return 1
    # config as code:config 是自己的 repo,第一個 commit 就是現在的 config
    cfgdir = home / "config"
    subprocess.run(["git", "init", "-q", str(cfgdir)], check=True)
    for k in ("user.name", "user.email"):
        v = subprocess.run(["git", "-C", str(ROOT), "config", k], capture_output=True, text=True).stdout.strip()
        if v:
            subprocess.run(["git", "-C", str(cfgdir), "config", k, v])
    subprocess.run(["git", "-C", str(cfgdir), "config", "core.hooksPath", str(ROOT / "githooks" / "config")])
    subprocess.run(["git", "-C", str(cfgdir), "add", "-A"], check=True)
    r = subprocess.run(["git", "-C", str(cfgdir), "commit", "-q", "-m", f"config moved from {ROOT}"], env=env,
                       capture_output=True, text=True)
    if r.returncode != 0:
        print(_("the config repo's first commit failed: {error}", error=(r.stdout + r.stderr).strip()[:400]), file=sys.stderr)
        return 1
    hubconf.POINTER.write_text(str(home) + "\n")   # 最後才寫:從這一刻起平台用新擺法;刪掉它就退回
    print(_("\n✓ wrote {pointer}. The old files in the hub are still there (not deleted). Next (for a person):",
            pointer=hubconf.POINTER))
    print(_("  1. bin/hub config plan shows what would change (the secrets path in projects' sandbox settings changes); "
            "if it looks right, bin/hub config apply"))
    print(_("  2. restart the long-running services that read paths (lease-runner, cap-runner)"))
    print(_("  3. only after the nightly flow and the backups (restore check) are fine, git rm those files from the platform repo"))
    return 0


# ---------- doctor ----------

def cmd_doctor(argv: list[str]) -> int:
    results: list[tuple[str, str, str]] = []   # (ok|warn|bad, 什麼, 怎麼修)

    def add(level, what, fix=""):
        results.append((level, what, fix))

    r = subprocess.run([str(BIN / "setup-python"), "--check"], capture_output=True, text=True)
    add("ok" if r.returncode == 0 else "bad", (r.stdout.strip() or r.stderr.strip())[:160] or _("the platform's Python"),
        "" if r.returncode == 0 else "bin/setup")
    if not hubconf.config_file("hub.json").exists():
        add("bad", _("no hub.json"), "bin/hub init")
        return report(results)
    r = subprocess.run(hubconf.launch(BIN / "config-check"), capture_output=True, text=True)
    add("ok" if r.returncode == 0 else "bad", _("config: all valid") if r.returncode == 0 else
        _("config: {errors}", errors=r.stderr.strip()[:300]),
        "" if r.returncode == 0 else _("fix hub.json / projects/ as the messages say, then bin/hub config check"))

    side = hubconf.owner_side()
    add("ok", _("owner side: {name} (owner_side: assistant)", name=hubconf.get('assistant.name') or _("assistant"))
        if side == "assistant" else _("owner side: built-in (owner_side: builtin; agenthub owner list / done / answer)"))
    import shutil
    cli = shutil.which("agenthub")
    add("ok" if cli else "warn", _("agenthub is on PATH: {path}", path=cli) if cli else
        _("agenthub is not on PATH (project sessions cannot reach the mailbox commands)"),
        "" if cli else "bin/agenthub install-cli")
    add("ok", _("MCP server: agenthub mcp (any agent with MCP can use the mailbox and write notes; registering it in "
              "the tool's settings is up to you)"),
        _("agenthub mcp config prints the snippet to register; how to add it per tool: docs/mcp.md"))
    import runtime_ports
    rname = runtime_ports.default_name()
    for feat, ok, miss in runtime_ports.feature_table(rname):
        add("ok" if ok else "warn", _("{feature}: available", feature=feat) if ok else
            _("{feature}: off (runtime {runtime} has no {missing})", feature=feat, runtime=rname, missing=miss),
            "" if ok else _("install a coding agent that has these, and point hub.json runtime.default at it"))
    try:
        auth = runtime_ports.load(ports=("auth",))
        for c in auth.credentials():
            if c.mode == "token":  # 排程、librarian 這類無人值守的呼叫預設用這個
                add("ok" if c.present else "bad", _("agent login ({label}): present", label=c.label) if c.present
                    else _("agent login ({label}): missing", label=c.label),
                    "" if c.present else c.renew)
            elif not c.present:
                add("warn", _("agent login ({label}): missing", label=c.label), c.renew)
    except runtime_ports.Unsupported:
        pass   # 沒有 agent 登入可查:上面的功能表已經說了哪些功能關掉
    except Exception as e:
        add("bad", _("cannot read the agent's login state: {error}", error=e), "bin/hub config check")
    import completion
    if completion.settings():
        for name, ok, why in completion.health_all():
            add("ok" if ok else "bad", _("LLM provider {name}: available", name=name) if ok else
                _("LLM provider {name}: {reason}", name=name, reason=why),
                "" if ok else _("see hub.json llm.providers; set the key with bin/hub llm set-key <provider>"))
        s = completion.settings()
        add("ok", _("model groups of the decision points: {groups}",
                    groups=",".join(f"{g}→{s['use'].get(g, _('(not set)'))}" for g in completion.GROUPS)))
    else:
        rt = runtime_ports.default_name()
        if "completion" in runtime_ports.capabilities(rt):
            add("ok", _("decision points go to the runtime {runtime} (no llm.providers; schedulectl models shows each point's "
                       "model)", runtime=rt))
        else:
            add("bad", _("decision points have nowhere to run: the runtime {runtime} has no completion port and hub.json "
                         "has no llm.providers", runtime=rt),
                _("agenthub llm setup (pick one: an API key or a local Ollama)"))

    uid = os.getuid()
    if hubconf.service_manager() is None:
        add("bad", _("scheduler, watchdog: {reason}", reason=hubconf.NO_SERVICE_MANAGER),
            _("schedule `bin/py bin/scheduler.py` yourself (every 15 minutes)"))
    elif hubconf.service_manager() == "systemd":
        import systemd_units
        for label, what in (("local.agent-hub-scheduler", _("scheduler")), ("local.agent-hub-scheduler-watchdog", _("watchdog"))):
            st = systemd_units.state(label)
            add("ok" if st == "running" else "bad", _("{what} ({label}.timer): enabled", what=what, label=label)
                if st == "running" else _("{what} ({label}.timer): not installed", what=what, label=label) if st is None
                else _("{what} ({label}.timer): installed but not scheduled", what=what, label=label),
                "" if st == "running" else "agenthub init")
        if systemd_units.linger() is False:
            add("warn", _("the scheduler and services stop after logout (systemd linger is off)"), "sudo loginctl enable-linger $USER")
    for label, what in (() if hubconf.service_manager() != "launchd" else
                        (("local.agent-hub-scheduler", _("scheduler")), ("local.agent-hub-scheduler-watchdog", _("watchdog")))):
        r = subprocess.run(["/bin/launchctl", "print", f"gui/{uid}/{label}"], capture_output=True, text=True)
        if r.returncode != 0:
            add("bad", _("{what} ({label}): not loaded", what=what, label=label), "bin/hub init")
        elif str(BIN) not in r.stdout:  # 同一個使用者底下載入的是別份 hub 的(例:另一個 clone)
            add("bad", _("{what} ({label}): the loaded one is not this hub ({bin})", what=what, label=label, bin=BIN),
                _("bin/hub init (replaces it with this one)"))
        else:
            add("ok", _("{what} ({label}): loaded", what=what, label=label))
    hb = hubconf.STATE / "scheduler-heartbeat"
    if hb.exists():
        age = (datetime.datetime.now() - datetime.datetime.fromtimestamp(hb.stat().st_mtime)).total_seconds() / 60
        add("ok" if age <= 35 else "bad", _("the scheduler last ticked {age:.0f} minutes ago", age=age),
            "" if age <= 35 else _("bin/schedulectl status; see .logs/scheduler-stderr.log"))
    else:
        add("warn", _("the scheduler has not ticked yet"),
            _("at most 15 minutes after installing; if still not, see .logs/scheduler-stderr.log"))
    if not hubconf.get("alerts"):
        add("warn", _("no alerts set up: a stopped scheduler or a dead service only shows on the status page and in the logs"),
            _("to be notified, add an alerts section as in hub.example.json"))

    import appliers
    left = {n: c for n, c in appliers.plan_all().items() if c and n != "scheduler"}
    add("ok" if not left else "warn", _("background services, project settings: match the config") if not left else
        _("background services, project settings: {count} not applied yet", count=sum(len(c) for c in left.values())),
        "" if not left else _("bin/hub config plan, then bin/hub config apply"))
    if (ROOT / ".git").exists():
        hp = subprocess.run(["git", "-C", str(ROOT), "config", "core.hooksPath"], capture_output=True, text=True).stdout.strip()
        add("ok" if hp == "githooks" else "warn", _("commit gate (core.hooksPath): {value}", value=hp or _("not set")),
            "" if hp == "githooks" else _("bin/hub init (or git config core.hooksPath githooks)"))
    return report(results)


def report(results) -> int:
    mark = {"ok": "✓", "warn": "!", "bad": "✗"}
    for level, what, fix in results:
        print(f"{mark[level]} {what}" + (f"\n    → {fix}" if fix else ""))
    bad = sum(1 for r in results if r[0] == "bad")
    warn = sum(1 for r in results if r[0] == "warn")
    print("\n" + (_("no problems") if not bad else _("{count} problems", count=bad))
          + (_(", {count} reminders", count=warn) if warn else ""))
    return 1 if bad else 0


# ---------- 包裝 ----------

LLM_CHOICES = ("runtime", "anthropic", "openai", "ollama", "none")


def write_secret(name: str, value: str) -> pathlib.Path:
    """值寫進平台的 secrets 目錄(600,先寫暫存檔再換名);不印值。"""
    d = hubconf.secrets_dir()
    d.mkdir(parents=True, exist_ok=True)
    d.chmod(0o700)
    f = d / name
    tmp = f.with_name(f.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(value.strip() + "\n")
    tmp.replace(f)
    return f


def default_llm_choice() -> str:
    """照這台有什麼:coding agent 有 completion 介面就用它自己的登入;不然本機有 Ollama 模型就用 Ollama;都沒有 = 先不設。"""
    import provider_ollama
    import runtime_ports
    if "completion" in runtime_ports.capabilities(runtime_ports.default_name()):
        return "runtime"
    return "ollama" if provider_ollama.list_models({}) else "none"


def llm_setup(args: dict, yes: bool) -> int:
    """判斷點(每晚整理筆記、週報)交給誰:寫 hub.json 的 llm 段;key 不顯示、寫進 secrets 目錄;模型從那家實際有的清單選。"""
    import completion
    import runtime_ports
    interactive = not yes and sys.stdin.isatty()
    rt = runtime_ports.default_name()
    choice = args.get("llm") or ask(
        _("who handles the platform's decisions (nightly notes, weekly report)? runtime = the coding agent's ({runtime}) "
          "own login, anthropic, openai (or a compatible API), ollama (local), none = not now", runtime=rt),
        default_llm_choice(), yes)
    if choice not in LLM_CHOICES:
        print(_("no option {choice} (choices: {choices})", choice=choice, choices=', '.join(LLM_CHOICES)), file=sys.stderr)
        return 2
    if not interactive and not args.get("llm") and choice not in ("runtime", "none") and not args.get("llm-model"):
        print(_("{choice} is available here, but a model cannot be picked non-interactively: decision points stay unset; "
                "run agenthub llm setup later", choice=choice))
        return 0
    d = read_hub_json()
    if choice in ("runtime", "none"):
        llm = d.get("llm") or {}
        llm.pop("providers", None)
        llm.pop("use", None)
        if llm:
            d["llm"] = llm
        else:
            d.pop("llm", None)
        write_hub_json(d)
        hubconf._cfg = None
        if choice == "none":
            print(_("decision points stay unset: when needed they fail plainly and say why. Run agenthub llm setup later"))
        elif "completion" not in runtime_ports.capabilities(rt):
            print(_("⚠️ the runtime {runtime} has no completion port: decision points will fail. Pick another provider: "
                    "agenthub llm setup", runtime=rt))
        else:
            print(_("decision points go to the runtime {runtime} (its own login; models follow its group table, see "
                    "schedulectl models)", runtime=rt))
        return 0
    mod = runtime_ports.load_completion(choice)
    conf = {"impl": choice}
    base = args.get("llm-base-url") or ask(_("address (Ollama)") if choice == "ollama" else
                                           _("address (change it for a compatible service)"), mod.DEFAULT_BASE, yes)
    if choice == "ollama":
        conf.update(base_url=base, location="local")
    else:
        if base != mod.DEFAULT_BASE:
            conf["base_url"] = base
        conf["key"] = {"secret": f"{choice}-api-key"}
        if interactive:
            value = getpass.getpass(_("{choice} API key (not shown; Enter alone = later with agenthub llm set-key {choice}): ",
                                      choice=choice))
            if value.strip():
                print(_("written to {path} (600)", path=write_secret(conf['key']['secret'], value)))
    probe = dict(conf)
    try:
        probe["_key"] = completion.read_key(probe)
    except completion.Refused:
        probe["_key"] = None
    names = mod.list_models(probe) if (probe.get("_key") or choice == "ollama") else []
    if args.get("llm-model"):
        picked = {g: args["llm-model"] for g in completion.GROUPS}
    elif not interactive:
        print(_("non-interactively, name the model with --llm-model <name> (or run agenthub llm setup interactively later)"),
              file=sys.stderr)
        return 1
    else:
        if names:
            print(_("{choice} has these models:", choice=choice))
            for i, n in enumerate(names[:60], 1):
                print(f"  {i:2}. {n}")
        else:
            print(_("cannot list the models (no key yet, or not reachable); type a name"))

        def pick(question: str, default: str) -> str:
            a = ask(question, default, yes)
            return names[int(a) - 1] if a.isdigit() and 1 <= int(a) <= len(names) else a
        std = pick(_("standard (ordinary decisions: nightly tidy-up, weekly report): which one (number or name)"), "")
        if not std:
            print(_("no model picked; hub.json unchanged"), file=sys.stderr)
            return 1
        picked = {"standard": std, "fast": pick(_("fast (simple, high-volume decisions)"), std),
                  "strong": pick(_("strong (the hardest: consolidation)"), std)}
    conf["models"] = {g: picked[g] for g in completion.GROUPS}
    llm = d.setdefault("llm", {})
    llm.setdefault("providers", {})[choice] = conf
    llm["use"] = {g: choice for g in completion.GROUPS}
    errs = completion.config_errors(llm)
    if errs:
        print(_("invalid settings; hub.json unchanged:\n  {errors}", errors="\n  ".join(errs)), file=sys.stderr)
        return 1
    write_hub_json(d)
    hubconf._cfg = None
    ok, why = next(((o, w) for n, o, w in completion.health_all() if n == choice), (False, _("not checked")))
    print(_("hub.json llm: decision points go to {choice} ({models}); {status}", choice=choice,
            models=', '.join(f'{g}={conf['models'][g]}' for g in completion.GROUPS),
            status=_("reachable") if ok else _("⚠️ not usable yet: {reason}", reason=why)))
    print(_("remember to commit hub.json (config as code). Agent work (mailbox handling and the like) needs a coding agent; "
            "see the feature table in agenthub doctor"))
    return 0 if ok else 1


def cmd_llm(argv: list[str]) -> int:
    import completion
    if argv[:1] == ["health"]:
        return subprocess.run([sys.executable, str(BIN / "llm.py"), "health"]).returncode
    if argv[:1] == ["setup"]:
        opts = {k.lstrip("-"): argv[i + 1] for i, k in enumerate(argv[:-1]) if k in ("--llm", "--llm-model", "--llm-base-url")}
        return llm_setup(opts, "--yes" in argv)
    if argv[:1] != ["set-key"] or len(argv) != 2:
        print(_("usage: agenthub llm setup | set-key <provider> (key from stdin) | health"), file=sys.stderr)
        return 2
    conf = ((completion.settings() or {}).get("providers") or {}).get(argv[1])
    if not conf:
        print(_("hub.json llm.providers has no {provider}", provider=argv[1]), file=sys.stderr)
        return 2
    k = conf.get("key") or {}
    if not k.get("secret"):
        print(_('llm.providers.{provider}.key is not {{"secret": file name}} (a key from an environment variable does not '
                'need this command)', provider=argv[1]), file=sys.stderr)
        return 2
    if sys.stdin.isatty():
        import getpass
        value = getpass.getpass(_("{provider} API key (not shown): ", provider=argv[1]))
    else:
        value = sys.stdin.read()
    if not value.strip():
        print(_("no key read; nothing written"), file=sys.stderr)
        return 1
    print(_("written to {path} (600). Check: agenthub llm health", path=write_secret(k['secret'], value)))
    return 0


def passthrough(script: str):
    return lambda argv: subprocess.run([*hubconf.launch(BIN / script), *argv]).returncode


# 專案的 session(任何 coding agent)用的子指令:跟 policy.platform_cli() 同一份清單(權限規則只放行這些)
SESSION_COMMANDS = {**{c: ("hubbus", c) for c in ("send", "inbox", "show", "ack", "done", "thread", "open-questions")},
                    "merge-branch": ("merge-branch", None), "cap-run": ("hub-run", None)}


def session_command(name: str):
    script, sub = SESSION_COMMANDS[name]
    return lambda argv: subprocess.run([*hubconf.launch(BIN / script), *([sub] if sub else []), *argv]).returncode


def cmd_install_cli(argv: list[str]) -> int:
    """~/.local/bin/agenthub:兩行的轉接腳本(不能用 symlink——agenthub 第一行照自己所在的資料夾找平台的 Python)。"""
    d = pathlib.Path(os.path.expanduser(argv[argv.index("--dir") + 1] if "--dir" in argv else "~/.local/bin"))
    d.mkdir(parents=True, exist_ok=True)
    f = d / "agenthub"
    body = (f'#!/bin/sh\n# agent-hub 的 CLI(agenthub install-cli 寫的;hub 搬家就重跑一次)\n'
            f'exec "{BIN / "py"}" "{BIN / "agenthub"}" "$@"\n')
    if f.exists() and f.read_text() == body:
        print(_("✓ {path} is up to date", path=f))
    else:
        f.write_text(body)
        f.chmod(0o755)
        print(_("wrote {path}", path=f))
    on_path = str(d) in os.environ.get("PATH", "").split(":")
    if not on_path:
        print(_('⚠️ {dir} is not on PATH: add it to your shell setup (e.g. export PATH="{dir}:$PATH") so sessions can '
                'reach agenthub', dir=d))
    return 0 if on_path else 1


COMMANDS = {
    "init": cmd_init, "doctor": cmd_doctor, "config": cmd_config, "modules": cmd_modules, "llm": cmd_llm,
    "move-instance": cmd_move_instance,
    "onboard": passthrough("onboard-project.sh"), "recover": passthrough("recover-project.sh"),
    "rename": passthrough("rename-project.sh"), "status": passthrough("overview.sh"),
    "jobs": lambda argv: subprocess.run([*hubconf.launch(BIN / "schedulectl"), "list", *argv]).returncode,
    "run": lambda argv: subprocess.run([*hubconf.launch(BIN / "schedulectl"), "run", *argv]).returncode,
    "install-cli": cmd_install_cli,
    # stdio 就是協定:直接換成伺服器的程序,不多一層
    "mcp": lambda argv: os.execv(sys.executable, [sys.executable, str(BIN / "mcp_server.py"), *argv]),
    "owner": lambda argv: subprocess.run([*hubconf.launch(BIN / "owner.py"), *argv]).returncode,
    **{name: session_command(name) for name in SESSION_COMMANDS},
}


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help") or argv[0] not in COMMANDS:
        print(_(__doc__))
        return 0 if not argv or argv[0] in ("-h", "--help", "help") else 2
    return COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
