#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""agent-hub's single entry point (docs/design/new-user.md 3.4). A thin dispatch layer; it does not rewrite the existing scripts.

The name is `agenthub` (2026-10-29: `hub` clashed with GitHub's old hub CLI; `bin/hub` stays and forwards here). `agenthub install-cli`
puts a small forwarding script in ~/.local/bin, so any coding agent's session can type `agenthub …` directly and the rules
files need no local paths.

Getting started:
  agenthub init [--home <instance dir>] [--owner <name>] [--timezone <tz>] [--workspace <folder>] [--modules a,b] [--yes]
           [--llm runtime|anthropic|openai|ollama|none] [--llm-model <name>] [--llm-base-url <url>] [--no-launchd] [--dry-run]
                        with no hub.json, creates the instance directory (default ~/.agent-hub: config/ is a git repo, data/,
                        secrets/), writes config/hub.json from hub.example.json (asks a few questions; --yes takes the defaults),
                        and last writes <hub>/.hub-home pointing there; creates the folders it needs; asks which model the
                        platform's decisions go to (= agenthub llm setup); installs the scheduler and watchdog (the launchd/
                        templates; left alone when unchanged); applies the config. With a hub.json already there, leaves it alone
  agenthub doctor            everything that is broken, at a glance: the platform's Python, config, logins, scheduler, watchdog,
                        background services, commit gate, and whether a newer release is out
  agenthub upgrade [--to vX.Y.Z | --main] [--check] [--yes]
                        move this checkout to the newest release (or that tag, or the remote's main) and bring the machine
                        in step: Python packages, registry, config apply, scheduler, hooks, CLI, doctor. Shows the
                        changelog first; --check stops there (exit 10 = an upgrade is there). Never moves a development
                        checkout (bin/upgrade.py)
  agenthub init --scheduler-only   only (re)install the scheduler and watchdog from the templates (upgrade runs it)
  agenthub init --questions [--answers <file>] | --answers <file>
                        for an AI agent setting agent-hub up in its chat (README, "Set up through your agent"): the
                        questions as JSON; then the answers applied, ending with one JSON line. Consents and keys are
                        asked of you directly (a window on your screen, a page in your browser), never taken from the file
config:
  agenthub config check | plan | apply [--only <applier>,...]
                        validate the config / what would change / apply (check → apply → plan again must be empty → record)
  agenthub llm setup [--llm …] [--llm-model …] [--llm-base-url …]
                        who handles the platform's decisions (nightly tidy-up, weekly report): the coding agent's own login,
                        an Anthropic / OpenAI (or compatible) API key, a local Ollama; the key is not shown and goes into the
                        secrets directory; the model is picked from the list that provider actually has (the platform does not
                        guess names)
  agenthub llm set-key <provider>   write the API key of hub.json llm.providers.<provider> from stdin into the platform's
                        secrets directory (chmod 600; not read from arguments, so it stays out of the shell history)
  agenthub llm health        whether each provider works (= bin/llm.py health)
  agenthub modules [enable|disable <name>]
                        which optional features exist and which are on; switching changes hub.json and applies it (remember
                        to commit hub.json)
  agenthub move-instance --to <instance dir> [--apply]
                        move the old layout (everything in the hub root) to an instance directory: copies only, validates the
                        new layout, writes .hub-home last (delete it to go back)
projects:
  agenthub connect [<folder>] [--yes] [--remote] [--dry-run]
                        connect existing folders as projects (bin/connect.py): one repo, a monorepo, or a folder of repos
  agenthub onboard …         = bin/onboard-project.sh (start a new project / connect a folder)
  agenthub recover <name>    = bin/recover-project.sh (new machine / the folder is gone)
  agenthub rename <old> <new>  = bin/rename-project.sh (dry-run first, then add --apply)
  agenthub status [project]  = bin/overview.sh
scheduling:
  agenthub jobs              = schedulectl list
  agenthub run <job>         = schedulectl run (run it once now)
  agenthub land              after a merge of agent-hub: rebuild the registry index from the merged code (run by
                        merge-branch; not a session command)
owner (you; not commands for project sessions):
  agenthub owner list | done/drop/already-done <key> | answer <question id> "answer"
                        = bin/owner.py: the built-in owner side (hub.json owner_side: builtin; with an assistant, list only)
for project sessions (these are what the rules files name; the permission rules allow only these, not the admin commands above):
  agenthub send | inbox | show | ack | done | thread | open-questions …   = the project mailbox (bin/hubbus subcommands of the
                        same name)
  agenthub merge-branch …    = bin/merge-branch (the merge gate for parallel sessions)
  agenthub test [--tier T] [--when M] [--force] [--rev R | --index]
                        = bin/test-runner.py: the project's declared test tiers in an exported tree, a recorded pass
                        is a hit (docs/design/test-waiting.md B4)
  agenthub cap-run --cap <capability> -- <command…>   = bin/hub-run (the platform runs a program the sandbox blocks)
  agenthub complete <point> [--schema F] < prompt    = bin/hub-run --complete (a model call the project declares in
                                                       its registry models:, run by the platform)
  agenthub install-cli [--dir <folder>]   put agenthub's forwarding script in <folder> (default ~/.local/bin; must be on PATH)
  agenthub mcp               the platform's MCP server (stdio): any coding agent with MCP can use the mailbox and write notes
                        (= bin/mcp_server.py)
  agenthub mcp config        print the snippet to register in the tool's MCP settings (the platform does not change your
                        tool's settings for you; docs/mcp.md)
  agenthub --version         the platform's version: the release tag this checkout is at (git describe)
"""
from __future__ import annotations

import datetime
import getpass
import hashlib
import json
import os
import pathlib
import plistlib
import shutil
import subprocess
import sys
import tempfile

BIN = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(BIN))
import hubconf  # noqa: E402
import i18n  # noqa: E402
import init_dialogue  # noqa: E402

_ = i18n.domain(__file__)

ROOT = hubconf.ROOT   # the same one as hubconf's (AGENT_HUB_ROOT can override it), so path comparisons agree

AGENTS = pathlib.Path.home() / "Library" / "LaunchAgents"
# the scheduler and the watchdog don't go through render-services (it's a job the scheduler runs; a broken scheduler
# is exactly what the watchdog reports); init installs them from the templates
CORE_PLISTS = ("local.agent-hub-scheduler", "local.agent-hub-scheduler-watchdog")


# ---------- config ----------

def show(plans: dict) -> int:
    n = 0
    for name, changes in plans.items():
        for c in changes:
            print(f"{name:15} {c.line()}")
            n += 1
    if not n:
        print(_("nothing to change (the machine matches the config)"))
    return n


def cmd_config(argv: list[str]) -> int:
    import appliers
    sub = argv[0] if argv else ""
    only = argv[argv.index("--only") + 1].split(",") if "--only" in argv else None
    if sub == "check":
        return subprocess.run(hubconf.launch(BIN / "config-check")).returncode
    if sub == "plan":
        show(appliers.plan_all(only=only))
        return 0
    if sub == "apply":
        if hubconf.worktree_lookup():   # it would apply the config to the machine from a half-edited copy
            print(_("agenthub config apply: {root} is a linked worktree of the hub; apply from the main checkout "
                    "({main})", root=hubconf.ROOT, main=hubconf.MAIN), file=sys.stderr)
            return 1
        if subprocess.run(hubconf.launch(BIN / "config-check")).returncode != 0:
            print(_("agenthub config apply: the config is invalid; nothing applied"), file=sys.stderr)
            return 1
        done = appliers.apply_all(only=only)
        show(done)
        left = {n: c for n, c in appliers.plan_all(only=only).items() if c}
        if left:  # verify: a plan after applying should be empty
            print(_("agenthub config apply: ⚠️ still differs from the config after applying:"), file=sys.stderr)
            show(left)
        record(done, ok=not left)
        return 1 if left else 0
    print(_(__doc__), file=sys.stderr)
    return 2


def record(done: dict, ok: bool) -> None:
    """Record which config commit was applied: .state/config-applied.json (read by the status page) + config.applied
    on the bus (sent only when something changed)."""
    import appliers
    commit = appliers.config_commit()
    applied = appliers.applied_path()
    changes = [{"op": c.op, "target": c.target, "detail": c.detail} for cs in done.values() for c in cs]
    applied.parent.mkdir(parents=True, exist_ok=True)
    applied.write_text(json.dumps({"commit": commit, "ok": ok, "changes": len(changes),
                                   "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds")},
                                  ensure_ascii=False, indent=1) + "\n")
    if not changes:
        return
    payload = {"commit": commit, "changes": changes, "source": "hub config apply"}
    # the same apply sent again isn't recorded twice
    eid = "config-" + hashlib.sha1(json.dumps(payload, sort_keys=True).encode()).hexdigest()[:16]
    r = subprocess.run([str(BIN / "py"), str(BIN / "hubbus"), "publish", "config.applied", "--source", hubconf.hub_project(),
                        "--payload", json.dumps(payload, ensure_ascii=False), "--id", eid], capture_output=True, text=True)
    if r.returncode != 0:
        print(_("agenthub config apply: recording on the bus failed (.state/config-applied.json was written): {error}",
                error=r.stderr.strip()[:200]), file=sys.stderr)


# ---------- modules ----------

def read_hub_json() -> dict:
    return json.loads(hubconf.config_file("hub.json").read_text())


def write_hub_json(d: dict) -> None:
    hubconf.config_file("hub.json").write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")


def llm_modules() -> list[str]:
    """The modules whose work is judgment points (needs_llm: true in modules/<name>.yaml): without a model for those
    they do nothing useful, and their jobs fail."""
    import yaml
    return sorted(f.stem for f in (ROOT / "modules").glob("*.yaml")
                  if (yaml.safe_load(f.read_text()) or {}).get("needs_llm") is True)


def judgment_points_can_run() -> bool:
    """an LLM provider in hub.json, or a runtime with a completion interface (doctor checks the same)"""
    import completion
    import runtime_ports
    return bool(completion.settings()) or "completion" in runtime_ports.capabilities(runtime_ports.default_name())


def llm_modules_warning(names: list[str]) -> str | None:
    """the line for LLM-only modules that are on while judgment points have nowhere to run"""
    if not names or judgment_points_can_run():
        return None
    return _("⚠️ on without a model: {modules}. These modules only do judgment-point work, so their jobs fail until "
             "agenthub llm setup (or turn one off: agenthub modules disable <name>)", modules=", ".join(names))


def cmd_modules(argv: list[str]) -> int:
    import registry
    import yaml
    on = set(registry.enabled_modules())
    if not argv:
        for f in sorted(registry.MODULES_DIR.glob("*.yaml")):
            doc = yaml.safe_load(f.read_text()) or {}
            desc = i18n.translate("modules", doc.get("description") or "", {})   # catalog: locales/<lang>/modules.json
            needs = _(" (needs an LLM: agenthub llm setup)") if doc.get("needs_llm") is True else ""
            print(f"{'✓' if f.stem in on else ' '} {f.stem:12} {desc}{needs}")
        print(_("\nSwitch: agenthub modules enable|disable <name> (changes modules in hub.json, then applies)"))
        return 0
    if len(argv) != 2 or argv[0] not in ("enable", "disable"):
        print(_(__doc__), file=sys.stderr)
        return 2
    name = argv[1]
    if not (registry.MODULES_DIR / f"{name}.yaml").exists():
        print(_("agenthub modules: no module {name} (modules/ has: {available})", name=name,
                available=', '.join(sorted(p.stem for p in registry.MODULES_DIR.glob('*.yaml')))), file=sys.stderr)
        return 1
    d = read_hub_json()
    d.setdefault("modules", {})[name] = argv[0] == "enable"
    write_hub_json(d)
    print(f"hub.json:modules.{name} = {str(argv[0] == 'enable').lower()}")
    if argv[0] == "enable" and name in llm_modules() and (warning := llm_modules_warning([name])):
        print(warning)
    rc = subprocess.run([*hubconf.launch(BIN / "agenthub"), "config", "apply"]).returncode
    print(_("remember to commit hub.json (config as code)."))
    return rc


# ---------- init ----------

def UI():
    """The transport init's questions go through (bin/init_dialogue.py): the terminal, an agent's answers, or the list of
    questions for an agent."""
    return init_dialogue.ui()


def render_plist(label: str) -> bytes:
    return (ROOT / "launchd" / f"{label}.plist").read_text().replace("{{hub}}", str(ROOT)).encode()


def install_core_plists(dry: bool, failed: list[str] | None = None) -> list[str]:
    """Scheduler + watchdog: if the template's content matches what's installed, leave it (no needless scheduler
    reload). Only from the main checkout: units rendered from a linked worktree would run the scheduler from there,
    which refuses every tick (11-01: an `init --help` in a worktree stopped the live scheduler this way). The labels
    whose install failed (or was refused) are added to `failed`."""
    failed = [] if failed is None else failed
    if hubconf.ROOT != hubconf.MAIN:
        failed.extend(CORE_PLISTS)
        return [_("⚠️ not installing the scheduler and watchdog from a linked worktree ({root}); run init from the main "
                  "checkout ({main})", root=hubconf.ROOT, main=hubconf.MAIN)]
    sm = hubconf.service_manager()
    if sm is None:
        return [_("⚠️ {reason}; to run the nightly flow, {how}", reason=hubconf.no_service_manager(),
                  how=hubconf.manual_scheduler())]
    if sm == "systemd":   # the same launchd/ templates turned into user units (bin/systemd_units.py)
        import systemd_units
        done = []
        for label in CORE_PLISTS:
            plist = plistlib.loads(render_plist(label))
            if systemd_units.installed(label) == systemd_units.files(plist) and systemd_units.state(label) == "running":
                continue
            done.append(_("{dry}{label}: {action} (systemd)", dry="(dry-run) " if dry else "", label=label,
                           action=_("update") if systemd_units.installed(label) else _("install")))
            if not dry:
                r = systemd_units.install(plist)
                if r.returncode != 0:
                    failed.append(label)
                    done.append(_("  ⚠️ systemctl enable failed: {error}", error=r.stderr.strip()[:200]))
        if systemd_units.linger() is False:
            done.append(_("  ⚠️ user units stop after logout: `loginctl enable-linger $USER` (needs sudo)"))
        return done
    done = []
    for label in CORE_PLISTS:
        want = render_plist(label)
        path = AGENTS / f"{label}.plist"
        cur = path.read_bytes() if path.exists() else None
        loaded = subprocess.run(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"], capture_output=True).returncode == 0
        if cur is not None and plistlib.loads(cur) == plistlib.loads(want) and loaded:
            continue
        done.append(_("{dry}{label}: {action}", dry="(dry-run) " if dry else "", label=label,
                       action=_("install") if cur is None else _("update") if cur else _("load")))
        if dry:
            continue
        AGENTS.mkdir(parents=True, exist_ok=True)
        if loaded:
            subprocess.run(["/bin/launchctl", "bootout", f"gui/{os.getuid()}/{label}"], capture_output=True)
        path.write_bytes(want)
        r = subprocess.run(["/bin/launchctl", "bootstrap", f"gui/{os.getuid()}", str(path)], capture_output=True, text=True)
        if r.returncode != 0:
            failed.append(label)
            done.append(_("  ⚠️ bootstrap failed: {error}", error=r.stderr.strip()[:200]))
    return done


# ---------- the platform's agent (docs/design/newcomer-path.md B4) ----------

def agent_presets() -> dict[str, dict]:
    """The agents init can offer, in order: each runtime adapter with install_info(), then each module with a
    runtime_preset. name → {label, gives, find, install, credential, settings}. Tool specifics live there, not here."""
    import importlib
    import yaml
    out: dict[str, dict] = {}
    for f in sorted(BIN.glob("runtime_*.py")):
        name = f.stem[len("runtime_"):]
        if name in ("ports", "fake", "none"):
            continue
        try:
            mod = importlib.import_module(f.stem)
        except Exception:   # an adapter that can't load is simply not offered
            continue
        if hasattr(mod, "install_info"):
            out[name] = mod.install_info()
    for f in sorted((ROOT / "modules").glob("*.yaml")):
        doc = yaml.safe_load(f.read_text()) or {}
        if isinstance(doc.get("runtime_preset"), dict):
            info = dict(doc["runtime_preset"])
            info["gives"] = i18n.translate("modules", doc.get("description") or "", {})
            out[f.stem] = info
    return out


def agent_found(info: dict) -> pathlib.Path | None:
    """The tool's command: under nvm's default node (the platform's copy), else on PATH."""
    import shutil
    nb = hubconf.nvm_bin()
    if nb and (nb / info["find"]).exists():
        return nb / info["find"]
    w = shutil.which(info["find"])
    return pathlib.Path(w) if w else None


def agent_env() -> dict:
    """The environment for the tools' own commands: nvm's default node first on PATH."""
    nb = hubconf.nvm_bin()
    return {**os.environ, "PATH": f"{nb}:{os.environ.get('PATH', '')}"} if nb else dict(os.environ)


def choose_agent(args: dict, presets: dict[str, dict]) -> str:
    """init's agent question: which agent the platform runs for its own work. --agent answers it; without a terminal
    (or --yes) the first one found, else none."""
    if args.get("agent"):
        return args["agent"]
    found = [n for n, info in presets.items() if agent_found(info)]
    default = found[0] if found else "none"
    options = [(n, f"{info['label']}: {info['gives']} ("
                   + (_("installed") if agent_found(info) else _("not installed")) + ")") for n, info in presets.items()]
    options.append(("none", _("None for now: memory, schedules and the mailbox work; agent features stay off")))
    return UI().menu("agent", _("Which AI agent should agent-hub use for its own work (nightly tidy-up, the mailbox)?"),
                     options, default)


def apply_agent(d: dict, choice: str, presets: dict[str, dict]) -> None:
    """Make choice the platform's agent in hub.json d: its settings merged in, the other presets' modules off."""
    for n, info in presets.items():
        for m in (info.get("settings") or {}).get("modules") or {}:
            d.setdefault("modules", {})[m] = False
    if choice == "none":
        d["runtime"] = {**(d.get("runtime") or {}), "default": "none"}
        return
    s = presets[choice].get("settings") or {}
    d["runtime"] = {**(d.get("runtime") or {}), **(s.get("runtime") or {})}
    for m, on in (s.get("modules") or {}).items():
        d.setdefault("modules", {})[m] = on


def install_agent(choice: str, presets: dict[str, dict]) -> bool:
    """Offer to install the chosen agent (user level, the preset's lines), only on the owner's yes. Whether it is there
    afterwards."""
    if choice == "none":
        return True
    info = presets[choice]
    if agent_found(info):
        return True
    print(_("{label} is not installed. Installing it runs:", label=info["label"]))
    for line in info.get("install") or []:
        print(f"    {line}")
    if not UI().consent("install_agent", _("Install {label} now? It runs: {lines}", label=info["label"],
                                           lines="; ".join(info.get("install") or []))):
        print(_("Not installed. Later: run those lines, then agenthub init --agent {name}", name=choice))
        return False
    for line in info.get("install") or []:
        if subprocess.run(["/bin/bash", "-c", line], env=agent_env()).returncode != 0:
            print(_("this step failed: {line}", line=line))
            return False
    hubconf.nvm_bin.cache_clear() if hasattr(hubconf.nvm_bin, "cache_clear") else None
    ok = agent_found(info) is not None
    print(_("✓ {label} installed", label=info["label"]) if ok else
          _("{label} still isn't found; open a new terminal and run agenthub init --agent {name}",
            label=info["label"], name=choice))
    return ok


def agent_login_check() -> str | None:
    """One real request through the platform's own path (llm.py's login-check point): None when it answers."""
    r = subprocess.run([*hubconf.launch(BIN / "llm.py"), "run", "login-check"], input="Reply with just: ok",
                       capture_output=True, text=True, timeout=180)
    try:
        out = json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return (r.stderr.strip() or r.stdout.strip())[-300:] or _("no answer")
    return out.get("llm_error") or (out.get("result") if out.get("is_error") else None)


def agent_credential(choice: str, presets: dict[str, dict]) -> None:
    """The chosen agent's credential for unattended runs. A pasted token goes straight into its file (never shown,
    mode 600); a tool's own login is run in the terminal. Without a terminal, only what to do is printed."""
    if choice == "none":
        return
    info = presets[choice]
    cred = info.get("credential") or {}
    if not agent_found(info) and UI().acts:   # nothing to log in to yet: install_agent said how to install it
        return
    if cred.get("kind") == "pasted-token":
        f = pathlib.Path(os.path.expanduser(cred["file"]))
        if not f.exists():
            cmd = " ".join(cred["command"])
            print(_("{label} runs unattended with a long-lived token from `{command}` (needs {needs}).",
                    label=info["label"], command=cmd, needs=cred.get("needs", "")))
            if UI().terminal:
                if not UI().consent("agent_token_command", _("Run `{command}` now?", command=cmd)):
                    print(_("Later: run `{command}`, then agenthub init --agent {name} to paste the token", command=cmd,
                            name=choice))
                    return
                subprocess.run(cred["command"], env=agent_env())
                token = UI().secret("agent_token", _("Paste the token it printed (it isn't shown): "))
            else:   # the token is printed where only the owner sees it, then pasted into init directly (B3)
                token = UI().secret("agent_token", _("{label}'s token: run `{command}` in a terminal (the app's own "
                                                     "terminal works), then paste the token it prints",
                                                     label=info["label"], command=cmd))
            if not UI().acts:
                return
            if not token:
                print(_("No token pasted; nothing written. Later: agenthub init --agent {name}", name=choice))
                return
            f.parent.mkdir(parents=True, exist_ok=True)
            f.touch(mode=0o600)
            f.chmod(0o600)
            f.write_text(token + "\n")
            print(_("✓ token written to {file}", file=f))
        if (why := agent_login_check()):
            print(_("⚠️ {label} did not answer with that login: {reason}", label=info["label"], reason=why[:300]))
        else:
            print(_("✓ {label} answers", label=info["label"]))
    elif cred.get("kind") == "tool-login":
        if agent_found(info) and subprocess.run(cred["status"], env=agent_env(), capture_output=True).returncode == 0:
            print(_("✓ {label} is logged in", label=info["label"]))
            return
        cmd = " ".join(cred["command"])
        if not UI().terminal:   # a login shows a link or a code to the owner: only in a terminal they see
            UI().needs_user("agent_login", _("{label} is not logged in: run `{command}` in a terminal (the app's own "
                                             "terminal works)", label=info["label"], command=cmd))
            return
        if not UI().consent("agent_login", _("{label} is not logged in. Run `{command}` now?", label=info["label"],
                                               command=cmd)):
            print(_("Later: run `{command}`", command=cmd))
            return
        subprocess.run(cred["command"], env=agent_env())


def agenthub_command() -> list[str]:
    """How a tool should start this hub's agenthub (absolute: an app started from the GUI may not have PATH)."""
    cli = pathlib.Path.home() / ".local" / "bin" / "agenthub"
    return [str(cli)] if cli.exists() else [str(BIN / "py"), str(BIN / "agenthub")]


def offer_mcp_registration(presets: dict[str, dict]) -> None:
    """docs/design/newcomer-path.md B5: register agent-hub's MCP server at user level in each installed tool that has a
    registration command, so a session in any folder (the desktop apps' too) knows agent-hub is there. A user-level
    change, so only on the owner's own yes on the terminal (AGENTS.md); never with --yes or without a terminal."""
    # init --questions lists it for every tool that has a registration command: one may be installed by then
    tools = [(n, info) for n, info in presets.items()
             if info.get("mcp_register") and (agent_found(info) or not UI().acts)]
    if not tools:
        return
    labels = ", ".join(info["label"] for _n, info in tools)
    if not UI().consent("register_mcp", _("Let your AI apps ({tools}) use agent-hub in every folder? This registers "
                                          "agent-hub's MCP server for your user.", tools=labels)):
        print(_("Not registered. Later: agenthub init --register-mcp"))
        return
    for _n, info in tools:
        argv = [x for a in info["mcp_register"] for x in (agenthub_command() if a == "{agenthub}" else [a])]
        r = subprocess.run(argv, env=agent_env(), capture_output=True, text=True)
        print(_("✓ registered in {tool}", tool=info["label"]) if r.returncode == 0 else
              _("registering in {tool} failed: {error}", tool=info["label"], error=(r.stderr or r.stdout).strip()[:200]))


def set_agent(choice: str, args: dict) -> int:
    """init --agent <name> on an existing instance: only the agent step (settings, install, credential), then the
    judgment-point setup offered again; hub.json committed alone and the config applied."""
    presets = agent_presets()
    d = read_hub_json()
    apply_agent(d, choice, presets)
    write_hub_json(d)
    hubconf._cfg = None
    print(_("✓ the platform's agent: {name}", name=presets[choice]["label"] if choice in presets else choice))
    install_agent(choice, presets)
    agent_credential(choice, presets)
    if choice != "none" and UI().consent("llm_now", _("Set up who makes the platform's judgment calls now (agenthub llm "
                                                      "setup)?")):
        llm_setup(args)
    rc = subprocess.run([str(BIN / "commit-hub-files.sh"), f"chore(config): the platform's agent is {choice}",
                         "hub.json"]).returncode
    if rc != 0:
        print(_("warning: {file} was written, but the commit/push failed; it needs a manual fix", file="hub.json"))
    return subprocess.run([*hubconf.launch(BIN / "agenthub"), "config", "apply"]).returncode or (1 if rc else 0)


def new_hub_json(args: dict) -> dict:
    d = json.loads((ROOT / "hub.example.json").read_text())
    try:
        default_tz = os.path.realpath("/etc/localtime").split("zoneinfo/")[1]
    except IndexError:
        default_tz = "UTC"
    d["owner"]["tag"] = args.get("owner") or UI().ask("owner", _("your name (in the owner to-do tag, and what agents call you)"),
                                                      getpass.getuser())
    d["owner"]["timezone"] = args.get("timezone") or UI().ask("timezone", _("time zone"), default_tz)
    d["workspace_root"] = args.get("workspace") or UI().ask("workspace", _("where projects live"),
                                                            d.get("workspace_root", "~/workspace"))
    shipped = [k for k, v in d.get("modules", {}).items() if not k.startswith("_")]
    import shutil
    # defaults follow what this machine has (docs/design/tool-agnostic.md): its maintenance module only with Claude
    # Code; without an assistant, the built-in owner side
    presets = agent_presets()
    choice = choose_agent(args, presets)
    apply_agent(d, choice, presets)
    if choice != "none":
        install_agent(choice, presets)
    args["_agent"] = choice   # the credential step runs once hub.json is written (cmd_init)
    if "owner" in d["modules"]:
        # the template's assistant section is a placeholder (its api is filled in): what counts is the module
        d["modules"]["owner"] = not d["modules"].get("assistant")
    # with no model for judgment points after llm setup (asked later), the modules that only do judgment-point work
    # are off by default
    if not llm_expected(args, (d.get("runtime") or {}).get("default", "claude")):
        held = [k for k in shipped if d["modules"][k] is True and k in llm_modules()]
        for k in held:
            d["modules"][k] = False
        if held and not args.get("modules"):
            print(_("left off: {modules}. These modules only do judgment-point work, and no model is set up for that; "
                    "after agenthub llm setup, turn them on with agenthub modules enable <name>", modules=", ".join(held)))
    default_on = ",".join(k for k in shipped if d["modules"][k] is True)
    picked = args.get("modules") or UI().ask("modules", _("which modules to turn on (available: {modules})",
                                                           modules=', '.join(shipped)), default_on)
    want = {m.strip() for m in picked.split(",") if m.strip()}
    for k in shipped:
        d["modules"][k] = k in want
    # for features left off, their settings section goes too (the template's placeholder values left in would be taken
    # for real settings)
    for module, section in (("assistant", "assistant"), ("backup", "backup")):
        if module not in want:
            d.pop(section, None)
    # alerts need a Discord bot first; when wanted, add the alerts section back from hub.example.json
    d.pop("alerts", None)
    gh = shutil.which("gh") and subprocess.run(["gh", "api", "user", "--jq", ".login"], capture_output=True, text=True)
    if gh and gh.returncode == 0 and gh.stdout.strip():
        d["github"]["owner"] = gh.stdout.strip()
    else:
        # onboard with --no-remote; to create GitHub repos, gh auth login first, then add github.owner
        d.pop("github", None)
    return d


# ---------- the config repo (config as code: config/ is its own git repo) ----------

# the email the config repo commits with when git has none (a reserved domain: never anyone's real address)
FALLBACK_EMAIL = "owner@agent-hub.invalid"


def git_out(repo: pathlib.Path, *args: str) -> str:
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True).stdout.strip()


def config_repo_identity(repo: pathlib.Path, owner: str) -> str | None:
    """git needs a name and an email to commit. Given ones (git config at any level, GIT_AUTHOR_*/GIT_COMMITTER_* in
    the environment) are used as they are. Otherwise git guesses from the login and host name: in a fresh container it
    cannot, so every commit fails, and on macOS it commits as user@host.local. Then what is missing is set in this repo
    only (the user-level git config is the user's to change), and the returned line says so and how to use their
    own."""
    given = all(subprocess.run(["git", "-C", str(repo), "-c", "user.useConfigOnly=true", "var", v],
                               capture_output=True).returncode == 0 for v in ("GIT_AUTHOR_IDENT", "GIT_COMMITTER_IDENT"))
    if given:
        return None
    fallback = {"user.name": owner or getpass.getuser(), "user.email": FALLBACK_EMAIL}
    missing = [k for k in fallback if not git_out(repo, "config", "--get", k)]
    for k in missing:
        subprocess.run(["git", "-C", str(repo), "config", k, fallback[k]])
    return _("⚠️ git has no identity on this machine ({keys} not set), so the config repo {dir} commits as "
             "\"{name} <{email}>\", set in that repo only. To commit as yourself: git config --global user.name "
             "\"Your Name\"; git config --global user.email you@example.com; then git -C {dir} config --remove-section user",
             keys=", ".join(missing), dir=repo, name=git_out(repo, "config", "user.name"),
             email=git_out(repo, "config", "user.email"))


def config_repo_first_commit(cfgdir: pathlib.Path, owner: str) -> tuple[bool, list[str]]:
    """Config as code: config/ is its own git repo, behind the config gate (githooks/config), and its first commit is
    the config as it is (later changes are committed by whoever writes them, with commit-hub-files.sh). Without that
    commit the next one fails: onboard's registry commit runs the gate, which exports the index, and the index has no
    hub.json. A repo that already has a commit is left alone. Returns (ok, lines to print).

    Plain git rather than commit-hub-files.sh: that one commits named paths in a repo that already has history, under
    a lock in the hub checkout's git dir, and pushes; this is the first commit of everything in config/, as
    move-instance makes it."""
    if not shutil.which("git"):
        return False, [_("⚠️ git is not installed: {dir} is not a git repo, so config changes are not recorded and "
                         "onboarding cannot commit the registry. Install git, then run agenthub init again (it commits "
                         "the config as it is)", dir=cfgdir)]
    if not (cfgdir / ".git").exists():
        subprocess.run(["git", "init", "-q", str(cfgdir)], capture_output=True)
        subprocess.run(["git", "-C", str(cfgdir), "config", "core.hooksPath", str(ROOT / "githooks" / "config")])
    if subprocess.run(["git", "-C", str(cfgdir), "rev-parse", "-q", "--verify", "HEAD"], capture_output=True).returncode == 0:
        return True, []
    lines = [note] if (note := config_repo_identity(cfgdir, owner)) else []
    subprocess.run(["git", "-C", str(cfgdir), "add", "-A"], capture_output=True)
    r = subprocess.run(["git", "-C", str(cfgdir), "commit", "-q", "-m", "config: first commit (agenthub init)"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return False, lines + [_("the config repo's first commit failed: {error}", error=(r.stdout + r.stderr).strip()[:400])]
    return True, lines + [_("✓ config committed: {dir} is a git repo, and its first commit is the config as it is now",
                            dir=cfgdir)]


INIT_FLAGS = ("--yes", "--no-launchd", "--dry-run", "--scheduler-only", "--register-mcp", "--questions")
# written when init has made the instance, removed once its later steps are done: a re-run after a Ctrl-C finishes them
INIT_UNFINISHED = hubconf.STATE / "init-unfinished"
INIT_OPTIONS = ("--owner", "--timezone", "--workspace", "--modules", "--home", "--llm", "--llm-model", "--llm-base-url",
                "--lang", "--agent", "--connect", "--answers")


def parse_lang(value: str) -> tuple[str, str] | None:
    """--lang <ui>[,<content>] → (ui, content); None when either isn't one of hubconf.LANGUAGES."""
    parts = [x.strip() for x in value.split(",")]
    ui, content = parts[0], parts[1] if len(parts) > 1 else parts[0]
    if len(parts) > 2 or ui not in hubconf.LANGUAGES or content not in hubconf.LANGUAGES:
        return None
    return ui, content


def both(variants: list[str]) -> str:
    """A text in every language at once (from _.variants), for the one question asked before the language is known."""
    return " / ".join(variants)


def ask_one_language(qid: str, question: str, default: str) -> str:
    names = {"en": "English", "zh-Hant": both(_.variants("Traditional Chinese"))}
    return UI().menu(qid, question, [(code, names[code]) for code in hubconf.LANGUAGES], default)


def choose_language(args: dict) -> tuple[str, str] | None:
    """init's first question (docs/design/newcomer-path.md B0): (ui, content). The default is the environment's
    AGENT_HUB_LANG_UI, else the system's language. Asked in every language at once, since none is chosen yet."""
    if args.get("lang"):
        return parse_lang(args["lang"])
    env_ui = os.environ.get("AGENT_HUB_LANG_UI")
    default = env_ui if env_ui in hubconf.LANGUAGES else hubconf.system_language()
    env_content = os.environ.get("AGENT_HUB_LANG_CONTENT")
    if not UI().can_ask:
        return default, env_content if env_content in hubconf.LANGUAGES else default
    if hubconf.is_simplified_chinese(hubconf.system_tag()):
        UI().say(both(_.variants("Simplified Chinese has no translation yet, so English is the default.")))
    choice = UI().menu("language", both(_.variants("Language")), [
        ("en", "English"), ("zh-Hant", both(_.variants("Traditional Chinese"))),
        ("split", both(_.variants("A different language for notes than for the interface")))], default)
    if choice != "split":
        return choice, choice
    ui = ask_one_language("language_ui", both(_.variants("Interface language")), default)
    return ui, ask_one_language("language_content", both(_.variants("Notes and project state")), ui)


def set_language(ui: str, content: str) -> int:
    """init --lang on an existing instance: only the language changes (hub.json, committed alone), nothing else of
    init runs."""
    d = read_hub_json()
    d["language"] = {**(d.get("language") or {}), "ui": ui, "content": content}
    write_hub_json(d)
    hubconf._cfg = None
    os.environ["AGENT_HUB_LANG_UI"] = ui
    print(_("✓ language: interface {ui}, notes and project state {content}", ui=ui, content=content))
    rc = subprocess.run([str(BIN / "commit-hub-files.sh"), f"chore(config): language {ui}, content {content}",
                         "hub.json"]).returncode
    if rc != 0:
        print(_("warning: {file} was written, but the commit/push failed; it needs a manual fix", file="hub.json"))
    print(_("Commands use it from now on; long-running processes (lease-runner, an open MCP server) after they restart."))
    return 0 if rc == 0 else 1


def init_argv_problem(argv: list[str]) -> str | None:
    """init writes the instance and installs services, so it acts only on arguments it knows: anything else (a typo,
    --help) stops it before it writes anything."""
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in INIT_OPTIONS:
            if i + 1 >= len(argv):
                return _("{option} needs a value", option=a)
            i += 2
        elif a in INIT_FLAGS:
            i += 1
        else:
            return _("unknown argument: {arg}", arg=a)
    return None


def instance_home_answer(args: dict) -> pathlib.Path:
    return pathlib.Path(os.path.expanduser(args.get("home") or os.environ.get("AGENT_HUB_HOME") or UI().ask(
        "home", _("instance directory (your config, data and credentials live here)"), "~/.agent-hub")))


def connect_existing(args: dict, yes: bool) -> None:
    """Existing projects (docs/design/newcomer-path.md B6): where they are, never the workspace root just made empty.
    The folder becomes a root agent sessions may connect folders from (B5): named at the terminal that is the owner's
    say; named through an agent it needs the owner's own yes as well."""
    folder = args.get("connect") or UI().ask("connect", _("Where are your existing projects? A folder to connect from "
                                                          "(Enter to skip)"), "")
    if not folder:
        return
    if not UI().terminal and not UI().consent("connect_root", _("Let AI sessions connect folders inside {folder} to "
                                                                "agent-hub, and connect it now?", folder=folder)):
        return
    if not UI().acts:
        return
    subprocess.run([*hubconf.launch(BIN / "connect.py"), "--add-root", folder])
    subprocess.run([*hubconf.launch(BIN / "connect.py"), folder, *(["--yes"] if yes or not UI().terminal else [])])


def current_agent(d: dict, presets: dict[str, dict]) -> str:
    """Which preset hub.json d runs (for an init carried on after it stopped)."""
    for n, info in presets.items():
        s = info.get("settings") or {}
        if ((d.get("runtime") or {}).get("default") == (s.get("runtime") or {}).get("default")
                and all((d.get("modules") or {}).get(m) is on for m, on in (s.get("modules") or {}).items())):
            return n
    return "none"


# init --answers: what each answer is to init (its option), and the values it may take
ANSWERS = {"language": "lang", "language_ui": None, "language_content": None, "home": "home", "owner": "owner",
           "timezone": "timezone", "workspace": "workspace", "agent": "agent", "modules": "modules", "llm": "llm",
           "llm_base_url": "llm-base-url", "llm_model": "llm-model", "connect": "connect"}


def answers_problem(a) -> str | None:
    """The answers file is written by an agent: only known ids, strings, and for a choice one of its values. Consents
    and secrets have no id here at all: they never come from the file."""
    if not isinstance(a, dict):
        return _("the answers file must hold one JSON object: each question's id and its answer")
    for k, v in a.items():
        if k not in ANSWERS:
            return _("{id} is not a question init --answers takes (see init --questions)", id=k)
        if not isinstance(v, str):
            return _("the answer to {id} must be text", id=k)
        if v.startswith("-"):   # it becomes the value of init's option: never an option itself
            return _("the answer to {id} can't start with -", id=k)
    choices = {"language": [*hubconf.LANGUAGES, "split"], "language_ui": list(hubconf.LANGUAGES),
               "language_content": list(hubconf.LANGUAGES), "agent": [*agent_presets(), "none"], "llm": list(LLM_CHOICES)}
    for k, allowed in choices.items():
        if k in a and a[k] not in allowed:
            return _("{id} takes {choices}", id=k, choices=", ".join(allowed))
    if a.get("language") == "split" and not (a.get("language_ui") and a.get("language_content")):
        return _("language split needs language_ui and language_content")
    return None


def answers_args(a: dict) -> dict:
    args = {opt: a[k] for k, opt in ANSWERS.items() if opt and a.get(k)}
    if a.get("language") == "split":
        args["lang"] = f"{a['language_ui']},{a['language_content']}"
    return args


def init_questions(args: dict) -> list[dict]:
    """init --questions: the questions a fresh init would ask (or the ones an init that stopped has left), walked
    through the same steps with nothing done."""
    import contextlib
    import io
    rec = init_dialogue.Recorder({k: v for k, v in (args.pop("_answers", {}) or {}).items()})
    init_dialogue.use(rec)
    presets = agent_presets()
    saved = {k: os.environ.get(k) for k in ("AGENT_HUB_LANG_UI", "AGENT_HUB_LANG_CONTENT")}
    try:
        with contextlib.redirect_stdout(io.StringIO()):
            if hubconf.config_file("hub.json").exists():
                choice = current_agent(read_hub_json(), presets)
            else:
                ui, content = choose_language(args)
                os.environ["AGENT_HUB_LANG_UI"], os.environ["AGENT_HUB_LANG_CONTENT"] = ui, content
                instance_home_answer(args)
                d = new_hub_json(args)
                choice = args["_agent"]
                args["_runtime"] = (d.get("runtime") or {}).get("default")   # hub.json isn't written: llm_setup asks
            agent_credential(choice, presets)
            offer_mcp_registration(presets)
            llm_setup(args)
            connect_existing(args, False)
    finally:
        for k, v in saved.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
    return rec.questions


def init_for_agent(flags: set, args: dict, argv: list[str]) -> int:
    """docs/design/newcomer-path.md B3: init --questions [--answers <file>] prints what to ask as JSON; init --answers
    <file> applies the answers and ends with one JSON line: done, and what only the owner can do (needs_user)."""
    def emit(obj: dict) -> None:
        print(json.dumps(obj, ensure_ascii=False))
    answers = {}
    if args.get("answers"):
        try:
            answers = json.loads(pathlib.Path(args["answers"]).read_text())
        except (OSError, ValueError) as e:
            emit({"error": _("can't read the answers file: {error}", error=e)})
            return 2
    if "--yes" in flags:   # --yes takes defaults and never consents: it can't stand in for the owner either
        emit({"error": _("--yes doesn't go with --questions or --answers")})
        return 2
    if (problem := answers_problem(answers)):
        emit({"error": problem})
        return 2
    opts = answers_args(answers)
    exists = hubconf.config_file("hub.json").exists()
    if exists and not INIT_UNFINISHED.exists():
        emit({"error": _("agent-hub is already set up here"), "next": "agenthub doctor"})
        return 1
    if exists:   # carrying on an init that stopped: only its later steps take answers
        opts = {k: v for k, v in opts.items() if k in ("llm", "llm-model", "llm-base-url", "connect")}
    if "--questions" in flags:
        emit({"questions": init_questions({**opts, "_answers": answers}),
              "next": _("ask the owner the chat questions, write the answers to a file as one JSON object (each id and its answer), run "
                        "agenthub init --questions --answers <file> for any that follow from them, then agenthub "
                        "init --answers <file>. Questions via page or dialog are answered by the owner directly when "
                        "init runs; never ask for them in the chat.")})
        return 0
    agent = init_dialogue.Agent()
    rest = [x for k, v in opts.items() for x in (f"--{k}", v)] + [a for a in argv if a in ("--no-launchd", "--dry-run")]
    rc = cmd_init(rest, agent)
    if agent.needs and hubconf.config_file("hub.json").exists():
        # what is left for the owner: the same --answers carries on with only those steps once they're done
        INIT_UNFINISHED.parent.mkdir(parents=True, exist_ok=True)
        INIT_UNFINISHED.write_text("owner-steps\n")
    emit({"done": rc == 0 and not agent.needs, "exit": rc, "needs_user": agent.needs})
    return rc


def cmd_init(argv: list[str], transport=None) -> int:
    if any(a in ("-h", "--help") for a in argv):
        print(_(__doc__))
        return 0
    if problem := init_argv_problem(argv):
        print(_("agenthub init: {problem} (nothing was done; see agenthub --help)", problem=problem), file=sys.stderr)
        return 2
    if "--scheduler-only" in argv:   # a step of agenthub upgrade: the two units init installs, nothing else
        failed: list[str] = []
        for line in install_core_plists(False, failed) or [_("✓ the scheduler and watchdog are already installed")]:
            print(line)
        return 1 if failed else 0   # no service manager at all is not a failure here: doctor says so
    flags = {a for a in argv if a in INIT_FLAGS}
    args = {k.lstrip("-"): argv[i + 1] for i, k in enumerate(argv[:-1]) if k in INIT_OPTIONS}
    dry, yes = "--dry-run" in flags, "--yes" in flags
    if transport is None and ("--questions" in flags or "answers" in args):
        return init_for_agent(flags, args, argv)
    init_dialogue.use(transport or init_dialogue.Terminal(yes))
    if args.get("lang") and not parse_lang(args["lang"]):
        print(_("agenthub init: --lang takes {languages}, or two of them as <interface>,<notes> (nothing was done)",
                languages=", ".join(hubconf.LANGUAGES)), file=sys.stderr)
        return 2
    if args.get("lang") and hubconf.config_file("hub.json").exists():
        return set_language(*parse_lang(args["lang"]))   # an existing instance: only the language
    if args.get("agent") and args["agent"] not in (*agent_presets(), "none"):
        print(_("agenthub init: --agent takes {agents} (nothing was done)",
                agents=", ".join([*agent_presets(), "none"])), file=sys.stderr)
        return 2
    if args.get("agent") and hubconf.config_file("hub.json").exists():
        return set_agent(args["agent"], args)   # an existing instance: only the agent step
    if "--register-mcp" in flags and hubconf.config_file("hub.json").exists():
        offer_mcp_registration(agent_presets())   # an existing instance: only this step
        return 0
    created = False
    legacy = hubconf.instance_home() is None and hubconf.config_file("hub.json").exists()
    if legacy:
        # the old layout (hub.json in the hub root, as before the move): left alone; the move is a separate step
        # (docs/design/new-user.md step 6)
        print(_("✓ {path} already exists (the old layout); leaving it alone", path=hubconf.config_file('hub.json')))
    elif hubconf.config_file("hub.json").exists():
        print(_("✓ {path} already exists; leaving it alone (to change it, edit it, then run agenthub config apply)",
                path=hubconf.config_file('hub.json')))
        if INIT_UNFINISHED.exists() and not dry:   # an earlier init stopped after writing hub.json: finish its steps
            print(_("an earlier agenthub init stopped before it finished; carrying on with what it didn't do"))
            created = True
    else:
        ui, content = choose_language(args)
        os.environ["AGENT_HUB_LANG_UI"], os.environ["AGENT_HUB_LANG_CONTENT"] = ui, content   # every later question
        home = instance_home_answer(args)
        d = new_hub_json(args)
        d["registry_dir"] = "projects"   # relative to config/
        d["language"] = {**(d.get("language") or {}), "ui": ui, "content": content}
        if dry:
            print(_("(dry-run) would create the instance directory {home}/{{config,data,secrets}}, write config/hub.json, "
                    "write {pointer}:\n", home=home, pointer=hubconf.POINTER) + json.dumps(d, ensure_ascii=False, indent=2))
            return 0
        for sub in ("config/projects", "data", "secrets"):
            (home / sub).mkdir(parents=True, exist_ok=True)
        (home / "secrets").chmod(0o700)
        (home / "config" / "hub.json").write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")
        hubconf.POINTER.write_text(str(home) + "\n")   # written last: once it exists, the platform uses this instance
        hubconf._cfg = None
        # until the steps after hub.json are done (llm setup), a re-run of init carries on instead of skipping them
        INIT_UNFINISHED.parent.mkdir(parents=True, exist_ok=True)
        INIT_UNFINISHED.write_text("llm-setup\n")
        created = True
        print(_("✓ instance directory {home} (owner {owner}, modules {modules})", home=home,
                owner=d['owner']['tag'], modules=', '.join(k for k, v in d['modules'].items() if v is True)))
    if dry and not hubconf.config_file("hub.json").exists():
        return 0
    dirs = [hubconf.registry_dir(), hubconf.STATE, hubconf.LOGS, hubconf.secrets_dir(), hubconf.data_dir(),
            hubconf.p("workspace_root", "~/workspace"), hubconf.p("git_origin", "~/git-origin"),
            hubconf.p("memory_copies", "~/.memory-copies")]
    for d in dirs:
        if d and not d.exists():
            print(_("{dry}create folder {path}", dry="(dry-run) " if dry else "", path=d))
            if not dry:
                d.mkdir(parents=True, exist_ok=True)
    if not dry and hubconf.secrets_dir().exists():
        hubconf.secrets_dir().chmod(0o700)
    # the platform's own commit gate is a git hook the project-settings applier installs in its git dir, as for every
    # repo with commit_gate (docs/design/test-waiting.md A1): `config apply` below does it
    if created and not dry:
        # a failure doesn't block init: doctor will say judgment points have nowhere to run; agenthub llm setup later
        # a carried-on init (no agent question this time) logs in the agent hub.json already names
        agent_credential(args.get("_agent") or current_agent(read_hub_json(), agent_presets()), agent_presets())
        offer_mcp_registration(agent_presets())
        llm_setup(args)
        INIT_UNFINISHED.unlink(missing_ok=True)
        on = [m for m in llm_modules() if (hubconf.get("modules") or {}).get(m) is True]
        if warning := llm_modules_warning(on):   # turned on by hand, or llm setup ended with no model after all
            print(warning)
    status = 0
    if not dry and not legacy:
        # after llm setup, which writes hub.json too; an instance whose config repo has no commit yet (init made none
        # before v0.2.0) gets it here as well
        ok, lines = config_repo_first_commit(hubconf.config_dir(), hubconf.owner_tag())
        for line in lines:
            print(line)
        status = 0 if ok else 1
    if "--no-launchd" in flags:
        print(_("--no-launchd: not installing the scheduler, not applying services"))
        return status
    for line in install_core_plists(dry) or [_("✓ the scheduler and watchdog are already installed")]:
        print(line)
    if not dry:
        rc = subprocess.run([*hubconf.launch(BIN / "agenthub"), "config", "apply"]).returncode
        if rc != 0:
            return rc
        import upgrade
        upgrade.record_in_step()   # this checkout's commit is in step now (agenthub upgrade, doctor)
    if created and not dry:
        connect_existing(args, yes)
    print(_("\nNext: agenthub doctor shows what is missing; agenthub connect <folder> connects existing projects, "
            "agenthub onboard ~/workspace/<project> starts a new one"))
    return status


# ---------- move-instance (the old layout → an instance directory, docs/design/new-user.md step 6) ----------

CONFIG_FILES = ["hub.json", "models.env", "mirror-list.txt", "services.tsv", "schedule.yaml"]
DATA_FILES = ["digest", "reflect", "todo.md", "index.md", "review-log.md", "openclaw-migration-status.md", "legacy-paths.tsv"]


def move_plan(home: pathlib.Path) -> list[tuple[pathlib.Path, pathlib.Path]]:
    """(source, destination). Runs only on the old layout, so the source is where hubconf points now. The platform's
    own registry (projects/agent-hub.yaml) stays with the platform; .state and .logs belong to this machine and don't
    move."""
    out = [(hubconf.config_file(f), home / "config" / f) for f in CONFIG_FILES if hubconf.config_file(f).exists()]
    reg = hubconf.registry_dir()
    out += [(f, home / "config" / "projects" / f.name) for f in sorted(reg.iterdir())
            if f.name != hubconf.platform_registry().name and f.name != "__pycache__"]
    out += [(hubconf.data_file(f), home / "data" / f) for f in DATA_FILES if hubconf.data_file(f).exists()]
    sec = hubconf.secrets_dir()
    out += [(f, home / "secrets" / f.name) for f in sorted(sec.iterdir())] if sec.is_dir() else []
    return out


def cmd_move_instance(argv: list[str]) -> int:
    """hub move-instance --to <instance directory> [--apply]: copy (the source isn't deleted), verify the new layout,
    write <hub>/.hub-home last."""
    if "--to" not in argv:
        print(_("usage: agenthub move-instance --to <instance directory> [--apply] (without --apply it only lists what it would "
                "do)"),
              file=sys.stderr)
        return 2
    home = pathlib.Path(os.path.expanduser(argv[argv.index("--to") + 1])).resolve()
    apply = "--apply" in argv
    if hubconf.POINTER.exists() or os.environ.get("AGENT_HUB_HOME"):
        print(_("already in the instance-directory layout ({home}); nothing to move", home=hubconf.instance_home()), file=sys.stderr)
        return 1
    if not hubconf.config_file("hub.json").exists():
        print(_("no hub.json: nothing to move"), file=sys.stderr)
        return 1
    if home.exists() and any(home.iterdir()):
        print(_("{path} is not empty; not overwriting", path=home), file=sys.stderr)
        return 1
    plan = move_plan(home)
    for src, dst in plan:
        print(_("copy {src} → {dst}", src=src, dst=dst) if apply else _("(would copy) {src} → {dst}", src=src, dst=dst))
    if not apply:
        print(_("\n{count} {count:item|items}; add --apply to do it (copies only; the originals stay in the hub; {pointer} is "
                "written last)",
                count=len(plan), pointer=hubconf.POINTER))
        return 0
    for src, dst in plan:
        dst.parent.mkdir(parents=True, exist_ok=True)
        (shutil.copytree if src.is_dir() else shutil.copy2)(src, dst)
    for sub in ("config/projects", "data", "secrets"):
        (home / sub).mkdir(parents=True, exist_ok=True)
    (home / "secrets").chmod(0o700)
    # backup scope: the old .secrets becomes the new secrets; config/ and data/ are added (once out of git, the backup
    # is their only copy)
    cfg_path = home / "config" / "hub.json"
    cfg = json.loads(cfg_path.read_text())
    b = cfg.get("backup")
    if isinstance(b, dict):
        inc = [x for x in b.get("include", []) if hubconf.path(x) != hubconf.secrets_dir()]
        b["include"] = inc + [str(home / "config"), str(home / "data"), str(home / "secrets")]
    cfg_path.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")
    env = {**os.environ, "AGENT_HUB_HOME": str(home)}
    # verify the new layout (the pointer file isn't written yet: point there with AGENT_HUB_HOME)
    # in a state of its own: the real registry index is rebuilt from the new place once the pointer is written
    check_state = tempfile.mkdtemp()
    r = subprocess.run(hubconf.launch(BIN / "config-check"), env={**env, "AGENT_HUB_STATE": check_state},
                       capture_output=True, text=True)
    shutil.rmtree(check_state, ignore_errors=True)
    print(r.stdout.strip() or r.stderr.strip())
    if r.returncode != 0:
        print(_("the config in the new layout is invalid; not writing {pointer} (the copies are in {home}; delete them and "
                "start over)", pointer=hubconf.POINTER, home=home), file=sys.stderr)
        return 1
    # config as code: config is its own repo, and its first commit is the current config
    cfgdir = home / "config"
    subprocess.run(["git", "init", "-q", str(cfgdir)], check=True)
    for k in ("user.name", "user.email"):
        v = subprocess.run(["git", "-C", str(ROOT), "config", k], capture_output=True, text=True).stdout.strip()
        if v:
            subprocess.run(["git", "-C", str(cfgdir), "config", k, v])
    subprocess.run(["git", "-C", str(cfgdir), "config", "core.hooksPath", str(ROOT / "githooks" / "config")])
    subprocess.run(["git", "-C", str(cfgdir), "add", "-A"], check=True)
    r = subprocess.run(["git", "-C", str(cfgdir), "commit", "-q", "-m", f"config moved from {ROOT}"], env=env,
                       capture_output=True, text=True)
    if r.returncode != 0:
        print(_("the config repo's first commit failed: {error}", error=(r.stdout + r.stderr).strip()[:400]), file=sys.stderr)
        return 1
    # written last: from this moment the platform uses the new layout; deleting it goes back
    hubconf.POINTER.write_text(str(home) + "\n")
    # the registry dir moved with the config: rebuild the index from it on purpose (refresh() refuses another dir)
    subprocess.run([*hubconf.launch(BIN / "registry.py"), "check", "--rebuild"], capture_output=True, text=True)
    print(_("\n✓ wrote {pointer}. The old files in the hub are still there (not deleted). Next steps (by hand):",
            pointer=hubconf.POINTER))
    print(_("  1. agenthub config plan shows what would change (the secrets path in projects' sandbox settings changes); "
            "if it looks right, run agenthub config apply"))
    print(_("  2. restart the long-running services that read paths (lease-runner, cap-runner)"))
    print(_("  3. only after the nightly flow and the backups (restore check) are fine, git rm those files from the platform repo"))
    return 0


# ---------- doctor ----------

def machine_sleeps(pmset: str | None = None, batteries: list | None = None) -> str | None:
    """Why this machine counts as one that sleeps (docs/design/newcomer-path.md B7), or None. macOS: pmset's system
    sleep setting is not 0 (desktops set to sleep included). Linux: a battery."""
    import re
    if sys.platform == "darwin":
        if pmset is None:
            r = subprocess.run(["/usr/bin/pmset", "-g"], capture_output=True, text=True)
            pmset = r.stdout if r.returncode == 0 else ""
        m = re.search(r"^\s*sleep\s+(\d+)", pmset, re.M)
        return _("system sleep after {minutes} min", minutes=m.group(1)) if m and m.group(1) != "0" else None
    if batteries is None:
        batteries = list(pathlib.Path("/sys/class/power_supply").glob("BAT*"))
    return _("it has a battery") if batteries else None


def cmd_doctor(argv: list[str]) -> int:
    results: list[tuple[str, str, str]] = []   # (ok|info|warn|bad, what, how to fix)

    def add(level, what, fix=""):
        results.append((level, what, fix))

    r = subprocess.run([str(BIN / "setup-python"), "--check"], capture_output=True, text=True)
    add("ok" if r.returncode == 0 else "bad", (r.stdout.strip() or r.stderr.strip())[:160] or _("the platform's Python"),
        "" if r.returncode == 0 else "bin/setup")
    if not hubconf.config_file("hub.json").exists():
        add("bad", _("no hub.json"), _("agenthub init"))
        return report(results)
    r = subprocess.run(hubconf.launch(BIN / "config-check"), capture_output=True, text=True)
    add("ok" if r.returncode == 0 else "bad", _("config: all valid") if r.returncode == 0 else
        _("config: {errors}", errors=r.stderr.strip()[:300]),
        "" if r.returncode == 0 else _("fix hub.json / projects/ as the messages say, then run agenthub config check"))
    add("ok", _("language: interface {ui}, notes and project state {content} (change: agenthub init --lang "
                "<interface>[,<notes>])", ui=hubconf.lang_ui(), content=hubconf.lang_content()))
    if (why := machine_sleeps()):
        add("info", _("this machine sleeps ({why}): daily jobs run when it wakes, background services are offline and "
                      "letters wait while it sleeps (README: a machine that sleeps)", why=why))

    import upgrade
    for level, what, fix in upgrade.doctor_lines():   # the release; network at most once a day (bin/upgrade.py)
        add(level, what, fix)

    side = hubconf.owner_side()
    add("ok", _("owner side: {name} (owner_side: assistant)", name=hubconf.get('assistant.name') or _("assistant"))
        if side == "assistant" else _("owner side: built-in (owner_side: builtin; agenthub owner list / done / answer)"))
    import shutil
    cli = shutil.which("agenthub")
    add("ok" if cli else "warn", _("agenthub is on PATH: {path}", path=cli) if cli else
        _("agenthub is not on PATH (project sessions cannot reach the mailbox commands)"),
        "" if cli else "bin/agenthub install-cli")
    hold = int(((hubconf.get("mailbox") or {}).get("mcp_hold_max_min", 120)))   # hubbus MCP_HOLD_MAX_MIN
    add("ok", _("MCP server: agenthub mcp (any agent with MCP can use the mailbox and write notes; while it works in a "
                "project, the platform holds requests to that project instead of dispatching an agent, for up to "
                "{minutes} minutes; registering it in the tool's settings is up to you)", minutes=hold),
        _("agenthub mcp config prints the snippet to register; how to add it per tool: docs/mcp.md"))
    import runtime_ports
    rname = runtime_ports.default_name()
    optional = runtime_ports.optional_features()   # off is said, not a reminder: letters still arrive at the next hook
    installed = runtime_ports.installed()
    if installed == [rname]:   # one coding agent (runtime.installed unset or only the default): as before A1
        for feat, ok, miss in runtime_ports.feature_table(rname):
            add("ok" if ok else "info" if feat in optional else "warn", _("{feature}: available", feature=feat) if ok else
                # runtime none is no coding agent at all, not one that lacks a part
                _("{feature}: off (no coding agent is set up: hub.json runtime.default is none)", feature=feat)
                if rname == "none" else
                _("{feature}: off (the runtime {runtime} has no {missing})", feature=feat, runtime=rname, missing=miss),
                "" if ok or feat in optional else
                _("install a coding agent that supports them, and point hub.json runtime.default at it"))
    else:
        doctor_runtimes(add, rname, installed, optional)
    if runtime_ports.throwaway_only(rname):
        add("warn", _("the runtime {runtime} runs only in the platform's throwaway worktree: agent-shaped judgment points "
                      "other than {points} are refused with that reason", runtime=rname,
                      points=", ".join(runtime_ports.THROWAWAY_POINTS)),
            _("keep a runtime with session state as runtime.default and put {runtime} on single points "
              "(hub.json llm.points.<point>.runtime)", runtime=rname))
    hub_cfg = {"runtime": hubconf.get("runtime") or {}, "llm": hubconf.get("llm") or {},
               "mailbox": hubconf.get("mailbox") or {}}
    for name in runtime_ports.RUNTIMES:   # a runtime's own "allowed but weak" settings
        warn_fn = getattr(runtime_ports._module(name), "warnings", None)
        for text, hint in (warn_fn(hub_cfg) if callable(warn_fn) else []):
            add("warn", text, hint)
    pinned = {pin.get("runtime") for pin in ((hubconf.get("llm") or {}).get("points") or {}).values()
              if isinstance(pin, dict) and pin.get("runtime")}
    for name in [rname, *sorted(pinned - {rname})]:   # the default runtime, then each one a point is pinned to
        try:
            auth = runtime_ports.load(name, ports=("auth",))
            for c in auth.credentials():
                if c.mode == "token":  # unattended calls like the schedule and the librarian use this by default
                    add("ok" if c.present else "bad", _("agent login ({label}): present", label=c.label) if c.present
                        else _("agent login ({label}): missing", label=c.label),
                        "" if c.present else c.renew)
                elif not c.present:
                    add("warn", _("agent login ({label}): missing", label=c.label), c.renew)
        except runtime_ports.Unsupported:
            pass   # no agent login to check: the feature table above already said which features are off
        except Exception as e:
            add("bad", _("cannot read the agent's login state: {error}", error=e), _("agenthub config check"))
    import completion
    if completion.settings():
        for name, ok, why in completion.health_all():
            add("ok" if ok else "bad", _("LLM provider {name}: available", name=name) if ok else
                _("LLM provider {name}: {reason}", name=name, reason=why),
                "" if ok else _("see hub.json llm.providers; set the key with agenthub llm set-key <provider>"))
        s = completion.settings()
        add("ok", _("model groups of the judgment points: {groups}",
                    groups=_(", ").join(f"{g}→{s['use'].get(g, _('(not set)'))}" for g in completion.GROUPS)))
    else:
        rt = runtime_ports.default_name()
        if "completion" in runtime_ports.capabilities(rt):
            add("ok", _("judgment points go to the runtime {runtime} (no llm.providers; schedulectl models shows each point's "
                       "model)", runtime=rt))
        else:
            add("bad", _("judgment points have nowhere to run: no coding agent is set up (runtime.default: none) and "
                         "hub.json has no llm.providers") if rt == "none" else
                _("judgment points have nowhere to run: the runtime {runtime} has no completion interface and hub.json "
                  "has no llm.providers", runtime=rt),
                _("agenthub llm setup (pick one: an API key or a local Ollama)"))

    uid = os.getuid()
    scheduled = False   # whether a service manager runs this hub's scheduler (said again at the heartbeat below)
    if hubconf.service_manager() is None:
        add("bad", _("scheduler, watchdog: {reason}", reason=hubconf.no_service_manager()),
            hubconf.manual_scheduler())
    elif hubconf.service_manager() == "systemd":
        import systemd_units
        for label, what in (("local.agent-hub-scheduler", _("scheduler")), ("local.agent-hub-scheduler-watchdog", _("watchdog"))):
            st = systemd_units.state(label)
            scheduled = scheduled or (label == "local.agent-hub-scheduler" and st == "running")
            add("ok" if st == "running" else "bad", _("{what} ({label}.timer): enabled", what=what, label=label)
                if st == "running" else _("{what} ({label}.timer): not installed", what=what, label=label) if st is None
                else _("{what} ({label}.timer): installed but not scheduled", what=what, label=label),
                "" if st == "running" else "agenthub init")
        if systemd_units.linger() is False:
            add("warn", _("the scheduler and services stop after logout (systemd linger is off)"), "sudo loginctl enable-linger $USER")
    for label, what in (() if hubconf.service_manager() != "launchd" else
                        (("local.agent-hub-scheduler", _("scheduler")), ("local.agent-hub-scheduler-watchdog", _("watchdog")))):
        r = subprocess.run(["/bin/launchctl", "print", f"gui/{uid}/{label}"], capture_output=True, text=True)
        if r.returncode != 0:
            add("bad", _("{what} ({label}): not loaded", what=what, label=label), _("agenthub init"))
        elif str(BIN) not in r.stdout:  # what's loaded for this user is another hub's (e.g. another clone)
            add("bad", _("{what} ({label}): the loaded one belongs to a different hub, not {bin}", what=what, label=label, bin=BIN),
                _("agenthub init (replaces it with this one)"))
        else:
            scheduled = scheduled or label == "local.agent-hub-scheduler"
            add("ok", _("{what} ({label}): loaded", what=what, label=label))
    import isolation
    why = isolation.can_sandbox()
    held = [n for n, d in hubconf.projects().items() if isolation.sandboxed(d)]
    if not why:
        add("ok", _("sandboxed projects' own services and jobs: run isolated ({adapter})", adapter=f"{isolation.adapter()[0]}: {', '.join(isolation.guarantees())}"))
    else:
        add("bad" if held else "warn",
            _("sandboxed projects' own services and jobs: off, they are not run ({reason})", reason=why)
            + (_("; affects: {projects}", projects=", ".join(held)) if held else ""),
            _("what each system needs: docs/design/capabilities.md (macOS: sandbox-exec; Linux: kernel 6.7 or later "
              "with Landlock enabled)"))
    hb = hubconf.STATE / "scheduler-heartbeat"
    if hb.exists():
        age = (datetime.datetime.now() - datetime.datetime.fromtimestamp(hb.stat().st_mtime)).total_seconds() / 60
        shown = f"{age:.0f}"   # what the message prints: "0" is "just ticked", and the plural follows the shown number
        add("ok" if age <= 35 else "bad", _("the scheduler just ticked") if shown == "0" else
            _("the scheduler last ticked {age:.0f} {age:minute|minutes} ago", age=float(shown)),
            "" if age <= 35 else _("bin/schedulectl status; see .logs/scheduler-stderr.log"))
    elif scheduled:
        add("warn", _("the scheduler has not ticked yet"),
            _("it ticks within 15 minutes of installing; if it still hasn't ticked, see .logs/scheduler-stderr.log"))
    else:   # not installed (init --no-launchd, no service manager) or not loaded: no tick is coming by itself
        add("warn", _("the scheduler has not ticked yet, and no service manager runs it here (see the scheduler line "
                      "above)"))
    if not hubconf.get("alerts"):
        add("warn", _("no alerts set up: a stopped scheduler or a dead service only shows on the status page and in the logs"),
            _("to be notified, add an alerts section as in hub.example.json"))

    import appliers
    left = {n: c for n, c in appliers.plan_all().items() if c and n != "scheduler"}
    add("ok" if not left else "warn", _("background services, project settings: match the config") if not left else
        _("background services, project settings: {count} {count:change|changes} not applied yet", count=sum(len(c) for c in left.values())),
        "" if not left else _("agenthub config plan, then agenthub config apply"))
    return report(results)


def doctor_runtimes(add, default: str, installed: list[str], optional: set) -> None:
    """Doctor with more than one coding agent (hub.json runtime.installed; docs/design/mailbox-runtimes.md A1): a column
    per runtime in the feature table, each runtime's rules file, and the runtimes refused in sandboxed projects."""
    import runtime_ports
    names = list(dict.fromkeys([default, *installed]))
    tables = {n: runtime_ports.feature_table(n) for n in names}
    add("ok", _("coding agents: {names} (the platform starts {default}; hub.json runtime.installed)",
                names=", ".join(installed), default=default))
    for i, (feat, _ok, _miss) in enumerate(tables[default]):
        cells = [(n, tables[n][i][1], tables[n][i][2]) for n in names]
        if all(ok for _n, ok, _m in cells):
            add("ok", _("{feature}: available", feature=feat))
            continue
        states = _("; ").join(_("{runtime} available", runtime=n) if ok else
                              _("{runtime} off (has no {missing})", runtime=n, missing=miss) for n, ok, miss in cells)
        add("info" if feat in optional else "warn", _("{feature}: {states}", feature=feat, states=states),
            "" if feat in optional else _("a runtime that is off for a feature only lacks it for its own sessions"))
    for n in installed:
        try:
            rules = runtime_ports.load(n, ports=("instructions",)).instructions_file(pathlib.Path("."))
            add("ok", _("{runtime}: the platform's rules go into {file}", runtime=n, file=rules))
        except runtime_ports.Unsupported:
            add("info", _("{runtime}: no rules file; its sessions get the platform's rules from the MCP server's "
                          "instructions (agenthub mcp) or their session-start hook", runtime=n))
        caps = runtime_ports.capabilities(n)
        if "lifecycle" in caps and not {"control", "confine"} <= caps:
            add("warn", _("{runtime}: its hooks are not installed in sandboxed projects, and a session of it there gets "
                          "no letters or notes from the platform (it has no {missing})", runtime=n,
                          missing=runtime_ports.or_list(runtime_ports.missing_label(n, p)
                                                        for p in ("control", "confine") if p not in caps)),
                _("use a runtime with both in sandboxed projects"))


def report(results) -> int:
    mark = {"ok": "✓", "info": "·", "warn": "!", "bad": "✗"}   # info: said, counted as neither
    for level, what, fix in results:
        print(f"{mark[level]} {what}" + (f"\n    → {fix}" if fix else ""))
    bad = sum(1 for r in results if r[0] == "bad")
    warn = sum(1 for r in results if r[0] == "warn")
    print("\n" + (_("no problems") if not bad else _("{count} {count:problem|problems}", count=bad))
          + (_(", {count} {count:reminder|reminders}", count=warn) if warn else ""))
    return 1 if bad else 0


# ---------- wrappers ----------

LLM_CHOICES = ("runtime", "anthropic", "openai", "ollama", "none")


def write_secret(name: str, value: str) -> pathlib.Path:
    """Write the value into the platform's secrets directory (600, temp file first, then rename); the value isn't
    printed."""
    d = hubconf.secrets_dir()
    d.mkdir(parents=True, exist_ok=True)
    d.chmod(0o700)
    f = d / name
    tmp = f.with_name(f.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(value.strip() + "\n")
    tmp.replace(f)
    return f


def default_llm_choice(runtime: str | None = None) -> str:
    """Based on what this machine has: a coding agent with a completion interface → its own login; otherwise local
    Ollama models → Ollama; neither = leave unset for now. `runtime`: the one a hub.json not written yet will name."""
    import provider_ollama
    import runtime_ports
    if "completion" in runtime_ports.capabilities(runtime or runtime_ports.default_name()):
        return "runtime"
    return "ollama" if provider_ollama.list_models({}) else "none"


def llm_expected(args: dict, runtime: str) -> bool:
    """Whether init's llm setup, asked after the modules, will give judgment points somewhere to run, as llm_setup
    decides: none; the runtime's own login only with a completion interface; a provider only with a model, which a
    run without questions gets only from --llm-model."""
    import runtime_ports
    choice = args.get("llm") or default_llm_choice(runtime)
    if choice == "none":
        return False
    if choice == "runtime":
        return "completion" in runtime_ports.capabilities(runtime)
    return bool(args.get("llm-model")) or UI().can_ask


def llm_setup(args: dict) -> int:
    """Who handles judgment points (nightly note tidying, the weekly report): writes hub.json's llm section; the key
    isn't shown and goes into the secrets directory; the model is chosen from that provider's actual list."""
    import completion
    import runtime_ports
    interactive = UI().can_ask
    rt = args.get("_runtime") or runtime_ports.default_name()
    choice = args.get("llm") or UI().ask("llm",
        _("who handles the platform's decisions (nightly notes, weekly report)? runtime = your coding agent's own "
          "login ({runtime}), anthropic, openai (or a compatible API), ollama (local), none = not now", runtime=rt)
        if "completion" in runtime_ports.capabilities(rt) else
        # nothing to offer as runtime: no coding agent (none), or one without a completion interface
        _("who handles the platform's decisions (nightly notes, weekly report)? anthropic, openai (or a compatible "
          "API), ollama (local), none = not now"),
        default_llm_choice(rt))
    if choice not in LLM_CHOICES:
        print(_("no option {choice} (choices: {choices})", choice=choice, choices=', '.join(LLM_CHOICES)), file=sys.stderr)
        return 2
    if not UI().acts:   # init --questions: what an agent relays for a provider, then nothing is written
        if choice not in ("runtime", "none"):
            UI().ask("llm_base_url", _("address (change it for a compatible service)"), "")
            UI().ask("llm_model", _("the model's name, used for every kind of decision (see agenthub llm setup to pick "
                                    "per kind)"), "")
            if choice != "ollama":
                UI().secret("llm_key", _("{choice} API key", choice=choice))
        return 0
    if not interactive and not args.get("llm") and choice not in ("runtime", "none") and not args.get("llm-model"):
        print(_("{choice} is available here, but a model cannot be picked non-interactively: judgment points stay unset; "
                "run agenthub llm setup later", choice=choice))
        return 0
    d = read_hub_json()
    if choice in ("runtime", "none"):
        llm = d.get("llm") or {}
        llm.pop("providers", None)
        llm.pop("use", None)
        if llm:
            d["llm"] = llm
        else:
            d.pop("llm", None)
        write_hub_json(d)
        hubconf._cfg = None
        if choice == "none":
            print(_("judgment points stay unset: when needed, they fail plainly and say why. Run agenthub llm setup later"))
        elif rt == "none":
            print(_("⚠️ no coding agent is set up (runtime.default: none), so runtime has no login to hand judgment "
                    "points to: they will fail. Pick a provider: agenthub llm setup"))
        elif "completion" not in runtime_ports.capabilities(rt):
            print(_("⚠️ the runtime {runtime} has no completion interface: judgment points will fail. Pick another provider: "
                    "agenthub llm setup", runtime=rt))
        else:
            print(_("judgment points go to the runtime {runtime} (its own login; models follow its group table, see "
                    "schedulectl models)", runtime=rt))
        return 0
    if not interactive and not args.get("llm-model"):   # stop before a key is asked for nothing
        print(_("When running non-interactively, give the model with --llm-model <name> (or run agenthub llm setup "
                "interactively later)"),
              file=sys.stderr)
        return 1
    mod = runtime_ports.load_completion(choice)
    conf = {"impl": choice}
    base = args.get("llm-base-url") or UI().ask("llm_base_url", _("address (Ollama)") if choice == "ollama" else
                                                _("address (change it for a compatible service)"), mod.DEFAULT_BASE)
    if choice == "ollama":
        conf.update(base_url=base, location="local")
    else:
        if base != mod.DEFAULT_BASE:
            conf["base_url"] = base
        conf["key"] = {"secret": f"{choice}-api-key"}
        value = UI().secret("llm_key", _("{choice} API key (not shown; Enter alone = later with agenthub llm set-key "
                                         "{choice}): ", choice=choice))
        if value:
            print(_("written to {path} (600)", path=write_secret(conf['key']['secret'], value)))
    probe = dict(conf)
    try:
        probe["_key"] = completion.read_key(probe)
    except completion.Refused:
        probe["_key"] = None
    names = mod.list_models(probe) if (probe.get("_key") or choice == "ollama") else []
    if args.get("llm-model"):
        picked = {g: args["llm-model"] for g in completion.GROUPS}
    else:
        if names:
            print(_("{choice} has these models:", choice=choice))
            for i, n in enumerate(names[:60], 1):
                print(f"  {i:2}. {n}")
        else:
            print(_("cannot list the models (no key yet, or not reachable); type a name"))

        def pick(qid: str, question: str, default: str) -> str:
            a = UI().ask(qid, question, default)
            return names[int(a) - 1] if a.isdigit() and 1 <= int(a) <= len(names) else a
        std = pick("llm_model_standard", _("standard (ordinary decisions: nightly tidy-up, weekly report): which one (number or name)"), "")
        if not std:
            print(_("no model picked; hub.json unchanged"), file=sys.stderr)
            return 1
        picked = {"standard": std, "fast": pick("llm_model_fast", _("fast (simple, high-volume decisions)"), std),
                  "strong": pick("llm_model_strong", _("strong (the hardest: consolidation)"), std)}
    conf["models"] = {g: picked[g] for g in completion.GROUPS}
    llm = d.setdefault("llm", {})
    llm.setdefault("providers", {})[choice] = conf
    llm["use"] = {g: choice for g in completion.GROUPS}
    errs = completion.config_errors(llm)
    if errs:
        print(_("invalid settings; hub.json unchanged:\n  {errors}", errors="\n  ".join(errs)), file=sys.stderr)
        return 1
    write_hub_json(d)
    hubconf._cfg = None
    ok, why = next(((o, w) for n, o, w in completion.health_all() if n == choice), (False, _("not checked")))
    print(_("hub.json llm: judgment points go to {choice} ({models}); {status}", choice=choice,
            models=', '.join(f'{g}={conf['models'][g]}' for g in completion.GROUPS),
            status=_("reachable") if ok else _("⚠️ not usable yet: {reason}", reason=why)))
    print(_("remember to commit hub.json (config as code). Agent work (mailbox handling and the like) needs a coding agent; "
            "see the feature table in agenthub doctor"))
    return 0 if ok else 1


def cmd_llm(argv: list[str]) -> int:
    import completion
    if argv[:1] == ["health"]:
        return subprocess.run([sys.executable, str(BIN / "llm.py"), "health"]).returncode
    if argv[:1] == ["setup"]:
        opts = {k.lstrip("-"): argv[i + 1] for i, k in enumerate(argv[:-1]) if k in ("--llm", "--llm-model", "--llm-base-url")}
        init_dialogue.use(init_dialogue.Terminal("--yes" in argv))
        return llm_setup(opts)
    if argv[:1] != ["set-key"] or len(argv) != 2:
        print(_("usage: agenthub llm setup | set-key <provider> (key from stdin) | health"), file=sys.stderr)
        return 2
    conf = ((completion.settings() or {}).get("providers") or {}).get(argv[1])
    if not conf:
        print(_("hub.json llm.providers has no {provider}", provider=argv[1]), file=sys.stderr)
        return 2
    k = conf.get("key") or {}
    if not k.get("secret"):
        print(_('llm.providers.{provider}.key is not {{"secret": file name}} (a key from an environment variable does not '
                'need this command)', provider=argv[1]), file=sys.stderr)
        return 2
    if sys.stdin.isatty():
        import getpass
        value = getpass.getpass(_("{provider} API key (not shown): ", provider=argv[1]))
    else:
        value = sys.stdin.read()
    if not value.strip():
        print(_("no key read; nothing written"), file=sys.stderr)
        return 1
    print(_("written to {path} (600). Check: agenthub llm health", path=write_secret(k['secret'], value)))
    return 0


def cmd_land(argv: list[str]) -> int:
    """After a merge of agent-hub (merge-branch runs it from the merged code): the registry index rebuilt by that code,
    then the hub's own git hooks installed from its entry (the installer decides from the index, so the refresh comes
    first). Both run whatever the other said; the worse exit code is returned."""
    rc = subprocess.run([*hubconf.launch(BIN / "registry.py"), "check", *argv]).returncode
    rc2 = subprocess.run([*hubconf.launch(BIN / "render-project-settings.py"), "--only", hubconf.hub_project()]).returncode
    return max(rc, rc2)


def passthrough(script: str):
    return lambda argv: subprocess.run([*hubconf.launch(BIN / script), *argv]).returncode


# subcommands for project sessions (any coding agent): the same list as policy.platform_cli() (the permission rules
# allow only these)
SESSION_COMMANDS = {**{c: ("hubbus", c) for c in ("send", "inbox", "show", "ack", "done", "thread", "open-questions")},
                    "merge-branch": ("merge-branch", None), "test": ("test-runner.py", None),
                    "cap-run": ("hub-run", None),
                    "complete": ("hub-run", "--complete")}


def session_command(name: str):
    script, sub = SESSION_COMMANDS[name]
    return lambda argv: subprocess.run([*hubconf.launch(BIN / script), *([sub] if sub else []), *argv]).returncode


def cmd_install_cli(argv: list[str]) -> int:
    """~/.local/bin/agenthub: a two-line wrapper script (not a symlink: agenthub's first line finds the platform's
    Python from the folder it is in)."""
    d = pathlib.Path(os.path.expanduser(argv[argv.index("--dir") + 1] if "--dir" in argv else "~/.local/bin"))
    d.mkdir(parents=True, exist_ok=True)
    f = d / "agenthub"
    body = (f'#!/bin/sh\n# the agent-hub CLI (written by agenthub install-cli; run it again after moving the hub)\n'
            f'exec "{BIN / "py"}" "{BIN / "agenthub"}" "$@"\n')
    if f.exists() and f.read_text() == body:
        print(_("✓ {path} is up to date", path=f))
    else:
        f.write_text(body)
        f.chmod(0o755)
        print(_("wrote {path}", path=f))
    on_path = str(d) in os.environ.get("PATH", "").split(":")
    if not on_path:
        print(_('⚠️ {dir} is not on PATH: add it to your shell setup (e.g. export PATH="{dir}:$PATH") so sessions can '
                'reach agenthub', dir=d))
    return 0 if on_path else 1


COMMANDS = {
    "init": cmd_init, "doctor": cmd_doctor, "config": cmd_config, "modules": cmd_modules, "llm": cmd_llm,
    "move-instance": cmd_move_instance,
    "onboard": passthrough("onboard-project.sh"), "connect": passthrough("connect.py"),
    "recover": passthrough("recover-project.sh"),
    "rename": passthrough("rename-project.sh"), "status": passthrough("overview.sh"),
    "jobs": lambda argv: subprocess.run([*hubconf.launch(BIN / "schedulectl"), "list", *argv]).returncode,
    "run": lambda argv: subprocess.run([*hubconf.launch(BIN / "schedulectl"), "run", *argv]).returncode,
    "install-cli": cmd_install_cli,
    "upgrade": passthrough("upgrade.py"),
    # stdio is the protocol: exec into the server process, no extra layer
    "mcp": lambda argv: os.execv(sys.executable, [sys.executable, str(BIN / "mcp_server.py"), *argv]),
    "owner": lambda argv: subprocess.run([*hubconf.launch(BIN / "owner.py"), *argv]).returncode,
    # after a merge of agent-hub, run by merge-branch from the merged tree (docs/design/test-waiting.md step 2.2;
    # step 2.3 adds the hook install): the registry index rebuilt by the code that just landed
    "land": cmd_land,
    **{name: session_command(name) for name in SESSION_COMMANDS},
}


def version() -> str:
    """the release this checkout is at: `git describe` against the v* tags (cliff.toml's tag_pattern); an untagged
    commit reads <tag>-<n>-g<sha>, a checkout with no release yet its short sha, a tree outside git `unknown`"""
    import upgrade
    return upgrade.describe()


def main(argv: list[str]) -> int:
    if argv[:1] == ["--version"]:
        print(f"agenthub {version()}")
        return 0
    if not argv or argv[0] in ("-h", "--help", "help") or argv[0] not in COMMANDS:
        print(_(__doc__))
        return 0 if not argv or argv[0] in ("-h", "--help", "help") else 2
    return COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
