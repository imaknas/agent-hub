#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""The config pipeline's check (docs/design/new-user.md 3.7): validates every config file at once.

  config-check            validate the config in the working tree
  config-check --staged   validate the **index** (what is about to be committed; called by the config repo's
                          githooks/config/pre-commit; agent-hub's lint tier runs the same check as --child). Passes at once when the index changes no config file.
                          A shared working tree may hold someone else's half-edited files, so, as the test runner does, the index
                          is exported to a temp directory and validated there with AGENT_HUB_ROOT pointing at it.

What it validates:
  hub.json           contracts/hub.v1.schema.json (minischema) + unknown top-level keys (except explanation keys starting
                     with _): a mistyped key (e.g. "assitant") is not silently ignored
  projects/          registry.refresh()'s validation (schema, duplicate names, after: pointing at jobs that exist, run
                     resolvable…)
  models.env         must not exist (since 10-29 model settings live in hub.json llm.points)
  mirror-list.txt    one git remote per line
  services.tsv       every row has as many columns as the header, labels are unique
  schedule.yaml      readable, job names unique (the old format, during the switch)

When it passes, the tree it validated is recorded in the git directory's config-check-passed.
"""
from __future__ import annotations

import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile

BIN = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(BIN))
import i18n  # noqa: E402
import names  # noqa: E402

_ = i18n.domain(__file__)
CONFIG = re.compile(r"^(hub\.json|models\.env|mirror-list\.txt|services\.tsv|schedule\.yaml|projects/)")
UNREADABLE = "hub.json: cannot read it ({error})"
FAILED = "config-check: ✗ {error}"


def check(root: pathlib.Path) -> list[str]:
    """The problems in the config under the config directory root (empty = passes). The schema is the platform's (the
    hub this script is in); registry validation needs hubconf to see the same config directory, so --staged runs in a
    child process (AGENT_HUB_CONFIG pointing at the exported index)."""
    sys.path.insert(0, str(BIN))
    import minischema
    errs: list[str] = []

    hub = root / "hub.json"
    if not hub.exists() and (root / "bin" / "agenthub").exists():
        # the platform repo's index: since 10-29 the platform repo holds no user config -- check the example; registry
        # validation still checks the platform's registry entry and modules
        hub = root / "hub.example.json"
    try:
        cfg = json.loads(hub.read_text())
    except (OSError, ValueError) as e:
        return [_(UNREADABLE, error=e)]
    schema = json.loads((BIN.parent / "contracts" / "hub.v1.schema.json").read_text())
    errs += [_("hub.json: {error}", error=e) for e in minischema.errors(schema, cfg)]
    known = set(schema["properties"])
    for k in cfg:
        if not k.startswith("_") and k not in known:
            near = [x for x in sorted(known) if _close(k, x)]
            errs.append(_("hub.json: unknown key `{key}`{hint}; to add one, put it in contracts/hub.v1.schema.json first",
                          key=k, hint=_(" (did you mean {keys}?)", keys=', '.join(near)) if near else ""))

    import runtime_ports
    rdefault = (cfg.get("runtime") or {}).get("default")
    if rdefault and rdefault not in runtime_ports.RUNTIMES:
        errs.append(_("hub.json: runtime.default `{name}` is not a registered runtime (have: {have})", name=rdefault,
                      have=", ".join(runtime_ports.RUNTIMES)))
    elif rdefault and runtime_ports.throwaway_only(rdefault):
        errs.append(_("hub.json: runtime.default `{name}` runs only in the platform's throwaway worktree, so as the "
                      "default it would run nothing (dispatch needs session state, every other point is refused); keep "
                      "another runtime as the default and pin {name} on {points} (llm.points.<point>.runtime)",
                      name=rdefault, points=", ".join(runtime_ports.THROWAWAY_POINTS)))
    rcfg = cfg.get("runtime") or {}
    for name in [*(rcfg.get("installed") or []), *([rcfg["bare_ids"]] if rcfg.get("bare_ids") else [])]:
        if isinstance(name, str) and name not in runtime_ports.RUNTIMES:
            errs.append(_("hub.json: runtime.installed / runtime.bare_ids name `{name}`, which is not a registered "
                          "runtime (have: {have})", name=name, have=", ".join(runtime_ports.RUNTIMES)))
    for name in runtime_ports.RUNTIMES:   # a runtime's own settings (e.g. runtime.acp), checked by its adapter
        check_conf = getattr(runtime_ports._module(name), "config_errors", None)
        if callable(check_conf):
            errs += [_("hub.json: {error}", error=e) for e in check_conf(cfg)]

    if "llm" in cfg:
        import completion
        errs += [_("hub.json: llm: {error}", error=e) for e in completion.config_errors(cfg["llm"])]

    import registry
    index = registry.refresh()
    for name, es in sorted(index["errors"].items()):
        where = (f"modules/{name.split(':', 1)[1]}.yaml" if name.startswith("module:")
                 else _("schedule (after/before)") if name == "(jobs)" else "registry" if name == "(registry)"
                 else f"projects/{name}.yaml")
        errs += [_("{where}: {error}", where=where, error=e) for e in es]

    # since 10-29 model settings live only in hub.json (llm.model_for); nobody reads this file any more
    if (root / "models.env").exists():
        errs.append(_("models.env: no longer used; model settings moved into hub.json llm.points (schedulectl set-model "
                      "state|index|consolidate <model>; a value equal to the group default need not be written), then delete "
                      "models.env"))

    ml = root / "mirror-list.txt"
    if ml.exists():
        for i, line in enumerate(ml.read_text().splitlines(), 1):
            s = line.strip()
            if s and not s.startswith("#") and not re.fullmatch(r"(git@[\w.-]+:[\w./-]+|https://[\w.-]+/[\w./-]+)", s):
                errs.append(_("mirror-list.txt:{line}: not a git remote: {text}", line=i, text=s))

    st = root / "services.tsv"
    if st.exists():
        rows = [r for r in st.read_text().splitlines() if r.strip()]
        width = len(rows[0].split("\t")) if rows else 0
        seen = set()
        for i, r in enumerate(rows[1:], 2):
            cols = r.split("\t")
            if len(cols) != width:
                errs.append(_("services.tsv:{line}: {count} {count:column|columns}; the header has {width}", line=i, count=len(cols), width=width))
            elif cols[0] in seen:
                errs.append(_("services.tsv:{line}: label `{label}` repeated", line=i, label=cols[0]))
            seen.add(cols[0])

    sy = root / "schedule.yaml"
    if sy.exists():
        import yaml
        try:
            jobs = (yaml.safe_load(sy.read_text()) or {}).get("jobs") or []
            names = [j.get("name") for j in jobs]
            errs += [_("schedule.yaml: job `{name}` repeated", name=n) for n in sorted({n for n in names if names.count(n) > 1})]
        except yaml.YAMLError as e:
            errs.append(_("schedule.yaml: cannot read it ({error})", error=e))
    return errs


def _close(a: str, b: str) -> bool:
    """Off by a character or two (a typo): edit distance ≤ 2."""
    if abs(len(a) - len(b)) > 2:
        return False
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i]
        for j, cb in enumerate(b, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
        prev = cur
    return prev[-1] <= 2


def git(*args: str) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def main(argv: list[str]) -> int:
    if argv == ["--child"]:  # --staged's child process: AGENT_HUB_CONFIG already points at the exported index
        errs = check(pathlib.Path(names.env("CONFIG")))
    elif argv == ["--staged"]:
        if not any(CONFIG.match(p) for p in git("diff", "--cached", "--name-only").splitlines()):
            return 0
        # the child gets its own state too: registry.refresh() writes the index it builds into STATE, and the real one
        # rebuilt from the export (in the platform repo: only agent-hub.yaml) dropped every project until the next tick
        with tempfile.TemporaryDirectory() as d, tempfile.TemporaryDirectory() as state:
            git("checkout-index", "-a", f"--prefix={d}/")
            env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
            # this script checks the exported config
            r = subprocess.run([str(BIN / "py"), str(pathlib.Path(__file__).resolve()), "--child"],
                               env=names.env_set(names.env_set(env, "CONFIG", d), "STATE", state), capture_output=True,
                               text=True)
        sys.stdout.write(r.stdout)
        sys.stderr.write(r.stderr)
        if r.returncode == 0:
            pathlib.Path(git("rev-parse", "--git-path", "config-check-passed").strip()).write_text(
                git("write-tree").strip() + "\n")
        return r.returncode
    elif not argv:
        sys.path.insert(0, str(BIN))
        import hubconf
        errs = check(hubconf.config_dir())
    else:
        print(_(__doc__), file=sys.stderr)
        return 2
    for e in errs:
        print(_(FAILED, error=e), file=sys.stderr)
    if not errs:
        print(_("config-check: the config is all valid"))
    return 1 if errs else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
