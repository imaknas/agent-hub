#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""Run the test suite in parallel: one process per test module, a pool of workers, the slowest modules first.

    run-tests [<tests dir>]       default: the tests/ next to this bin/

What `unittest discover -s tests` does, but each tests/test*.py module runs as its own `python -m unittest <module>` with
the tests directory on PYTHONPATH and the current directory unchanged, so a module also passes alone (no test may lean
on another module having run first in the same process). A module that took longer than TEST_SPLIT_S (default 4) seconds
last time is split: each of its tests runs as its own item, so one slow module no longer holds the run up for the sum of
its tests (the floor becomes the slowest single test). The E1 goldens' second pass on English
(tests/test_i18n_golden_en.py) becomes one more item per golden module (I18N_GOLDEN_LANG=en), so it is spread over the
pool too instead of being one long item.

The output ends like unittest's own (people and agents read it): `Ran <n> tests in <s>s`, then `OK` / `OK (skipped=k)` or
`FAILED (failures=…, errors=…, skipped=…)`; before it, the full output of every module that failed (its `FAIL:` /
`ERROR:` blocks at the start of a line). Exit 1 when any module failed.

    TEST_JOBS=<n>          workers (default: the number of cores, 2 to 16)
    TEST_DURATIONS=<file>  seconds per item from the last run (read to order and split the work, written after it);
                           without it, larger files go first and nothing is split
    TEST_SPLIT_S=<s>       split modules slower than this (default 4)
"""
from __future__ import annotations

import json
import os
import pathlib
import queue
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import names  # noqa: E402

RAN = re.compile(r"^Ran (\d+) tests? in ([\d.]+)s$", re.M)
RESULT = re.compile(r"^(OK|FAILED)(?: \((.*)\))?$", re.M)
GOLDEN_EN = "test_i18n_golden_en"


def items(tests: pathlib.Path) -> list[tuple[str, str | None]]:
    """(module, language) pairs: every test module, plus the golden modules again on en."""
    mods = sorted(p.stem for p in tests.glob("test*.py"))
    out: list[tuple[str, str | None]] = [(m, None) for m in mods]
    if GOLDEN_EN in mods:
        out += [(m, "en") for m in mods if m.startswith("test_i18n_golden") and m != GOLDEN_EN]
    return out


def key(item: tuple[str, str | None]) -> str:
    return item[0] + (f"@{item[1]}" if item[1] else "")


# No test reaches the real coding agent: a fresh HOME (no nvm there, so hubconf.tool and nvm_bin find none) and a recording `claude`
# first on PATH. A test that means to run one has its own stand-in; any call that lands here fails the run.
# In the tree's .state, not the temp area: the sandbox tests need a HOME the sandbox can't write (test_cap_profile skips otherwise)
_state = pathlib.Path(__file__).resolve().parents[1] / ".state"
_state.mkdir(parents=True, exist_ok=True)
GUARD = pathlib.Path(tempfile.mkdtemp(prefix="run-tests-guard-", dir=_state))
(GUARD / "home").mkdir()
(GUARD / "bin").mkdir()
CALLS = GUARD / "calls.log"
(GUARD / "bin" / "claude").write_text(f'#!/bin/sh\necho "$PWD :: $*" >> "{CALLS}"\necho "run-tests: no test may start a real claude" >&2\nexit 97\n')
(GUARD / "bin" / "claude").chmod(0o755)


def env_for(tests: pathlib.Path, lang: str | None) -> dict[str, str]:
    # the tree under test is the platform the tests see (as the test runner's export is): an explicit root skips hubconf's
    # lookup of the main checkout, so a run in a linked worktree never reaches the machine's live instance. Only the
    # root: HOME and STATE would leak into the fake hubs the tests build (docs/design/test-waiting.md A1)
    env = {**os.environ, "PYTHONPATH": os.pathsep.join(filter(None, [str(tests), os.environ.get("PYTHONPATH")])),
           "HOME": str(GUARD / "home"), "PATH": f"{GUARD / 'bin'}{os.pathsep}{os.environ.get('PATH', '')}"}
    if not names.env("PYTHON", environ=env):
        names.env_set(env, "PYTHON", sys.executable)   # bin/py looks for it under HOME
    names.env_set(env, "TEST_RUNNER", "1")
    names.env_set(env, "ROOT", names.env("ROOT") or str(tests.resolve().parent))
    # the gate runs as a zh-Hant instance and CI (bin/linux-test: plain unittest, a bare HOME) as an English one, so a
    # test that assumes either language fails in one of them without running anything twice; a caller's own setting wins
    for var in ("LANG_UI", "LANG_CONTENT"):
        names.env_set(env, var, names.env(var, environ=env) or "zh-Hant")
    if lang:
        env["I18N_GOLDEN_LANG"] = lang
    return env


def test_ids(item: tuple[str, str | None], tests: pathlib.Path) -> list[str]:
    """The ids of a module's tests (module.Class.method), loaded the way unittest loads them; [] if it cannot be
    loaded (then the module runs whole and reports its own import error)."""
    code = ("import sys, unittest\n"
            "def walk(s):\n"
            "    for t in s:\n"
            "        yield from walk(t) if isinstance(t, unittest.TestSuite) else [t.id()]\n"
            "print('\\n'.join(walk(unittest.defaultTestLoader.loadTestsFromName(sys.argv[1]))))\n")
    r = subprocess.run([sys.executable, "-c", code, item[0]], env=env_for(tests, item[1]), stdin=subprocess.DEVNULL,
                       capture_output=True, text=True)
    ids = r.stdout.split() if r.returncode == 0 else []
    return ids if all(i.startswith(item[0] + ".") for i in ids) else []


def run_one(item: tuple[str, str | None], tests: pathlib.Path) -> tuple[int, str, float]:
    t0 = time.monotonic()
    r = subprocess.run([sys.executable, "-m", "unittest", item[0]], env=env_for(tests, item[1]),
                       stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    return r.returncode, r.stdout, time.monotonic() - t0


def threading_map(fn, xs: list, n: int) -> list:
    """fn over xs on n threads, results in order (the test listings run side by side)."""
    out: list = [None] * len(xs)
    q: queue.Queue = queue.Queue()
    for i in range(len(xs)):
        q.put(i)

    def work():
        while True:
            try:
                i = q.get_nowait()
            except queue.Empty:
                return
            out[i] = fn(xs[i])
    ts = [threading.Thread(target=work, daemon=True) for _ in range(max(1, min(n, len(xs))))]
    for t in ts:
        t.start()
    for t in ts:
        t.join()
    return out


def counts(out: str) -> dict[str, int]:
    c = {"tests": 0, "failures": 0, "errors": 0, "skipped": 0, "expected failures": 0, "unexpected successes": 0}
    if m := RAN.search(out):
        c["tests"] = int(m.group(1))
    if m := RESULT.search(out):
        for part in (m.group(2) or "").split(","):
            name, _eq, n = part.strip().rpartition("=")
            if name in c and n.isdigit():
                c[name] += int(n)
    return c


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    tests = pathlib.Path(argv[0] if argv else pathlib.Path(__file__).resolve().parents[1] / "tests").resolve()
    # one worker per core: the tests mostly wait on child processes and files, so more workers than that only stretch
    # the slowest tests (measured 10-31 on 14 cores: 7 → 47 s, 14 → 32 s, 20 → 30 s, 28 → 31 s)
    jobs = int(os.environ.get("TEST_JOBS") or max(2, min(16, os.cpu_count() or 4)))
    cache = pathlib.Path(os.environ["TEST_DURATIONS"]) if os.environ.get("TEST_DURATIONS") else None
    try:
        last = json.loads(cache.read_text()) if cache else {}
    except (OSError, ValueError):
        last = {}
    split_s = float(os.environ.get("TEST_SPLIT_S") or 4)
    modules = items(tests)
    slow = [it for it in modules if last.get(key(it), 0.0) > split_s]
    ids = dict(zip(map(key, slow), threading_map(lambda it: test_ids(it, tests), slow, jobs)))
    work, parent = [], {}   # parent: an item split out of a module → that module's key
    for it in modules:
        parts = ids.get(key(it)) or []
        if len(parts) > 1:
            for t in parts:
                work.append((t, it[1]))
                parent[key((t, it[1]))] = key(it)
        else:
            work.append(it)
    guess = {k: last.get(m, 0.0) / sum(1 for v in parent.values() if v == m) for k, m in parent.items()}
    work.sort(key=lambda it: (-last.get(key(it), guess.get(key(it), 0.0)),
                              -(tests / f"{it[0].split('.')[0]}.py").stat().st_size))
    todo: queue.Queue = queue.Queue()
    for it in work:
        todo.put(it)
    results: dict[str, tuple[int, str, float]] = {}
    lock = threading.Lock()

    def worker():
        while True:
            try:
                it = todo.get_nowait()
            except queue.Empty:
                return
            res = run_one(it, tests)
            with lock:
                results[key(it)] = res

    t0 = time.monotonic()
    threads = [threading.Thread(target=worker, daemon=True) for _ in range(min(jobs, len(work)))]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    wall = time.monotonic() - t0

    total = {"tests": 0, "failures": 0, "errors": 0, "skipped": 0, "expected failures": 0, "unexpected successes": 0}
    failed = []
    for k in sorted(results):
        code, out, _secs = results[k]
        c = counts(out)
        for name in total:
            total[name] += c[name]
        if code != 0:
            failed.append(k)
            if not (c["failures"] or c["errors"]):
                total["errors"] += 1   # crashed before unittest's own summary (import error, killed…)
            lines = [line for line in out.splitlines() if not RAN.match(line) and not RESULT.match(line)]
            while lines and (not lines[-1].strip() or set(lines[-1]) == {"-"}):   # its own separator before "Ran"
                lines.pop()
            body = "\n".join(lines)
            print(f"======== {k} (exit {code})\n{body}\n", flush=True)
    if cache:
        secs = {k: v[2] for k, v in results.items()}
        for k, m in parent.items():   # a split module's own total: decides next time whether to split it again
            secs[m] = secs.get(m, 0.0) + secs.get(k, 0.0)
        try:
            cache.parent.mkdir(parents=True, exist_ok=True)
            cache.write_text(json.dumps({k: round(v, 2) for k, v in secs.items()}, indent=1, sort_keys=True))
        except OSError:
            pass
    calls = CALLS.read_text().splitlines() if CALLS.exists() else []
    shutil.rmtree(GUARD, ignore_errors=True)
    if calls:
        failed.append("real-agent-guard")
        total["errors"] += 1
        print("======== a test reached for the real coding agent; give it a stand-in\n" + "\n".join(calls[:20]) + "\n", flush=True)
    print(f"({len(modules)} modules, {len(results)} items, {len(threads)} workers)")
    print("-" * 70)
    print(f"Ran {total['tests']} test{'' if total['tests'] == 1 else 's'} in {wall:.3f}s")   # as unittest writes it
    print()
    extra = [f"{n}={total[n]}" for n in ("failures", "errors", "skipped", "expected failures", "unexpected successes")
             if total[n]]
    if failed:
        print(f"FAILED ({', '.join(extra)})")
        print("failed modules: " + ", ".join(failed))
        return 1
    print("OK" + (f" ({', '.join(extra)})" if extra else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
