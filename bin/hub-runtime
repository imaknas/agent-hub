#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""A small command for shell scripts to ask about the runtime (runtime abstraction, docs/design/runtime-abstraction.md).
The default runtime is set in hub.json.

  hub-runtime instructions-file <folder>   the file the platform's managed block goes into (relative to that folder)
  hub-runtime local-ignores                this runtime's machine-local files, one per line (to add to .git/info/exclude)
  hub-runtime has <port>                   exit 0 when the runtime has that interface (runtime_ports.PORTS), 3 when not

The system python3 (3.9) can run it.
"""
from __future__ import annotations

import os
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import i18n  # noqa: E402
import runtime_ports  # noqa: E402

_ = i18n.domain(__file__)


def main(argv) -> int:
    if argv[:1] == ["has"] and len(argv) == 2:   # e.g. onboard says only what was really set up
        return 0 if argv[1] in runtime_ports.capabilities() else 3
    try:
        rt = runtime_ports.load(ports=("instructions",))
    # no rules file: exit code 3 (the caller treats it as "unsupported" rather than guessing a default file name)
    except runtime_ports.Unsupported as e:
        print(e, file=sys.stderr)
        return 3
    if argv[:1] == ["instructions-file"] and len(argv) == 2:
        ws = pathlib.Path(argv[1]).resolve()
        print(os.path.relpath(rt.instructions_file(ws), ws))
        return 0
    if argv == ["local-ignores"]:
        print("\n".join(rt.local_ignores()))
        return 0
    print(_(__doc__), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
