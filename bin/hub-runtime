#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""A small command for shell scripts to ask about the runtime (runtime abstraction, docs/design/runtime-abstraction.md).
The default runtime is set in {settings}.

  hub-runtime [--runtime <name>] instructions-file <folder>
                                           the file the platform's managed block goes into (relative to that folder),
                                           for that runtime (default: runtime.default)
  hub-runtime instructions-files <folder>  the same for every installed runtime with a rules file ({settings}
                                           runtime.installed), one per line, no repeats: each gets the managed block
  hub-runtime local-ignores                the installed runtimes' machine-local files, one per line (to add to
                                           .git/info/exclude)
  hub-runtime [--runtime <name>] has <port>
                                           exit 0 when the runtime has that interface (runtime_ports.PORTS), 3 when not
  hub-runtime [--runtime <name>] worktree-settings <worktree> <main checkout>
                                           worktree-memory.sh: a linked worktree's own settings, so its session can write
                                           the main checkout's memory notes (the runtime's install_worktree); 3 when the
                                           runtime has none

The system python3 (3.9) can run it.
"""
from __future__ import annotations

import os
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import i18n  # noqa: E402
import runtime_ports  # noqa: E402

_ = i18n.domain(__file__)


def installed(argv) -> int:
    """instructions-files / local-ignores over every installed runtime with a rules file (docs/design/
    mailbox-runtimes.md A1); none has one: exit code 3, the reason on stderr."""
    out, why = [], None
    for name in runtime_ports.installed():
        try:
            rt = runtime_ports.load(name, ports=("instructions",))
        except runtime_ports.Unsupported as e:
            why = why or e
            continue
        if argv[0] == "instructions-files":
            ws = pathlib.Path(argv[1]).resolve()
            items = [os.path.relpath(rt.instructions_file(ws), ws)]
        else:
            items = rt.local_ignores()
        out += [x for x in items if x not in out]
    if why and not out:
        print(why, file=sys.stderr)
        return 3
    if out:
        print("\n".join(out))
    return 0


def main(argv) -> int:
    name = None   # --runtime: which runtime's (worktree-memory.sh names its own); none = runtime.default
    if argv[:1] == ["--runtime"] and len(argv) >= 3:
        name, argv = argv[1], argv[2:]
    if argv[:1] == ["has"] and len(argv) == 2:   # e.g. onboard says only what was really set up
        return 0 if argv[1] in runtime_ports.capabilities(name) else 3
    if (argv[:1] == ["instructions-files"] and len(argv) == 2 or argv == ["local-ignores"]) and name is None:
        return installed(argv)
    if argv[:1] == ["worktree-settings"] and len(argv) == 3:
        try:
            rt = runtime_ports.load(name, ports=("lifecycle",))
        except runtime_ports.Unsupported as e:
            print(e, file=sys.stderr)
            return 3
        install = getattr(rt, "install_worktree", None)
        if not callable(install):   # a runtime whose worktree sessions need nothing of the kind
            return 3
        install(pathlib.Path(argv[1]), pathlib.Path(argv[2]))
        return 0
    try:
        rt = runtime_ports.load(name, ports=("instructions",))
    # no rules file: exit code 3 (the caller treats it as "unsupported" rather than guessing a default file name)
    except runtime_ports.Unsupported as e:
        print(e, file=sys.stderr)
        return 3
    if argv[:1] == ["instructions-file"] and len(argv) == 2:
        ws = pathlib.Path(argv[1]).resolve()
        print(os.path.relpath(rt.instructions_file(ws), ws))
        return 0
    print(_(__doc__), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
