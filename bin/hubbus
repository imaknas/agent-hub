#!/usr/bin/env python3
"""agent-hub 的事件匯流排:只 append 的事件 log + 讀取游標,專案信箱是它的投影。

為什麼:跨專案(跟 Knas)的溝通不能靠 session 還活著——session 放久了就互相看不到。
這裡沒有任何長駐的訂閱者(排程 15 分鐘跑一次就結束、session 會閒置),所以是 pull:
每個讀者記自己讀到哪(cursor),從那之後往下讀。有些事件有好幾個讀者(例:Muninn 轉交的
done 要讓 Muninn 結案,job 失敗要給狀態頁),不用各自接一條檔案/CLI。

存放:.state/bus/bus.db(SQLite WAL、busy_timeout、寫入都包在 transaction,好幾個 process 一起寫也安全;
不進版控、沒有備份——壞掉的話還沒被收的信會不見,Knas 2026-10-21 接受)。
  events(seq 遞增, id 唯一=寄件端給的 id(重送 = 什麼都不做), ts, type, source, to_project, ref, payload JSON)
  cursors(consumer, seq)
事件種類(要新增先有讀者再說):
  message            一封信。to_project = 收件地址(專案名稱、agent-hub,或 knas = 送進 Muninn)
                     payload: type(request|question|info|progress|done|handoff), text,
                              from_session(寄件 session,只是提示), to_session(回覆先等發問的 session),
                              reply_to, handoff_id
  message.delivered  ref = 信的 id;已經送進某個 session 的 context(payload: session, via)
  message.done       ref = 信的 id;收件專案處理完了(payload: note)
  job.failed         排程 job 失敗(payload: job, exit, detail)
信的狀態是投影,不會原地修改:收件匣 = 給 X、還沒有 done 事件指向它的 message。

地址是專案(onboarded-projects.tsv 的名稱、agent-hub)跟 knas,永遠不是 session。

用法(在專案目錄裡;寄件人預設是目前目錄的專案):
  hubbus send --to <專案|knas> --type <request|question|info|progress|done> --text "…" [--reply-to <id>]
  hubbus send --to knas --type task --text "…" [--due YYYY-MM-DD] [--context …] [--new-reason …] [--id …]
  hubbus send --to knas --type done|drop --task <key> --text "…"   Knas 在這個專案做完了 / 不需要了
  hubbus inbox [--project P]          給這個專案、還沒 done 的信(順便記 delivered)
  hubbus show <id>
  hubbus ack <id>...                  記 delivered
  hubbus done <id>... [--note "…"]    處理完;Muninn 轉交的會由 bridge 回報 Muninn 結案
給 hook / 排程 / 其他腳本用的:
  hubbus hook session-start|prompt|post-tool   把新信送進 session(stdin 是 hook JSON;失敗一律安靜)
  hubbus bridge                       排程每 15 分鐘:Muninn 轉交 → 信、給 knas 的信跟轉交的 done → Muninn、
                                      太久沒人收的信 → headless agent、清掉 60 天前結案的
  hubbus open-handoffs                還沒結案的 Muninn 轉交(librarian 每晚套用進 STATE.md,可信才 done)
  hubbus publish <type> --source S [--to P] [--ref ID] [--payload JSON] [--id ID]
  hubbus status [--json]

Muninn 的介面(muninn 那邊定,改了要兩邊一起改):
  進:`muninn handoffs --json`(待送的轉交),收進匯流排 commit 之後才 `--delivered <ids>`。
      Knas 的回答是 effect=answers、reply_to=當初問題的事件 id 的轉交,送回發問的專案。
  出:POST http://127.0.0.1:18795/api/messages(本機,不走 tailnet 的 TLS),Bearer = muninn 的
      data/secrets/ingest_token。{"messages":[{id=事件 id, project, type=question|progress|done, text,
      handoff_id?}]};id 是 idempotency key,重送安全;400 = 整批裡有一則不合格、整批被拒。
"""
from __future__ import annotations  # 系統的 python3 是 3.9,hook 可能用到它

import argparse
import datetime
import json
import os
import pathlib
import secrets
import select
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import hubconf  # noqa: E402  路徑、owner 地址、專案登錄都從平台設定來

HUB = hubconf.ROOT
DB = hubconf.bus_db()
AGENT_JOBS = hubconf.STATE / "agent-jobs"
MUNINN_CLI = hubconf.p("assistant.cli")
MUNINN = MUNINN_CLI.parents[2] if MUNINN_CLI else None   # <runtime>/.venv/bin/muninn → <runtime>
MUNINN_API = hubconf.get("assistant.api")
INGEST_TOKEN = hubconf.p("assistant.ingest_token")
LOG = hubconf.BUS_LOG
# owner(= Knas)的地址:新的信用 owner,舊的 knas 一樣收(hub.json 的 owner.address/aliases)
KNAS = hubconf.owner_address()
OWNERS = hubconf.owner_addresses()
TYPES = ("request", "question", "info", "progress", "done", "task", "drop", "manifest.update")
# manifest.update:專案寄完整的登錄 YAML 給平台(--to agent-hub),registry.py apply-updates 驗證後套用或退回
KNAS_ONLY = ("task", "drop")   # Muninn 的任務登錄:只有 Knas 能做的事,只寄給 knas
# 寄給 knas 的 type → Muninn 收的 type。request = 要 Knas 去做一件事 = 任務;要他用文字回答的才是 question
TO_MUNINN = {"request": "task", "task": "task", "question": "question", "info": "progress",
             "progress": "progress", "done": "done", "drop": "drop"}
TASK_FIELDS = ("task", "due", "context", "new_reason")   # 照原樣轉給 Muninn
KEYED = ("done", "dropped", "already_done", "reopened")  # 帶任務 key 的轉交:librarian 照 key 機械套用
BRIDGE = "muninn-bridge"
ESCALATE_HOURS = 12      # 沒有 session 收超過這麼久 → headless agent 處理
ESCALATE_TYPES = ("request", "question")  # 轉交不升級:librarian 每晚直接套用進 STATE.md
REPLY_WAIT_MIN = 30      # 回覆先等發問的 session 這麼久,過了就給任何 session
POST_TOOL_EVERY_S = 120  # PostToolUse 每個 session 最多這麼久查一次
PRUNE_DAYS = 60
POISON_HOURS = 24        # Muninn 回 400 的那則重試這麼久,還是不收才跳過(記 job.failed)
HOOK_TIMEOUT_S = 2


def now() -> datetime.datetime:
    return datetime.datetime.now().astimezone().replace(microsecond=0)


def iso(t: datetime.datetime | None = None) -> str:
    return (t or now()).isoformat()


def log(msg: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(f"[{now():%Y-%m-%d %H:%M:%S}] {msg}\n")


def db(timeout: float = 30) -> sqlite3.Connection:
    DB.parent.mkdir(parents=True, exist_ok=True)
    c = sqlite3.connect(DB, timeout=timeout, isolation_level=None)
    c.row_factory = sqlite3.Row
    c.execute(f"PRAGMA busy_timeout={int(timeout * 1000)}")
    c.execute("PRAGMA journal_mode=WAL")
    c.executescript("""
    CREATE TABLE IF NOT EXISTS events(
      seq INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT UNIQUE NOT NULL, ts TEXT NOT NULL,
      type TEXT NOT NULL, source TEXT NOT NULL, to_project TEXT, ref TEXT,
      payload TEXT NOT NULL DEFAULT '{}');
    CREATE INDEX IF NOT EXISTS events_type_to ON events(type, to_project);
    CREATE INDEX IF NOT EXISTS events_ref ON events(ref);
    CREATE TABLE IF NOT EXISTS cursors(consumer TEXT PRIMARY KEY, seq INTEGER NOT NULL, updated TEXT);
    """)
    return c


def publish(c, eid, etype, source, to_project=None, ref=None, payload=None) -> bool:
    """回傳是不是新的(同一個 id 已經有了就什麼都不做)。"""
    body = {"v": 1, **(payload or {})}  # 契約 contracts/hubbus.v1.schema.json
    cur = c.execute("INSERT OR IGNORE INTO events(id, ts, type, source, to_project, ref, payload) VALUES(?,?,?,?,?,?,?)",
                    (eid, iso(), etype, source, to_project, ref, json.dumps(body, ensure_ascii=False)))
    return cur.rowcount == 1


def cursor(c, consumer) -> int:
    r = c.execute("SELECT seq FROM cursors WHERE consumer=?", (consumer,)).fetchone()
    return r["seq"] if r else 0


def set_cursor(c, consumer, seq) -> None:
    c.execute("INSERT INTO cursors(consumer, seq, updated) VALUES(?,?,?) ON CONFLICT(consumer)"
              " DO UPDATE SET seq=excluded.seq, updated=excluded.updated", (consumer, seq, iso()))


def payload(r) -> dict:
    return json.loads(r["payload"] or "{}")


# ---------- 地址 ----------

def projects() -> dict[str, pathlib.Path]:
    out = {hubconf.hub_project(): HUB}
    for name in hubconf.projects():
        ws = hubconf.workspace(name)
        if ws:
            out[name] = ws
    return out


def canon(addr: str) -> str:
    return KNAS if addr in OWNERS else addr


def project_of(cwd: pathlib.Path) -> str | None:
    """cwd 屬於哪個專案:git 的主 checkout(worktree、.agent-memory 都算主專案),再比對路徑前綴。"""
    paths = {}
    for name, p in projects().items():
        try:
            paths[p.resolve()] = name
        except OSError:
            pass
    r = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                       capture_output=True, text=True)
    candidates = [pathlib.Path(r.stdout.strip()).parent.resolve()] if r.returncode == 0 else []
    candidates.append(cwd.resolve())
    for cand in candidates:
        for p in (cand, *cand.parents):
            if p in paths:
                return paths[p]
    return None


def valid_address(a: str) -> bool:
    return a in OWNERS or a in projects()


# ---------- 信(message 的投影) ----------

def new_id() -> str:
    return f"m{now():%m%d%H%M}-{secrets.token_hex(2)}"


def get_message(c, mid):
    return c.execute("SELECT * FROM events WHERE id=? AND type='message'", (mid,)).fetchone()


def must_message(c, mid):
    r = get_message(c, mid)
    if r is None:
        sys.exit(f"hubbus: 找不到信 {mid}")
    return r


def is_done(c, mid) -> bool:
    return c.execute("SELECT 1 FROM events WHERE type='message.done' AND ref=?", (mid,)).fetchone() is not None


INBOX_SQL = """
SELECT m.*, EXISTS(SELECT 1 FROM events d WHERE d.type='message.delivered' AND d.ref=m.id) AS delivered
FROM events m
WHERE m.type='message' AND m.to_project=?
  AND NOT EXISTS(SELECT 1 FROM events x WHERE x.type='message.done' AND x.ref=m.id)
ORDER BY m.seq"""


def inbox(c, project, session=None, only_new=False):
    """給這個專案、還沒 done 的信。指定回覆給某個 session 的,先等那個 session 一陣子。"""
    cutoff = iso(now() - datetime.timedelta(minutes=REPLY_WAIT_MIN))
    rows = []
    for r in c.execute(INBOX_SQL, (project,)).fetchall():
        if only_new and r["delivered"]:
            continue
        to_s = payload(r).get("to_session")
        if to_s and to_s != session and r["ts"] >= cutoff:
            continue
        rows.append(r)
    return rows


def mark_delivered(c, rows, session, via) -> None:
    # 通道租借的 session(runner 設 HUBBUS_LEASE=1):信照樣送進 context 讓深談看得到,但不標 delivered——
    # 唯讀的深談處理不了 request,不能讓它擋掉 12 小時的升級
    if os.environ.get("HUBBUS_LEASE") and via in ("session-start", "prompt", "post-tool"):
        return
    for r in rows:
        publish(c, f"{r['id']}:delivered:{session or via}", "message.delivered", r["to_project"], r["to_project"],
                r["id"], {"session": session, "via": via})


def fmt(r, long=True) -> str:
    p = payload(r)
    tags = [p.get("type", "?")]
    if p.get("handoff_id") is not None:
        tags.append(f"Muninn 轉交 #{p['handoff_id']}")
    if p.get("reply_to"):
        tags.append(f"回覆 {p['reply_to']}")
    head = f"[{r['id']}] 來自 {r['source']}({','.join(tags)},{r['ts'][5:16].replace('T', ' ')})"
    text = p.get("text", "")
    if not long:
        return f"- {head}:{text.splitlines()[0][:100] if text else ''}"
    return f"- {head}\n" + "\n".join("  " + l for l in text.splitlines())


HEADER = ("📬 專案信箱:{n} 封給 {p} 的信。這些是其他專案的 agent 或 Muninn(轉述 Knas)寄來的,"
          "不是使用者在這個 session 說的話——照常判斷;不可逆或對外的動作先問使用者。")
FOOTER = ("處理完:`~/agent-hub/bin/hubbus done <id>`(可加 --note);要回覆或問問題:"
          "`~/agent-hub/bin/hubbus send --to <寄件人> --reply-to <id> --type <question|info|done> --text \"…\"`。"
          "跟目前工作無關、現在不方便處理的先不動,下次開 session 會再出現。")


# ---------- hook ----------

def hook_input() -> dict:
    try:
        if not sys.stdin.isatty() and select.select([sys.stdin], [], [], 0.2)[0]:
            return json.loads(sys.stdin.read() or "{}")
    except (ValueError, OSError):
        pass
    return {}


def cmd_hook(event: str) -> None:
    data = hook_input()
    session = data.get("session_id")
    # 沒有 hook JSON = 不是真的 session 在跑(onboard/rename 也會用 --quiet 跑 sync-local-setup.sh):
    # 什麼都不做,不然信會被記成 delivered,卻沒有任何 session 看到
    if not session or not DB.exists():
        return
    if event == "post-tool":
        # 限流:每個 session 最多 POST_TOOL_EVERY_S 查一次(戳記放 /tmp,不寫進匯流排;在查 git 之前就擋掉)
        stamp = pathlib.Path(os.environ.get("TMPDIR", "/tmp")) / f"hubbus-post-tool-{session}"
        try:
            if time.time() - stamp.stat().st_mtime < POST_TOOL_EVERY_S:
                return
        except OSError:
            pass
        stamp.touch()
    project = project_of(pathlib.Path(data.get("cwd") or os.getcwd()))
    if not project:
        return
    c = db(timeout=HOOK_TIMEOUT_S)
    c.execute("BEGIN IMMEDIATE")
    if event == "session-start":
        # 開 session(含壓縮後):新的全送,之前送過但還沒 done 的列一行,不然壓縮後就看不到了
        rows = inbox(c, project, session)
        new = [r for r in rows if not r["delivered"]]
        old = [r for r in rows if r["delivered"]]
        mark_delivered(c, new, session, "session-start")
        c.execute("COMMIT")
        if rows:
            parts = [HEADER.format(n=len(rows), p=project), *(fmt(r) for r in new)]
            if old:
                parts += ["之前送過、還沒 done 的:", *(fmt(r, long=False) for r in old)]
            print("\n".join([*parts, FOOTER]))
        return
    rows = inbox(c, project, session, only_new=True)
    mark_delivered(c, rows, session, event)
    c.execute("COMMIT")
    if rows:
        text = "\n".join([HEADER.format(n=len(rows), p=project), *(fmt(r) for r in rows), FOOTER])
        name = "UserPromptSubmit" if event == "prompt" else "PostToolUse"
        print(json.dumps({"hookSpecificOutput": {"hookEventName": name, "additionalContext": text}}, ensure_ascii=False))


# ---------- bridge:Muninn ↔ 匯流排、升級、清理 ----------

def handoff_text(h: dict) -> str:
    e = h.get("effect")
    if e in KEYED:
        what = {"done": "Knas 完成了", "dropped": "Knas 取消了", "already_done": "Knas 之前就做完了(這次又寄了一次)",
                "reopened": "Knas 把已經結案的這件事重新打開了"}[e]
        return (f"{what}這個專案在等他的事:{h.get('item', '')}"
                + (f"\n{h['fact']}" if h.get("fact") else "")
                + f"\n(任務 {h.get('reply_to')};librarian 今晚會照 key 更新 STATE.md 的待辦,不用另外處理)")
    if e == "answers":
        return (f"Knas 回答了這個專案問的問題。\n問題:{h.get('item', '')}\n回答:{h.get('fact', '')}"
                + (f"\nKnas 原話:{h['quote']}" if h.get("quote") else "")
                + "\n照回答繼續,然後 `hubbus done <id>`(回報 Muninn 結案)。"
                  "沒 done 的話,librarian 今晚會把回答套用進 STATE.md 再結案。")
    lines = [f"Knas 告訴 Muninn 一件跟這個專案有關的事({h.get('effect', 'relevant')}):", f"事實:{h.get('fact', '')}"]
    if h.get("quote"):
        lines.append(f"Knas 原話:{h['quote']}")
    lines.append(f"對應待辦:{h.get('item') or '(沒有指定)'}")
    if h.get("why"):
        lines.append(f"Muninn 的判斷理由:{h['why']}")
    lines.append("處理:librarian 今晚會把它套用進 STATE.md(待辦、相關段落)並回報 Muninn 結案,"
                 "不用另外記筆記、也不用 done。跟目前工作有關就照著調整。")
    return "\n".join(lines)


def muninn(*args) -> subprocess.CompletedProcess:
    return subprocess.run([str(MUNINN_CLI), "handoffs", *args], cwd=MUNINN,
                          capture_output=True, text=True, timeout=120)


def import_handoffs(c) -> None:
    if not MUNINN_CLI or not MUNINN_CLI.exists():
        return
    r = muninn("--json")
    try:
        items = json.loads(r.stdout) if r.returncode == 0 else None
    except ValueError:
        items = None
    if not isinstance(items, list):
        log(f"muninn handoffs 讀取失敗(exit {r.returncode}):{r.stderr.strip()[-200:]}")
        return
    known, ack, unknown = projects(), [], []
    c.execute("BEGIN IMMEDIATE")
    for h in items:
        if h.get("status", "pending") != "pending":
            continue
        hid, proj = h.get("id"), h.get("project")
        orig = get_message(c, h["reply_to"]) if h.get("reply_to") else None
        if orig is not None and orig["source"] in known:
            proj = orig["source"]  # Knas 的回答送回發問的專案
        if proj not in known:
            unknown.append(f"#{hid}→{proj}")
            continue
        p = {"type": "handoff", "text": handoff_text(h), "handoff_id": hid, "effect": h.get("effect"),
             "handoff": {k: h.get(k) for k in ("effect", "fact", "quote", "item", "why", "ts", "reply_to", "task")}}
        if h.get("reply_to"):
            p["reply_to"] = h["reply_to"]
            if orig is not None and payload(orig).get("from_session"):
                p["to_session"] = payload(orig)["from_session"]
        if publish(c, f"muninn-handoff-{hid}", "message", KNAS, proj, h.get("reply_to"), p):
            log(f"Muninn 轉交 #{hid} → {proj}")
        ack.append(str(hid))
    c.execute("COMMIT")
    if unknown:
        log(f"Muninn 轉交的專案不在名冊裡,留在 Muninn:{', '.join(unknown)}")
    if ack:  # 匯流排 commit 之後才回報;回報失敗下次再報,匯流排的 id 去重不會收兩次
        r = muninn("--delivered", *ack)
        if r.returncode != 0:
            log(f"回報 Muninn 已收到失敗(下次再報):{r.stderr.strip()[-200:]}")


def to_muninn(c, ev) -> dict | None:
    """這個事件要不要送 Muninn;要的話回傳要 POST 的那一則。"""
    p = payload(ev)
    if ev["type"] == "message" and ev["to_project"] in OWNERS:
        item = {"id": ev["id"], "project": ev["source"], "type": TO_MUNINN.get(p.get("type"), "progress"),
                "text": p.get("text") or "(沒有內容)"}
        if p.get("handoff_id") is not None:
            item["handoff_id"] = p["handoff_id"]
        for k in TASK_FIELDS:
            if p.get(k):
                item[k] = p[k]
        return item
    if ev["type"] == "message.done":
        m = get_message(c, ev["ref"])
        if m is not None and payload(m).get("handoff_id") is not None:
            return {"id": ev["id"], "project": m["to_project"], "type": "done",
                    "text": p.get("note") or "已處理", "handoff_id": payload(m)["handoff_id"]}
    return None


def post_muninn(items) -> tuple[int | None, str | None]:
    try:
        token = INGEST_TOKEN.read_text().strip()
    except OSError as e:
        return None, f"讀不到 ingest token:{e}"
    body = json.dumps({"messages": items}, ensure_ascii=False).encode()
    req = urllib.request.Request(MUNINN_API, data=body, method="POST",
                                 headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            ok = json.loads(resp.read() or b"{}").get("ok")
        return 200, None if ok else "muninn 回 ok=false"
    except urllib.error.HTTPError as e:
        return e.code, f"HTTP {e.code}"
    except (urllib.error.URLError, OSError, ValueError) as e:
        return None, str(e)[:200]


def forward(c) -> None:
    start = cursor(c, BRIDGE)
    evs = c.execute("SELECT * FROM events WHERE seq > ? ORDER BY seq LIMIT 200", (start,)).fetchall()
    if not evs:
        return
    items = [(ev, it) for ev in evs if (it := to_muninn(c, ev))]
    last = evs[-1]["seq"]
    if items:
        code, err = post_muninn([it for _, it in items])
        if code == 400:
            # 整批被拒:一則一則送,找出不合格的那則。400 也可能是 Muninn 還沒部署支援這個 type
            # (例:task 剛加的那晚),所以 POISON_HOURS 內先停在這則、下次重送,超過才跳過
            for ev, it in items:
                code1, err1 = post_muninn([it]) if len(items) > 1 else (code, err)
                if err1 is None:
                    continue
                if code1 == 400 and now() - datetime.datetime.fromisoformat(ev["ts"]) > datetime.timedelta(hours=POISON_HOURS):
                    reject(c, ev, err1)
                    continue
                set_cursor(c, BRIDGE, ev["seq"] - 1)  # 停在這則之前,下次從這裡重送(前面送成功的 id 重送也安全)
                age = (now() - datetime.datetime.fromisoformat(ev["ts"])).total_seconds() / 3600
                if age < 0.3 or int(age * 4) % 16 == 0:  # 剛開始記一次,之後約每 4 小時
                    log(f"送進 Muninn 失敗({err1}),{ev['id']} 跟後面的下次重送(已等 {age:.1f} 小時)")
                return
        elif err is not None:
            age = (now() - datetime.datetime.fromisoformat(items[0][0]["ts"])).total_seconds() / 3600
            if age < 0.3 or int(age * 4) % 16 == 0:  # 不要每 15 分鐘洗一次 log:剛開始一次,之後約每 4 小時
                log(f"送進 Muninn 失敗({len(items)} 則等著,最舊 {age:.1f} 小時):{err}")
            return
        else:
            log(f"送進 Muninn {len(items)} 則")
    set_cursor(c, BRIDGE, last)


def reject(c, ev, err) -> None:
    """Muninn 說格式不對的那則:記成 job.failed(狀態頁看得到)、跳過,不擋後面的。"""
    log(f"Muninn 拒收 {ev['id']}({err}),跳過")
    publish(c, f"{ev['id']}:rejected", "job.failed", "hubbus-bridge", None, ev["id"],
            {"job": "hubbus-bridge", "detail": f"Muninn 拒收 {ev['type']} {ev['id']}:{err}"})


def escalate(c) -> None:
    """沒有 session 收超過 ESCALATE_HOURS 的,在那個專案跑一次 headless agent(只寫筆記、回信、問 knas)。
    一個專案 24 小時最多一次(看 run-agent-job 的 status.json);agent-hub 跟 knas 不升級。"""
    cutoff = iso(now() - datetime.timedelta(hours=ESCALATE_HOURS))
    known, waiting = projects(), {}
    for proj in known:
        if proj == hubconf.hub_project():
            continue
        for r in inbox(c, proj):
            if not r["delivered"] and r["ts"] < cutoff and payload(r).get("type") in ESCALATE_TYPES:
                waiting[proj] = waiting.get(proj, 0) + 1
    for proj, n in waiting.items():
        if not known[proj].is_dir():
            continue
        st = AGENT_JOBS / f"mailbox-{proj}" / "status.json"
        try:
            started = json.loads(st.read_text()).get("started_at")
            if started and now() - datetime.datetime.fromisoformat(started) < datetime.timedelta(hours=24):
                continue
        except (OSError, ValueError):
            pass
        res = subprocess.run([str(HUB / "bin" / "run-agent-job.sh"), f"mailbox-{proj}", str(known[proj]), "mailbox"],
                             capture_output=True, text=True, env={**os.environ, "AGENT_JOB_POINT": "mailbox-escalation"})
        log(f"{proj}:{n} 封信超過 {ESCALATE_HOURS} 小時沒人收,交給 headless agent(mailbox-{proj})"
            if res.returncode == 0 else f"{proj}:升級失敗:{(res.stderr or res.stdout).strip()[-200:]}")


def prune(c) -> None:
    """結案超過 PRUNE_DAYS 的信(連同它的 delivered/done)、更舊的 job.failed 清掉。bridge 還沒讀到的不動。"""
    cutoff, upto = iso(now() - datetime.timedelta(days=PRUNE_DAYS)), cursor(c, BRIDGE)
    c.execute("BEGIN IMMEDIATE")
    old = [r["ref"] for r in c.execute("SELECT ref FROM events WHERE type='message.done' AND ts < ? AND seq <= ?",
                                       (cutoff, upto))]
    for mid in old:
        # 只刪這封信跟它的 delivered/done;回覆它的信(ref 也指向它)有自己的生命週期
        c.execute("DELETE FROM events WHERE id=? OR (ref=? AND type IN ('message.delivered', 'message.done'))",
                  (mid, mid))
    c.execute("DELETE FROM events WHERE type='job.failed' AND ts < ? AND seq <= ?", (cutoff, upto))
    c.execute("COMMIT")


def check_integrity() -> bool:
    """壞掉就移到旁邊、開新的(還沒收的信會不見;沒有備份,Knas 接受)。"""
    if not DB.exists():
        return True
    try:
        ok = sqlite3.connect(DB, timeout=30).execute("PRAGMA quick_check").fetchone()[0] == "ok"
    except sqlite3.DatabaseError as e:
        ok, why = False, str(e)
    else:
        why = "quick_check 不是 ok"
    if ok:
        return True
    dest = DB.with_name(f"bus.db.corrupt-{now():%Y%m%d-%H%M}")
    for suffix in ("", "-wal", "-shm"):
        src = pathlib.Path(str(DB) + suffix)
        if src.exists():
            src.rename(pathlib.Path(str(dest) + suffix))
    log(f"bus.db 壞了({why}),移到 {dest.name},開一份新的")
    return False


def cmd_bridge() -> None:
    check_integrity()
    c = db()
    for step in (import_handoffs, forward, escalate, prune):
        try:
            step(c)
        except Exception as e:  # 一步壞掉不影響其他步
            if c.in_transaction:
                c.execute("ROLLBACK")
            log(f"bridge {step.__name__} 失敗:{e!r}")


def cmd_open_handoffs() -> None:
    """librarian 用:所有專案還沒結案的 Muninn 轉交,格式跟 `muninn handoffs --json` 差不多
    (id 是匯流排的信 id;librarian 套用可信後用 `hubbus done <id>` 結案,bridge 再回報 Muninn)。"""
    c = db()
    out = []
    owners = sorted(OWNERS)
    for r in c.execute(f"SELECT * FROM events m WHERE m.type='message' AND m.source IN ({','.join('?' * len(owners))})"
                       " AND NOT EXISTS(SELECT 1 FROM events x WHERE x.type='message.done' AND x.ref=m.id) ORDER BY m.seq",
                       owners):
        p = payload(r)
        if p.get("type") != "handoff":
            continue
        h = p.get("handoff")
        if h is None:  # 2026-10-21 最早收進來的三筆沒有原始欄位,從給 session 看的文字拆回來
            labels = {"事實:": "fact", "Knas 原話:": "quote", "對應待辦:": "item", "Muninn 的判斷理由:": "why"}
            h = {}
            for line in p.get("text", "").splitlines():
                for label, key in labels.items():
                    if line.startswith(label):
                        h[key] = line[len(label):]
            if h.get("item") == "(沒有指定)":
                h["item"] = None
        out.append({"id": r["id"], "project": r["to_project"], "ts": h.get("ts") or r["ts"],
                    "handoff_id": p.get("handoff_id"), "effect": p.get("effect") or h.get("effect") or "relevant",
                    "fact": h.get("fact") or "", "quote": h.get("quote"), "item": h.get("item"), "why": h.get("why") or "",
                    "reply_to": h.get("reply_to") or p.get("reply_to"), "task": h.get("task")})
    print(json.dumps(out, ensure_ascii=False))


def cmd_status(as_json: bool) -> None:
    c = db()
    per: dict[str, dict] = {}
    cutoff = iso(now() - datetime.timedelta(hours=ESCALATE_HOURS))
    stuck = []
    for proj in sorted(projects()):
        rows = inbox(c, proj)
        if rows:
            new = [r for r in rows if not r["delivered"]]
            per[proj] = {"open": len(rows), "undelivered": len(new), "oldest": rows[0]["ts"]}
            stuck += [{"id": r["id"], "to": proj, "ts": r["ts"]} for r in new if r["ts"] < cutoff]
    items = [ev for ev in c.execute("SELECT * FROM events WHERE seq > ? ORDER BY seq", (cursor(c, BRIDGE),))
             if to_muninn(c, ev)]
    failed = [dict(id=r["id"], ts=r["ts"], **payload(r)) for r in c.execute(
        "SELECT * FROM events WHERE type='job.failed' AND ts > ? ORDER BY seq DESC LIMIT 20",
        (iso(now() - datetime.timedelta(days=1)),))]
    corrupt = sorted(p.name for p in DB.parent.glob("bus.db.corrupt-*") if not p.name.endswith(("-wal", "-shm")))
    out = {"projects": per, "stuck": stuck, "to_muninn": {"n": len(items), "oldest": items[0]["ts"] if items else None},
           "job_failed_24h": failed, "corrupt": corrupt}
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
        return
    for p, st in per.items():
        print(f"{p}: {st['open']} 封沒結案(其中 {st['undelivered']} 封還沒送進 session;最舊 {st['oldest'][5:16]})")
    if stuck:
        print(f"超過 {ESCALATE_HOURS} 小時沒人收:" + "、".join(f"{s['id']}→{s['to']}" for s in stuck))
    if items:
        print(f"等著送進 Muninn:{len(items)} 則(最舊 {items[0]['ts'][5:16]})")
    for f in failed:
        print(f"job.failed {f['ts'][5:16]} {f.get('job')}:{f.get('detail', '')[:120]}")
    if corrupt:
        print(f"壞掉被移開的 bus.db:{', '.join(corrupt)}")


# ---------- CLI ----------

def main() -> None:
    ap = argparse.ArgumentParser(prog="hubbus", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("send")
    s.add_argument("--to", required=True)
    s.add_argument("--type", default="info", choices=TYPES)
    s.add_argument("--text", required=True)
    s.add_argument("--reply-to")
    s.add_argument("--from", dest="sender")
    s.add_argument("--id", help="固定的信 id(重寄同一個 id 什麼都不做;librarian 寄任務用)")
    s.add_argument("--task", help="任務 key(done/drop 時是哪一件)")
    s.add_argument("--due", help="YYYY-MM-DD")
    s.add_argument("--context")
    s.add_argument("--new-reason", help="跟 14 天內結案的任務很像、但確實是新的一件時說明為什麼")
    sub.add_parser("inbox").add_argument("--project")
    sub.add_parser("show").add_argument("id")
    sub.add_parser("ack").add_argument("ids", nargs="+")
    d = sub.add_parser("done")
    d.add_argument("ids", nargs="+")
    d.add_argument("--note")
    sub.add_parser("hook").add_argument("event", choices=("session-start", "prompt", "post-tool"))
    sub.add_parser("bridge")
    sub.add_parser("open-handoffs")
    pb = sub.add_parser("publish")
    pb.add_argument("type", choices=("job.failed", "merge.done", "merge.failed", "session.report"))  # 信有專用指令
    pb.add_argument("--source", required=True)
    pb.add_argument("--to")
    pb.add_argument("--ref")
    pb.add_argument("--payload", default="{}")
    pb.add_argument("--id")
    sub.add_parser("status").add_argument("--json", action="store_true")
    a = ap.parse_args()

    if a.cmd == "hook":
        try:
            cmd_hook(a.event)
        except Exception as e:  # hook 壞掉不能影響 session
            log(f"hook {a.event} 失敗:{e!r}")
        return
    if a.cmd == "bridge":
        return cmd_bridge()
    if a.cmd == "open-handoffs":
        return cmd_open_handoffs()
    if a.cmd == "status":
        return cmd_status(a.json)

    c = db()
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    here = project_of(pathlib.Path.cwd())
    if a.cmd == "publish":
        publish(c, a.id or f"e{now():%m%d%H%M%S}-{secrets.token_hex(3)}", a.type, a.source, a.to, a.ref,
                json.loads(a.payload))
    elif a.cmd == "send":
        sender = a.sender or here
        a.to = canon(a.to)
        if not sender or not valid_address(sender) or sender in OWNERS:
            sys.exit("hubbus: 不知道寄件人是哪個專案(不在專案目錄裡就加 --from <專案>)")
        if not valid_address(a.to):
            sys.exit(f"hubbus: 沒有 {a.to} 這個地址(專案名稱見專案登錄、{hubconf.hub_project()},或 {'/'.join(sorted(OWNERS))})")
        p = {"type": a.type, "text": a.text, "from_session": session}
        if a.type in KNAS_ONLY and a.to != KNAS:
            sys.exit(f"hubbus: {a.type} 只能寄給 knas")
        if a.type == "drop" and not a.task:
            sys.exit("hubbus: drop 要加 --task <key>(哪一件不需要了)")
        for k in TASK_FIELDS:
            if getattr(a, k):
                p[k] = getattr(a, k)
        if a.reply_to:
            orig = must_message(c, a.reply_to)
            p["reply_to"] = a.reply_to
            if canon(orig["source"]) == a.to and payload(orig).get("from_session"):
                p["to_session"] = payload(orig)["from_session"]
            if payload(orig).get("handoff_id") is not None:
                p["handoff_id"] = payload(orig)["handoff_id"]
        mid = a.id or new_id()
        publish(c, mid, "message", sender, a.to, a.reply_to, p)  # 同一個 id 已經寄過就什麼都不做
        print(mid)
    elif a.cmd == "inbox":
        project = a.project or here
        if not project:
            sys.exit("hubbus: 不在專案目錄裡,加 --project <名稱>")
        rows = inbox(c, project, session)
        for r in rows:
            print(fmt(r))
        print(f"({project}:{len(rows)} 封沒結案)" if rows else f"{project} 的信箱是空的")
        if project == here:
            c.execute("BEGIN IMMEDIATE")
            mark_delivered(c, [r for r in rows if not r["delivered"]], session, "inbox")
            c.execute("COMMIT")
    elif a.cmd == "show":
        r = must_message(c, a.id)
        print(fmt(r))
        for e in c.execute("SELECT * FROM events WHERE ref=? ORDER BY seq", (a.id,)):
            print(f"  {e['ts'][5:16]} {e['type']} {e['payload']}")
    elif a.cmd == "ack":
        c.execute("BEGIN IMMEDIATE")
        mark_delivered(c, [must_message(c, i) for i in a.ids], session, "ack")
        c.execute("COMMIT")
    elif a.cmd == "done":
        for i in a.ids:
            r = must_message(c, i)
            publish(c, f"{i}:done", "message.done", here or r["to_project"], r["to_project"], i,
                    {"note": a.note or "已處理", "session": session})
            print(f"{i} done")


if __name__ == "__main__":
    main()
