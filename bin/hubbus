ASSISTANT_API = hubconf.get("assistant.api")
INGEST_TOKEN = hubconf.p("assistant.ingest_token")
LOG = hubconf.BUS_LOG
# owner(= owner)的地址:新的信用 owner,舊的 knas 一樣收(hub.json 的 owner.address/aliases)
OWNER_ADDRESS = hubconf.owner_address()
KNAS = OWNER_ADDRESS   # 舊名稱,新程式用 OWNER_ADDRESS
OWNERS = hubconf.owner_addresses()
TYPES = ("request", "question", "info", "progress", "done", "task", "drop", "manifest.update")
# manifest.update:專案寄完整的登錄 YAML 給平台(--to agent-hub),registry.py apply-updates 驗證後套用或退回
OWNER = hubconf.owner_tag()                         # 給人看的稱呼(待辦的〔標籤〕),這台是 hub.json owner.tag
ASSISTANT = hubconf.assistant_name()                # 個人助理給人看的名字(hub.json assistant.name)
OWNER_ALIAS = hubconf.fill_names("{{owner_alias}}")  # agent 寄信給 owner 用的地址(hub.json owner.aliases 的第一個)
HANDOFF_ID_PREFIX = "muninn-handoff-"   # 轉交收進來的信 id 開頭(匯流排裡已經是這個格式:不能改,改了重送會收兩次)
KNAS_ONLY = ("task", "drop")   # 助理 的任務登錄:只有 owner 能做的事,只寄給 knas
# 寄給 knas 的 type → 助理 收的 type。request = 要 owner 去做一件事 = 任務;要他用文字回答的才是 question
TO_MUNINN = {"request": "task", "task": "task", "question": "question", "info": "progress",
             "progress": "progress", "done": "done", "drop": "drop"}
TASK_FIELDS = ("task", "due", "context", "new_reason", "inferred", "question")   # 照原樣轉給 助理
QUESTION_CHECK_DAYS = 3   # 問 owner 的問題開著幾天後,問發問的專案還要不要(m10252237:在專案 session 裡解決了,助理 不知道)
