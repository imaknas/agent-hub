STUCK_HOURS = 1          # status: sent longer ago than this, no session took it, the platform didn't either
CONFLICT_DAYS = 14       # status: a record id sent with other content is listed this long after its last arrival
# a background resume not closed after this long (mailbox-conversation's timeout is 30 minutes) → dispatch as a
# delegation
RESUME_TIMEOUT_MIN = 35
SEEN_ALIVE_MIN = 30      # a hook this recent says a session runs (Live): a headless one is on no list, and a long tool call goes
#                          quiet for a while. The price: a session gone without its end hook keeps what it holds this long
START_TRIES, START_RETRY_MIN = 3, 15   # a handler that couldn't start is tried again this often, this long apart
PLATFORM_RUN_DAYS = 7    # the platform starts nothing (a fork, a handler) for a letter older than this: it waits for a hook
# delegation: a live session with activity within this window handles it in a fork with its context
FORK_RECENT_H = int(_MB.get("fork_recent_hours", 24))
