DB = hubconf.BUS_DIR / "bus.db"
AGENT_JOBS = hubconf.STATE / "agent-jobs"
ASSISTANT_CLI = hubconf.p("assistant.cli")
ASSISTANT_HOME = ASSISTANT_CLI.parents[2] if ASSISTANT_CLI else None   # <runtime>/.venv/bin/muninn → <runtime>
ASSISTANT_API = hubconf.get("assistant.api")
INGEST_TOKEN = hubconf.p("assistant.ingest_token")
LOG = hubconf.BUS_LOG
# the owner's address: new letters use owner, old aliases are still accepted (hub.json's owner.address/aliases)
OWNER_ADDRESS = hubconf.owner_address()
OWNERS = hubconf.owner_addresses()
TYPES = ("request", "question", "info", "progress", "done", "task", "drop", "manifest.update")
# manifest.update: a project sends its full registry YAML to the platform (--to agent-hub); registry.py apply-updates
# validates it, then applies or rejects it
OWNER = hubconf.owner_tag()                         # the name people see (the to-do tag), here hub.json owner.tag
ASSISTANT = hubconf.assistant_name()                # the personal assistant's display name (hub.json assistant.name)
OWNER_ALIAS = hubconf.owner_alias()                 # the address agents mail the owner at (first of owner.aliases)
# id prefix of letters taken in from handoffs (the bus already holds this format: can't change, or a resend would be
# taken twice)
HANDOFF_ID_PREFIX = "muninn-handoff-"
OWNER_ONLY = ("task", "drop")   # the assistant's task registry: things only the owner can do, sent only to the owner
# type sent to the owner → type the assistant receives. request = asks the owner to go do something = a task; only
# ones he's to answer in words are question
TO_MUNINN = {"request": "task", "task": "task", "question": "question", "info": "progress",
             "progress": "progress", "done": "done", "drop": "drop"}
TASK_FIELDS = ("task", "due", "context", "new_reason", "inferred", "question")   # passed through to the assistant as is
# days a question to the owner stays open before asking the asking project whether it still needs it (m10252237:
# settled in the project's session, and the assistant didn't know)
QUESTION_CHECK_DAYS = 3
KEYED = ("done", "dropped", "already_done", "reopened")  # handoffs with a task key: the librarian applies them by key
BRIDGE = "muninn-bridge"
# letters the platform handles; handoffs are applied by the librarian nightly, notifications need no handling
ACTIONABLE = ("request", "question")
_MB = hubconf.get("mailbox", {}) or {}
# someone is using it / the other party is still open: wait for its hook
CONVERSATION_WAIT_MIN = int(_MB.get("conversation_wait_min", 5))
RESUME_MAX_TOKENS = int(_MB.get("resume_max_tokens", 150000))
# tasks to the owner are sent as 0.3 records instead (turn on only once the assistant takes v2; bridge v2 follows the
# same switch)
RECORDS = bool(_MB.get("records", False))
# delivery into a session only counts as "seen"; no ack/reply/done for this long → treated as untaken, dispatched as
# usual
TAKE_TIMEOUT_MIN = int(_MB.get("take_timeout_min", 60))
# these only mean the letter appeared on some session's screen, not that anyone took it on
# if the resumed context exceeds this, dispatch a new one (with the whole thread)
SEEN_VIA = ("session-start", "prompt", "post-tool", "inbox", "show")
WAKE_PICKUP_MIN = CONVERSATION_WAIT_MIN   # a woken session not told by then: its route ends, and it is woken-missed
