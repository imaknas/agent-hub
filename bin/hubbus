class Refused(Exception):
    """A command refused, with the reason for whoever ran it: the CLI exits with it, the outbox import reports it to
    the project."""


def refuse(msg: str):
    raise Refused(msg)


def now() -> datetime.datetime:
    return datetime.datetime.now().astimezone().replace(microsecond=0)


def iso(t: datetime.datetime | None = None) -> str:
    return (t or now()).isoformat()


def log(msg: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(f"[{now():%Y-%m-%d %H:%M:%S}] {msg}\n")


def db(timeout: float = 30) -> sqlite3.Connection:
    if DB == hubconf.BUS_DIR / "bus.db":
        hubconf.bus_db()   # moves it here from where it used to be
    DB.parent.mkdir(parents=True, exist_ok=True)
    c = sqlite3.connect(DB, timeout=timeout, isolation_level=None)
    c.row_factory = sqlite3.Row
    c.execute(f"PRAGMA busy_timeout={int(timeout * 1000)}")
    c.execute("PRAGMA journal_mode=WAL")
    c.executescript(SCHEMA)
    if not c.execute("SELECT 1 FROM meta WHERE key='generation'").fetchone():   # a read first: readers take no write lock
        c.execute("INSERT OR IGNORE INTO meta(key, value) VALUES('generation', ?)", (secrets.token_hex(8),))
    return c


def view_db(project: str) -> sqlite3.Connection:
    """A sandboxed project's own mailbox, from the view the platform writes into its folder: an in-memory database
    with the bus's tables, so every reader (inbox, thread, open_questions, the checks send makes) works on it
    unchanged. Missing (the platform hasn't written it yet): empty."""
    c = sqlite3.connect(":memory:", isolation_level=None)
    c.row_factory = sqlite3.Row
    c.executescript(SCHEMA)
    ws = hubconf.workspace(project)
    try:
        data = json.loads(nofollow.read(ws, VIEW, VIEW_CAP) or b"{}") if ws else {}
    except (OSError, ValueError) as e:
        refuse(_("hubbus: cannot read {project}'s mailbox view ({e}); the platform writes it again within a minute",
                 project=project, e=e))
    for e in data.get("events") or []:
        c.execute("INSERT OR IGNORE INTO events(seq, id, ts, type, source, to_project, ref, payload)"
                  " VALUES(:seq, :id, :ts, :type, :source, :to_project, :ref, :payload)", e)
    return c


def mail_db(project: str | None) -> sqlite3.Connection:
    """Where this project's mail is read: its view when it goes through an outbox, else the bus."""
    return view_db(project) if outboxed(project) else db()


SCHEMA = """
    CREATE TABLE IF NOT EXISTS events(
      seq INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT UNIQUE NOT NULL, ts TEXT NOT NULL,
      type TEXT NOT NULL, source TEXT NOT NULL, to_project TEXT, ref TEXT,
      payload TEXT NOT NULL DEFAULT '{}');
    CREATE INDEX IF NOT EXISTS events_type_to ON events(type, to_project);
    CREATE INDEX IF NOT EXISTS events_ref ON events(ref);
    CREATE TABLE IF NOT EXISTS cursors(consumer TEXT PRIMARY KEY, seq INTEGER NOT NULL, updated TEXT);
    -- presence (not events: updated on every hook, not in the log): which session is in which project, cwd, last
    -- activity
    CREATE TABLE IF NOT EXISTS presence(session TEXT PRIMARY KEY, project TEXT NOT NULL, cwd TEXT, seen TEXT NOT NULL);
    -- meta.generation: a random id fixed when this file is created; a reader's cursor (event jobs) is only valid for
    -- the generation it was taken in (a corrupt file moved aside starts a new one, seq from 1 again)
    CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value TEXT NOT NULL);
    """


def publish(c, eid, etype, source, to_project=None, ref=None, payload=None) -> bool:
    """Return whether it's new (if the same id already exists, nothing happens). Written from inside a scheduled run
    (AGENT_HUB_JOB_CHAIN set), the event carries that run's chain: event jobs never trigger themselves through it."""
    body = {"v": 1, **(payload or {})}  # contract: contracts/hubbus.v1.schema.json
    if chain := event_jobs.chain_from_env(os.environ):
        given = body.get("chain") if isinstance(body.get("chain"), list) else []
        body["chain"] = list(dict.fromkeys([*given, *chain]))
        body["depth"] = max(event_jobs.depth_of({"payload": body}) if given else 0,
                            event_jobs.depth_from_env(os.environ) or len(chain))
    cur = c.execute("INSERT OR IGNORE INTO events(id, ts, type, source, to_project, ref, payload) VALUES(?,?,?,?,?,?,?)",
                    (eid, iso(), etype, source, to_project, ref, json.dumps(body, ensure_ascii=False)))
    return cur.rowcount == 1


def cursor(c, consumer) -> int:
    r = c.execute("SELECT seq FROM cursors WHERE consumer=?", (consumer,)).fetchone()
    return r["seq"] if r else 0


def set_cursor(c, consumer, seq) -> None:
    c.execute("INSERT INTO cursors(consumer, seq, updated) VALUES(?,?,?) ON CONFLICT(consumer)"
              " DO UPDATE SET seq=excluded.seq, updated=excluded.updated", (consumer, seq, iso()))


def payload(r) -> dict:
    return json.loads(r["payload"] or "{}")


# ---------- addresses ----------

def projects() -> dict[str, pathlib.Path]:
    out = {hubconf.hub_project(): HUB}
    for name in hubconf.projects():
        ws = hubconf.workspace(name)
        if ws:
            out[name] = ws
    return out


def canon(addr: str) -> str:
    return KNAS if addr in OWNERS else addr


def outboxed(project: str | None) -> bool:
    """Whether this project's mail goes through its outbox (policy.mail_outbox: its sessions are sandboxed)."""
    return bool(project) and policy.mail_outbox(hubconf.projects().get(project))


def project_of(cwd: pathlib.Path) -> str | None:
    """Which project cwd belongs to: a sandboxed project's folder by path alone; otherwise git's main checkout
    (worktrees and .agent-memory count as the main project), then path-prefix matching. The main checkout is read from
    the .git pointer files (gitdirs), not asked of git: a hook runs this as the user, and the repo's config can hang
    even rev-parse. In a sandboxed project's folder those pointer files are the project's to write: a `gitdir:` naming
    another project's repo would make its session that project's (its mail delivered, its presence recorded)."""
    paths = {}
    for name, p in projects().items():
        try:
            paths[p.resolve()] = name
        except OSError:
            pass
    try:
        here = cwd.resolve()
    except OSError:
        return None
    for p in (here, *here.parents):
        if p in paths and outboxed(paths[p]):
            return paths[p]
    found = gitdirs.dirs(cwd)
    candidates = [found.common.parent] if found else []
    candidates.append(cwd.resolve())
    for cand in candidates:
        for p in (cand, *cand.parents):
            if p in paths:
                return paths[p]
    return None


# subcommands that change the bus: an agent in a platform-sends-for-it job (propose) may never run them (see
# platform_mails())
RELAYS = {"bridge", "dispatch", "reconcile-questions"}
WRITES = {"send", "done", "ack", "publish", "record-publish", "bridge", "dispatch", "reconcile-questions"}
PLATFORM_MAILS_ENV = "HUB_MAIL_BY_PLATFORM"   # set by bin/propose_apply.py for the agent it starts
# what it looks like when it's really started (this hub's absolute path + the mailbox subcommand); matching only the
# name would also count commands that mention it in quotes (e.g. a commit message)
PROPOSE_CMD = re.compile(rf"(?:^|\s){re.escape(str(HUB / 'bin' / 'propose_apply.py'))}\s+mailbox(?:\s|$)")


def platform_mails() -> str | None:
    """Whether this process is inside an "agent proposes, platform applies" job (bin/propose_apply.py): in that kind
    of job the letters to send and things to close are sent by the platform from the agent's output; an agent sending
    by itself would bypass the guarantee that it may only reply to the original sender and that the platform sets the
    sender. Two ways to tell (either one means yes): the environment variable propose_apply sets; propose_apply.py
    among the ancestor processes (can't be dodged by clearing the environment or changing the working directory)."""
    if os.environ.get(PLATFORM_MAILS_ENV):
        return _("environment variable")
    pid = os.getppid()
    for _i in range(40):
        if pid <= 1:
            return None
        try:
            r = subprocess.run(["ps", "-o", "ppid=,command=", "-p", str(pid)], capture_output=True, text=True)
        except OSError:
            # the tool's sandbox doesn't allow running ps (setuid), and can only see processes in the same sandbox
            # anyway: same as "can't see that process", leaving only the environment variable check
            return None
        ppid, _sep, cmd = r.stdout.strip().partition(" ")
        if r.returncode != 0 or not ppid.strip().isdigit():
            return None
        if PROPOSE_CMD.search(cmd):
            return _("parent process")
        pid = int(ppid)
    return None


def valid_address(a: str) -> bool:
    return a in OWNERS or a in projects()


# ---------- letters (the projection of message) ----------

def new_id() -> str:
    return f"m{now():%m%d%H%M}-{secrets.token_hex(2)}"


def get_message(c, mid):
    return c.execute("SELECT * FROM events WHERE id=? AND type='message'", (mid,)).fetchone()


# ---------- Principal Handoff 0.3 records (docs/design/principal-handoff-0.3-migration.md, stage 3) ----------
# Bus event type "record", payload {"v": 1, "record": <the 0.3 record as is>}. To the assistant: source = project,
# to_project = owner; from the assistant: source = owner, to_project = project (renamed ones followed to their
# current name; the record itself is unchanged).
# Event id = rec:<ext>:<project>:<record id> (core's dedup scope is (ext, project, id)), so a resend is a no-op.
KEY_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")   # a core 0.3 key
RECORD_REQUIRED = ("ph", "ext", "id", "type", "origin", "by", "key", "project", "ts")


def record_event_id(rec: dict) -> str:
    return f"rec:{rec['ext']}:{rec['project']}:{rec['id']}"


def record_errors(rec) -> list[str]:
    """Only checks core's required fields and the version (full schema validation is the receiver's job)."""
    if not isinstance(rec, dict):
        return [_("not a JSON object")]
    errs = [_("missing {k}", k=k) for k in RECORD_REQUIRED if not rec.get(k)]
    if rec.get("ph") and rec["ph"] not in ph_wire.READ:
        errs.append(_("ph is {ph!r}, must be one of {versions}", ph=rec["ph"], versions=", ".join(ph_wire.READ)))
    return errs


def task_key(project: str, text: str) -> str:
    """The key of a task a project sends without one: same text, same task. Never the registrar's `task-` prefix
    (acts 0.4 §6.1): a key a project assigns outside STATE.md must not pass for one the registrar raised from a line."""
    return f"ask-{project}-{hashlib.sha1(' '.join(text.split()).encode()).hexdigest()[:10]}"


def need_state(c, project: str, key: str, family: str = "acts") -> dict | None:
    """The need register of one item this project raised (core §6): {terms: the latest terms, rev: their terms_rev,
    current: the current need record}; None when it was never raised."""
    recs = [r["record"] for r in records(c, project, None, ("raised", "amended", "withdrawn"), direction="out")
            if r["record"].get("key") == key and ph_wire.family(r["record"].get("ext")) == family]
    with_terms = [r for r in recs if r.get("terms")]
    if not with_terms:
        return None
    when = lambda r: (r.get("ts", ""), r.get("id", ""))   # noqa: E731
    latest = max(with_terms, key=lambda r: (r.get("terms_rev", 1), *when(r)))
    replaced = {s for r in recs for s in r.get("supersedes", [])}
    current = max([r for r in recs if r["id"] not in replaced] or recs, key=when)
    raised = min((r for r in recs if r.get("type") == "raised"), key=when, default=None)
    return {"terms": latest["terms"], "rev": latest.get("terms_rev", 1), "current": current,
            "by": (raised or {}).get("by")}


def send_record(c, a, sender: str, mid: str, p: dict) -> str | None:
    """Translate what send mails to the owner into an Acts or Decisions record (direction one's mapping table); for
    what neither covers, return None (sent as a v1 letter as usual). A task sent again under the key of one this
    project raised before is that item: changed terms → amended (terms_rev + 1), the same terms → nothing new."""
    if a.type == "question" or a.question:
        return send_decision(c, a, sender, mid, p)
    kind = "raised" if a.type in ("task", "request") else \
        "claimed" if a.type == "done" and a.task else "withdrawn" if a.type == "drop" and a.task else None
    if kind is None:
        return None
    key = (a.id or task_key(sender, a.text)) if kind == "raised" else a.task
    if not KEY_RE.match(key):
        refuse(_("hubbus: {key!r} is not a valid task key", key=key))
    rec = {"ph": ph_wire.SEND, "ext": ph_wire.ACTS, "type": kind, "key": key, "project": sender, "ts": iso()}
    need = need_state(c, sender, key)
    if kind == "raised" and need:
        terms = {"text": " ".join(a.text.split()), **({"due": a.due} if a.due else {})}
        if terms == {k: v for k, v in need["terms"].items() if k in ("text", "due")}:
            return record_event_id(need["current"])
        if need["by"] == hubconf.party("registrar"):   # acts 0.4 §4: a STATE.md item changes only through its line
            refuse(_("hubbus: {key} is a to-do in STATE.md; change its line there (the registrar sends the change)",
                     key=key))
        rec |= {"type": "amended", "id": f"a:{key}:{need['rev'] + 1}", "origin": "requester",
                "by": hubconf.party("requester", sender), "terms": terms, "terms_rev": need["rev"] + 1,
                "supersedes": [need["current"]["id"]]}
    elif kind == "raised":
        rec |= {"id": f"r:{key}", "origin": "requester", "by": hubconf.party("requester", sender),
                "terms": {"text": " ".join(a.text.split()), **({"due": a.due} if a.due else {})}, "terms_rev": 1}
        if a.new_reason:
            # much like a recently closed one, but really new: the assistant then doesn't merge them
            rec["note"] = a.new_reason
    elif kind == "claimed":
        rec |= {"id": f"c:{key}:{mid}", "origin": "agent", "by": hubconf.party("agent", sender), "outcome": "done",
                "evidence": {"basis": a.text}}
    else:
        # drop --task = this project doesn't need it: the assistant keeps it and asks the owner (other projects' needs
        # aren't affected)
        rec |= {"id": f"w:{key}:{mid}", "origin": "requester", "by": hubconf.party("requester", sender),
                "reason": "not_needed", "note": a.text, **({"supersedes": [need["current"]["id"]]} if need else {})}
    if a.context:
        rec["context"] = a.context
    return publish_record(c, rec, sender, OWNER_ADDRESS)[0]


EXT_DECISIONS = ph_wire.DECISIONS


def send_decision(c, a, sender: str, mid: str, p: dict) -> str | None:
    """A question to the owner and how it ends, as Decisions records: question → raised (key = the letter id, the one
    --question names later; the assistant keeps it under that id), done --question → claimed with the answer, then
    withdrawn (settled), drop --question → withdrawn (not needed). A reply in an asks thread stays a v1 letter: asks
    is outside 0.3 and the assistant ties it back by handoff_id."""
    if p.get("handoff_id") is not None:
        return None
    base = {"ph": ph_wire.SEND, "ext": EXT_DECISIONS, "project": sender, "ts": iso()}
    asker = {"origin": "requester", "by": hubconf.party("requester", sender)}
    if a.type == "question":
        if not KEY_RE.match(mid):
            refuse(_("hubbus: {key!r} is not a valid question id", key=mid))
        rec = base | asker | {"id": f"r:{mid}", "type": "raised", "key": mid,
                              "terms": {"text": a.text, **({"due": a.due} if a.due else {})}, "terms_rev": 1}
        recs = [rec]
    elif a.type == "done":
        recs = [base | {"id": f"c:{a.question}:{mid}", "type": "claimed", "key": a.question, "origin": "agent",
                        "by": hubconf.party("agent", sender), "outcome": "decided",
                        "evidence": {"basis": _("answered in a session of {project}", project=sender)},
                        "answer": {"text": a.text}},
                base | asker | {"id": f"w:{a.question}:{mid}", "type": "withdrawn", "key": a.question,
                                "reason": "settled"}]
    else:
        recs = [base | asker | {"id": f"w:{a.question}:{mid}", "type": "withdrawn", "key": a.question,
                                "reason": "not_needed", "note": a.text}]
    need = need_state(c, sender, a.question, "decisions") if a.type != "question" else None
    for r in recs:
        if a.context:
            r["context"] = a.context
        if need and r["type"] == "withdrawn":
            r["supersedes"] = [need["current"]["id"]]   # core §6: a withdrawal names the need it replaces
    extra = {"from_session": p["from_session"]} if p.get("from_session") else None
    eids = [publish_record(c, r, sender, OWNER_ADDRESS, extra)[0] for r in recs]
    return mid if a.type == "question" else eids[0]   # a question: the id --question takes later


def question_asked(c, key: str) -> dict | None:
    """The question to the owner with this key: the v1 letter (key = its id) or the Decisions raised record.
    {id: key, event, project, ts, text, from_session}; None when there is none."""
    r = c.execute("SELECT * FROM events WHERE type='message' AND id=?", (key,)).fetchone()
    if r is not None and r["to_project"] in OWNERS and payload(r).get("type") == "question":
        return _question(r, key, payload(r).get("text"))
    suffix = f":r:{key}"
    for r in c.execute("SELECT * FROM events WHERE type='record' AND id LIKE 'rec:decisions/%' "
                       "AND substr(id, -length(?)) = ? ORDER BY seq", (suffix, suffix)):
        rec = payload(r).get("record") or {}
        if r["to_project"] in OWNERS and rec.get("type") == "raised" and rec.get("key") == key:
            return _question(r, key, (rec.get("terms") or {}).get("text"))
    return None


def _question(r, key: str, text) -> dict:
    return {"id": key, "event": r["id"], "project": canon(r["source"]), "ts": r["ts"], "text": text or "",
            "from_session": payload(r).get("from_session")}


def publish_record(c, rec: dict, source: str, to_project: str, extra: dict | None = None,
                   ref: str | None = None) -> tuple[str, bool]:
    """extra goes on the event beside the record, never into it: routing (from_session, to_session) and, for an
    answer, the question it answers."""
    eid = record_event_id(rec)
    return eid, publish(c, eid, "record", source, to_project, ref, {"record": rec, **(extra or {})})


def records(c, project, ext=None, types=None, pending=False, direction=None) -> list[dict]:
    """This project's records, both directions, oldest first: {id: event id, ts, direction: out (project to the
    assistant) | in (from the assistant), done, record}. The registrar works out the latest terms/terms_rev from the
    out raised/amended ones and knows which keys were withdrawn: the bus is its record."""
    owners = tuple(OWNERS)
    marks = ",".join("?" * len(owners))
    out = []
    for r in c.execute(f"""SELECT m.*, EXISTS(SELECT 1 FROM events x WHERE x.type='message.done' AND x.ref=m.id) AS done
                           FROM events m WHERE m.type='record'
                             AND ((m.to_project=? AND m.source IN ({marks})) OR (m.source=? AND m.to_project IN ({marks})))
                           ORDER BY m.seq""", (project, *owners, project, *owners)):
        rec = payload(r).get("record") or {}
        d = "in" if r["to_project"] == project else "out"
        if (ext and rec.get("ext") != ext) or (types and rec.get("type") not in types) or (pending and r["done"]) \
                or (direction and d != direction):
            continue
        item = {"id": r["id"], "ts": r["ts"], "direction": d, "done": bool(r["done"]), "record": rec}
        if payload(r).get("question"):
            item["question"] = payload(r)["question"]   # an answer: what was asked
        out.append(item)
    return out


def fmt_record(r, long=True) -> str:
    """A record as a session can read it: which item, who decided, what authority."""
    rec = payload(r).get("record") or {}
    family, kind = rec.get("ext", "?").split("/")[0], rec.get("type", "?")
    what = {"acts": _("task"), "decisions": _("question")}.get(family, family)
    head = _("[{id}] from {source} ({tags}, {ts})", id=r["id"], source=r["source"], tags=f"{family} {kind}",
             ts=r["ts"][5:16].replace("T", " "))
    lines = []
    if family == "decisions" and payload(r).get("question"):
        lines.append(_("Question: {text}", text=payload(r)["question"]))
    if kind == "settled":
        auth = rec.get("authority") or {}
        lines.append(_("{what} {key}: {outcome} ({kind}, decided by {decider})", what=what, key=rec.get("key"),
                       outcome=rec.get("outcome"), kind=auth.get("kind", "?"), decider=auth.get("decider", "?")))
        if (rec.get("answer") or {}).get("text"):
            lines.append(_("Answer: {text}", text=rec["answer"]["text"]))
    elif kind == "reopened":
        lines.append(_("{what} {key} reopened: {text}", what=what, key=rec.get("key"), text=rec.get("restore_text", "")))
    elif kind == "note":
        about = rec.get("about") or {}
        lines.append(_("About {subject}", subject=about.get("key") or _("“{quote}”", quote=str(about.get("quote", "")))))
    elif kind == "related":
        lines.append(_("{what} {key}: {text}", what=what, key=rec.get("key"), text=rec.get("relation")))
    elif (rec.get("terms") or {}).get("text"):
        lines.append(_("{what} {key}: {text}", what=what, key=rec.get("key"), text=rec["terms"]["text"]))
    if rec.get("note"):
        lines.append(rec["note"])
    if family == "decisions" and kind == "settled":
        lines.append(_("Carry on with it, then `agenthub done {id}`; without a done, librarian applies it to STATE.md "
                       "tonight.", id=r["id"]))
    elif kind in ("settled", "reopened", "related"):
        lines.append(_("(librarian updates the to-dos in STATE.md from it tonight; during the day it is for reference only)"))
    if not long:
        return _("- {head}: {text}", head=head, text=lines[0][:100] if lines else "")
    return f"- {head}\n" + "\n".join("  " + l for l in lines)


def get_event(c, eid):
    """A letter or a record (for done, show)."""
    return c.execute("SELECT * FROM events WHERE id=? AND type IN ('message','record')", (eid,)).fetchone()


def must_message(c, mid):
    r = get_message(c, mid)
    if r is None:
        refuse(_("hubbus: no letter {mid}", mid=mid))
    return r


def is_done(c, mid) -> bool:
    return c.execute("SELECT 1 FROM events WHERE type='message.done' AND ref=?", (mid,)).fetchone() is not None


INBOX_SQL = """
SELECT m.*, EXISTS(SELECT 1 FROM events d WHERE d.type='message.delivered' AND d.ref=m.id) AS delivered
FROM events m
WHERE m.type IN ('message','record') AND m.to_project=?
  AND NOT EXISTS(SELECT 1 FROM events x WHERE x.type='message.done' AND x.ref=m.id)
ORDER BY m.seq"""


def inbox(c, project, session=None, only_new=False):
    """Letters to this project not done yet. A reply addressed to a particular session waits for that session a
    while first."""
    cutoff = iso(now() - datetime.timedelta(minutes=REPLY_WAIT_MIN))
    rows = []
    for r in c.execute(INBOX_SQL, (project,)).fetchall():
        if only_new and r["delivered"]:
            continue
        to_s = payload(r).get("to_session")
        if to_s and to_s != session and r["ts"] >= cutoff:
            continue
        rows.append(r)
    return rows


def mark_delivered(c, rows, session, via) -> None:
    # a channel-lease session (the runner sets HUBBUS_LEASE=1): letters still go into the context so the discuss lease
    # sees them, but aren't marked delivered: a read-only discuss lease can't handle a request, and mustn't block the
    # 12-hour escalation
    if os.environ.get("HUBBUS_LEASE") and via in ("session-start", "prompt", "post-tool"):
        return
    for r in rows:
        publish(c, f"{r['id']}:delivered:{session or via}", "message.delivered", r["to_project"], r["to_project"],
                r["id"], {"session": session, "via": via})


def take_state(c, mid, to_project=None):
    """Who has taken this letter on: "taken" (a session acked it, the platform dispatched it, or held it) / the last
    time it was seen (only seen) / None (never delivered).
    10-27: a letter a hook delivered into a session busy with something else went unhandled: delivered doesn't mean
    someone took it on (m10270201-921a)."""
    if to_project and c.execute("SELECT 1 FROM events WHERE type='message' AND ref=? AND source=?",
                                (mid, to_project)).fetchone():
        # the receiving project already replied (replied but not done yet still means someone is handling it)
        return "taken"
    seen = None
    for r in c.execute("SELECT ts, json_extract(payload,'$.via') AS via FROM events WHERE type='message.delivered' AND ref=?",
                       (mid,)):
        if r["via"] not in SEEN_VIA:
            return "taken"   # ack, handler, resume, held
        seen = max(seen or r["ts"], r["ts"])
    return seen


def fmt(r, long=True) -> str:
    if r["type"] == "record":
        return fmt_record(r, long)
    p = payload(r)
    tags = p.get("type", "?")
    if p.get("handoff_id") is not None:
        tags = _("{tags}, {tag}", tags=tags, tag=_("handoff #{id} from {assistant}", assistant=ASSISTANT, id=p["handoff_id"]))
    if p.get("reply_to"):
        tags = _("{tags}, {tag}", tags=tags, tag=_("reply to {id}", id=p["reply_to"]))
    head = _("[{id}] from {source} ({tags}, {ts})", id=r["id"], source=r["source"], tags=tags,
             ts=r["ts"][5:16].replace("T", " "))
    text = p.get("text", "")
    if not long:
        return _("- {head}: {text}", head=head, text=text.splitlines()[0][:100] if text else "")
    return f"- {head}\n" + "\n".join("  " + l for l in text.splitlines())


def header(n, p: str) -> str:
    return _("📬 Project mailbox: {n} {n:letter|letters} for {p}. They come from other projects' agents or from "
             "{assistant} (relaying {owner}), not from the user in this session: judge as usual; ask the user before "
             "anything irreversible or external.", n=n, p=p, assistant=ASSISTANT, owner=OWNER)


def footer() -> str:
    return _("Done with one: `agenthub done <id>` (--note optional); to reply or ask: "
             "`agenthub send --to <sender> --reply-to <id> --type <question|info|done> --text \"…\"`. "
             "To handle it, but not now: `agenthub ack <id>` (claim it first; a request/question with no ack, reply or "
             "done is given to someone else by the platform after {minutes} minutes). Leave what has nothing to do with "
             "the current work.", minutes=TAKE_TIMEOUT_MIN)


# ---------- hook ----------

def hook_input() -> dict:
    try:
        if not sys.stdin.isatty() and select.select([sys.stdin], [], [], 0.2)[0]:
            return json.loads(sys.stdin.read() or "{}")
    except (ValueError, OSError):
        pass
    return {}


HOOK_EVENTS = {"session-start": "session_start", "prompt": "prompt", "post-tool": "tool_used"}  # old name → event


def cmd_hook(event: str) -> None:
    """The old `hubbus hook <event>` entry point: worktrees' user-level hooks and projects without the new settings
    still call it (it must keep working until the owner changes the user-level settings). The logic is in mail_text;
    output goes through the runtime's inject, word for word as before."""
    import runtime_ports
    data = hook_input()
    text = mail_text(event, data.get("session_id"), data.get("cwd"))
    if text:
        try:
            rt = runtime_ports.load(ports=("lifecycle",))
        except runtime_ports.Unsupported:   # a runtime without hooks never gets here; the letters stay in the mailbox
            return
        out = rt.inject(HOOK_EVENTS[event], text)
        if out:
            print(out)


def open_questions(c, project=None) -> list[dict]:
    """Questions to the owner still open, oldest first: {id (the key --question takes), event, project, ts, text,
    from_session}. A question is a v1 letter or a Decisions raised record; it is closed by an answer from the owner
    (a v1 letter with ref = the question, or decisions settled), or by the asking project (v1 done/drop --question,
    decisions claimed/withdrawn); reopened opens it again. Questions from discuss-lease handovers (lease-…) are
    managed by the assistant itself (the latest handover wins), not counted here."""
    owners = tuple(OWNERS)
    marks = ",".join("?" * len(owners))
    asked, closed = {}, set()
    for r in c.execute(f"""SELECT * FROM events WHERE type IN ('message','record')
                             AND (to_project IN ({marks}) OR source IN ({marks})) ORDER BY seq""", owners + owners):
        p, to_owner = payload(r), r["to_project"] in OWNERS
        if r["type"] == "message":
            if not to_owner and r["ref"]:
                closed.add(r["ref"])                 # the owner's answer (v1)
            elif to_owner and p.get("question"):
                closed.add(p["question"])            # done/drop --question (v1)
            elif to_owner and p.get("type") == "question":
                asked.setdefault(r["id"], _question(r, r["id"], p.get("text")))
            continue
        rec = p.get("record") or {}
        if not str(rec.get("ext", "")).startswith("decisions/"):
            continue
        key, kind = rec.get("key"), rec.get("type")
        if to_owner and kind == "raised":
            asked.setdefault(key, _question(r, key, (rec.get("terms") or {}).get("text")))
        elif (to_owner and kind in ("claimed", "withdrawn")) or (not to_owner and kind == "settled"):
            closed.add(key)
        elif not to_owner and kind == "reopened":
            closed.discard(key)
    return [q for q in asked.values() if not q["id"].startswith("lease-") and q["id"] not in closed
            and (project is None or q["project"] == project)]


def questions_note(c, project) -> str | None:
    """At session start: this project's questions to the owner that are still open. One settled here must be closed
    with --question, so the assistant knows."""
    qs = open_questions(c, project)
    if not qs:
        return None
    lines = [_("❓ Questions this project asked {owner} that have no answer yet ({n}). If {owner} already answered them "
               "in a session, or they are no longer needed, close them (so {assistant} stops waiting for an answer): "
               '`agenthub send --to {alias} --type done --question <id> --text "how it was resolved"` (`--type drop` '
               "when no longer needed). Leave the ones still to ask.",
               owner=OWNER, n=len(qs), assistant=ASSISTANT, alias=OWNER_ALIAS)]
    lines += [f"- [{q['id']}] {q['ts'][5:16].replace('T', ' ')} {q['text'][:120]}" for q in qs[-5:]]
    return "\n".join(lines)


def reconcile_questions(c, now=None) -> list:
    """Questions open longer than QUESTION_CHECK_DAYS days: send a request to the asking project (the platform's
    dispatch delivers it into an open session, or with nobody there sends a headless agent to judge from memory),
    asking whether it's still needed. The id is fixed (question + which week), so a rerun doesn't resend; returns the
    ids of the letters sent."""
    now = now or datetime.datetime.now(datetime.timezone.utc)
    sent = []
    for r in open_questions(c):
        age = now - datetime.datetime.fromisoformat(r["ts"].replace("Z", "+00:00"))
        if age.days < QUESTION_CHECK_DAYS or not valid_address(r["project"]):
            continue
        mid = f"qcheck-{r['id']}-{(age.days - QUESTION_CHECK_DAYS) // 7}"
        text = _("The question this project asked {owner} on {date} is still open ({assistant} keeps it under "
                 "\"waiting for you\"):\n  [{id}] {text}\nIf it is resolved ({owner} answered it in a session of this "
                 "project, or it is no longer needed), send "
                 "`agenthub send --to {alias} --type done --question {id} --text \"how it was resolved\"` (--type drop "
                 "when no longer needed) and {assistant} closes it. If {owner} still has to answer, send nothing and just "
                 "mark this letter done. If you cannot tell, leave it and mark this letter done too.",
                 date=r["ts"][:10], owner=OWNER, assistant=ASSISTANT, id=r["id"], text=r["text"][:300],
                 alias=OWNER_ALIAS)
        if publish(c, mid, "message", hubconf.hub_project(), r["project"], None,
                   {"type": "request", "text": text, "question_check": r["id"]}):
            sent.append(mid)
    return sent


def mail_text(event: str, session, cwd) -> str | None:
    """The platform's logic: record presence, deliver the letters this session should get, return the text to put
    into the context (None if there's none). event is session-start / prompt / post-tool. Runtime-independent."""
    # no session = no real session is running (onboard/rename also run sync-local-setup.sh with --quiet):
    # do nothing, or letters would be recorded as delivered without any session seeing them
    if not session or not DB.exists():
        return None
    # The platform's own headless model calls (llm.py sets HUB_LLM_POINT, e.g. the hourly login-check) aren't
    # recipients: no letters delivered, no presence recorded. Unblocked, a call run in the hub root inherits
    # agent-hub's SessionStart hook and marks new letters delivered, so dispatch doesn't send anyone (found by a
    # blind review on 10-27; m10250040-50a0 and others were swallowed by login-check). Lease sessions are the exception:
    # a discuss lease must see letters (still not marked delivered, below)
    if os.environ.get("HUB_LLM_POINT") and not os.environ.get("HUBBUS_LEASE"):
        return None
    if event == "post-tool":
        # rate limit: each session checks at most once per POST_TOOL_EVERY_S (the stamp lives in /tmp, not the bus;
        # stopped before querying git)
        stamp = pathlib.Path(os.environ.get("TMPDIR", "/tmp")) / f"hubbus-post-tool-{session}"
        try:
            if time.time() - stamp.stat().st_mtime < POST_TOOL_EVERY_S:
                return None
        except OSError:
            pass
        stamp.touch()
    cwd = cwd or os.getcwd()
    project = project_of(pathlib.Path(cwd))
    if not project:
        return None
    c = db(timeout=HOOK_TIMEOUT_S)
    c.execute("BEGIN IMMEDIATE")
    if not os.environ.get("HUBBUS_LEASE"):  # lease sessions don't count as recipients
        c.execute("INSERT INTO presence(session, project, cwd, seen) VALUES(?,?,?,?) ON CONFLICT(session) DO UPDATE"
                  " SET project=excluded.project, cwd=excluded.cwd, seen=excluded.seen",
                  (session, project, str(cwd), iso()))
    if event == "session-start":
        # session start (including after compaction): deliver all new ones, list one line for each delivered before
        # but not done yet, otherwise they'd be invisible after compaction
        rows = inbox(c, project, session)
        new = [r for r in rows if not r["delivered"]]
        old = [r for r in rows if r["delivered"]]
        mark_delivered(c, new, session, "session-start")
        c.execute("COMMIT")
        hook_view(c, project)
        note = questions_note(c, project)
        if rows:
            parts = [header(len(rows), project), *(fmt(r) for r in new)]
            if old:
                taken = claimed(c, [r["id"] for r in old])
                parts += [_("Delivered before, not done yet:"),
                          *(fmt(r, long=False) + (_(" (the platform is handling it, nothing to do)") if r["id"] in taken
                                                  else "") for r in old)]
            return "\n".join([*parts, footer()] + ([note] if note else []))
        return note
    rows = inbox(c, project, session, only_new=True)
    mark_delivered(c, rows, session, event)
    # Conversation replies to this session that the platform handled by resuming it in the background while it was
    # idle: mention them in a line at its next activity, otherwise it wouldn't know.
    # Forks still running aren't mentioned yet (what they said is brought over once done; otherwise the original
    # session would only know "handled", not the outcome)
    handled, merged = [], {}
    for r in c.execute("""SELECT m.* FROM events m JOIN events d ON d.ref=m.id AND d.type='message.delivered'
        AND json_extract(d.payload,'$.via')='resume' AND json_extract(d.payload,'$.session')=?
        WHERE m.type='message' AND NOT EXISTS(SELECT 1 FROM events s WHERE s.id = m.id || ':delivered:' || ?)""",
                         (session, session)).fetchall():
        finished, summary = fork_result(c, r)
        if finished:
            handled.append(r)
            merged[r["id"]] = summary
    mark_delivered(c, handled, session, event)
    c.execute("COMMIT")
    if rows or handled:
        hook_view(c, project)
    if handled:
        rows = rows + handled
    if rows:
        return "\n".join([header(len(rows), project),
                           *(fmt(r) + ("\n  " + _("(While you were idle the platform handled this letter in a background "
                                                  "branch with your context; nothing more to do.{result})",
                                                  result=("\n  " + merged[r["id"]]) if merged.get(r["id"]) else
                                                  _(" The result is in the reply or the memory notes."))
                                       if r in handled else "") for r in rows), footer()])
    return None


# ---------- bridge: assistant ↔ bus, escalation, cleanup ----------

def handoff_text(h: dict) -> str:
    e = h.get("effect")
    if e in KEYED:
        what = {"done": _("{owner} did", owner=OWNER), "dropped": _("{owner} cancelled", owner=OWNER),
                "already_done": _("{owner} had already done (and sent it once more now)", owner=OWNER),
                "reopened": _("{owner} reopened, after it was closed,", owner=OWNER)}[e]
        return (_("{what} the thing this project was waiting on them for: {item}", what=what, item=h.get("item", ""))
                + (f"\n{h['fact']}" if h.get("fact") else "")
                + "\n" + _("(task {task}; librarian updates the to-dos in STATE.md by key tonight; nothing else to do)",
                           task=h.get("reply_to")))
    if e == "answers":
        return (_("{owner} answered the question this project asked.\nQuestion: {item}\nAnswer: {fact}",
                  owner=OWNER, item=h.get("item", ""), fact=h.get("fact", ""))
                + ("\n" + _("{owner}'s words: {quote}", owner=OWNER, quote=h["quote"]) if h.get("quote") else "")
                + "\n" + _("Carry on with the answer, then `agenthub done <id>` (tells {assistant} that it is closed). "
                           "Without a done, librarian applies the answer to STATE.md tonight and closes it.",
                           assistant=ASSISTANT))
    lines = [_("{owner} told {assistant} something about this project ({effect}):", owner=OWNER, assistant=ASSISTANT,
               effect=h.get("effect", "relevant")),
             _("Fact: {fact}", fact=h.get("fact", ""))]
    if h.get("quote"):
        lines.append(_("{owner}'s words: {quote}", owner=OWNER, quote=h["quote"]))
    lines.append(_("To-do: {item}", item=h.get("item") or _("(none given)")))
    if h.get("why"):
        lines.append(_("Reasoning from {assistant}: {why}", assistant=ASSISTANT, why=h["why"]))
    lines.append(_("To do: librarian applies it to STATE.md tonight (to-dos, related sections) and reports to {assistant} "
                   "that it is closed; no note and no done needed. If it bears on the current work, adjust to it.",
                   assistant=ASSISTANT))
    return "\n".join(lines)


def current_name(proj: str) -> str:
    """What a renamed project is called now (followed all the way through .state/project-renames.json; unchanged if
    never renamed). The assistant's handoffs may still use the old name (e.g. after idea-1 was upgraded and renamed to
    garden-app, handoffs still came addressed to idea-1)."""
    try:
        renames = json.loads((hubconf.STATE / "project-renames.json").read_text())
    except (OSError, ValueError):
        return proj
    seen = set()
    while proj in renames and proj not in seen and (renames[proj] or {}).get("stage") == "done":
        seen.add(proj)
        proj = renames[proj]["new"]
    return proj


def log_once(key: str, msg: str) -> None:
    """Log the same thing only once, until its content changes (the every-minute dispatch mustn't flood the log
    with the same line)."""
    f = hubconf.STATE / f"hubbus-logged-{key}.txt"
    try:
        if f.read_text() == msg:
            return
    except OSError:
        pass
    if msg:  # empty = the issue is gone: just reset the record, don't log an empty line
        log(msg)
    try:
        f.write_text(msg)
    except OSError:
        pass


def asks_text(h: dict) -> str:
    """effect=asks: the owner asks this project something through the assistant (m10261731-817c). Sent as a question
    and handled by dispatch's rules (if someone is typing, wait; otherwise a fork of this project's most recent live
    session answers). A reply must carry --reply-to, so the handoff_id goes back with it."""
    return (_("{owner} asks this project through {assistant} and is waiting for the answer:\n{fact}",
              owner=OWNER, assistant=ASSISTANT, fact=h.get("fact", ""))
            + ("\n" + _("{owner}'s words: {quote}", owner=OWNER, quote=h["quote"]) if h.get("quote") else "")
            + "\n" + _("Reply: `agenthub send --to {alias} --reply-to <this letter's id> --type info --text \"the "
                       'answer"`. Always add --reply-to: the answer and every later addition are each passed on to '
                       "{owner} as written. After answering, `agenthub done <id>`; with only a done and no reply, "
                       "{assistant} reports that this project closed the question without an answer.",
                       alias=OWNER_ALIAS, owner=OWNER, assistant=ASSISTANT))


def assistant_cli(*args) -> subprocess.CompletedProcess:
    return subprocess.run([str(ASSISTANT_CLI), "handoffs", *args], cwd=ASSISTANT_HOME,
                          capture_output=True, text=True, timeout=120)


def import_handoffs(c) -> None:
    if not ASSISTANT_CLI or not ASSISTANT_CLI.exists():
        return
    r = assistant_cli("--json")
    try:
        items = json.loads(r.stdout) if r.returncode == 0 else None
    except ValueError:
        items = None
    if not isinstance(items, list):
        log(_("reading the assistant's handoffs failed (exit {code}): {err}", code=r.returncode, err=r.stderr.strip()[-200:]))
        return
    known, ack, unknown = projects(), [], []
    c.execute("BEGIN IMMEDIATE")
    for h in items:
        if h.get("status", "pending") != "pending":
            continue
        if RECORDS and has_record(h):
            # v2 delivers it (once the assistant acks, v1 stops listing it); taking both would let the
            # librarian/registrar see it twice
            continue
        proj = publish_handoff(c, h, known)
        if proj is None:
            unknown.append(f"#{h.get('id')}→{h.get('project')}")
            continue
        ack.append(str(h.get("id")))
    c.execute("COMMIT")
    log_once("handoffs-unknown", _("Handoffs from {assistant} are addressed to projects not in the roster; left with "
                                   "{assistant}: {items}", assistant=ASSISTANT, items=", ".join(unknown)) if unknown else "")
    # report only after the bus commit; if reporting fails, report next time: the bus's id dedup won't take it twice
    if ack:
        r = assistant_cli("--delivered", *ack)
        if r.returncode != 0:
            log(_("could not tell the assistant they were received (retrying next time): {err}", err=r.stderr.strip()[-200:]))


# Handoffs the assistant also has as 0.3 records (the same rule as its handoff_records.Outbox.records); answers are
# decisions settled
V2_KEYED = ("done", "dropped", "already_done", "reopened", "same_as", "premise", "answers")
V2_NOTES = ("resolves", "changes", "relevant")


def has_record(h: dict) -> bool:
    e = h.get("effect")
    return e in V2_NOTES or (e in V2_KEYED and bool(h.get("reply_to")))


def publish_handoff(c, h: dict, known) -> str | None:
    """Write one handoff as a letter in the project mailbox (fixed id = HANDOFF_ID_PREFIX + handoff id, so rewriting
    is a no-op). Returns the receiving project; None for one it doesn't recognize."""
    hid, proj = h.get("id"), h.get("project")
    orig = get_message(c, h["reply_to"]) if h.get("reply_to") else None
    if orig is not None and orig["source"] in known:
        proj = orig["source"]  # the owner's answer goes back to the asking project
    if proj not in known:
        proj = current_name(proj)
    if proj not in known:
        return None
    if h.get("effect") == "asks":
        # not a handoff to apply into STATE.md (open-handoffs only takes type handoff): a question for the project
        # to answer
        p = {"type": "question", "text": asks_text(h), "handoff_id": hid, "effect": "asks"}
    else:
        p = {"type": "handoff", "text": handoff_text(h), "handoff_id": hid, "effect": h.get("effect"),
             "handoff": {k: h.get(k) for k in ("effect", "fact", "quote", "item", "why", "ts", "reply_to", "task")}}
    if h.get("reply_to"):
        p["reply_to"] = h["reply_to"]
        if orig is not None and payload(orig).get("from_session"):
            p["to_session"] = payload(orig)["from_session"]
    if publish(c, f"{HANDOFF_ID_PREFIX}{hid}", "message", KNAS, proj, h.get("reply_to"), p):
        log(_("handoff #{id} from {assistant} → {project}", assistant=ASSISTANT, id=hid, project=proj))
    return proj


def to_assistant(c, ev) -> dict | None:
    """Whether this event goes to the assistant; if so, return the item to POST."""
    p = payload(ev)
    if ev["type"] == "message" and ev["to_project"] in OWNERS:
        item = {"id": ev["id"], "project": ev["source"], "type": TO_MUNINN.get(p.get("type"), "progress"),
                "text": p.get("text") or _("(no content)")}
        if p.get("handoff_id") is not None:
            item["handoff_id"] = p["handoff_id"]
        for k in TASK_FIELDS:
            if p.get(k):
                item[k] = p[k]
        return item
    if ev["type"] == "message.done":
        m = get_message(c, ev["ref"])
        if m is not None and payload(m).get("handoff_id") is not None:
            hid = payload(m)["handoff_id"]
            if payload(m).get("effect") == "asks":
                # asked by the assistant for the owner: the assistant tells the owner the first item carrying this
                # handoff_id as the answer, so a closing "handled" must not become the answer
                replied = c.execute("SELECT 1 FROM events WHERE type='message' AND ref=? AND source=?",
                                    (m["id"], m["to_project"])).fetchone()
                if replied:
                    return None   # the reply already took the answer over
                if p.get("note"):
                    return {"id": ev["id"], "project": m["to_project"], "type": "progress", "text": p["note"],
                            "handoff_id": hid}   # no reply; the answer is in the done's note
                return {"id": ev["id"], "project": m["to_project"], "type": "done", "handoff_id": hid,
                        "text": _("(this project closed the question without answering it)")}
            return {"id": ev["id"], "project": m["to_project"], "type": "done",
                    "text": p.get("note") or _("handled"), "handoff_id": hid}
    return None


def post_assistant(items) -> tuple[int | None, str | None]:
    try:
        token = INGEST_TOKEN.read_text().strip()
    except OSError as e:
        return None, _("cannot read the ingest token: {e}", e=e)
    body = json.dumps({"messages": items}, ensure_ascii=False).encode()
    req = urllib.request.Request(ASSISTANT_API, data=body, method="POST",
                                 headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            ok = json.loads(resp.read() or b"{}").get("ok")
        return 200, None if ok else _("the assistant answered ok=false")
    except urllib.error.HTTPError as e:
        return e.code, f"HTTP {e.code}"
    except (urllib.error.URLError, OSError, ValueError) as e:
        return None, str(e)[:200]


RECORDS_OUT = "records-out"   # cursor: how far the records to the owner have been sent (bridge v2)


def records_http(method: str, path: str, body=None, query=None) -> tuple[int | None, dict | None, str | None]:
    """The assistant's /api/records (records.v2): same host and token as /api/messages. Returns (HTTP status, JSON,
    error)."""
    try:
        token = INGEST_TOKEN.read_text().strip()
    except OSError as e:
        return None, None, _("cannot read the ingest token: {e}", e=e)
    u = urllib.parse.urlsplit(ASSISTANT_API)
    url = f"{u.scheme}://{u.netloc}{path}" + (f"?{urllib.parse.urlencode(query)}" if query else "")
    data = json.dumps(body, ensure_ascii=False).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return resp.status, json.loads(resp.read() or b"{}"), None
    except urllib.error.HTTPError as e:
        return e.code, None, f"HTTP {e.code}"
    except (urllib.error.URLError, OSError, ValueError) as e:
        return None, None, str(e)[:200]


def forward_records(c) -> None:
    """Outbound: records to the owner are sent to the assistant in batches. Each status is checked: invalid records
    job.failed, no retry (a resend would be just as invalid); if it can't be sent, the whole batch stays where it is
    and is resent next time (the assistant dedups by (ext, project, id))."""
    # catch up all the way in one go (when the switch is first turned on, the bus already holds thousands of other
    # events)
    while True:
        start = cursor(c, RECORDS_OUT)
        evs = c.execute("SELECT * FROM events WHERE seq > ? ORDER BY seq LIMIT 500", (start,)).fetchall()
        if not evs:
            return
        recs = [ev for ev in evs if ev["type"] == "record" and ev["to_project"] in OWNERS]
        if recs:
            code, data, err = records_http("POST", "/api/records", {"records": [payload(ev)["record"] for ev in recs]})
            if code != 200 or not isinstance(data, dict):
                log_once("records-out", _("records could not be sent to {assistant} ({err}); {n} to resend next time",
                                          assistant=ASSISTANT, err=err or code, n=len(recs)))
                return
            log_once("records-out", "")
            by_id = {ev_rec_id(ev): ev for ev in recs}
            for res in data.get("results") or []:
                ev = by_id.get(res.get("id"))
                if ev is not None and res.get("status") == "invalid":
                    reject(c, ev, "; ".join(map(str, res.get("errors") or [])) or "invalid")
                elif ev is not None and res.get("status") == "unsupported":
                    log(_("{ext} is not supported by {assistant}: {id} accepted but not handled", assistant=ASSISTANT,
                          ext=payload(ev)["record"].get("ext"), id=ev["id"]))
            log(_("sent {n} {n:record|records} to {assistant}", assistant=ASSISTANT, n=len(recs)))
        set_cursor(c, RECORDS_OUT, evs[-1]["seq"])


def ev_rec_id(ev) -> str:
    return (payload(ev).get("record") or {}).get("id")


def pull_names() -> dict[str, str]:
    """Project names to pull → the name used when writing into the bus: every project, plus names from before a
    rename (the assistant may still send under the old name)."""
    current = projects()
    names = {p: p for p in current}
    try:
        renames = json.loads((hubconf.STATE / "project-renames.json").read_text())
    except (OSError, ValueError):
        renames = {}
    for old in renames:
        if old not in names and current_name(old) in current:
            names[old] = current_name(old)
    return names


def incoming_errors(rec, asked: str) -> list[str]:
    errs = record_errors(rec)
    if not errs and rec.get("project") != asked:
        errs = [_("project is {project}, but {asked} was pulled", project=rec.get("project"), asked=asked)]
    if not errs and rec.get("origin") != "principal":
        errs = [_("origin is {origin}: what the assistant sends is always principal", origin=rec.get("origin"))]
    return errs


def answer_routing(c, rec: dict) -> tuple[dict | None, str | None]:
    """For a Decisions record from the owner: back to the session that asked (as v1 answers did), with the question
    beside it; ref = the question's event, so the thread holds together."""
    if not str(rec.get("ext", "")).startswith("decisions/"):
        return None, None
    q = question_asked(c, rec.get("key") or "")
    if q is None:
        return None, None
    extra = {"question": q["text"]} | ({"to_session": q["from_session"]} if q["from_session"] else {})
    return extra, q["event"]


def pull_records(c) -> None:
    """Inbound: pull the assistant's records for each project, write them as record events (sender owner), ack only
    after the commit. The first time after the switch is turned on (no project has a cursor yet) only sets the
    starting point: what v1 already delivered isn't taken again; names that appear later (new projects, renames) are
    read from the start, or what's queued for them on the assistant's side would be skipped. An ack that can't be sent
    is made up next time."""
    switch_on = c.execute("SELECT 1 FROM cursors WHERE consumer LIKE 'records-in:%' LIMIT 1").fetchone() is None
    for name, proj in pull_names().items():
        got, acked = f"records-in:{name}", f"records-ack:{name}"
        row = c.execute("SELECT seq FROM cursors WHERE consumer=?", (got,)).fetchone()
        known = row is not None or not switch_on
        after = row["seq"] if row else 0
        while True:
            code, data, err = records_http("GET", "/api/records", query={"project": name, "after": str(after)})
            if code != 200 or not isinstance(data, dict):
                log_once(f"records-in-{name}", _("pulling {assistant}'s records for {project} failed: {err}",
                                                 assistant=ASSISTANT, project=name, err=err or code))
                break
            log_once(f"records-in-{name}", "")
            page, nxt = data.get("records") or [], int(data.get("cursor") or after)
            c.execute("BEGIN IMMEDIATE")
            refused = []
            if known:
                for rec in page:
                    if (errs := incoming_errors(rec, name)):
                        refused.append(_("record {id!r} from {assistant} for {project} refused: {errors}",
                                         assistant=ASSISTANT, id=(rec or {}).get("id") if isinstance(rec, dict) else rec,
                                         project=name, errors="; ".join(errs)))
                        continue
                    publish_record(c, rec, OWNER_ADDRESS, proj, *answer_routing(c, rec))
            if refused:
                # never past a record not taken in: the cursor and the ack stay before this page, so it comes again
                # (the ones taken are deduplicated) until the reason is fixed, instead of being lost
                c.execute("COMMIT")
                log_once(f"records-refused-{name}", "; ".join(refused))
                break
            log_once(f"records-refused-{name}", "")
            set_cursor(c, got, nxt)
            if not known:
                set_cursor(c, acked, nxt)   # starting point: earlier ones came via v1, not acked here
            c.execute("COMMIT")
            if not page or nxt <= after:
                break
            after = nxt
        cur, done = cursor(c, got), cursor(c, acked)
        if known and cur > done:
            code, _data, err = records_http("POST", "/api/records/ack", {"project": name, "through": cur})
            if code == 200:
                set_cursor(c, acked, cur)
            else:
                log_once(f"records-ack-{name}", _("ack to {assistant} for {project} through {cur} failed: {err}; "
                                                  "retrying next time", assistant=ASSISTANT, project=name, cur=cur, err=err or code))


def forward(c) -> None:
    start = cursor(c, BRIDGE)
    evs = c.execute("SELECT * FROM events WHERE seq > ? ORDER BY seq LIMIT 200", (start,)).fetchall()
    if not evs:
        return
    items = [(ev, it) for ev in evs if (it := to_assistant(c, ev))]
    last = evs[-1]["seq"]
    if items:
        code, err = post_assistant([it for _ev, it in items])
        if code == 400:
            # the whole batch was refused: send one by one to find the invalid item. A 400 can also mean the
            # assistant hasn't deployed support for this type yet (e.g. the night task was added), so within
            # POISON_HOURS stop at this item and resend next time; skip it only after that
            for ev, it in items:
                code1, err1 = post_assistant([it]) if len(items) > 1 else (code, err)
                if err1 is None:
                    continue
                if code1 == 400 and now() - datetime.datetime.fromisoformat(ev["ts"]) > datetime.timedelta(hours=POISON_HOURS):
                    reject(c, ev, err1)
                    continue
                # stop just before this item and resend from here next time (resending ids that went through is
                # safe)
                set_cursor(c, BRIDGE, ev["seq"] - 1)
                age = (now() - datetime.datetime.fromisoformat(ev["ts"])).total_seconds() / 3600
                if age < 0.3 or int(age * 4) % 16 == 0:  # log once at the start, then about every 4 hours
                    log(_("sending to the assistant failed ({err}); {id} and the ones after it are resent next time (waited "
                          "{age:.1f} h)", err=err1, id=ev["id"], age=age))
                return
        elif err is not None:
            age = (now() - datetime.datetime.fromisoformat(items[0][0]["ts"])).total_seconds() / 3600
            # don't flood the log every 15 minutes: once at the start, then about every 4 hours
            if age < 0.3 or int(age * 4) % 16 == 0:
                log(_("sending to the assistant failed ({n} waiting, oldest {age:.1f} h): {err}", n=len(items), age=age, err=err))
            return
        else:
            log(_("sent {n} to the assistant", n=len(items)))
    set_cursor(c, BRIDGE, last)


def reject(c, ev, err) -> None:
    """An item the assistant says is malformed: recorded as job.failed (visible on the status page) and skipped,
    without blocking the ones after it."""
    log(_("the assistant refused {id} ({err}); skipped", id=ev["id"], err=err))
    publish(c, f"{ev['id']}:rejected", "job.failed", "hubbus-bridge", None, ev["id"],
            {"job": "hubbus-bridge", "detail": _("the assistant refused {type} {id}: {err}", type=ev["type"], id=ev["id"], err=err)})


def claimed(c, ids) -> set[str]:
    """Letters the platform has already taken on (dispatched someone / resumed in the background / held)."""
    if not ids:
        return set()
    q = ",".join("?" * len(ids))
    return {r[0] for r in c.execute(
        f"SELECT ref FROM events WHERE type='message.delivered' AND ref IN ({q})"
        " AND json_extract(payload,'$.via') IN ('handler','resume','held')", list(ids))}


def claim(c, rows, via, **extra) -> None:
    for r in rows:
        publish(c, f"{r['id']}:delivered:{via}", "message.delivered", r["to_project"], r["to_project"], r["id"],
                {"session": extra.get("session"), "via": via, **extra})


def thread_chain(c, r) -> list:
    """The whole thread of this letter, following reply_to back (oldest first)."""
    chain, seen = [r], {r["id"]}
    while payload(chain[0]).get("reply_to"):
        o = get_message(c, payload(chain[0])["reply_to"])
        if o is None or o["id"] in seen:
            break
        chain.insert(0, o)
        seen.add(o["id"])
    return chain


def platform_rounds(c, chain) -> int:
    ids = [m["id"] for m in chain]
    q = ",".join("?" * len(ids))
    return c.execute(f"SELECT COUNT(DISTINCT ref) FROM events WHERE type='message.delivered' AND ref IN ({q})"
                     " AND json_extract(payload,'$.via') IN ('handler','resume')", ids).fetchone()[0]


def runs_today(c, proj) -> int:
    return c.execute("SELECT COUNT(DISTINCT json_extract(payload,'$.run')) FROM events WHERE type='message.delivered'"
                     " AND to_project=? AND ts >= ? AND json_extract(payload,'$.via') IN ('handler','resume')",
                     (proj, iso()[:10])).fetchone()[0]


def lease_ids() -> set[str]:
    try:
        return set(json.loads((hubconf.STATE / "lease-runner" / "leases.json").read_text()))
    except (OSError, ValueError):
        return set()


def active_sessions(c, proj, live) -> list[str]:
    cutoff = iso(now() - datetime.timedelta(minutes=CONVERSATION_WAIT_MIN))
    return [r["session"] for r in c.execute("SELECT session FROM presence WHERE project=? AND seen >= ?", (proj, cutoff))
            if r["session"] in live]


def session_cwd(c, sid):
    r = c.execute("SELECT cwd FROM presence WHERE session=?", (sid,)).fetchone()
    return pathlib.Path(r["cwd"]) if r and r["cwd"] and pathlib.Path(r["cwd"]).is_dir() else None


# The prompts of the background branch copies (templates/prompts/<name>.md): a reply reaching an idle session (resume)
# and a request handed to the session that used the project last (delegate)
RESUME_PROMPT, DELEGATE_PROMPT = "mailbox-resume", "mailbox-delegate"


def branch_prompt(r, prompt=None) -> str:
    """The prompt a background branch copy gets for letter r, filled when it is sent (the content language of now)."""
    return prompts.render(prompt or RESUME_PROMPT, letter=fmt(r), id=r["id"])


def recent_session(c, proj, live) -> str | None:
    """The live session with recent activity in this project (within FORK_RECENT_H; lease sessions don't record
    presence)."""
    cutoff = iso(now() - datetime.timedelta(hours=FORK_RECENT_H))
    for r in c.execute("SELECT session FROM presence WHERE project=? AND seen >= ? ORDER BY seen DESC", (proj, cutoff)):
        if r["session"] in live:
            return r["session"]
    return None


def fork_result(c, r) -> tuple[bool, str]:
    """The outcome of a background fork handling this letter: (finished or not, the fork's last reply + the letters it
    sent for this one). Finished = has a result, the letter is closed, or timed out."""
    out = hubconf.STATE / "mailbox" / f"resume-{r['id']}.log"
    text = ""
    try:
        for line in reversed(out.read_text(errors="replace").splitlines()):
            if line.startswith("{"):
                text = str(json.loads(line).get("result") or "").strip()
                break
    except (OSError, ValueError):
        pass
    replies = [m for m in c.execute("SELECT * FROM events WHERE type='message' AND ref=? ORDER BY seq", (r["id"],))
               if payload(m).get("reply_to") == r["id"]]
    done = c.execute("SELECT 1 FROM events WHERE type='message.done' AND ref=?", (r["id"],)).fetchone() is not None
    claimed_at = c.execute("SELECT ts FROM events WHERE type='message.delivered' AND ref=? "
                           "AND json_extract(payload,'$.via')='resume' ORDER BY seq DESC", (r["id"],)).fetchone()
    stale = claimed_at is not None and claimed_at["ts"] < iso(now() - datetime.timedelta(minutes=RESUME_TIMEOUT_MIN))
    parts = []
    if text:
        parts.append(_("The branch's reply: {text}", text=text[:800]))
    parts += [_("Letter the branch sent [{id}] → {to}: {text}", id=m["id"], to=m["to_project"],
                text=payload(m).get("text", "")[:300]) for m in replies]
    return bool(text or done or stale), "\n  ".join(parts)


CONFINED_TYPES = ("manifest.update", "task", "drop")


def confined_refusal(a, here) -> str | None:
    """A confined run (AGENT_HUB_CONFINED, set by llm.py for settings: platform points, i.e. event-triggered agent jobs
    that anyone who can write the bus can start) uses the mail commands only as its own project, for its own letters:
    no other sender, no registry rewrite (manifest.update), no owner to-dos, no other project's mailbox."""
    if not os.environ.get("AGENT_HUB_CONFINED"):
        return None
    if getattr(a, "sender", None) and a.sender != here:
        return _("hubbus: a confined run sends only as its own project (no --from)")
    if getattr(a, "id", None) and a.cmd == "send":
        # ids are idempotency keys: a chosen one could take an id another writer will use (<id>:done)
        return _("hubbus: a confined run can't choose a letter id (--id)")
    if a.cmd == "send" and (a.type in CONFINED_TYPES or getattr(a, "task", None)):
        return _("hubbus: a confined run can't send {type} (registry changes and the owner's to-dos need a person)",
                 type=a.type)
    if a.cmd in ("inbox", "open-questions") and getattr(a, "project", None) and a.project != here:
        return _("hubbus: a confined run reads only its own project's mailbox")
    if a.cmd in ("publish", "record-publish", "bridge", "dispatch", "reconcile-questions"):
        return _("hubbus: a confined run can't use {cmd}", cmd=a.cmd)
    return None


def confined_letter(r, here, boxed: bool = False) -> None:
    """A confined run touches only letters to or from its own project (show, thread, ack, done); so does a sandboxed
    project's letter (boxed), whose reply carries the original's handoff and session."""
    if boxed and here not in (r["to_project"], r["source"]):
        refuse(_("hubbus: {id} is not a letter to or from {project}", id=r["id"], project=here))
    if os.environ.get("AGENT_HUB_CONFINED") and here not in (r["to_project"], r["source"]):
        refuse(_("hubbus: a confined run reads only its own project's letters"))


def chain_env(rows) -> dict:
    """The environment for a handler of these letters: the chain of the runs that sent them, so what the handler
    publishes stays in that chain although it isn't the run's child process (event-jobs.md section 7)."""
    evs = [{"payload": payload(r)} for r in rows]
    chain = event_jobs.run_chain("", evs)[:-1]
    env = {k: v for k, v in os.environ.items() if k not in (event_jobs.CHAIN_ENV, event_jobs.DEPTH_ENV)}
    if chain:
        env[event_jobs.CHAIN_ENV] = json.dumps(chain, ensure_ascii=False)
        env[event_jobs.DEPTH_ENV] = str(max(event_jobs.depth_of(e) for e in evs))
    return env


def run_handler(c, proj, ws, rows) -> None:
    """Delegation: dispatch a headless agent in that project (templates/prompts/mailbox.md, filled by prompts.render;
    judgment point mailbox-escalation)."""
    st = AGENT_JOBS / f"mailbox-{proj}" / "status.json"
    try:
        if json.loads(st.read_text()).get("state") == "running":
            return  # one at a time per project; these letters are dispatched next round
    except (OSError, ValueError):
        pass
    if runs_today(c, proj) >= DAILY_RUNS:
        log(_("{project}: already dispatched {max} {max:time|times} today; {n} {n:letter waits|letters wait} (visible "
              "on the status page)",
              project=proj, max=DAILY_RUNS, n=len(rows)))
        return
    run = f"h{now():%m%d%H%M%S}-{secrets.token_hex(2)}"
    c.execute("BEGIN IMMEDIATE")
    claim(c, rows, "handler", run=run)
    c.execute("COMMIT")
    if (hubconf.get("mailbox") or {}).get("handler") == "propose":
        # agent proposes, platform applies (bin/propose_apply.py; docs/design/tool-agnostic.md): any agent can run it,
        # in a throwaway worktree; the platform only takes the memory notes and sends the letters on its behalf. Runs
        # in the background; it writes status.json itself (running → done), one at a time per project
        log_f = AGENT_JOBS / f"mailbox-{proj}" / "propose.log"
        log_f.parent.mkdir(parents=True, exist_ok=True)
        with log_f.open("a") as f:
            subprocess.Popen([sys.executable, str(HUB / "bin" / "propose_apply.py"), "mailbox", proj, *[r["id"] for r in rows]],
                             stdout=f, stderr=f, start_new_session=True, env=chain_env(rows))
        log(_("{project}: dispatched an agent (propose) for {n} {n:letter|letters} ({ids}, {run})", project=proj, n=len(rows),
              ids=", ".join(r["id"] for r in rows), run=run))
        return
    # the platform's template (no personal names) with this machine's names and content language filled in
    prompt = AGENT_JOBS / f"mailbox-{proj}" / "prompt.md"
    prompt.parent.mkdir(parents=True, exist_ok=True)
    prompt.write_text(prompts.render("mailbox") + "\n")
    res = subprocess.run([str(HUB / "bin" / "run-agent-job.sh"), f"mailbox-{proj}", str(ws), str(prompt)],
                         capture_output=True, text=True, env={**chain_env(rows), "AGENT_JOB_POINT": "mailbox-escalation"})
    log(_("{project}: dispatched a headless agent for {n} {n:letter|letters} ({ids}, {run})", project=proj, n=len(rows),
          ids=", ".join(r["id"] for r in rows), run=run)
        if res.returncode == 0 else
        _("{project}: could not dispatch: {err}", project=proj, err=(res.stderr or res.stdout).strip()[-200:]))


def stale_resumes(c, proj) -> list:
    """Letters resumed in the background, not closed after RESUME_TIMEOUT_MIN and not re-dispatched yet (a failed
    resume mustn't leave a letter stuck)."""
    cutoff = iso(now() - datetime.timedelta(minutes=RESUME_TIMEOUT_MIN))
    return c.execute("""SELECT m.* FROM events m JOIN events d ON d.ref=m.id AND d.type='message.delivered'
        AND json_extract(d.payload,'$.via')='resume' AND d.ts < ?
        WHERE m.type='message' AND m.to_project=?
          AND NOT EXISTS(SELECT 1 FROM events x WHERE x.type='message.done' AND x.ref=m.id)
          AND NOT EXISTS(SELECT 1 FROM events h WHERE h.type='message.delivered' AND h.ref=m.id
                         AND json_extract(h.payload,'$.via') IN ('handler','held'))""", (cutoff, proj)).fetchall()


def resume(c, r, sid, cwd, rt, ws=None, prompt=None) -> None:
    """Conversation: resume with that session's context in the background (a fork; the original session is
    untouched). If it can't be started, dispatch it as a delegation right away."""
    run = f"r{now():%m%d%H%M%S}-{secrets.token_hex(2)}"
    text = branch_prompt(r, prompt)
    c.execute("BEGIN IMMEDIATE")
    claim(c, [r], "resume", session=sid, run=run)
    c.execute("COMMIT")
    out = hubconf.STATE / "mailbox"
    out.mkdir(parents=True, exist_ok=True)
    try:
        with open(out / f"resume-{r['id']}.log", "w") as fh:
            p = subprocess.Popen([sys.executable, str(HUB / "bin" / "llm.py"), "run", "mailbox-conversation",
                                  "--cwd", str(cwd), "--", *rt.resume_args(sid)],
                                 stdin=subprocess.PIPE, stdout=fh, stderr=subprocess.STDOUT, cwd=str(cwd), text=True,
                                 start_new_session=True, env=chain_env([r]))
            p.stdin.write(text)
            p.stdin.close()
    except OSError as e:
        log(_("{project}: {id}: the background resume could not start ({e!r}); delegating instead",
              project=r["to_project"], id=r["id"], e=e))
        run_handler(c, r["to_project"], ws or cwd, [r])
        return
    log(_("{project}: {id} handed to the idle session {session} to resume in the background ({run})",
          project=r["to_project"], id=r["id"], session=sid[:8], run=run))


def hold(c, r) -> None:
    """The platform has already handled too many rounds of this thread: stop handling it, ask the owner."""
    c.execute("BEGIN IMMEDIATE")
    claim(c, [r], "held")
    text = payload(r).get("text", "")
    publish(c, f"{r['id']}:loop", "message", hubconf.hub_project(), KNAS, r["id"],
            {"type": "question", "text": _(
                "The platform has already handled {rounds} rounds of the thread between {a} and {b}; going on may be "
                "the two answering each other without end, so it stops here. Latest letter ({id}): {text}\n"
                "To go on, open a session in one of the projects.",
                a=r["to_project"], b=r["source"], rounds=THREAD_MAX_ROUNDS, id=r["id"], text=text[:300])})
    c.execute("COMMIT")
    log(_("{project}: {id}: this thread has already had {rounds} rounds handled; stopping to ask {owner}",
          project=r["to_project"], id=r["id"], rounds=THREAD_MAX_ROUNDS, owner=OWNER))


def dispatch(c, rt=None) -> int:
    """The platform handles requests/questions nobody took (see the file header). Returns the number of letters still
    waiting for a hook."""
    if rt is None:
        import runtime_ports  # the runtime is only reached through the interface (Claude Code is one implementation)
        try:
            rt = runtime_ports.load(ports=("agent", "sessions"))
        except runtime_ports.Unsupported as e:
            # no coding agent (runtime.default: none): no agent dispatched, letters stay in the mailbox for a person
            # (a session opening, or the owner side, sees them); the reason is logged once, not every minute
            log_once("dispatch-unsupported", _("mailbox delegation dispatches no agent: {e}", e=e))
            return 0
        log_once("dispatch-unsupported", "")
    live, leases = rt.live_sessions(), lease_ids()
    wait_cut = iso(now() - datetime.timedelta(minutes=CONVERSATION_WAIT_MIN))
    take_cut = iso(now() - datetime.timedelta(minutes=TAKE_TIMEOUT_MIN))
    waiting = 0
    for proj, ws in projects().items():
        if not ws.is_dir():
            continue
        delegate = []
        for r in c.execute(INBOX_SQL, (proj,)).fetchall():
            p = payload(r)
            if p.get("type") not in ACTIONABLE:
                continue
            if r["delivered"]:
                st = take_state(c, r["id"], r["to_project"])
                if st == "taken":
                    continue
                if st and st >= take_cut:   # just delivered into a session: give it time to ack, reply or done
                    waiting += 1
                    continue
                log(_("{project}: {id} sat in a session for over {minutes} {minutes:minute|minutes} with no ack, reply "
                      "or done; treating it as not taken and dispatching again", project=proj, id=r["id"], minutes=TAKE_TIMEOUT_MIN))
            if platform_rounds(c, thread_chain(c, r)) >= THREAD_MAX_ROUNDS:
                hold(c, r)
                continue
            to_s = p.get("to_session")
            # conversation: a reply to some session (lease sessions aren't resumed; treated as a delegation)
            if to_s and to_s not in leases:
                if to_s in live and r["ts"] >= wait_cut:
                    waiting += 1
                    continue
                tokens = rt.context_size(to_s)
                if tokens is not None and tokens <= RESUME_MAX_TOKENS and runs_today(c, proj) < DAILY_RUNS:
                    resume(c, r, to_s, session_cwd(c, to_s) or ws, rt, ws)
                    continue
                # context too large or no transcript found → treat it as a delegation (the handler reads the whole
                # thread with hubbus thread)
            elif active_sessions(c, proj, live) and r["ts"] >= wait_cut:  # someone is using the project: theirs first
                waiting += 1
                continue
            else:
                # delegation: a live session with recent activity in this project → handled in a background fork with
                # its context (owner's trial since 10-26, m10261706), which can answer about what that session has on
                # hand; none, context too large, or today's quota used up → headless agent
                sid = recent_session(c, proj, live)
                tokens = rt.context_size(sid) if sid else None
                if tokens is not None and tokens <= RESUME_MAX_TOKENS and runs_today(c, proj) < DAILY_RUNS:
                    resume(c, r, sid, session_cwd(c, sid) or ws, rt, ws, prompt=DELEGATE_PROMPT)
                    continue
            delegate.append(r)
        delegate += stale_resumes(c, proj)  # background resume failed or never closed: re-dispatch
        # agent-hub's letters too (they used to be left for its dedicated session; with nobody typing, nobody took
        # them, m10261706)
        if delegate:
            run_handler(c, proj, ws, delegate)
    return waiting


# ---------- sandboxed projects' outboxes and views (docs/design/bus-sender.md) ----------

def take_outboxes(c) -> None:
    """Every sandboxed project's outbox → the bus, sent by that project. Each file is read without following a link or
    waiting on a FIFO, at most OUTBOX_CAP, oldest name first, checked like the command it stands for with the outbox's
    project as the sender (a sender named in the file is never read), and deleted once it is in; one that is
    malformed or refused is never applied: it is reported to the project in a letter and deleted too. A bus that is
    busy leaves the file for the next run."""
    for proj, ws in projects().items():
        if not outboxed(proj) or not ws.is_dir():
            continue
        try:
            names = nofollow.entries(ws, OUTBOX) or []
        except OSError as e:
            log_once(f"outbox-{proj}", _("{project}: cannot read its outbox: {e}", project=proj, e=e))
            continue
        for name in sorted(n for n in names if not n.startswith("."))[:OUTBOX_RUN]:
            rel = f"{OUTBOX}/{name}"
            try:
                raw = nofollow.read(ws, rel, OUTBOX_CAP)
                if raw is None:
                    continue
                entry = json.loads(raw)
                c.execute("BEGIN IMMEDIATE")
                try:
                    take(c, proj, entry)
                except BaseException:
                    c.execute("ROLLBACK")
                    raise
                c.execute("COMMIT")
            except sqlite3.Error:
                raise
            except (OSError, ValueError, TypeError, Refused) as e:
                outbox_refused(c, proj, name, str(e) or type(e).__name__)
            try:
                nofollow.remove(ws, rel)
            except OSError as e:
                log_once(f"outbox-{proj}-{name}", _("{project}: cannot delete {name} from its outbox: {e}",
                                                      project=proj, name=name, e=e))


def own_session(c, project: str, session) -> str | None:
    """A session id named in an outbox file, only when the hooks saw that session in this project (presence is
    written outside the sandbox): a reply to it is resumed in that session, so another project's must never pass."""
    if not isinstance(session, str):
        return None
    r = c.execute("SELECT project FROM presence WHERE session=?", (session,)).fetchone()
    return session if r and r["project"] == project else None


def _strings(entry: dict, keys) -> None:
    for k in keys:
        if entry.get(k) is not None and not isinstance(entry[k], str):
            refuse(_("hubbus: {key} must be text", key=k))


def take(c, proj: str, entry) -> None:
    """One outbox entry into the bus (inside the caller's transaction): send, ack, done or publish, as proj."""
    if not isinstance(entry, dict) or entry.get("v") != 1:
        refuse(_("hubbus: not an outbox entry (an object with v 1)"))
    session = own_session(c, proj, entry.get("session"))
    op = entry.get("op")
    if op == "send":
        _strings(entry, ("id", *(k for k in SEND_FIELDS if k != "inferred")))
        if not OUTBOX_ID.match(entry.get("id") or ""):
            refuse(_("hubbus: a letter id from an outbox has the form m<MMDDhhmm>-<12 hex digits>"))
        if entry.get("type") not in TYPES or not entry.get("to") or not entry.get("text"):
            refuse(_("hubbus: a letter needs to, text and a type of {types}", types="/".join(TYPES)))
        a = argparse.Namespace(cmd="send", sender=proj, id=None,
                               **{k: entry.get(k) for k in SEND_FIELDS if k != "inferred"},
                               inferred=entry.get("inferred") is True)
        send_letter(c, a, proj, session, proj, boxed=True, mid=entry["id"])
    elif op in ("ack", "done"):
        ids = entry.get("ids")
        if not isinstance(ids, list) or not 0 < len(ids) <= 50 or not all(isinstance(i, str) for i in ids):
            refuse(_("hubbus: ids must be a list of 1 to 50 letter ids"))
        _strings(entry, ("note",))
        for i in ids:
            r = get_event(c, i) if op == "done" else get_message(c, i)
            if r is None or r["to_project"] != proj:
                refuse(_("hubbus: {id} is not a letter to {project}", id=i, project=proj))
            if op == "ack":
                publish(c, f"{i}:ack:{session or 'outbox'}", "message.delivered", proj, proj, i,
                        {"session": session, "via": "ack"})
            else:
                publish(c, f"{i}:done", "message.done", proj, proj, i,
                        {"note": entry.get("note") or _("handled"), "session": session})
    elif op == "publish":
        if entry.get("type") not in OUTBOX_PUBLISH or not isinstance(entry.get("id"), str) \
                or not EVENT_ID.match(entry["id"]) or not isinstance(entry.get("payload"), dict):
            refuse(_("hubbus: a published event needs an id and a payload, and a type of {types}",
                     types="/".join(OUTBOX_PUBLISH)))
        publish(c, f"outbox:{proj}:{entry['id']}", entry["type"], proj, proj, None, entry["payload"])
    else:
        refuse(_("hubbus: unknown outbox operation {op!r}", op=op))


def outbox_refused(c, proj: str, name: str, why: str) -> None:
    """Tell the project a file in its outbox was not sent (a letter its sessions get through the hooks), once."""
    why = why[:300]
    log(_("{project}: refused {name} from its outbox: {why}", project=proj, name=name, why=why))
    publish(c, f"outbox-refused-{proj}-{hashlib.sha1(name.encode()).hexdigest()[:12]}", "message",
            hubconf.hub_project(), proj, None,
            {"type": "info", "outbox_refused": name,
             "text": _("A file in {project}'s outbox was not sent and has been deleted ({name}): {why}",
                       project=proj, name=name, why=why)})


VIEW_SQL = """
SELECT * FROM events WHERE (type IN ('message','record') AND (to_project=:p OR source=:p))
   OR (type IN ('message.delivered','message.done') AND ref IN
       (SELECT id FROM events WHERE type IN ('message','record') AND (to_project=:p OR source=:p)))
ORDER BY seq"""


def view(c, proj: str) -> dict:
    """A sandboxed project's mailbox: the letters and records to or from it, with what happened to them. Other
    projects' session ids are left out (only a hint to them, and a way in to anyone who could name one)."""
    events = []
    for r in c.execute(VIEW_SQL, {"p": proj}):
        p = payload(r)
        if r["source"] != proj:
            p.pop("from_session", None)
            p.pop("session", None)
        if r["to_project"] != proj:
            p.pop("to_session", None)
        events.append({**dict(r), "payload": json.dumps(p, ensure_ascii=False)})
    return {"v": 1, "project": proj, "events": events}


def write_views(c) -> None:
    for proj, ws in projects().items():
        if outboxed(proj) and ws.is_dir():
            write_view(c, proj, ws)


def write_view(c, proj: str, ws: pathlib.Path) -> None:
    """A sandboxed project's view into its folder, only when it changed; replaced, never written through a link."""
    data = json.dumps(view(c, proj), ensure_ascii=False, sort_keys=True).encode()
    try:
        cur = nofollow.read(ws, VIEW, VIEW_CAP)
    except OSError:
        cur = None
    if cur == data:
        return
    try:
        nofollow.replace(ws, VIEW, data)
        log_once(f"view-{proj}", "")
    except OSError as e:
        log_once(f"view-{proj}", _("{project}: cannot write its mailbox view: {e}", project=proj, e=e))


def hook_view(c, project: str) -> None:
    """The hooks just delivered letters into a sandboxed project's session: its view gets them now, so a reply, ack or
    done the session makes right away finds them (dispatch writes it only once a minute)."""
    ws = hubconf.workspace(project)
    if outboxed(project) and ws and ws.is_dir():
        write_view(c, project, ws)


def mailbox_step(c, step) -> None:
    try:
        step(c)
    except Exception as e:
        if c.in_transaction:
            c.execute("ROLLBACK")
        log(_("dispatch {step} failed: {e!r}", step=step.__name__, e=e))


def dispatch_locked(c, pull=False) -> None:
    """The bridge dispatches too: it takes the same lock as launchd's every-minute run, and skips if it can't get it
    (so the two never dispatch at the same time)."""
    import fcntl
    with open(DB.parent / "dispatch.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return
        mailbox_step(c, take_outboxes)   # before dispatching: a request from a sandboxed project is handled this run
        # also pull handoffs every minute (0.2 s): questions the assistant asks for the owner (asks) needn't wait for
        # the bridge's 15 minutes
        if pull and hubconf.owner_side() == "assistant":
            # with the built-in owner side (builtin) there's no assistant to pull from: records for the owner stay on
            # the bus, and bin/owner.py reads them directly
            try:
                import_handoffs(c)
            except Exception as e:
                if c.in_transaction:
                    c.execute("ROLLBACK")
                log(_("dispatch: pulling handoffs failed: {e!r}", e=e))
            if RECORDS:   # bridge v2: send and pull 0.3 records every minute
                for step in (forward_records, pull_records):
                    try:
                        step(c)
                    except Exception as e:
                        if c.in_transaction:
                            c.execute("ROLLBACK")
                        log(_("dispatch {step} failed: {e!r}", step=step.__name__, e=e))
        try:
            dispatch(c)
        finally:
            mailbox_step(c, write_views)   # after: the view shows what dispatch claimed


def prune(c) -> None:
    """Remove letters closed more than PRUNE_DAYS ago (with their delivered/done) and older job.failed. Anything the
    bridge hasn't read yet is left alone."""
    cutoff, upto = iso(now() - datetime.timedelta(days=PRUNE_DAYS)), cursor(c, BRIDGE)
    c.execute("BEGIN IMMEDIATE")
    old = [r["ref"] for r in c.execute("SELECT ref FROM events WHERE type='message.done' AND ts < ? AND seq <= ?",
                                       (cutoff, upto))]
    for mid in old:
        # only delete this letter and its delivered/done; letters replying to it (ref also points at it) have their
        # own lifecycle
        c.execute("DELETE FROM events WHERE id=? OR (ref=? AND type IN ('message.delivered', 'message.done'))",
                  (mid, mid))
    c.execute("DELETE FROM events WHERE type='job.failed' AND ts < ? AND seq <= ?", (cutoff, upto))
    c.execute("COMMIT")


def check_integrity() -> bool:
    """If it's broken, move it aside and start a new one (letters not yet received are lost; no backup, accepted by
    the owner)."""
    if not DB.exists():
        return True
    try:
        ok = sqlite3.connect(DB, timeout=30).execute("PRAGMA quick_check").fetchone()[0] == "ok"
    except sqlite3.DatabaseError as e:
        ok, why = False, str(e)
    else:
        why = _("quick_check is not ok")
    if ok:
        return True
    dest = DB.with_name(f"bus.db.corrupt-{now():%Y%m%d-%H%M}")
    for suffix in ("", "-wal", "-shm"):
        src = pathlib.Path(str(DB) + suffix)
        if src.exists():
            src.rename(pathlib.Path(str(dest) + suffix))
    log(_("bus.db is broken ({why}); moved it to {name} and started a new one", why=why, name=dest.name))
    return False


def cmd_bridge() -> None:
    check_integrity()
    c = db()
    for step in (import_handoffs, forward, dispatch_locked, prune):
        try:
            step(c)
        except Exception as e:  # one broken step doesn't affect the others
            if c.in_transaction:
                c.execute("ROLLBACK")
            log(_("bridge {step} failed: {e!r}", step=step.__name__, e=e))


def cmd_open_handoffs() -> None:
    """For the librarian: the assistant's handoffs not closed yet, across all projects, in about the same format as
    `muninn handoffs --json` (id is the bus's letter id; once the librarian has applied one and trusts it, it closes
    it with `hubbus done <id>`, and the bridge then reports back to the assistant)."""
    c = db()
    out = []
    owners = sorted(OWNERS)
    for r in c.execute(f"SELECT * FROM events m WHERE m.type='message' AND m.source IN ({','.join('?' * len(owners))})"
                       " AND NOT EXISTS(SELECT 1 FROM events x WHERE x.type='message.done' AND x.ref=m.id) ORDER BY m.seq",
                       owners):
        p = payload(r)
        if p.get("type") != "handoff":
            continue
        # every handoff carries its raw fields; only the first three taken in (10-21) had none, and they are closed
        h = p.get("handoff") or {}
        out.append({"id": r["id"], "project": r["to_project"], "ts": h.get("ts") or r["ts"],
                    "handoff_id": p.get("handoff_id"), "effect": p.get("effect") or h.get("effect") or "relevant",
                    "fact": h.get("fact") or "", "quote": h.get("quote"), "item": h.get("item"), "why": h.get("why") or "",
                    "reply_to": h.get("reply_to") or p.get("reply_to"), "task": h.get("task")})
    print(json.dumps(out, ensure_ascii=False))


def cmd_status(as_json: bool) -> None:
    c = db()
    per: dict[str, dict] = {}
    cutoff = iso(now() - datetime.timedelta(hours=STUCK_HOURS))
    stuck = []
    for proj in sorted(projects()):
        rows = inbox(c, proj)
        if rows:
            new = [r for r in rows if not r["delivered"]]
            per[proj] = {"open": len(rows), "undelivered": len(new), "oldest": rows[0]["ts"]}
            # only letters to handle (request/question) count as stuck; info/progress/done are notifications, and
            # nobody taking them isn't a problem (m10261706)
            stuck += [{"id": r["id"], "to": proj, "ts": r["ts"]} for r in new
                      if r["ts"] < cutoff and payload(r).get("type") in ACTIONABLE]
    items = [ev for ev in c.execute("SELECT * FROM events WHERE seq > ? ORDER BY seq", (cursor(c, BRIDGE),))
             if to_assistant(c, ev)]
    failed = [dict(id=r["id"], ts=r["ts"], **payload(r)) for r in c.execute(
        "SELECT * FROM events WHERE type='job.failed' AND ts > ? ORDER BY seq DESC LIMIT 20",
        (iso(now() - datetime.timedelta(days=1)),))]
    corrupt = sorted(p.name for p in DB.parent.glob("bus.db.corrupt-*") if not p.name.endswith(("-wal", "-shm")))
    out = {"projects": per, "stuck": stuck, "to_muninn": {"n": len(items), "oldest": items[0]["ts"] if items else None},
           "job_failed_24h": failed, "corrupt": corrupt}
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
        return
    for p, st in per.items():
        print(_("{project}: {open} open {open:letter|letters} ({undelivered} of them not yet in a session; oldest "
                "{oldest})",
                project=p, open=st["open"], undelivered=st["undelivered"], oldest=st["oldest"][5:16]))
    if stuck:
        print(_("Unclaimed for over {hours} h (no session took them and the platform did not handle them): {items}", hours=STUCK_HOURS,
                items=_(", ").join(f"{s['id']}→{s['to']}" for s in stuck)))
    if items:
        print(_("Waiting to go to the assistant: {n} (oldest {oldest})", n=len(items), oldest=items[0]["ts"][5:16]))
    for f in failed:
        print(_("job.failed {ts} {job}: {detail}", ts=f["ts"][5:16], job=f.get("job"), detail=f.get("detail", "")[:120]))
    if corrupt:
        print(_("Broken bus.db moved aside: {files}", files=", ".join(corrupt)))


# ---------- the mail commands (the bus, or a sandboxed project's outbox and view) ----------

MAIL_COMMANDS = ("send", "inbox", "show", "thread", "ack", "done", "open-questions", "publish")


def mail_box(a, here) -> str | None:
    """The project whose outbox and view this command uses, or None (the bus): run in a sandboxed project's folder,
    naming no one else (--from/--project/--source absent or that project). A command that names another sender goes
    to the bus as before: with the user's authority (the platform's own processes run in project folders too, e.g. a
    job's llm.py publishing job.failed) it works, inside the sandbox the bus file is not there to write. What a
    project can send as is decided by the sandbox, never by this choice."""
    if not outboxed(here):
        return None
    named = getattr(a, "sender", None) or getattr(a, "project", None) or getattr(a, "source", None)
    return here if named in (None, here) else None


def outbox_id() -> str:
    return f"m{now():%m%d%H%M}-{secrets.token_hex(6)}"


def outbox_put(project: str, entry: dict) -> None:
    """One file in the project's outbox, renamed into place whole (the platform skips the temporary name, which starts
    with a dot); no link in the project's folder followed, whoever runs this."""
    nofollow.replace(hubconf.workspace(project), f"{OUTBOX}/{time.time_ns()}-{secrets.token_hex(4)}.json",
                     json.dumps({"v": 1, **entry}, ensure_ascii=False).encode())


def queued(project: str) -> None:
    print(_("(in {project}'s outbox: the platform sends it within a minute)", project=project), file=sys.stderr)


def send_letter(c, a, sender: str, session, here, boxed: bool = False, mid: str | None = None) -> str:
    """send's checks and write, for the CLI and for a letter taken from a sandboxed project's outbox (boxed: sender =
    that project, never a name in the file; a reply only in its own threads). mid: the letter id (else --id, else a
    new one); --id stays what it is to a task, its key. Returns the id to print."""
    a.to = canon(a.to)
    if not sender or not valid_address(sender) or sender in OWNERS:
        refuse(_("hubbus: cannot tell which project the sender is (outside a project folder add --from <project>)"))
    if not valid_address(a.to):
        refuse(_("hubbus: there is no address {to} (project names are in the project registry, {hub}, or {owners})",
                 to=a.to, hub=hubconf.hub_project(), owners="/".join(sorted(OWNERS))))
    p = {"type": a.type, "text": a.text, "from_session": session}
    if a.type in KNAS_ONLY and a.to != KNAS:
        refuse(_("hubbus: {type} can only be sent to {alias}", type=a.type, alias=OWNER_ALIAS))
    if a.type == "drop" and not (a.task or a.question):
        refuse(_("hubbus: drop needs --task <key> or --question <id> (which task/question is no longer needed)"))
    if a.question:
        if a.task or a.to != KNAS or a.type not in ("done", "drop"):
            refuse(_("hubbus: --question is only for a done/drop sent to {alias} (not together with --task)",
                     alias=OWNER_ALIAS))
        q = question_asked(c, a.question)
        if q is None or q["project"] != sender:
            refuse(_("hubbus: {question} is not a question {sender} asked {owner}", question=a.question,
                     sender=sender, owner=OWNER))
    if a.inferred and not (a.type in ("done", "drop") and a.task):
        refuse(_("hubbus: --inferred is only for a done/drop with --task"))
    for k in TASK_FIELDS:
        if getattr(a, k):
            p[k] = getattr(a, k)
    if a.reply_to:
        orig = must_message(c, a.reply_to)
        confined_letter(orig, here, boxed)   # a reply carries the original's handoff and session
        p["reply_to"] = a.reply_to
        if canon(orig["source"]) == a.to and payload(orig).get("from_session"):
            p["to_session"] = payload(orig)["from_session"]
        if payload(orig).get("handoff_id") is not None:
            p["handoff_id"] = payload(orig)["handoff_id"]
    mid = mid or a.id or new_id()
    if RECORDS and a.to == OWNER_ADDRESS:
        if a.inferred:
            refuse(_("hubbus: an inferred claim is sent by registrar itself (hubbus record-publish); send does not "
                     "translate it"))
        if (eid := send_record(c, a, sender, mid, p)):
            return eid
    publish(c, mid, "message", sender, a.to, a.reply_to, p)  # already sent with the same id: nothing happens
    return mid


def mail_command(a) -> None:
    """send / inbox / show / thread / ack / done / open-questions / publish. For a sandboxed project the reads come
    from its view and the writes go into its outbox, after the same checks against the view that the platform makes
    against the bus when it takes them in."""
    import runtime_ports  # the sending session: ask the runtime (currently an environment variable Claude Code sets)
    session = runtime_ports.current_session()
    here = project_of(pathlib.Path.cwd())
    box = mail_box(a, here)
    if box:
        here = box
    c = view_db(box) if box else db()
    if a.cmd == "publish":
        pl = json.loads(a.payload)
        if box:
            if a.type not in OUTBOX_PUBLISH or (a.to or box) != box or a.ref:
                refuse(_("hubbus: {project} publishes only its own {types} (source and recipient itself, no ref)",
                         project=box, types="/".join(OUTBOX_PUBLISH)))
            if a.id and not EVENT_ID.match(a.id):
                refuse(_("hubbus: {id!r} is not a valid event id", id=a.id))
            outbox_put(box, {"op": "publish", "type": a.type, "id": a.id or outbox_id(), "payload": pl})
            return queued(box)
        publish(c, a.id or f"e{now():%m%d%H%M%S}-{secrets.token_hex(3)}", a.type, a.source, a.to, a.ref, pl)
    elif a.cmd == "send":
        mid = None
        if box:
            # the letter id is picked here; --id only as such an id (a task's key from an outbox is its text's)
            if a.id and not OUTBOX_ID.match(a.id):
                refuse(_("hubbus: a letter id from an outbox has the form m<MMDDhhmm>-<12 hex digits>"))
            mid, a.id = a.id or outbox_id(), None
        out = send_letter(c, a, a.sender or here, session, here, boxed=bool(box), mid=mid)
        if box:
            outbox_put(box, {"op": "send", "id": mid, "session": session, **{k: getattr(a, k) for k in SEND_FIELDS}})
            queued(box)
            out = mid
        print(out)
    elif a.cmd == "inbox":
        project = a.project or here
        if not project:
            refuse(_("hubbus: not in a project folder, add --project <name>"))
        rows = inbox(c, project, session)
        for r in rows:
            print(fmt(r))
        print(_("({project}: {n} open {n:letter|letters})", project=project, n=len(rows)) if rows else
              _("{project}'s mailbox is empty", project=project))
        if project == here and not box:   # a sandboxed session's letters are marked delivered by its hooks
            c.execute("BEGIN IMMEDIATE")
            mark_delivered(c, [r for r in rows if not r["delivered"]], session, "inbox")
            c.execute("COMMIT")
    elif a.cmd == "show":
        r = must_message(c, a.id)
        confined_letter(r, here)
        print(fmt(r))
        for e in c.execute("SELECT * FROM events WHERE ref=? ORDER BY seq", (a.id,)):
            print(f"  {e['ts'][5:16]} {e['type']} {e['payload']}")
    elif a.cmd == "thread":
        r = must_message(c, a.id)
        confined_letter(r, here)
        for r in thread_chain(c, r):
            print(fmt(r))
    elif a.cmd == "open-questions":
        project = canon(a.project) if a.project else None
        if os.environ.get("AGENT_HUB_CONFINED"):   # only its own project's questions
            project = here
        if box:
            project = box
        rows = open_questions(c, project)
        if a.json:
            print(json.dumps([{k: q[k] for k in ("id", "project", "ts", "text")} for q in rows], ensure_ascii=False))
        else:
            for q in rows:
                print(f"[{q['id']}] {q['project']} {q['ts'][:16]} {q['text'][:100]}")
    elif box:   # ack, done: only letters to this project
        for i in a.ids:
            r = get_event(c, i) if a.cmd == "done" else get_message(c, i)
            if r is None or r["to_project"] != box:
                refuse(_("hubbus: {id} is not a letter to {project}", id=i, project=box))
        outbox_put(box, {"op": a.cmd, "ids": a.ids, "session": session,
                         **({"note": a.note} if a.cmd == "done" and a.note else {})})
        queued(box)
        if a.cmd == "done":
            for i in a.ids:
                print(f"{i} done")
    elif a.cmd == "ack":
        c.execute("BEGIN IMMEDIATE")
        # ack = "I've taken it on": recorded separately from the hook's delivery (they used to share an id, so after a
        # hook delivery an ack recorded nothing)
        for i in a.ids:
            r = must_message(c, i)
            confined_letter(r, here)
            publish(c, f"{r['id']}:ack:{session or 'cli'}", "message.delivered", r["to_project"], r["to_project"], r["id"],
                    {"session": session, "via": "ack"})
        c.execute("COMMIT")
    elif a.cmd == "done":
        for i in a.ids:
            # a letter or a record (once the registrar has applied a record, it's done too)
            r = get_event(c, i) or must_message(c, i)
            confined_letter(r, here)
            publish(c, f"{i}:done", "message.done", here or r["to_project"], r["to_project"], i,
                    {"note": a.note or _("handled"), "session": session})
            print(f"{i} done")


# ---------- CLI ----------

def main() -> None:
    try:
        cli()
    except Refused as e:
        sys.exit(str(e))


def cli() -> None:
    ap = argparse.ArgumentParser(prog="hubbus", description=_(
        "agent-hub's event bus: an append-only event log plus read cursors; project mailboxes are its projection."))
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("send")
    s.add_argument("--to", required=True)
    s.add_argument("--type", default="info", choices=TYPES)
    s.add_argument("--text", required=True)
    s.add_argument("--reply-to")
    s.add_argument("--from", dest="sender")
    s.add_argument("--id", help=_("a fixed letter id (sending the same id again does nothing; librarian uses it for tasks)"))
    s.add_argument("--task", help=_("task key (with done/drop: which one)"))
    s.add_argument("--question", help=_("with done/drop: which question this project asked the owner (letter id) was resolved "
                                        "here / is no longer needed"))
    s.add_argument("--due", help="YYYY-MM-DD")
    s.add_argument("--context")
    s.add_argument("--new-reason", help=_("why it is a new task although it looks like one closed in the last 14 days"))
    s.add_argument("--inferred", action="store_true",
                   help=_("done/drop with --task: only inferred (nobody saw the owner do it); the assistant asks the owner before closing"))
    sub.add_parser("inbox").add_argument("--project")
    sub.add_parser("show").add_argument("id")
    sub.add_parser("ack").add_argument("ids", nargs="+")
    d = sub.add_parser("done")
    d.add_argument("ids", nargs="+")
    d.add_argument("--note")
    sub.add_parser("hook").add_argument("event", choices=("session-start", "prompt", "post-tool"))
    sub.add_parser("bridge")
    sub.add_parser("dispatch")
    sub.add_parser("thread").add_argument("id")
    sub.add_parser("open-handoffs")
    oq = sub.add_parser("open-questions")
    oq.add_argument("--project")
    oq.add_argument("--json", action="store_true")
    sub.add_parser("reconcile-questions")
    rq = sub.add_parser("records")
    rq.add_argument("--project", required=True)
    rq.add_argument("--ext")
    rq.add_argument("--type", help=_("comma-separated, e.g. settled,reopened"))
    rq.add_argument("--pending", action="store_true", help=_("only the ones not done yet"))
    rq.add_argument("--direction", choices=("in", "out"))
    # {ph} is there so the text goes through format() and {{…}} prints as braces
    rp = sub.add_parser("record-publish", help=_("stdin: one {ph} record or a list; sent to owner (toward the assistant). "
                                                 "Prints for each {{id: record id, event: event id or null, status}}",
                                                 ph=ph_wire.SEND))
    rp.add_argument("--json", default="-", help=_("only - (stdin) is supported"))
    pb = sub.add_parser("publish")
    # letters have their own command (and records record-publish); config.applied = which config version bin/hub
    # config apply applied. Must be the contract's type enum without those (tests/test_scheduler_events.py checks it):
    # the contract is the list event jobs validate against
    pb.add_argument("type", choices=("job.failed", "merge.done", "merge.failed", "session.report",
                                     "config.applied"))
    pb.add_argument("--source", required=True)
    pb.add_argument("--to")
    pb.add_argument("--ref")
    pb.add_argument("--payload", default="{}")
    pb.add_argument("--id")
    sub.add_parser("status").add_argument("--json", action="store_true")
    a = ap.parse_args()
    if a.cmd in RELAYS:
        # these carry other parties' events (owner answers, dispatch claims, the assistant's records): they are not the
        # scheduled run's own doing, so they don't take the run's chain; dispatch passes each letter's chain on itself
        os.environ.pop(event_jobs.CHAIN_ENV, None)
        os.environ.pop(event_jobs.DEPTH_ENV, None)
    if os.environ.get("AGENT_HUB_CONFINED") and (why := confined_refusal(a, project_of(pathlib.Path.cwd()))):
        sys.exit(why)

    if a.cmd in WRITES and (how := platform_mails()):
        sys.exit(_("hubbus: this is work the platform sends letters for (recognized by the {how}): write the letters "
                   "to send and the things to close in your output; the platform sends them. Sending or closing them "
                   "yourself is not allowed", how=how))
    if a.cmd == "hook":
        try:
            cmd_hook(a.event)
        except Exception as e:  # a broken hook must not affect the session
            log(_("hook {event} failed: {e!r}", event=a.event, e=e))
        return
    if a.cmd == "bridge":
        return cmd_bridge()
    if a.cmd == "dispatch":
        # launchd, every minute (local.agent-hub-mailbox-dispatch); only one at a time (the bridge uses the same
        # lock). Without a bus yet, only when a sandboxed project's outbox may have its first letter
        if DB.exists() or any(outboxed(p) for p in projects()):
            check_integrity()
            dispatch_locked(db(), pull=True)
        return
    if a.cmd == "records":
        c = db()
        types = set(a.type.split(",")) if a.type else None
        print(json.dumps(records(c, canon(a.project), a.ext, types, a.pending, a.direction), ensure_ascii=False))
        return
    if a.cmd == "record-publish":
        c = db()
        data = json.loads(sys.stdin.read() or "null")
        recs = data if isinstance(data, list) else [data]
        out, bad = [], 0
        c.execute("BEGIN IMMEDIATE")
        for r in recs:   # one by one: an invalid one doesn't block the others
            errs = record_errors(r)
            if not errs and not valid_address(r["project"]):
                errs = [_("unknown project {project}", project=r["project"])]
            if not errs and r.get("origin") == "principal":
                errs = [_("a record with origin principal can only come from the assistant (the bridge takes it in); "
                          "projects cannot send one")]
            if errs:
                bad += 1
                out.append({"id": r.get("id") if isinstance(r, dict) else None, "event": None, "status": "invalid",
                            "errors": errs})
                continue
            eid, new = publish_record(c, r, r["project"], KNAS)
            out.append({"id": r["id"], "event": eid, "status": "accepted" if new else "duplicate"})
        c.execute("COMMIT")
        print(json.dumps(out, ensure_ascii=False))
        if bad:
            sys.exit(1)
        return
    if a.cmd == "reconcile-questions":
        c = db()
        c.execute("BEGIN IMMEDIATE")
        sent = reconcile_questions(c)
        c.execute("COMMIT")
        print(_("asked whether {n} {n:question is|questions are} still needed", n=len(sent)) + (_(": {ids}", ids=" ".join(sent)) if sent else ""))
        return
    if a.cmd == "open-handoffs":
        return cmd_open_handoffs()
    if a.cmd == "status":
        return cmd_status(a.json)

    if a.cmd in MAIL_COMMANDS:
        return mail_command(a)


if __name__ == "__main__":
    main()
