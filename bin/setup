#!/usr/bin/env bash
# 新機器第一步(docs/design/new-user.md 2):檢查平台要的指令都在,再建平台的 Python(bin/setup-python)。
# 缺什麼就印怎麼裝,**不自己裝**(用哪個套件管理器是使用者的事)。重跑安全。
#
#   bin/setup            檢查 + 建平台的 Python
#   bin/setup --check    只檢查,不建任何東西(缺必要的就 exit 1)
#
# 下一步:agenthub init(setup 會用 install-cli 把 agenthub 放上 PATH)
set -uo pipefail
HUB="${AGENT_HUB_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
check_only=""; [ "${1:-}" = "--check" ] && check_only=1

missing=0
need() {  # need <指令> <必要|選配> <用來做什麼> <怎麼裝>
  if command -v "$1" >/dev/null 2>&1; then
    printf '  ✓ %-8s %s\n' "$1" "$3"
  elif [ "$2" = 必要 ]; then
    printf '  ✗ %-8s %s——沒有。%s\n' "$1" "$3" "$4"; missing=1
  else
    printf '  - %-8s %s(選配,沒有就不能用這個功能)。%s\n' "$1" "$3" "$4"
  fi
}

echo "agent-hub:檢查需要的指令"
[ "$(uname -s)" = Darwin ] || echo "  ⚠️ 不是 macOS:平台跑得起來,但排程跟背景服務還沒接上(launchd 以外的服務管理器之後做;doctor 會說)"
need git     必要 "版本控制、memory 同步"            "macOS:xcode-select --install"
need jq      必要 "librarian 讀 JSON"               "brew install jq"
need uv      必要 "建平台的 Python(bin/setup-python)" "https://docs.astral.sh/uv/"
[ "$(uname -s)" = Darwin ] && need plutil 必要 "shell 腳本讀 hub.json" "macOS 內建"   # 其他系統用 jq
need claude  選配 "coding agent(Claude Code;沒有的話 hub.json runtime.default 設 none,agent 的功能關掉)" "https://claude.com/claude-code,裝好後 claude 登入一次"
need gh      選配 "onboard 時建 GitHub repo"         "brew install gh && gh auth login"
need restic  選配 "雲端備份(backup 模組)"           "brew install restic"

[ "$missing" = 0 ] || { echo "先把 ✗ 的裝好再跑一次 bin/setup"; exit 1; }
if [ -n "$check_only" ]; then
  "$HUB/bin/setup-python" --check
  exit $?
fi
"$HUB/bin/setup-python" || exit 1
"$HUB/bin/py" "$HUB/bin/agenthub" install-cli || echo "  (agenthub 沒放上 PATH:之後用 bin/py bin/agenthub …)"
echo "下一步:agenthub init"
