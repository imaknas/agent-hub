#!/usr/bin/env bash
# First step on a new machine (docs/design/new-user.md 2): check that the commands the platform needs are there,
# then build the platform's Python (bin/setup-python).
# Whatever is missing, it prints how to install it and **does not install anything itself** (which package manager
# to use is the user's call). Safe to rerun.
#
#   bin/setup            check + build the platform's Python
#   bin/setup --check    check only, build nothing (exit 1 when something required is missing)
#
# Next step: agenthub init (setup puts agenthub on the PATH with install-cli)
set -uo pipefail
HUB="${AGENT_HUB_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
check_only=""; [ "${1:-}" = "--check" ] && check_only=1

missing=0
need() {  # need <command> <required|optional> <what it is for> <how to install>
  if command -v "$1" >/dev/null 2>&1; then
    printf '  ✓ %-8s %s\n' "$1" "$3"
  elif [ "$2" = required ]; then
    printf '  ✗ %-8s %s -- missing. %s\n' "$1" "$3" "$4"; missing=1
  else
    printf '  - %-8s %s (optional; without it this feature cannot be used). %s\n' "$1" "$3" "$4"
  fi
}

echo "agent-hub: checking the commands it needs"
[ "$(uname -s)" = Darwin ] || echo "  ⚠️ not macOS: the platform runs, but scheduling and background services are not wired up yet (service managers other than launchd come later; doctor says so)"
need git     required "version control, memory sync"                "macOS: xcode-select --install"
need jq      required "the librarian reads JSON"                    "brew install jq"
need uv      required "builds the platform's Python (bin/setup-python)" "https://docs.astral.sh/uv/"
[ "$(uname -s)" = Darwin ] && need plutil required "shell scripts read hub.json" "built into macOS"   # other systems use jq
need claude  optional "coding agent (Claude Code; without it set hub.json runtime.default to none and the agent features are off)" "https://claude.com/claude-code, then log in to claude once"
need gh      optional "creates the GitHub repo when onboarding"     "brew install gh && gh auth login"
need restic  optional "cloud backup (backup module)"                "brew install restic"

[ "$missing" = 0 ] || { echo "Install what is marked ✗ first, then run bin/setup again"; exit 1; }
if [ -n "$check_only" ]; then
  "$HUB/bin/setup-python" --check
  exit $?
fi
"$HUB/bin/setup-python" || exit 1
"$HUB/bin/py" "$HUB/bin/agenthub" install-cli || echo "  (agenthub is not on the PATH: use bin/py bin/agenthub … from now on)"
echo "Next step: agenthub init"
