#!/usr/bin/env bash
# First step on a new machine (docs/design/new-user.md 2): check that the commands the platform needs are there,
# then build the platform's Python (bin/setup-python).
# Whatever is missing, it prints how to install it and **does not install anything itself** (which package manager
# to use is the user's call). Safe to rerun.
#
#   bin/setup            check + build the platform's Python
#   bin/setup --check    check only, build nothing (exit 1 when something required is missing)
#
# Next step: agenthub init (setup puts agenthub on the PATH with install-cli)
set -uo pipefail
HUB="${AGENT_HUB_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
check_only=""; [ "${1:-}" = "--check" ] && check_only=1

missing=0
need() {  # need <command> <required|optional> <what it is for> <how to install>
  if command -v "$1" >/dev/null 2>&1; then
    printf '  ✓ %-8s %s\n' "$1" "$3"
  elif [ "$2" = required ]; then
    printf '  ✗ %-8s %s -- missing. %s\n' "$1" "$3" "$4"; missing=1
  else
    printf '  - %-8s %s (optional; without it this feature cannot be used). %s\n' "$1" "$3" "$4"
  fi
}

os=$(uname -s)
# how this system installs a package (only to word the hints; nothing is installed)
if [ "$os" = Darwin ]; then pm="brew install"; command -v brew >/dev/null 2>&1 || pm_note=" (with Homebrew, https://brew.sh; or MacPorts)"
elif command -v apt-get >/dev/null 2>&1; then pm="sudo apt-get install"
elif command -v dnf >/dev/null 2>&1; then pm="sudo dnf install"
elif command -v pacman >/dev/null 2>&1; then pm="sudo pacman -S"
else pm=""; fi
inst() { if [ -n "$pm" ]; then echo "$pm $1${pm_note:-}"; else echo "install $1 with your package manager"; fi; }

echo "agent-hub: checking the commands it needs"
if [ "$os" != Darwin ]; then
  # the same test hubconf.service_manager() makes
  if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    echo "  ✓ systemd  user level: the scheduler, its watchdog and projects' services run as user units (agenthub init installs them)"
  else
    echo "  ⚠️ no service manager (no systemd user level, e.g. a container): nothing runs by itself. agenthub init prints the command to schedule yourself; agenthub run <job> runs one job now"
  fi
fi
need git     required "version control, memory sync"                "$([ "$os" = Darwin ] && echo "xcode-select --install" || inst git)"
need jq      optional "reads hub.json in shell scripts where the platform's Python can't run (the remote machine)" "$(inst jq)"
need uv      required "builds the platform's Python (bin/setup-python)" "https://docs.astral.sh/uv/"
[ "$os" = Darwin ] && need plutil required "shell scripts read hub.json" "built into macOS"   # other systems use jq
need claude  optional "coding agent (Claude Code; without it set hub.json runtime.default to none and the agent features are off)" "https://claude.com/claude-code, then log in to claude once"
need gh      optional "creates the GitHub repo when onboarding"     "$(inst gh), then gh auth login"
need restic  optional "cloud backup (backup module)"                "$(inst restic)"

[ "$missing" = 0 ] || { echo "Install what is marked ✗ first, then run bin/setup again"; exit 1; }
if [ -n "$check_only" ]; then
  "$HUB/bin/setup-python" --check
  exit $?
fi
"$HUB/bin/setup-python" || exit 1
"$HUB/bin/py" "$HUB/bin/agenthub" install-cli || echo "  (agenthub is not on the PATH: use bin/py bin/agenthub … from now on)"
echo "Next step: agenthub init"
