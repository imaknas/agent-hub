#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""清掉已經合併進 main、而且乾淨的 worktree。

  prune-worktrees [--project P]          只列出可以刪的(人用)
  prune-worktrees [--project P] --yes    真的刪,連 branch 一起(人確認過沒有 session 開在裡面)
  prune-worktrees --auto [--dry-run]     每晚的自動清理(平台 job agent-hub/prune-worktrees):
                                         閒置 ≥ 2 天只刪重建得回來的依賴(.venv 等,資料夾留著);
                                         閒置 ≥ 14 天、沒有 process 在裡面、ignore 的檔案都能重建,才移除
                                         worktree(branch 留著)。規則跟理由在 bin/worktrees.py 檔頭
"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import i18n  # noqa: E402
import worktrees  # noqa: E402

_ = i18n.domain(__file__)

args = sys.argv[1:]
if "--auto" in args:
    res = worktrees.auto_prune(dry_run="--dry-run" in args)
    dry = res["dry_run"]
    for line in res["deps"]:
        print(_("Would delete deps: {line}", line=line) if dry else _("Deleted deps: {line}", line=line))
    for line in res["removed"]:
        print(_("Would remove worktree: {line}", line=line) if dry else _("Removed worktree: {line}", line=line))
    for line in res["skipped"]:
        print(_("Skipped: {line}", line=line))
    print(_("Would free {mb} MB in total (dry-run, nothing was touched)", mb=res['freed_mb']) if dry
          else _("Freed {mb} MB in total", mb=res['freed_mb']))
    sys.exit(0)
proj = args[args.index("--project") + 1] if "--project" in args else None
sys.exit(worktrees.prune(proj, "--yes" in args))
