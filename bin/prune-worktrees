#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""Clean up worktrees that are already merged into main and clean.

  prune-worktrees [--project P]          only list what can be deleted (for people)
  prune-worktrees [--project P] --yes    really delete, branch included (a person has checked no session is open in it)
  prune-worktrees --auto [--dry-run]     the nightly automatic cleanup (platform job brunna/prune-worktrees):
                                         idle ≥ 2 days: only delete dependencies that can be rebuilt (.venv etc.,
                                         the folder stays);
                                         idle ≥ 14 days, no process inside, and every ignored file can be rebuilt:
                                         only then remove the worktree (the branch stays). Rules and reasons in the
                                         header of bin/worktrees.py
"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import hubconf  # noqa: E402
import i18n  # noqa: E402
import worktrees  # noqa: E402

_ = i18n.domain(__file__)

args = sys.argv[1:]
if "--auto" in args:
    res = worktrees.auto_prune(dry_run="--dry-run" in args)
    dry = res["dry_run"]
    for line in res["deps"]:
        print(_("Would delete deps: {line}", line=line) if dry else _("Deleted deps: {line}", line=line))
    for line in res["removed"]:
        print(_("Would remove worktree: {line}", line=line) if dry else _("Removed worktree: {line}", line=line))
    for line in res["skipped"]:
        print(_("Skipped: {line}", line=line))
    left = hubconf.prune_private_tmp(dry_run=dry)
    for line in left["removed"]:
        print(_("Would remove a run's leftovers: {line}", line=line) if dry else _("Removed a run's leftovers: {line}", line=line))
    for line in left["cant_tell"]:
        print(_("Kept a run's leftovers: {line}: can't find out whether a process is working in it", line=line))
    for line in left["not_removable"]:
        print(_("Kept a run's leftovers: {line}: something in it can't be removed", line=line))
    if left["unreadable"]:
        print(_("The private temp folder could not be read, nothing pruned there: {why}", why=left["unreadable"]))
    print(_("Would free {mb} MB in total (dry-run, nothing was touched)", mb=res['freed_mb']) if dry
          else _("Freed {mb} MB in total", mb=res['freed_mb']))
    sys.exit(0)
proj = args[args.index("--project") + 1] if "--project" in args else None
sys.exit(worktrees.prune(proj, "--yes" in args))
