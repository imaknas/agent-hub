#!/usr/bin/env bash
# 在 Linux 容器裡跑平台的全部測試(發版前跑;太慢,不在 commit 閘門裡)。需要 docker。
#   bin/linux-test [unittest 的參數…]     例:bin/linux-test tests.test_new_user
# 拿目前的 working tree(版控裡的檔 + 還沒 commit 的改動,不含沒追蹤的檔)複製進容器裡一份新的 git repo 跑,不動這份 checkout。
# 預期:0 failures;只在 macOS 有意義的測試會 skip。
set -euo pipefail
hub="$(cd "$(dirname "$0")/.." && pwd)"
# colima / Docker Desktop 預設只把家目錄掛進 VM:複製到家目錄底下,不用 /tmp
work="${AGENT_HUB_LINUX_TEST_DIR:-$HOME/.cache/agent-hub-linux}"
rm -rf "$work/src" && mkdir -p "$work/src"
(cd "$hub" && git ls-files -z --cached --others --exclude-standard | xargs -0 -I{} sh -c '[ -e "$1" ] && echo "$1"' _ {}) \
  | (cd "$hub" && tar -cf - -T -) | tar -xf - -C "$work/src"
docker build -q -t agent-hub-linux-test -f "$hub/tests/linux/Dockerfile" "$hub/tests/linux" >/dev/null
args=("$@"); [ ${#args[@]} -gt 0 ] || args=(discover -s tests)
docker run --rm -v "$work/src:/src:ro" -e AGENT_HUB_PYTHON=/usr/local/bin/python3 \
  -e GIT_AUTHOR_NAME=t -e GIT_AUTHOR_EMAIL=t@t -e GIT_COMMITTER_NAME=t -e GIT_COMMITTER_EMAIL=t@t agent-hub-linux-test sh -c '
  cp -r /src /tmp/hub && cd /tmp/hub && git init -q -b main && git add -A && git commit -qm linux-test &&
  exec /usr/local/bin/python3 -m unittest "$@"' _ "${args[@]}"
