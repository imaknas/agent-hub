#!/usr/bin/env bash
# Run the platform's full test suite in a Linux container (run before a release; too slow for the commit gate).
# Needs docker.
#   bin/linux-test [unittest arguments…]     e.g. bin/linux-test tests.test_new_user
# Copies the current working tree (tracked files with their uncommitted changes, plus untracked files that are not
# ignored) into a fresh git repo in the container and runs it there, leaving this checkout alone.
# Expected: 0 failures; tests that only make sense on macOS are skipped.
set -euo pipefail
hub="$(cd "$(dirname "$0")/.." && pwd)"
# --init: an init reaps orphans as on a real host (python as PID 1 would leave killed children as zombies)
# colima / Docker Desktop mount only the home directory into the VM by default: copy under home, not /tmp
work="${AGENT_HUB_LINUX_TEST_DIR:-${BRUNNA_LINUX_TEST_DIR:-$HOME/.cache/agent-hub-linux}}"
rm -rf "$work/src" && mkdir -p "$work/src"
(cd "$hub" && git ls-files -z --cached --others --exclude-standard | xargs -0 -I{} sh -c '[ -e "$1" ] && echo "$1"' _ {}) \
  | (cd "$hub" && COPYFILE_DISABLE=1 tar -cf - -T -) | tar -xf - -C "$work/src"   # no macOS ._ files
docker build -q -t agent-hub-linux-test -f "$hub/tests/linux/Dockerfile" "$hub/tests/linux" >/dev/null
args=("$@"); [ ${#args[@]} -gt 0 ] || args=(discover -s tests)
# the tests' temp folder outside the system's, as an install's are (in its private temp area): every sandbox may read
# /tmp, and the sandbox tests probe that the fake hub's state they put in their temp folder can't be read from inside
docker run --rm --init -v "$work/src:/src:ro" -e AGENT_HUB_PYTHON=/usr/local/bin/python3 \
  -e GIT_AUTHOR_NAME=t -e GIT_AUTHOR_EMAIL=t@t -e GIT_COMMITTER_NAME=t -e GIT_COMMITTER_EMAIL=t@t agent-hub-linux-test sh -c '
  cp -r /src /tmp/hub && cd /tmp/hub && git init -q -b main && git add -A && git commit -qm linux-test &&
  mkdir -m 700 "$HOME/tmp" && export TMPDIR="$HOME/tmp" && exec /usr/local/bin/python3 -m unittest "$@"' _ "${args[@]}"
