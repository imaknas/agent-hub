#!/bin/sh
# The platform's command (docs/design/rename-brunna.md). The implementation stays in bin/agenthub, under its name from
# before the rename: install-cli's wrappers, bin/py and the scripts that start each other run that file, and an older
# wrapper names it; this only forwards.
exec "${0%/*}/py" "${0%/*}/agenthub" "$@"
