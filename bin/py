#!/bin/sh
# The platform's Python (minimum 3.13, with PyYAML). All the platform's Python scripts go through here, not through
# whichever python3 happens to be on PATH:
#   - a script's first line: #!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
#     (the macOS kernel splits what follows #! on spaces and ignores quotes, hence ${IFS} instead of spaces; Linux
#     doesn't split this way, so this line only works on macOS)
#   - shell scripts, launchd, the registry's run: call the script directly (relying on the first line), or
#     "$HUB/bin/py" <script>; anything needing -m / -c uses this one too
# Where the environment lives is written only here (hubconf needs Python before it can read hub.json, so this is the one
# exception): AGENT_HUB_PYTHON can override it (used under the tests' fake HOME). Building and checking the environment:
# bin/setup-python.
# The deliberate exception that doesn't go through here: scheduler-watchdog.py (it must still send alerts when the
# platform's Python is broken, so it uses the system's built-in python3).
# the environment's folder under ~/.local/share: whichever spelling exists, this release's when neither does (a copy of
# bin/names.py's share_dir pair, current first; tests/test_name_pairs.py compares it)
NAMES_share_dir="brunna agent-hub"
py="${AGENT_HUB_PYTHON:-${BRUNNA_PYTHON:-}}"
if [ -z "$py" ]; then
  for _n in $NAMES_share_dir; do
    [ -x "$HOME/.local/share/$_n/python/bin/python3" ] && { py="$HOME/.local/share/$_n/python/bin/python3"; break; }
  done
  py="${py:-$HOME/.local/share/${NAMES_share_dir%% *}/python/bin/python3}"
fi
if [ ! -x "$py" ]; then
  echo "agent-hub: the platform's Python was not found ($py); run bin/setup-python once on this machine" >&2
  exit 127
fi
exec "$py" "$@"
