#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""Run a program that needs a "capability" under the platform's profile (e.g. Blender using the GPU): the client.

  hub-run --cap gpu [--timeout seconds] -- blender -b … -P tools/render.py …
  hub-run --wait <id>          reattach to a job still running (or finished), print its output, exit with its exit code
  hub-run --complete <point> [--schema F] < prompt
                               a model call the project declares (registry models: {point: {tier}}); the platform
                               runs it with its own credentials (brunna complete). stdout = the JSON result
                               ({structured_output, result, …}); exit 1 = refused or failed, the reason in llm_error
  hub-run --agent <name> [--schema F] < prompt
                               a confined agent call the project declares (registry agents: {name: {tier, allow,
                               timeout?}}; brunna agent): it runs in the project folder the call is made from (its
                               workspace or runtime folder, never a folder below), with only the declared rules. The
                               job id comes first on stderr; stdout = the JSON result, exit 1 = the run refused or
                               failed (llm_error says why), 124 = stopped at its deadline (the declared timeout plus a
                               minute). docs/design/project-agent-calls.md A

Run in the project folder (or below it). This only writes the request into its own project's `.hub-run/requests/`; the
platform's run service (cap-runner.py, not in the sandbox) checks it before running it, writes the output and exit code
back to `.hub-run/jobs/<id>/`, and this prints them as they come, unchanged. So it works inside the runtime's sandbox
too, asking of the runtime only "can write its own folder". Design: docs/design/capabilities.md.

Which capabilities are allowed: the project registry's enforce.capabilities. Limits on the job: it can only write the
project folder and the temp area, can't read other projects or credentials, has no network (local included), can't open
apps or have another program launch things for it.

It prints the job id first: if this call is interrupted (e.g. a tool call times out), the job keeps running; reattach
with --wait <id>.
Exit codes: the job's own exit code; timeout 124; the run service isn't running or a service restart lost the job 125;
request refused 126; usage error 2.
Standard library only.
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import secrets
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import hubconf  # noqa: E402
import i18n  # noqa: E402

_ = i18n.domain(__file__)

PICKUP_S = 30  # the service restarts itself on an upgrade (launchd waits 10 s); leave a margin


def say(msg: str) -> None:
    print(f"hub-run: {msg}", file=sys.stderr, flush=True)


def find_workspace() -> pathlib.Path | None:
    """The project folder this runs in: its workspace, or its runtime folder (a service's or job's cwd)."""
    cwd = pathlib.Path.cwd().resolve()
    best = None
    services = hubconf.p("services_root")
    for name, doc in hubconf.projects().items():
        for ws in (hubconf.workspace(name), services / name if services and doc.get("runtime") is not None else None):
            if not ws:
                continue
            ws = ws.resolve()
            if (cwd == ws or ws in cwd.parents) and (best is None or len(str(ws)) > len(str(best))):
                best = ws
    return best


def submit(ws: pathlib.Path, cap: str, argv: list[str], timeout: int | None) -> str:
    job_id = f"{time.strftime('%Y%m%d-%H%M%S')}-{secrets.token_hex(3)}"
    req = {"v": 1, "id": job_id, "cap": cap, "argv": argv, "cwd": os.path.relpath(pathlib.Path.cwd().resolve(), ws)}
    if timeout:
        req["timeout_s"] = timeout
    d = ws / ".hub-run" / "requests"
    d.mkdir(parents=True, exist_ok=True)
    tmp = d / f".{job_id}.tmp"  # write a temp file, then rename: the service never reads a half-written request
    tmp.write_text(json.dumps(req, ensure_ascii=False))
    tmp.rename(d / f"{job_id}.json")
    return job_id


def submit_complete(ws: pathlib.Path, point: str, prompt: str, schema: dict | None, kind: str = "complete") -> str:
    """A model call (kind complete: point = the models: name) or an agent call (kind agent: the agents: name)."""
    job_id = f"{time.strftime('%Y%m%d-%H%M%S')}-{secrets.token_hex(3)}"
    req = {"v": 1, "id": job_id, "kind": kind, "point" if kind == "complete" else "name": point, "prompt": prompt}
    if schema is not None:
        req["schema"] = schema
    d = ws / ".hub-run" / "requests"
    d.mkdir(parents=True, exist_ok=True)
    tmp = d / f".{job_id}.tmp"
    tmp.write_text(json.dumps(req, ensure_ascii=False))
    tmp.rename(d / f"{job_id}.json")
    return job_id


class Tail:
    def __init__(self, path: pathlib.Path, out):
        self.path, self.out, self.pos = path, out, 0

    def pump(self) -> None:
        try:
            with self.path.open("rb") as f:
                f.seek(self.pos)
                data = f.read()
        except FileNotFoundError:
            return
        if data:
            self.pos += len(data)
            self.out.write(data)
            self.out.flush()


def follow(ws: pathlib.Path, job_id: str, pickup: bool, agent: bool = False) -> int:
    req = ws / ".hub-run" / "requests" / f"{job_id}.json"
    job = ws / ".hub-run" / "jobs" / job_id
    tails = [Tail(job / "stdout", sys.stdout.buffer), Tail(job / "stderr", sys.stderr.buffer)]
    t0, said_queue = time.time(), False
    while True:
        try:
            st = json.loads((job / "state.json").read_text())
        except (OSError, ValueError):
            st = None
        if st is None:
            if not req.exists():
                say(_("no such job: {job_id}", job_id=job_id))
                return 2
            if pickup and time.time() - t0 > PICKUP_S:
                try:
                    req.unlink()  # a service that starts late won't run a job nobody is waiting for
                except FileNotFoundError:
                    continue  # just got picked up
                say(_("the platform's run service is not running (nobody picked the request up in {secs:g} s), so the "
                      "request was withdrawn. Tell the user that brunna's cap-runner service is not running", secs=PICKUP_S))
                return 125
            time.sleep(0.3)
            continue
        for t in tails:
            t.pump()
        state = st.get("state")
        if state == "queued" and not said_queue:
            say(_("queued (one job at a time per project, with a platform-wide limit)"))
            said_queue = True
        if state == "done":
            for t in tails:
                t.pump()
            if st.get("timed_out") and (agent or st.get("kind") == "agent"):
                say(_("the agent call ran past its deadline (its declared timeout plus a minute) and was stopped; the "
                      "registry's agents.<name>.timeout sets it"))
            elif st.get("timed_out"):
                say(_("timed out; the job was stopped (use --timeout for longer; the limit is {settings} "
                      "cap_runner.max_timeout_s)"))
            return int(st.get("exit", 1))
        if state == "rejected":
            say(_("request rejected: {reason}", reason=st.get('reason', '')))
            return 126
        if state == "lost":
            say(st.get("reason", _("the job was lost")))
            return 125
        time.sleep(0.3)


def main() -> int:
    ap = argparse.ArgumentParser(prog="hub-run",
                                 description=_("Run a program that needs a capability under the platform's profile"))
    ap.add_argument("--cap", help=_("capability name (one of the registry entry's enforce.capabilities)"))
    ap.add_argument("--timeout", type=int, help=_("seconds (default and limit: {settings} cap_runner)"))
    ap.add_argument("--wait", metavar="ID", help=_("reattach to a job"))
    ap.add_argument("--complete", metavar="POINT",
                    help=_("a model call this project declares (registry models:): prompt on stdin, JSON result on stdout"))
    ap.add_argument("--agent", metavar="NAME",
                    help=_("a confined agent call this project declares (registry agents:): prompt on stdin, JSON result "
                           "on stdout"))
    ap.add_argument("--schema", metavar="FILE", help=_("with --complete or --agent: JSON schema the answer must match"))
    ap.add_argument("cmd", nargs=argparse.REMAINDER)
    a = ap.parse_args()
    cmd = a.cmd[1:] if a.cmd[:1] == ["--"] else a.cmd
    ws = find_workspace()
    if not ws:
        say(_("run this inside a registered project folder"))
        return 2
    if a.wait:
        return follow(ws, a.wait, pickup=False)
    if a.complete or a.agent:
        try:
            schema = json.loads(pathlib.Path(a.schema).read_text()) if a.schema else None
        except (OSError, ValueError) as e:
            say(_("cannot read the schema: {err}", err=e))
            return 2
        prompt = sys.stdin.read()
        if not prompt.strip():
            say(_("the prompt (stdin) is empty"))
            return 2
        if a.complete:
            return follow(ws, submit_complete(ws, a.complete, prompt, schema), pickup=True)
        job_id = submit_complete(ws, a.agent, prompt, schema, kind="agent")
        say(_("job {job_id} (agent {name}); if this call is interrupted, the agent keeps running: reattach with "
              "`hub-run --wait {job_id}`", job_id=job_id, name=a.agent))
        return follow(ws, job_id, pickup=True, agent=True)
    if not a.cap or not cmd:
        say(_("usage: hub-run --cap <capability> [--timeout seconds] -- <command…>, or hub-run --wait <id>"))
        return 2
    job_id = submit(ws, a.cap, cmd, a.timeout)
    say(_("job {job_id} (capability {cap}); if this call is interrupted, the job keeps running: reattach with `hub-run "
          "--wait {job_id}`", job_id=job_id, cap=a.cap))
    return follow(ws, job_id, pickup=True)


if __name__ == "__main__":
    sys.exit(main())
