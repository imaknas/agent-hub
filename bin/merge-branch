#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""The merge gate: parallel sessions write in their own worktree/branch and, when done, merge back into main with this
script: the only merge point.

Run in the session's own worktree:
  merge-branch [--project P] [--branch B] [--note "what was done"] [--question "something for the owner to decide"]...
               [--dry-run]

  1. Lock (one merge per repo at a time). The worktree must be clean (commit or discard uncommitted changes first).
  2. `git rebase <main>`: on a conflict, abort, list the conflicting files, record merge.failed, stop.
  2b. Registry `commits: conventional`: every commit title on this branch must pass (bin/commit_title.py); stop if
      one doesn't.
  3. Run the affected `merge` tiers through the main checkout's runner (`agenthub test --when merge`; no tests declared:
     skipped and noted): on failure attach the last 40 lines, record merge.failed, stop.
  4. In the main checkout, `git merge --ff-only <branch>` (stop if uncommitted changes in the main checkout get in the
     way). In the hub's own repo, then `agenthub land` from the merged code (the registry index; a problem is reported,
     the merge stands).
  5. **Push only when the registry has `push_on_merge: true`** (no push by default: some repos are public, and
     merging ≠ publishing).
  6. Record merge.done and session.report on the bus (branch, commits, files, tests, questions, pushed or not);
     with --question, also send it to the owner (→ the personal assistant).

The report's format is in contracts/hubbus.v1.schema.json (the session.report event).
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import pathlib
import subprocess
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import commit_title  # noqa: E402
import hubconf  # noqa: E402
import names  # noqa: E402
import i18n  # noqa: E402

_ = i18n.domain(__file__)

HUBBUS = [sys.executable, str(hubconf.ROOT / "bin" / "hubbus")]


def git(cwd, *args, check=False) -> subprocess.CompletedProcess:
    r = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise RuntimeError(_("git {args}: {output}", args=" ".join(args), output=(r.stderr or r.stdout).strip()))
    return r


def publish(etype: str, project: str, eid: str, payload: dict) -> None:
    subprocess.run([*HUBBUS, "publish", etype, "--source", project, "--to", project, "--id", eid,
                    "--payload", json.dumps(payload, ensure_ascii=False)], capture_output=True)


def project_of(cwd: pathlib.Path) -> tuple[str | None, pathlib.Path | None]:
    common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common.returncode != 0:
        return None, None
    main = pathlib.Path(common.stdout.strip()).parent.resolve()
    for name in hubconf.projects():
        ws = hubconf.workspace(name)
        if ws and ws.resolve() == main:
            return name, main
    return (hubconf.hub_project(), main) if main == hubconf.ROOT.resolve() else (None, main)


def main() -> int:
    ap = argparse.ArgumentParser(prog="merge-branch")
    ap.add_argument("--project")
    ap.add_argument("--branch")
    ap.add_argument("--note", default="")
    ap.add_argument("--question", action="append", default=[])
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    if hubconf.MAIN != hubconf.ROOT:   # a worktree's own copy of the hub: only the main checkout's merge-branch merges
        os.execv(sys.executable, [sys.executable, str(hubconf.MAIN / "bin" / "merge-branch"), *sys.argv[1:]])

    wt = pathlib.Path.cwd()
    owner, main_dir = project_of(wt)
    proj = a.project or owner
    if not proj or not main_dir:
        sys.exit(_("merge-branch: cannot tell which project's repo this is (add --project)"))
    info = hubconf.projects().get(proj)
    if not info or info.get("v") != 2:   # not validated (missing, roster()'s paths, an index of older code): its tests and commit rules are unknown
        sys.exit(_("merge-branch: {project} is not in the validated project registry, so its test command and commit "
                   "rules are unknown; nothing was merged. `agenthub config check` rebuilds the registry and says what "
                   "is wrong", project=proj))
    # whose tests and commit rules apply is the repo's, never the caller's choice: --project only names it, and must
    # name the project whose workspace this repo is (round 6: naming one without tests merged untested)
    named = hubconf.workspace(proj)
    if not named or named.resolve() != main_dir:
        sys.exit(_("merge-branch: {project}'s folder is not this repo ({path}); nothing was merged", project=proj,
                   path=main_dir))
    branch = a.branch or git(wt, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    base = next((b for b in ("main", "master") if git(main_dir, "rev-parse", "--verify", "-q", b).returncode == 0), None)
    if not base:
        sys.exit(_("merge-branch: no main / master branch"))
    if branch in (base, "HEAD"):
        sys.exit(_("merge-branch: you are on {branch}; run this in your own branch/worktree "
                   "(the main checkout is for merging)", branch=branch))
    if wt.resolve() == main_dir:
        sys.exit(_("merge-branch: this is the main checkout; run it in that branch's worktree"))
    if git(wt, "status", "--porcelain").stdout.strip():
        sys.exit(_("merge-branch: the worktree has uncommitted changes; commit (or discard) them before merging"))

    head0 = git(wt, "rev-parse", "HEAD").stdout.strip()
    eid = f"merge-{proj}-{branch.replace('/', '_')}-{head0[:10]}"
    report = {"project": proj, "branch": branch, "base": base, "note": a.note, "open_questions": a.question,
              "merged": False, "pushed": False}

    def fail(stage: str, detail: str) -> int:
        report.update(stage=stage, detail=detail[-2000:])
        if not a.dry_run:
            publish("merge.failed", proj, f"{eid}:failed", report)
        print(_("✗ {stage}: {detail}", stage=stage, detail=detail[-1500:]))
        return 1

    lock_path = pathlib.Path(git(wt, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()) / "merge-branch.lock"
    with open(lock_path, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        # 2. rebase
        r = git(wt, "rebase", base)
        if r.returncode != 0:
            conflicts = git(wt, "diff", "--name-only", "--diff-filter=U").stdout.split()
            git(wt, "rebase", "--abort")
            return fail("rebase", _("conflicts with {base}: {conflicts} — resolve them in this worktree with "
                                    "`git rebase {base}` and run again", base=base,
                                    conflicts=", ".join(conflicts) or (r.stderr or r.stdout).strip()))
        head = git(wt, "rev-parse", "HEAD").stdout.strip()
        commits = [dict(zip(("sha", "subject"), l.split("\t", 1)))
                   for l in git(wt, "log", "--format=%h\t%s", f"{base}..{head}").stdout.splitlines()]
        # merge.done records full shas (for detection)
        full = git(wt, "log", "--format=%H", f"{base}..{head}").stdout.split()
        files = git(wt, "diff", "--name-only", f"{base}...{head}").stdout.split()
        report.update(head=head, commits=commits, files=files)
        if not commits:
            return fail("empty", _("{branch} is the same as {base}; nothing to merge", branch=branch, base=base))
        # 2b. commit titles
        if info.get("commits") == "conventional":
            bad = [_("{sha} {subject}: {why}", sha=c["sha"], subject=c["subject"], why=why) for c in commits
                   if (why := commit_title.problem(c["subject"], final=True))]
            if bad:
                return fail("commit-titles", _("these commit titles are not Conventional Commits (registry: commits: "
                                               "conventional):\n{titles}\n— fix the titles (e.g. `git rebase --exec` "
                                               "or commit again) and run again", titles="\n".join(bad)))
        # 3. tests: the affected merge tiers through the main checkout's runner (a recorded pass for this tree is a
        # hit; the hub's own declaration is read from the tree under test; docs/design/test-waiting.md B4)
        if info.get("tests") or proj == hubconf.hub_project():
            cmd = "agenthub test --when merge"
            t0 = time.monotonic()
            # the runner's run log counts this as the merge's run, not the agent's own (the waiting report, B7)
            t = subprocess.run([*hubconf.launch(hubconf.MAIN / "bin" / "test-runner.py"), "--when", "merge"], cwd=wt,
                               capture_output=True, text=True, env=names.env_set(dict(os.environ), "TEST_CALLER", "merge-branch"))
            tail = "\n".join((t.stdout + t.stderr).strip().splitlines()[-40:])
            report["tests"] = {"cmd": cmd, "ok": t.returncode == 0, "tail": tail,
                               "secs": round(time.monotonic() - t0, 1)}
            if not report["tests"]["ok"]:
                return fail("tests", _("`{cmd}` failed:\n{tail}", cmd=cmd, tail=tail))
        else:
            report["tests"] = {"cmd": None, "ok": None, "tail": _("the registry entry declares no tests; no tests were run")}
        if a.dry_run:
            print(_("(dry-run) would fast-forward {n} {n:commit|commits} of {branch} into {base}; tests: {tests}",
                    n=len(commits), branch=branch, base=base, tests=report["tests"]["ok"]))
            return 0
        # 4. fast-forward main
        if git(main_dir, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip() != base:
            return fail("main", _("the main checkout ({path}) is not on {base}", path=main_dir, base=base))
        r = git(main_dir, "merge", "--ff-only", branch)
        if r.returncode != 0:
            return fail("main", _("the main checkout cannot fast-forward: {output}", output=(r.stderr or r.stdout).strip()))
        report["merged"] = True
        # 4b. the hub's own repo: what landed is the running platform. Its own code, started fresh from the main
        # checkout (not in this process, which imported the old modules), rebuilds what must match it, still under
        # the lock: `agenthub land` (docs/design/test-waiting.md step 2.2: the registry index; 2.3 adds the hooks)
        if proj == hubconf.hub_project():
            land = subprocess.run([*hubconf.launch(main_dir / "bin" / "agenthub"), "land"], cwd=main_dir,
                                  capture_output=True, text=True)
            report["landed"] = land.returncode == 0
            if land.returncode != 0:
                print(_("merge-branch: merged, but `agenthub land` reported a problem (the index may not match the "
                        "merged code until the next tick):\n{tail}", tail="\n".join(
                            (land.stdout + land.stderr).strip().splitlines()[-15:])), file=sys.stderr)
        # 5. push (only when the registry says so)
        if info.get("push_on_merge"):
            # a commit_gate repo's main moves only through this gate: a diverged origin is reported, never pulled in
            push = ["git", "push", "-q"] if info.get("commit_gate") else [str(hubconf.ROOT / "bin" / "git-safe-push.sh")]
            p = subprocess.run(push, cwd=main_dir, capture_output=True, text=True)
            report["pushed"] = p.returncode == 0
            if p.returncode != 0:
                report["push_error"] = (p.stderr or p.stdout).strip()[-500:]
    # 6. record
    publish("merge.done", proj, f"{eid}:done", {"project": proj, "branch": branch, "head": head, "commits": full})
    publish("session.report", proj, f"{eid}:report", report)
    for q in a.question:
        subprocess.run([*HUBBUS, "send", "--from", proj, "--to", hubconf.owner_address(), "--type", "question",
                        "--text", f"[{proj} · {branch}] {q}"], capture_output=True)
    push = _("pushed") if report["pushed"] else \
        _("not pushed") + (_(" (push_on_merge is false)") if not info.get("push_on_merge") else "")
    print(_("✓ {n} {n:commit|commits} of {branch} merged into {base} (tests: {tests}; {push})",
            n=len(commits), branch=branch, base=base, tests=report["tests"]["ok"], push=push))
    return 0


if __name__ == "__main__":
    sys.exit(main())
