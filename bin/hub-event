#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""The platform's event entry point (runtime abstraction layer 3, docs/design/runtime-abstraction.md): each runtime
wires its native hooks to this.

  hub-event [--runtime <name>] <event>
                             the event is the platform's own name (runtime_ports.EVENTS); stdin is the runtime's
                             native hook input. --runtime: whose hook this is (each runtime's installed hooks say;
                             without it, runtime.default's, as hooks written before docs/design/mailbox-runtimes.md A1).
                             Its lifecycle parses the input, and the session is recorded in the platform's ids
                             (runtime_ports.qualify)
  hub-event [--runtime <name>] wait
                              the runtime's waiter for a wake (its wait(); docs/design/mailbox-runtimes.md B1): runs
                              in the background until a wake request for the session comes, then exits with the code
                              that wakes it (the one exception to "always exit 0" below)
  hub-event install <folder>  install the hooks of every installed runtime with session events in this project (the
                              platform's replaced with new ones, the user's own kept): called by sync-local-setup
  hub-event worktree <start|prompt|nudge|end>
                              worktree-memory.sh's user-level hooks, before anything runs as the project: a session in
                              a linked worktree goes on record as any session does, gets its mail (the bus is in no
                              sandbox, so it has to be from here) and its after-commit reminder in one output, and its
                              end (the runtime's session_ending: that command also runs at compaction) counts as any
                              session's
  hub-event worktree-scope <top> <main>
                              worktree-memory.sh's question, with the hook's input on stdin: whether what's left of that hook
                              runs as the user (project_git.worktree_scope; its exit code, and the memory folder printed)
  hub-event as-project <event> <workspace> <command>
                              inside a sandboxed project's sandbox: its handlers that touch its repo (AS_PROJECT),
                              JSON out (called by hub-event itself)

Flow: binding.parse_event turns the native input into a neutral HubEvent → the platform's handlers for that event run
in order (each catching its own errors, so one broken handler doesn't affect the others) → collect the text to put into
context or the reason to "block" → binding.inject / deny turn it back into the native output. Handlers return only
neutral things and know no runtime's format.

Invariants (the same as the `|| true` after every hook used to be): always exit 0; not a real session, or not in an
onboarded project: do nothing. A hook's error output is thrown away, so every run logs one line in .logs/hub-event.log
(event, project, which ran, which failed).

Runs on the platform's Python (bin/py, 3.13 minimum).
"""
from __future__ import annotations

import datetime
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import select
import subprocess
import sys

BIN = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(BIN))
import hubconf  # noqa: E402
import names  # noqa: E402
import project_git  # noqa: E402
import runtime_ports  # noqa: E402

LOG = hubconf.LOGS / "hub-event.log"


def _load(name: str, path: pathlib.Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def _workspace(cwd: str) -> pathlib.Path | None:
    """The project folder this session is in (the root of the main git checkout or of a worktree: the nearest folder
    with a .git); it counts as a project connected to the platform only if it has .agent-memory. Found by path, not by
    git: the repo's config is the project's, and can make even rev-parse hang."""
    try:
        here = pathlib.Path(cwd).resolve()
    except (OSError, RuntimeError):
        return None
    return next((d for d in (here, *here.parents) if os.path.lexists(d / ".git")), None)


def _memory(ws) -> bool:
    """Whether this project's memory is connected: .agent-memory is its own checkout (a worktree has a .git file). A
    plain folder of that name (agent-hub itself, memory: false) is not: git commands there act on the enclosing repo."""
    return bool(ws) and (_memdir(ws) / ".git").exists()


_LOOKED = {}   # {folder: memory} from handle's one look at it (project_git.scope_of): pointers can change after it


def _memdir(ws):
    return _LOOKED.get(ws) or project_git.memory_dir(ws)


# ---------- handlers: the platform's logic, returning only neutral results (text / None / reason to block) ----------

def memory_pull(ev, ws):
    if _memory(ws):
        subprocess.run([str(BIN / "with-lock.sh"), "git", "pull", "-q"], cwd=_memdir(ws),
                       capture_output=True, timeout=60)


def hub_pull(ev, ws):
    """agent-hub's own session in its main checkout: bring the checkout up to date first (what the hub's committed
    settings did before 11-01, now through the same entry point as every project). Not in a linked worktree of the
    hub: that branch is the session's own work, with no upstream to pull."""
    if ws and ws.resolve() == hubconf.MAIN.resolve():
        subprocess.run([str(BIN / "with-lock.sh"), "git", "pull", "-q"], cwd=ws, capture_output=True, timeout=60,
                       stdin=subprocess.DEVNULL)


def memory_sync(ev, ws):
    if _memory(ws):
        subprocess.run([str(BIN / "with-lock.sh"), str(BIN / "git-sync-memory.sh")], cwd=_memdir(ws),
                       capture_output=True, timeout=120)


def moved_notice(ws):
    """Only the moved-folder reminder (sync-local-setup.sh --moved-only): a marker file read, no git. What's left of local_setup
    in a folder where git may not run as the user: a laptop's old copy says "do not work here" with or without memory."""
    if _memory(ws):
        r = subprocess.run([str(BIN / "sync-local-setup.sh"), "--quiet", "--moved-only", str(ws)], capture_output=True, text=True,
                           timeout=30, stdin=subprocess.DEVNULL)
        return r.stdout.strip() or None


def local_setup(ev, ws):
    """Align the local setup with the templates (managed blocks, hooks, ignores, AGENT.md). What it prints (e.g. a
    moved-folder reminder) also goes into context."""
    if _memory(ws):
        r = subprocess.run([str(BIN / "sync-local-setup.sh"), "--quiet", str(ws)], capture_output=True, text=True,
                           timeout=120, stdin=subprocess.DEVNULL)
        return r.stdout.strip() or None


def nudge(ev, ws):
    if _memory(ws):
        mn = _load("memory_nudge", BIN / "memory-nudge.py")
        return mn.nudge_text(ws, ev.command if ev.event == "tool_used" else None)


_HUBBUS = None   # one hook, one load: the record and the mail both ask it


def _hubbus():
    global _HUBBUS
    if _HUBBUS is None:
        _HUBBUS = _load("hubbus_mod", BIN / "hubbus")
    return _HUBBUS


def mail(ev, ws):
    kind = {"session_start": "session-start", "prompt": "prompt", "tool_used": "post-tool"}[ev.event]
    return _hubbus().mail_text(kind, ev.session, ev.cwd, runtime=_RT_NAME)


def mail_end(ev, ws):
    """The session ended: its recent hooks no longer say it runs (hubbus.Live), so what it held is free at once."""
    if not platform_run(os.environ):
        _hubbus().session_ended(ev.session)
    return None


def guard(ev, ws):
    g = _load("guard_mod", BIN / "guard.py")
    return g.decide(ev.target or {}, ev.cwd)


_RT = None   # the runtime whose hook this is (handle sets it): wake_address, session_record ask it about the hook's
#              environment
_RT_NAME = None   # its name: presence records it


def wake_address(ev, ws):
    """Keep this session's wake address (docs/design/mailbox-runtimes.md B1) where only the platform reads it:
    hubconf.session_address_file, mode 600. Only for a session in a project (the only sessions dispatch wakes), and not
    for the platform's own runs or leases (they record no presence either)."""
    fn = getattr(_RT, "wake_address", None)
    f = hubconf.session_address_file(ev.session)
    if not callable(fn) or not f or not ws or not project_git.project_at(ws) or platform_run(os.environ):
        return None
    addr = fn(os.environ)
    if not addr:
        return wake_address_drop(ev, ws)
    f.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = f.with_name(f".{f.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(addr, fh)
    os.replace(tmp, f)
    return None


def _hub(ws) -> bool:
    """agent-hub's own folder (its main checkout or a linked worktree of it): a project whose letters dispatch routes
    like any other (hubbus.projects), though project_at finds nothing for it: its entry in the registry index has no
    workspace."""
    try:
        return ws.resolve().is_relative_to(hubconf.MAIN.resolve())
    except (OSError, RuntimeError):
        return False


def _project_of_folder(cwd) -> str | None:
    """The project a hook's cwd is in, the one answer mail gets too (hubbus.project_of): a sandboxed one's as the cwd names it,
    whatever that now resolves to, and a confirmed worktree outside its project's folder counts for a project that isn't
    sandboxed. The hub's own folder is asked by the main checkout as well: a linked worktree's copy of this script has
    that worktree as the hub."""
    project = _hubbus().project_of(pathlib.Path(cwd))
    ws = _workspace(cwd) if not project else None
    return project or (hubconf.hub_project() if ws and _hub(ws) else None)


def session_record(ev, ws):
    """Record the process this session runs in (runtime_ports.record_session; docs/design/mailbox-runtimes.md B1,
    "forked sessions"), so dispatch counts it live even when its id is on no command line. At the session's start it is
    written again (a resumed session has a new process); after that only when the process differs. It also says which
    project the process is in (mailbox-session-first.md, "Candidates"), which later hooks don't move. Only for a session
    in a project (the only sessions dispatch looks for), never for the platform's own runs (they record no presence)
    nor for a headless one the runtime tells apart (person_session: a -p or SDK run, which a person isn't in).
    Not run as the project: it writes only the secrets directory, which no sandbox can reach."""
    fn = getattr(_RT, "session_pid", None)
    if not callable(fn) or platform_run(os.environ) or not _project_of_folder(ev.cwd):
        return None
    pid, person = fn(os.environ), getattr(_RT, "person_session", None)
    if pid:
        runtime_ports.record_session(ev.session, _RT_NAME, pid, ev.cwd, refresh=ev.event == "session_start",
                                     wanted=(lambda p: person(p, os.environ)) if callable(person) else None,
                                     project_of=_project_of_folder)
    return None


def wake_address_drop(ev, ws):
    """The session ended: its address, its waiter's record (the waiter sees it gone and exits), any wake request left
    for it and its process record go."""
    for f in hubconf.session_files(ev.session):
        f.unlink(missing_ok=True)


def platform_run(env) -> bool:
    """A run the platform started (a judgment point, an agent job, a lease): it records no presence, keeps no wake
    address and arms no waiter."""
    return bool(env.get("HUB_LLM_POINT") or env.get("HUBBUS_LEASE"))


def keep_last(rt, raw: str) -> bool:
    """Whether this session's last reply may be kept (mailbox-session-first.md, "The last reply"): privacy.reflection is
    include for the project at its folder. A registry that can't be read, or a folder in no project, is no."""
    try:
        parse = getattr(rt, "parse_event", None)
        ev = parse("prompt", raw) if callable(parse) else None   # any plain event: only its folder is read
        project = _project_of_folder(ev.cwd) if ev else None
        private = hubconf.reflection_private()
        return bool(project) and private is not None and project not in private
    except Exception:
        return False


def wait(name: str | None, raw: str) -> int:
    """`hub-event [--runtime <name>] wait`: the runtime's waiter for a wake (docs/design/mailbox-runtimes.md B1), the
    one entry point that doesn't always exit 0: it returns the waiter's exit code (the runtime's way of waking the
    session) and prints its text to stderr. A runtime without the wake port, or a platform run, exits 0 at once."""
    name = name or runtime_ports.default_name()
    if platform_run(os.environ):
        return 0
    try:
        rt = runtime_ports.load(name, ports=("wake",))
    except runtime_ports.Unsupported:
        return 0
    fn = getattr(rt, "wait", None)
    if not callable(fn):
        return 0
    code, text, how = fn(raw, os.environ, keep_last=keep_last(rt, raw))
    if how != "no-session":   # each waiter's end, headless runs included (they arm none)
        _log("wait", None, [how], [])
    if text:
        print(text, file=sys.stderr)
    return code


# which handlers run for each event, in order; for the "deny" kind the return value is the reason to block
HANDLERS = {
    # session_record before mail: a session told a letter is on record by then, or the tick in between could judge it closed
    "session_start": [("hub_pull", hub_pull), ("memory_pull", memory_pull), ("local_setup", local_setup),
                      ("nudge", nudge), ("session_record", session_record), ("mail", mail), ("wake_address", wake_address)],
    "session_end": [("mail_end", mail_end), ("wake_address_drop", wake_address_drop), ("memory_sync", memory_sync)],
    "pre_compact": [("memory_sync", memory_sync)],
    "prompt": [("session_record", session_record), ("mail", mail)],
    "tool_used": [("nudge", nudge), ("session_record", session_record), ("mail", mail)],
    "open_session_attempt": [("guard", guard)],
}
DENY_HANDLERS = {"guard"}
# Hooks run outside the agent's sandbox, with the user's authority. For a sandboxed project, the handlers that run git
# in its repo or read files it can plant run as the project (`hub-event as-project`, through sandboxed-run) and hand
# back their text as JSON; its memory sync is the platform's bundle path (project_git.sync_memory). Design:
# docs/design/projects-and-repos.md section 4.
# mail is not one of them: it reads and writes only the bus (presence, delivery), which no sandbox can reach, and
# reads nothing from the project's folder (a sandboxed project's folder is its by path: hubbus.project_of).
AS_PROJECT = {"memory_pull", "local_setup", "nudge"}
# What runs no git and no script of the folder's. Any other handler, a new one included, runs only where the folder lets it: as
# the project, or as the user where project_git.user_git_ok says so. The default is no.
NOT_IN_FOLDER = {"session_record", "mail", "mail_end", "wake_address", "wake_address_drop", "guard"}
# What runs only in the project's memory checkout (project_git.memory_dir), so it can go on where its folder is only a worktree
MEMORY_ONLY = {"memory_pull", "memory_sync"}


def _read_stdin() -> str:
    try:
        if not sys.stdin.isatty() and select.select([sys.stdin], [], [], 0.2)[0]:
            return sys.stdin.read()
    except (OSError, ValueError):
        pass
    return ""


def _log(event, project, ran, failed) -> None:
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG, "a") as fh:
            fh.write(f"{datetime.datetime.now().isoformat(timespec='seconds')} {event} {project or '-'} "
                     f"ran={','.join(ran) or '-'} failed={','.join(failed) or '-'}\n")
    except OSError:
        pass


CAGED_NEEDS = {"control", "confine"}


def handle(event: str, raw: str, rt=None, name: str | None = None) -> str:
    """Run one event and return the native output to print to stdout ("" if none). For main and tests. name: whose
    hook (--runtime); none = runtime.default."""
    global _RT, _RT_NAME
    _RT_NAME = name = name or runtime_ports.default_name()
    rt = _RT = rt or runtime_ports.load(name, ports=("lifecycle",))
    ev = rt.parse_event(event, raw)
    if ev is None or event not in HANDLERS:
        return ""
    ev = ev._replace(session=runtime_ports.qualify(name, ev.session))
    ws = _workspace(ev.cwd)
    cage = None if os.environ.get("HUB_AS_PROJECT") else project_git.sandbox_of(ev.cwd)
    if cage and not CAGED_NEEDS <= runtime_ports.capabilities(name):
        # a sandboxed project's sessions run only under a runtime whose control files the platform protects and whose
        # runs it can confine: its hooks are never installed there, and one found anyway does nothing (fail closed)
        _log(event, ws.name if ws else None, [], [f"refused:{name}"])
        return ""
    # as the project only in a folder its workspace really holds: one swapped for a link elsewhere gets no work at all
    inside = bool(cage) and bool(ws) and project_git.holds(cage[1], ws)
    as_project = bool(os.environ.get("HUB_AS_PROJECT"))
    scope = project_git.scope_of(ws) if ws and not cage and not as_project else None
    if scope:
        _LOOKED[ws] = scope.memdir
    memory_ok = not cage and bool(ws) and (as_project or scope.memory_ok)
    folder_ok = memory_ok and (as_project or scope.folder_ok)
    inner = _as_project(cage[0], ws, ev) if inside and _needs_project(ev) else {}
    texts, reasons, ran, failed = [], [], [], []
    for name, fn in HANDLERS[event]:
        try:
            if name in NOT_IN_FOLDER or folder_ok or (memory_ok and name in MEMORY_ONLY):
                out = fn(ev, ws)
            elif inside and name in AS_PROJECT:
                if not isinstance(inner.get(name), dict) or not inner[name].get("ok"):
                    raise RuntimeError(f"as the project: {(inner.get('') or {}).get('error', 'failed')}")
                out = inner[name].get("text") if isinstance(inner[name].get("text"), str) else None
            elif inside and name == "memory_sync":
                out = _memory_sync_as_project(cage, ws)
            elif not cage and name == "local_setup":
                name = "moved_notice"   # the log says what ran
                out = moved_notice(ws)
            else:
                continue
            ran.append(name)
        except Exception as e:  # one handler broke; the others still run
            failed.append(f"{name}:{type(e).__name__}")
            continue
        if out:
            (reasons if name in DENY_HANDLERS else texts).append(out)
    _log(event, ws.name if ws else None, ran, failed)
    if reasons:
        return rt.deny(event, reasons[0])
    return rt.inject(event, "\n\n".join(texts)) if texts else ""


WORKTREE_EVENTS = {"start": "session_start", "prompt": "prompt", "nudge": "tool_used", "end": "session_end"}


def _worktree_nudge(ev, ws, cage):
    """The after-commit reminder, as handle gives it: as the project when it is sandboxed, as the user only where git may run
    so. Here because a hook's output is one JSON or none: this and a letter printed apart would both be lost, and the letter
    counted as told."""
    if cage:
        if not ws or not project_git.holds(cage[1], ws) or not _needs_project(ev):
            return None
        inner = _as_project(cage[0], ws, ev).get("nudge")
        if not isinstance(inner, dict) or not inner.get("ok"):
            raise RuntimeError("as the project")
        return inner.get("text") if isinstance(inner.get("text"), str) else None
    return nudge(ev, ws) if ws and project_git.folder_git_ok(ws) else None


def worktree(what: str, raw: str) -> int:
    """A session in a linked worktree (worktree-memory.sh): what session_record, mail and session_end do for the others, run
    outside any sandbox. A runtime that may not hold a sandboxed project's sessions gets no mail there, as in handle."""
    global _RT, _RT_NAME
    if what not in WORKTREE_EVENTS:
        return 0
    _RT_NAME = runtime_ports.default_name()
    rt = _RT = runtime_ports.load(_RT_NAME, ports=("lifecycle",))
    ev = rt.parse_event(WORKTREE_EVENTS[what], raw)
    if ev is None:
        return 0
    ev = ev._replace(session=runtime_ports.qualify(_RT_NAME, ev.session))
    ws = _workspace(ev.cwd)
    if what == "end":
        if callable(ending := getattr(rt, "session_ending", None)) and ending(raw):
            mail_end(ev, ws)
            wake_address_drop(ev, ws)
        return 0
    cage = project_git.sandbox_of(ev.cwd)
    refused = cage and not CAGED_NEEDS <= runtime_ports.capabilities(_RT_NAME)
    steps = [("session_record", lambda: session_record(ev, ws))]
    if not refused:
        steps += [("nudge", lambda: _worktree_nudge(ev, ws, cage))] if what == "nudge" else []
        steps += [("mail", lambda: mail(ev, ws))]
    texts, ran, failed = [], [], []
    for name, fn in steps:
        try:
            out = fn()
            ran.append(name)
            if out:
                texts.append(out)
        except Exception as e:   # one broke; the others still run
            failed.append(f"{name}:{type(e).__name__}")
    _log(f"worktree-{what}", ws.name if ws else None, ran, failed)
    if texts and (out := rt.inject(ev.event, "\n\n".join(texts))):
        print(out)
    return 0


def worktree_scope(top: str, main: str, raw: str) -> int:
    """`hub-event worktree-scope`: the folder the hook's input names (the runtime's to read) goes with what the script found."""
    try:
        ev = runtime_ports.load(runtime_ports.default_name(), ports=("lifecycle",)).parse_event("prompt", raw)
    except runtime_ports.Unsupported:
        ev = None
    return project_git.worktree_scope(top, main, ev.cwd if ev else None)


def _needs_project(ev) -> bool:
    """Whether this event has AS_PROJECT work at all: after a tool call only a git commit/push can nudge (the same test
    memory-nudge makes, on the command text alone), so the other calls of a sandboxed session don't each start a
    sandbox."""
    names = {n for n, _fn in HANDLERS.get(ev.event, [])} & AS_PROJECT
    if names == {"nudge"} and ev.event == "tool_used":
        return bool(_load("memory_nudge", BIN / "memory-nudge.py").GIT_WRITE.search(ev.command or ""))
    return bool(names)


def _as_project(project: str, ws: pathlib.Path, ev) -> dict:
    """This event's AS_PROJECT handlers, run by `hub-event as-project` as the project: {name: {ok, text}}, or
    {"": {error}} when it didn't run (e.g. the sandbox refused)."""
    argv = [*hubconf.launch(BIN / "hub-event"), "as-project", ev.event, str(ws), ev.command or ""]
    # its AGENT.md commit is pushed by the memory sync's bundle, not from inside (the sandbox can't write the bare repo)
    r = project_git.run(project, ws, argv, timeout=110, env=names.env_set({"HUB_AS_PROJECT": "1"}, "OFFLINE", "1"))
    try:
        out = json.loads(r.stdout) if r.returncode == 0 else None
    except ValueError:
        out = None
    return out if isinstance(out, dict) else {"": {"error": f"exit {r.returncode}: {r.stderr.strip()[-200:]}"}}


def _memory_sync_as_project(proj, ws):
    if (ws / ".agent-memory" / ".git").exists():
        why = project_git.sync_memory(proj[0], proj[1], ws / ".agent-memory", lock=True)
        if why:
            raise RuntimeError(why)


def as_project(event: str, ws: str, command: str) -> int:
    """Inside the project's sandbox: run this event's AS_PROJECT handlers, print {name: {ok, text}}."""
    ev = runtime_ports.HubEvent(event, "", ws, command or None)
    res = {}
    for name, fn in HANDLERS.get(event, []):
        if name in AS_PROJECT:
            try:
                res[name] = {"ok": True, "text": fn(ev, pathlib.Path(ws))}
            except Exception as e:
                res[name] = {"ok": False, "error": type(e).__name__}
    print(json.dumps(res))
    return 0


def install(ws: pathlib.Path) -> int:
    """The hooks of every installed runtime with session events (runtime_ports.installed). None has them: say why,
    exit code 3 for "unsupported"."""
    done, why = 0, None
    for name in runtime_ports.installed():
        try:
            rt = runtime_ports.load(name, ports=("lifecycle",))
        except runtime_ports.Unsupported as e:
            why = why or e
            continue
        rt.install_lifecycle(ws)
        done += 1
    if not done:
        print(why, file=sys.stderr)
        return 3
    return 0


def main(argv) -> int:
    if argv[:1] == ["as-project"] and len(argv) == 4:
        return as_project(*argv[1:])
    if argv[-1:] == ["wait"] and (len(argv) == 1 or (len(argv) == 3 and argv[0] == "--runtime")):
        try:
            return wait(argv[1] if len(argv) == 3 else None, _read_stdin())
        except Exception as e:   # a broken waiter ends quietly: the session never sees an error from it
            _log("wait", None, [], [f"hub-event:{type(e).__name__}"])
            return 0
    if argv[:1] == ["worktree-scope"] and len(argv) == 3:
        try:
            return worktree_scope(argv[1], argv[2], _read_stdin())
        except Exception as e:   # can't tell: nothing runs (never the 0 or the 3 the script goes on from)
            _log("worktree-scope", None, [], [f"hub-event:{type(e).__name__}"])
            return 1
    try:
        if argv[:1] == ["install"] and len(argv) == 2:
            return install(pathlib.Path(argv[1]).resolve())
        if argv[:1] == ["worktree"] and len(argv) == 2:
            return worktree(argv[1], _read_stdin())
        name = None
        if argv[:1] == ["--runtime"] and len(argv) == 3:
            name, argv = argv[1], argv[2:]
        if len(argv) == 1:
            out = handle(argv[0], _read_stdin(), name=name)
            if out:
                print(out)
    except Exception as e:  # a broken hook must not affect the session
        _log(argv[0] if argv else "?", None, [], [f"hub-event:{type(e).__name__}"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
