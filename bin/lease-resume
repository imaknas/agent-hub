#!/usr/bin/env bash
# Channel lease L3: resume a leased session in the terminal (the command the assistant gives when "resume in
# terminal" is pressed).
#   lease-resume <session id>
# The runner has already stopped its own process; this cds into that project and brings the headless token (under SSH
# claude can't read the keychain and would be "not logged in"; the cost: claude.ai connectors don't load), then rejoins
# the same conversation. When done, go back to the assistant and press "reclaim" to do the handover.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/hubpaths.sh"
id="${1:?$(hub_msg "usage: lease-resume <session id>")}"
HUB="$(cd "$(dirname "$0")/.." && pwd)"
cwd=$("$HUB/bin/py" -c "
import json, sys
d = json.load(open('$HUB/.state/lease-runner/leases.json'))
l = d.get(sys.argv[1]) or sys.exit(sys.argv[2])
print(l['cwd'])" "$id" "$(hub_msg "no such lease: {id}" id="$id")")
cd "$cwd"
token="$HOME/.claude/headless-oauth-token"
if ! claude auth status 2>/dev/null | grep -q '"loggedIn": true' && [ -r "$token" ]; then
  export CLAUDE_CODE_OAUTH_TOKEN="$(cat "$token")"
fi
exec claude --resume "$id"
