#!/usr/bin/env bash
# Lint for the platform's Python code: ruff, with only the error-catching F rules on (pyflakes: undefined names, unused
# imports/variables…), no formatting.
# The rules are in ruff.toml at the repo root (editors read that one too); ruff is installed in the platform's venv
# (bin/setup-python, pinned version).
# agent-hub's lint tier (projects/agent-hub.yaml, run by agenthub test) runs it on an exported tree; it can also be
# run by hand.
#   lint [dir]      default: the hub root; problems exit 1, no ruff exit 2 (says to run bin/setup-python)
# Scripts without an extension (first line is bin/py's shebang or python) aren't recognized by ruff on its own; they are
# listed here and handed to it too.
set -uo pipefail

HUB="$(cd "$(dirname "$0")/.." && pwd)"
source "$HUB/bin/hubpaths.sh"
dir="${1:-$HUB}"
py="${AGENT_HUB_PYTHON:-$("$HUB/bin/py" -c 'import sys; print(sys.executable)')}" || exit 2
ruff="$(dirname "$py")/ruff"
[ -x "$ruff" ] || { hub_say "lint: no ruff in the platform's venv ({ruff}); run bin/setup-python" ruff="$ruff" >&2; exit 2; }

cd "$dir" || exit 2
files=()
while IFS= read -r f; do
  case "$f" in
    *.py) files+=("$f") ;;
    bin/*|githooks/*) [ -f "$f" ] && head -1 "$f" | grep -qE '^#!.*(/py|python)' && files+=("$f") ;;
  esac
done < <(find bin githooks tests capabilities -type f 2>/dev/null | sort)
exec "$ruff" check --config "$dir/ruff.toml" --no-cache --quiet --output-format concise "${files[@]}"
