#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""Runs a sandboxed project's own service or command job isolated, through this machine's adapter (isolation.py:
macOS seatbelt.service_profile, Linux landlock.py): render-services puts it in front of the service's command, the
scheduler in front of the job's. A project with enforce.sandbox gets its services and jobs through manifest.update
without the owner's approval, so they must not run with more than the project's sessions have (no credentials, no
other projects, no platform state or bus; writes only to its own folders (its letters go into its outbox); its tool caches are its own, in its
repo's git dir: policy.py env).
Design: docs/design/capabilities.md.

  sandboxed-run --project <name> --cwd <dir> [--port <n>] -- <argv…>

The rules are computed fresh on every run (registry changes take effect on the next start). Fails closed: where the
platform can't sandbox (no adapter for this OS, the adapter can't work here, the project unknown) it prints why and
exits 78 without running the command; never runs it unsandboxed.
"""
from __future__ import annotations

import argparse
import os
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import hubconf  # noqa: E402

EX_CONFIG = 78


def refuse(why: str) -> int:
    print(f"sandboxed-run: {why}; not run (a sandboxed project's service or job never runs unsandboxed)",
          file=sys.stderr)
    return EX_CONFIG


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="sandboxed-run")
    ap.add_argument("--project", required=True)
    ap.add_argument("--cwd", required=True)
    ap.add_argument("--port", type=int)
    ap.add_argument("cmd", nargs=argparse.REMAINDER)
    a = ap.parse_args(argv)
    cmd = a.cmd[1:] if a.cmd[:1] == ["--"] else a.cmd
    if not cmd:
        return refuse("no command")
    import policy
    import registry
    import isolation
    if (why := isolation.can_sandbox()):
        return refuse(why)
    projects = hubconf.projects()
    doc = projects.get(a.project)
    if not doc:
        return refuse(f"{a.project} is not in the registry")
    pol = policy.policy(a.project, doc, {"projects": projects})
    d = registry.dirs(doc)
    dirs = [p for p in (d["runtime"], d["workspace"]) if p]
    os.chdir(a.cwd)
    os.environ.update(pol.get("env") or {})   # its own tool caches (the shared ones aren't writable in the sandbox)
    try:
        isolation.exec_service(pol, dirs, a.port, cmd)
    except OSError as e:
        return refuse(f"the sandbox could not be applied ({e.strerror or e})")
    return refuse("the adapter returned without running the command")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
