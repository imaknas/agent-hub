#!/usr/bin/env bash
# The commit gate's old entry point. It is kept for one merge only: the merge that switched agent-hub over
# (docs/design/test-waiting.md step 2.3) was tested by the merge-branch before it, whose registry entry said
# `runtime.test: bin/test-gate --all`. It runs agent-hub's declared tiers on what is staged, through the main
# checkout's runner (agenthub test), and goes in the next merge.
#   test-gate          the commit tiers on a branch, the merge tiers on main
#   test-gate --all    the merge tiers
set -uo pipefail
HUB="$(cd "$(dirname "$0")/.." && pwd)"
source "$HUB/bin/hubpaths.sh"
moment=commit
case "$(git symbolic-ref --short -q HEAD)" in main|master) moment=merge ;; esac
[ "${1:-}" = "--all" ] && moment=merge
exec "$HUB_MAIN/bin/py" "$HUB_MAIN/bin/test-runner.py" --index --when "$moment"
