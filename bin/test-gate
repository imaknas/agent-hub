#!/usr/bin/env bash
# commit 閘門:改到程式碼的 commit,兩個 python 的測試都過才放行(githooks/pre-commit 呼叫;也可以手動跑)。
#
#   test-gate            檢查「暫存區」(要 commit 的內容),不是 working tree——同一份 working tree 可能有
#                        別的 session 改到一半的檔案,測它們沒有意義
#   test-gate --all      不管暫存了什麼,一律跑
#
# 怎麼跑:把暫存區匯出到暫存目錄(git checkout-index),在那裡用 AGENT_HUB_ROOT 指過去、HOME 換成空的暫存目錄跑
#   /opt/homebrew/bin/python3 跟 /usr/bin/python3(hook 跑在系統的 3.9),兩個一起跑。
# 測試不准寫真的東西:HOME 是假的,所以碰不到真的 ~/workspace、匯流排、~/.claude;跑完假 HOME 裡多了任何檔案
#   (空資料夾不算)= 有測試在寫使用者目錄,閘門失敗,列出是哪些檔案。
# 只動資料檔的 commit(librarian、onboard 之類腳本寫的登錄、index、digest…)不跑:CODE 以外的路徑不觸發。
# 通過時把這次的 tree 記在 git 目錄的 test-gate-passed;githooks/post-commit 用它抓出跳過閘門(--no-verify)的 commit。
set -uo pipefail

HUB="$(cd "$(dirname "$0")/.." && pwd)"
cd "$HUB" || exit 1
CODE='^(bin|tests|contracts|templates|githooks|launchd|capabilities|agent-jobs)/|^hub\.json$'
PYTHONS=(/opt/homebrew/bin/python3 /usr/bin/python3)

if [ "${1:-}" != "--all" ] && ! git diff --cached --name-only | grep -Eq "$CODE"; then
  exit 0
fi

# 不放在 /tmp、/var/folders:能力的 Seatbelt profile 准寫暫存目錄,假 HOME 放那裡,「寫資料夾外」的測試就擋不到
mkdir -p "$HUB/.state/test-gate"
work="$(mktemp -d "$HUB/.state/test-gate/run.XXXXXX")" || exit 1
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/tree" "$work/home/workspace"
git checkout-index -a --prefix="$work/tree/" || { echo "test-gate:匯出暫存區失敗" >&2; exit 1; }

i=0
for py in "${PYTHONS[@]}"; do
  # 從 git hook 叫的時候環境裡有 GIT_DIR、GIT_INDEX_FILE…:不清掉,測試自己開的暫存 repo 會操作到這個 repo
  ( for v in $(env | sed -n 's/^\(GIT_[A-Z_]*\)=.*/\1/p'); do unset "$v"; done
    cd "$work/tree" && HOME="$work/home" AGENT_HUB_ROOT="$work/tree" PYTHONDONTWRITEBYTECODE=1 \
      "$py" -m unittest discover -s tests >"$work/out$i" 2>&1 ) &
  i=$((i + 1))
done
wait

fail=0
i=0
for py in "${PYTHONS[@]}"; do
  summary="$(grep -E '^(Ran|OK|FAILED)' "$work/out$i" | tr '\n' ' ')"
  if tail -3 "$work/out$i" | grep -q '^OK'; then
    echo "test-gate:$py $summary"
  else
    fail=1
    echo "test-gate:$py 沒過 $summary" >&2
    grep -E '^(ERROR|FAIL):' "$work/out$i" >&2
    tail -30 "$work/out$i" >&2
  fi
  i=$((i + 1))
done

leaked="$(cd "$work/home" && find . -type f | sed 's|^\./|~/|')"
if [ -n "$leaked" ]; then
  fail=1
  echo "test-gate:測試寫了使用者目錄(真的跑會寫到真的檔案):" >&2
  echo "$leaked" >&2
fi

if [ "$fail" -ne 0 ]; then
  echo "test-gate:不放行。修好再 commit;只改了資料檔就不要把程式碼一起暫存。" >&2
  exit 1
fi
git write-tree >"$(git rev-parse --git-path test-gate-passed)"
exit 0
