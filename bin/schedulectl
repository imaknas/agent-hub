#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""A small tool for schedule.yaml + the launchd scheduler, so you don't have to remember launchctl syntax or hand-edit yaml.

To add a schedule, just edit schedule.yaml and add a job entry. No need for this tool or for
launchd: the next scheduler.py tick (within 15 minutes) picks it up.
This tool only does what needs a command to remember, or risks breaking the yaml by hand:
pausing/resuming a single job, and turning the whole scheduler on/off and checking its state.

Usage:
  schedulectl list                list every job and its state (enabled/paused, when it runs, command)
  schedulectl pause <name>        pause a job (its settings stay; resume brings it back)
  schedulectl resume <name>       resume a job
  schedulectl status              whether the scheduler itself (launchd) is running, and the latest runs
  schedulectl logs [name] [n]     print the last n lines of a log (default scheduler.log; with name, that job's log for today)
  schedulectl run <name>          run a job once now (like Claude Desktop's "Run now") and record it as run today, so the
                                  schedule does not run it again that day (which matters for LLM jobs). Runs through launchd
                                  in the user's desktop session: under SSH the keychain can't be read and claude is logged out.
                                  With no service manager (a container) it runs right here, in the foreground.
                                  An event job runs with no events and its cursor stays: a manual run is a test. While a
                                  tick is running a job in the foreground it waits 30 seconds, then gives up
  schedulectl events <name>       an event job's cursor and the events waiting for it (and the ones the loop chain holds
                                  back): why it didn't run, what its next run gets
  schedulectl skip <name>         move an event job's cursor to the bus head: the events waiting are dropped for good (a
                                  batch that keeps failing)
  schedulectl stop                stop the scheduler completely (launchctl bootout; schedule.yaml untouched)
  schedulectl start               start the scheduler again (launchctl bootstrap)
  schedulectl models              the model each judgment point actually uses, and where that comes from (llm.model_for
                                  and {settings}'s llm section)
  schedulectl set-model <point|state|index|consolidate> <model|default>
                                  write into {settings} llm.points (default = drop the pin and go back to the group's
                                  default); state = the single-project STATE.md points, index = the cross-project index.md
                                  and the weekly report, consolidate = the cleanup pass
"""
import datetime
import json
import os
import subprocess
import sys
from pathlib import Path

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parent))
import event_jobs  # noqa: E402
import hubconf  # noqa: E402
import names  # noqa: E402
import i18n  # noqa: E402

_ = i18n.domain(__file__)

HUB = hubconf.ROOT
SCHEDULE = hubconf.config_file("schedule.yaml")
LOG_DIR = HUB / ".logs"
LABEL = names.unit_label("-scheduler")
PLIST = Path.home() / "Library/LaunchAgents" / f"{LABEL}.plist"
# set-model shorthands → judgment points (the ones models.env's STATE_MODEL / INDEX_MODEL / CONSOLIDATE_MODEL used
# to set)
MODEL_ALIASES = {"state": ["librarian-state", "librarian-todo-format", "librarian-state-edits",
                           "librarian-todo-format-edits"],
                 "index": ["librarian-index", "librarian-index-edits", "reflect-week"],
                 "consolidate": ["consolidate"]}


def load_jobs():
    return (yaml.safe_load(SCHEDULE.read_text()) or {}).get("jobs", [])


def all_jobs():
    """schedule.yaml + the project registry (the same list scheduler.py uses). pause/resume only handle schedule.yaml's;
    to change a registry job, edit projects/<project>.yaml."""
    sys.path.insert(0, str(HUB / "bin"))
    import scheduler
    return scheduler.all_jobs()[0]


def commit_hub_file(path, msg):
    """Changed a version-controlled file: commit+push it on the spot (only that file), not left for a person to do."""
    rc = subprocess.run([str(HUB / "bin/commit-hub-files.sh"), msg, path.name]).returncode
    if rc != 0:
        print(_("warning: {file} was written, but the commit/push failed; it needs a manual fix", file=path.name))


def save_jobs(jobs, msg):
    SCHEDULE.write_text(yaml.dump({"jobs": jobs}, allow_unicode=True, sort_keys=False))
    commit_hub_file(SCHEDULE, msg)


def find_job(jobs, name):
    for job in jobs:
        if job["name"] == name:
            return job
    print(_("No job named '{name}'. There are: {jobs}", name=name, jobs=", ".join(j["name"] for j in jobs) or _("(none)")))
    sys.exit(1)


def month_name(m: int) -> str:
    return (_("Jan"), _("Feb"), _("Mar"), _("Apr"), _("May"), _("Jun"), _("Jul"), _("Aug"), _("Sep"), _("Oct"), _("Nov"),
            _("Dec"))[m - 1]


def weekday_name(w: str) -> str:
    """a days_of_week value (mon…sun) as shown"""
    return {"mon": _("Mon"), "tue": _("Tue"), "wed": _("Wed"), "thu": _("Thu"), "fri": _("Fri"), "sat": _("Sat"),
            "sun": _("Sun")}.get(w, w)


def day_list(days: list) -> str:
    """days of the month: "1, 10 and 20" """
    names = [_("{day}", day=d) for d in days]
    out = names[0]
    for i, d in enumerate(names[1:], 1):
        out = _("{days} and {day}", days=out, day=d) if i == len(names) - 1 else _("{days}, {day}", days=out, day=d)
    return out


def describe_when(job):
    if "trigger" in job:
        extra = _(" (at most {n} {n:try|tries} a day)", n=job["max_attempts_per_day"]) if "max_attempts_per_day" in job else ""
        if "end_date" in job:
            extra += _(" (until {date})", date=job["end_date"])
        return event_jobs.describe(job) + extra
    return describe_clock(job)


def describe_clock(job):
    """Uses the same filter fields as scheduler.py's runs_today(), or list would show a monthly job as daily.
    One whole phrase per shape: "daily at 06:00", "every 15 minutes, 08:00-20:00", "weekly on Mon, Thu at 10:00",
    "monthly on days 1 and 15 at 10:00", "in Jan, Apr on day 1 at 06:00 (until 2027-12-31)"."""
    parts = []
    if "months" in job:
        months = month_name(job["months"][0])
        for m in job["months"][1:]:
            months = _("{months}, {month}", months=months, month=month_name(m))
        parts.append(_("in {months}", months=months))
    if "days_of_month" in job:
        days, one = day_list(job["days_of_month"]), len(job["days_of_month"]) == 1
        if parts:
            parts.append(_("on day {days}", days=days) if one else _("on days {days}", days=days))
        else:
            parts.append(_("monthly on day {days}", days=days) if one else _("monthly on days {days}", days=days))
    if "days_of_week" in job:
        wd = weekday_name(job["days_of_week"][0])
        for w in job["days_of_week"][1:]:
            wd = _("{weekdays}, {weekday}", weekdays=wd, weekday=weekday_name(w))
        parts.append(_("weekly on {weekdays}", weekdays=wd))
    when = " ".join(parts)
    extra = _(" (at most {n} {n:try|tries} a day)", n=job["max_attempts_per_day"]) if "max_attempts_per_day" in job else ""
    if "end_date" in job:
        extra += _(" (until {date})", date=job["end_date"])
    if "every_minutes" in job:
        n, between = job["every_minutes"], _(", {between}", between=job["between"]) if "between" in job else ""
        if not when:
            return _("every {n} {n:minute|minutes}{between}{extra}", n=n, between=between, extra=extra)
        return _("every {n} {n:minute|minutes}{between}, {when}{extra}", n=n, between=between, when=when, extra=extra)
    return _("{when} at {time}{extra}", when=when or _("daily"), time=job["time"], extra=extra)


def cmd_list():
    jobs = all_jobs()
    if not jobs:
        print(_("schedule.yaml has no jobs."))
        return
    for job in jobs:
        state = _("enabled") if job.get("enabled", True) else _("paused")
        print(f"[{state}] {job['name']:20s} {describe_when(job)}  {job['command']}")


def cmd_pause(name):
    jobs = load_jobs()
    job = find_job(jobs, name)
    job["enabled"] = False
    save_jobs(jobs, f"schedulectl: pause {name}")
    print(_("Paused '{name}' (its settings stay; resume brings it back)", name=name))


def cmd_resume(name):
    jobs = load_jobs()
    job = find_job(jobs, name)
    job["enabled"] = True
    save_jobs(jobs, f"schedulectl: resume {name}")
    print(_("Resumed '{name}'", name=name))


def cmd_status():
    if hubconf.service_manager() == "systemd":
        print(_("=== systemd (user) status ==="))
        subprocess.run(["systemctl", "--user", "status", "--no-pager", f"{LABEL}.timer", f"{LABEL}.service"])
    else:
        print(_("=== launchd registration ==="))
        subprocess.run(["launchctl", "print", f"gui/{subprocess.check_output(['id', '-u']).decode().strip()}/{LABEL}"])
    print()
    print(_("=== latest scheduler runs (last 10 lines of scheduler.log) ==="))
    log_file = LOG_DIR / "scheduler.log"
    if log_file.exists():
        print("\n".join(log_file.read_text().splitlines()[-10:]))
    else:
        print(_("(no log yet)"))


def cmd_logs(name=None, n=50):
    if name:
        today_logs = sorted(LOG_DIR.glob(f"{name}-*.log"))
        if not today_logs:
            print(_("No log for '{name}'", name=name))
            return
        log_file = today_logs[-1]
    else:
        log_file = LOG_DIR / "scheduler.log"
    if not log_file.exists():
        print(_("(no log yet)"))
        return
    print(_("--- {file} (last {n} lines) ---", file=log_file.name, n=n))
    print("\n".join(log_file.read_text().splitlines()[-int(n):]))


def cmd_stop():
    if hubconf.service_manager() == "systemd":
        subprocess.run(["systemctl", "--user", "disable", "--now", f"{LABEL}.timer"])
        print(_("Scheduler stopped (schedule.yaml unchanged; start brings it back)"))
        return
    uid = subprocess.check_output(["id", "-u"]).decode().strip()
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{LABEL}"])
    print(_("Scheduler stopped (schedule.yaml unchanged; start brings it back)"))


def cmd_start():
    if hubconf.service_manager() == "systemd":
        subprocess.run(["systemctl", "--user", "enable", "--now", f"{LABEL}.timer"])
        print(_("Scheduler started"))
        return
    uid = subprocess.check_output(["id", "-u"]).decode().strip()
    subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(PLIST)])
    print(_("Scheduler started"))


def run_env(job):
    """What the scheduler gives every run (event_jobs.run_env); a run started from inside another run keeps its
    chain. An event job gets no events."""
    chain = [*[j for j in event_jobs.chain_from_env(os.environ) if j != job["name"]], job["name"]]
    depth = event_jobs.depth_from_env(os.environ) + 1
    return {"SAFE_PUSH": str(HUB / "bin" / "git-safe-push.sh"),
            **event_jobs.run_env(job["name"], chain, depth, [] if "trigger" in job else None)}


def cmd_run(name):
    job = next((j for j in all_jobs() if j["name"] == name), None)
    if job is None:
        sys.exit(_("Neither schedule.yaml nor the project registry has '{name}'", name=name))
    env = run_env(job)
    # recorded before it starts: if the state can't be written (a tick holds it), nothing runs twice; taken back if
    # the start fails, so the day's scheduled run isn't lost
    prev = _mark_ran_today(name)
    try:
        if hubconf.service_manager() is None:
            return run_here(name, job, env)
        start(name, job, env)
    except BaseException as e:
        try:
            edit_state(lambda state: state.pop(name, None) if prev is None else state.__setitem__(name, prev))
        except SystemExit as held:   # the mark stays; say so without hiding why the start failed
            print(_("{name} did not start ({error!r}), and its mark as run today could not be taken back: {why}",
                    name=name, error=e, why=held), file=sys.stderr)
        raise


def job_log(name):
    return HUB / ".logs" / f"{name.replace('/', '__')}-{datetime.date.today().isoformat()}.log"


def run_here(name, job, env) -> int:
    """No service manager (a container, macOS with --no-launchd): run the job in this terminal, the way the scheduler
    would (its login shell, its environment), showing the output and appending it to the job's log too. Returns the
    job's exit code."""
    log = job_log(name)
    log.parent.mkdir(parents=True, exist_ok=True)
    print(_("Running {name} here (no service manager); its output also goes to {log}", name=name, log=log), flush=True)
    with open(log, "a") as f, subprocess.Popen([hubconf.login_shell(), "-lc", job["command"]], stdout=subprocess.PIPE,
                                               stderr=subprocess.STDOUT, text=True, env={**os.environ, **env}) as p:
        for line in p.stdout:
            sys.stdout.write(line)
            f.write(line)
        code = p.wait()
    print(_("{name} finished (exit {code}); today's schedule won't run it again", name=name, code=code))
    return code


def start(name, job, env):
    uid = subprocess.check_output(["id", "-u"]).decode().strip()
    label = names.unit_label(f"-run-now.{name.replace('/', '.')}")
    log = job_log(name)
    if hubconf.service_manager() == "systemd":   # a one-off user unit (cleans itself up when done)
        subprocess.run(["systemctl", "--user", "reset-failed", f"{label}.service"], capture_output=True)
        subprocess.run(["systemd-run", "--user", "--collect", f"--unit={label}",
                        f"--property=StandardOutput=append:{log}", f"--property=StandardError=append:{log}",
                        *[f"--setenv={k}={v}" for k, v in env.items()], "/bin/sh", "-lc", job["command"]], check=True)
        print(_("Started {name}; its output goes to {log} (today's schedule won't run it again)", name=name, log=log))
        return
    plist = hubconf.private_tmp() / f"{label}.plist"   # launchd runs what it says, as the user
    import plistlib
    plist.write_bytes(plistlib.dumps({
        "Label": label,
        "ProgramArguments": [hubconf.login_shell(), "-lc", job["command"]],
        "EnvironmentVariables": env,
        "RunAtLoad": True,
        "StandardOutPath": str(log),
        "StandardErrorPath": str(log),
    }))
    # first clear a same-named job left by the previous manual run (finished jobs stay in launchd)
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
    subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(plist)], check=True)
    print(_("Started {name}; its output goes to {log} (today's schedule won't run it again)", name=name, log=log))


def scheduler_module():
    sys.path.insert(0, str(HUB / "bin"))
    import scheduler
    return scheduler


def edit_state(fn):
    """Change the scheduler's state under its lock (a tick in progress is waited for), so neither side writes back a
    stale copy."""
    state_file = HUB / ".state" / "scheduler-last-run.json"
    with scheduler_module().state_lock(timeout=30, path=HUB / ".state" / "scheduler.lock") as mine:
        if not mine:
            sys.exit(_("The scheduler's state is held by a tick in progress (a job running in the foreground, or this "
                       "command was started by one); nothing was changed. Try again after the tick"))
        state = json.loads(state_file.read_text()) if state_file.exists() else {}
        out = fn(state)
        tmp = state_file.with_suffix(".tmp")
        tmp.write_text(json.dumps(state, indent=2))
        tmp.replace(state_file)
    return out


def _mark_ran_today(name):
    # mark as run today: otherwise a job whose scheduled time has passed runs again on the next tick (for an LLM job,
    # paying twice)
    def mark(state):
        prev = state.get(name)
        state[name] = datetime.date.today().isoformat()
        return prev
    return edit_state(mark)


def event_job(name):
    job = next((j for j in all_jobs() if j["name"] == name), None)
    if job is None or "trigger" not in job:
        sys.exit(_("'{name}' is not an event job (a registry job with trigger:)", name=name))
    return job


def cmd_events(name):
    job = event_job(name)
    state_file = HUB / ".state" / "scheduler-last-run.json"
    state = json.loads(state_file.read_text()) if state_file.exists() else {}
    print(_("{name}: {when}", name=name, when=describe_when(job)))
    if f"{name}.event_seq" not in state:
        print(_("No cursor yet: the next tick starts it at the bus head"))
        return
    cursor = state[f"{name}.event_seq"]
    got = event_jobs.pending(job, cursor)
    print(_("cursor {cursor}, bus head {head}; next: {next}", cursor=cursor, head=got["head"],
            next=event_jobs.waiting(job, state, datetime.datetime.now())))
    for title, evs in ((_("waiting:"), got["events"]), (_("held back by the loop chain:"), got["held"])):
        if evs:
            print(title)
        for ev in evs:
            chain = " > ".join(event_jobs.chain_of(ev))
            print(f"  {ev['seq']:>7}  {event_jobs.local(ev['ts']):%m/%d %H:%M}  {ev['type']:16} "
                  f"{event_jobs.belongs(ev) or '-':16} {chain}")


def cmd_skip(name):
    job = event_job(name)

    def skip(state):
        head, gen, _rows = event_jobs.read(0, [])
        old = state.get(f"{name}.event_seq")
        state[f"{name}.event_seq"], state[f"{name}.event_gen"] = max(old or 0, head), gen
        return old, head
    old, head = edit_state(skip)
    print(_("{name}: cursor {old} → {head}; the events in between won't be run", name=job["name"], old=old, head=head))


def cmd_models():
    sys.path.insert(0, str(HUB / "bin"))
    import completion
    import llm
    pins = (hubconf.get("llm") or {}).get("points") or {}
    providers = completion.settings() is not None
    for name, spec in llm.points()["points"].items():
        group = spec.get("model_group") or "standard"
        if providers and spec.get("shape") == "completion":
            try:
                t = completion.resolve(name, spec)
                where, model = f"llm.providers.{t['provider']}", t["model"]
            except completion.Refused as e:
                where, model = f"⚠️ {e}", "?"
        else:
            model = llm.model_for(name, spec)
            where = "hub.json llm.points" if (pins.get(name) or {}).get("model") else _("group {group}", group=group)
        print(f"{name:24} {model or _('(tool default)'):16} {where}")
    print(_("\nTo change one: schedulectl set-model <point|state|index|consolidate> <model|default>"))


def cmd_set_model(which, model):
    sys.path.insert(0, str(HUB / "bin"))
    import llm
    known = llm.points()["points"]
    targets = MODEL_ALIASES.get(which) or ([which] if which in known else None)
    if not targets:
        print(_("'{which}' is neither a judgment point nor one of {aliases} (the points: schedulectl models)", which=which,
                aliases=_(", ").join(MODEL_ALIASES)))
        sys.exit(1)
    f = hubconf.config_path()
    d = json.loads(f.read_text())
    pins = d.setdefault("llm", {}).setdefault("points", {})
    for t in targets:
        if model == "default":
            (pins.get(t) or {}).pop("model", None)
            if not pins.get(t):
                pins.pop(t, None)
        else:
            pins.setdefault(t, {})["model"] = model
    if not pins:
        d["llm"].pop("points")
    if not d["llm"]:
        d.pop("llm")
    f.write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")
    commit_hub_file(f, f"schedulectl: {which} → {model}")
    print(_("{settings} llm.points: {points} → {model}", points=_(", ").join(targets), model=model))


def main():
    args = sys.argv[1:]
    if not args:
        print(_(__doc__))
        sys.exit(1)

    cmd, rest = args[0], args[1:]
    if cmd in ("status", "stop", "start") and hubconf.service_manager() is None:
        print(_("schedulectl {cmd}: {reason}; {how}", cmd=cmd, reason=hubconf.no_service_manager(),
                how=hubconf.manual_scheduler()))
        sys.exit(2)
    if cmd == "list":
        cmd_list()
    elif cmd == "pause" and rest:
        cmd_pause(rest[0])
    elif cmd == "resume" and rest:
        cmd_resume(rest[0])
    elif cmd == "status":
        cmd_status()
    elif cmd == "logs":
        cmd_logs(*rest)
    elif cmd == "run" and rest:
        sys.exit(cmd_run(rest[0]) or 0)
    elif cmd == "events" and rest:
        cmd_events(rest[0])
    elif cmd == "skip" and rest:
        cmd_skip(rest[0])
    elif cmd == "stop":
        cmd_stop()
    elif cmd == "start":
        cmd_start()
    elif cmd == "models":
        cmd_models()
    elif cmd == "set-model" and len(rest) == 2:
        cmd_set_model(rest[0], rest[1])
    else:
        print(_(__doc__))
        sys.exit(1)


if __name__ == "__main__":
    main()
