#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""管理 schedule.yaml + launchd 排程器的小工具，不用記 launchctl 語法或手改 yaml 格式。

新增排程一律直接編輯 schedule.yaml,加一個 job 條目就好——不用碰這支工具、
不用碰 launchd,下一次 scheduler.py 的 tick(最多 15 分鐘內)就會生效。
這支工具只處理「暫停/恢復單一 job」跟「整個排程器開關/狀態」這種需要記
指令或怕手改 yaml 弄壞格式的操作。

用法:
  schedulectl list                列出所有 job 及其狀態(啟用/暫停、時間、指令)
  schedulectl pause <name>        暫停某個 job(保留設定,之後可以 resume)
  schedulectl resume <name>       恢復某個 job
  schedulectl status              排程器本身(launchd)有沒有在跑 + 最近幾筆執行紀錄
  schedulectl logs [name] [n]     印最近 n 行 log(預設 scheduler.log;給 name 則印該 job 當天的 log)
  schedulectl run <name>          現在就跑一次某個 job(像 Desktop 的「Run now」),並記成今天已跑
                                   (LLM job 同一天不會再被排程跑一次)。透過 launchd 在使用者的桌面 session 跑——
                                   SSH 底下讀不到 keychain,claude 會是未登入
  schedulectl stop                完全停用排程器(launchctl bootout,不動 schedule.yaml)
  schedulectl start               重新啟動排程器(launchctl bootstrap)
  schedulectl models               每個判斷點實際用的模型、從哪裡來(llm.model_for 跟 hub.json 的 llm 段)
  schedulectl set-model <判斷點|state|index|consolidate> <model|default>
                                   寫進 hub.json llm.points(default = 拿掉指定,回到組別的預設);state = 單一專案
                                   STATE.md 判斷那幾個點,index = 跨專案 index.md 跟週報,consolidate = 回頭清理
"""
import datetime
import json
import subprocess
import sys
from pathlib import Path

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parent))
import hubconf  # noqa: E402

HUB = hubconf.ROOT
SCHEDULE = hubconf.config_file("schedule.yaml")
LOG_DIR = HUB / ".logs"
LABEL = "local.agent-hub-scheduler"
PLIST = Path.home() / "Library/LaunchAgents" / f"{LABEL}.plist"
# set-model 的簡稱 → 判斷點(以前 models.env 的 STATE_MODEL / INDEX_MODEL / CONSOLIDATE_MODEL 管的那幾個)
MODEL_ALIASES = {"state": ["librarian-state", "librarian-todo-format", "librarian-state-edits"],
                 "index": ["librarian-index", "librarian-index-edits", "reflect-week"],
                 "consolidate": ["consolidate"]}


def load_jobs():
    return (yaml.safe_load(SCHEDULE.read_text()) or {}).get("jobs", [])


def all_jobs():
    """schedule.yaml + 專案登錄(跟 scheduler.py 同一份清單)。pause/resume 只管 schedule.yaml 的;
    登錄裡的 job 要改就改 projects/<專案>.yaml。"""
    sys.path.insert(0, str(HUB / "bin"))
    import scheduler
    return scheduler.all_jobs()[0]


def commit_hub_file(path, msg):
    """改了被版控的檔案就當場 commit+push(只 commit 這個檔案),不留給人手動補。"""
    rc = subprocess.run([str(HUB / "bin/commit-hub-files.sh"), msg, path.name]).returncode
    if rc != 0:
        print(f"警告:{path.name} 已寫入,但 commit/push 失敗,需要手動處理")


def save_jobs(jobs, msg):
    SCHEDULE.write_text(yaml.dump({"jobs": jobs}, allow_unicode=True, sort_keys=False))
    commit_hub_file(SCHEDULE, msg)


def find_job(jobs, name):
    for job in jobs:
        if job["name"] == name:
            return job
    print(f"沒有叫 '{name}' 的 job。現有:{', '.join(j['name'] for j in jobs) or '(空)'}")
    sys.exit(1)


def describe_when(job):
    """跟 scheduler.py 的 runs_today() 用同一組篩選欄位,不然 list 會把每月一次的 job 顯示成每天。"""
    parts = []
    if "months" in job:
        parts.append("每年 " + ",".join(f"{m}月" for m in job["months"]))
    if "days_of_month" in job:
        parts.append(("" if parts else "每月 ") + ",".join(f"{d}號" for d in job["days_of_month"]))
    if "days_of_week" in job:
        parts.append("每週 " + ",".join(job["days_of_week"]))
    when = " ".join(parts) or "每天"
    extra = f"(每天最多試 {job['max_attempts_per_day']} 次)" if "max_attempts_per_day" in job else ""
    if "end_date" in job:
        extra += f"(到 {job['end_date']} 為止)"
    if "every_minutes" in job:
        at = f"每 {job['every_minutes']} 分鐘" + (f"({job['between']})" if "between" in job else "")
    else:
        at = job["time"]
    return f"{when} {at}{extra}"


def cmd_list():
    jobs = all_jobs()
    if not jobs:
        print("schedule.yaml 裡沒有任何 job。")
        return
    for job in jobs:
        state = "啟用" if job.get("enabled", True) else "暫停"
        print(f"[{state}] {job['name']:20s} {describe_when(job)}  {job['command']}")


def cmd_pause(name):
    jobs = load_jobs()
    job = find_job(jobs, name)
    job["enabled"] = False
    save_jobs(jobs, f"schedulectl: pause {name}")
    print(f"已暫停 '{name}'(設定還在,之後用 resume 恢復)")


def cmd_resume(name):
    jobs = load_jobs()
    job = find_job(jobs, name)
    job["enabled"] = True
    save_jobs(jobs, f"schedulectl: resume {name}")
    print(f"已恢復 '{name}'")


def cmd_status():
    print("=== launchd 註冊狀態 ===")
    subprocess.run(["launchctl", "print", f"gui/{subprocess.check_output(['id', '-u']).decode().strip()}/{LABEL}"])
    print()
    print("=== 最近排程器執行紀錄(scheduler.log 最後 10 行) ===")
    log_file = LOG_DIR / "scheduler.log"
    if log_file.exists():
        print("\n".join(log_file.read_text().splitlines()[-10:]))
    else:
        print("(還沒有 log)")


def cmd_logs(name=None, n=50):
    if name:
        today_logs = sorted(LOG_DIR.glob(f"{name}-*.log"))
        if not today_logs:
            print(f"找不到 '{name}' 的 log")
            return
        log_file = today_logs[-1]
    else:
        log_file = LOG_DIR / "scheduler.log"
    if not log_file.exists():
        print("(還沒有 log)")
        return
    print(f"--- {log_file.name} (最後 {n} 行) ---")
    print("\n".join(log_file.read_text().splitlines()[-int(n):]))


def cmd_stop():
    uid = subprocess.check_output(["id", "-u"]).decode().strip()
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{LABEL}"])
    print("排程器已停用(schedule.yaml 沒有變動,之後用 start 重新啟動)")


def cmd_start():
    uid = subprocess.check_output(["id", "-u"]).decode().strip()
    subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(PLIST)])
    print("排程器已啟動")


def cmd_run(name):
    job = next((j for j in all_jobs() if j["name"] == name), None)
    if job is None:
        sys.exit(f"schedule.yaml 跟專案登錄裡都沒有 '{name}'")
    uid = subprocess.check_output(["id", "-u"]).decode().strip()
    label = f"local.agent-hub-run-now.{name.replace('/', '.')}"
    log = HUB / ".logs" / f"{name.replace('/', '__')}-{datetime.date.today().isoformat()}.log"
    plist = Path("/tmp") / f"{label}.plist"
    import plistlib
    plist.write_bytes(plistlib.dumps({
        "Label": label,
        "ProgramArguments": ["/bin/zsh", "-lc", job["command"]],
        "EnvironmentVariables": {"SAFE_PUSH": str(HUB / "bin" / "git-safe-push.sh")},
        "RunAtLoad": True,
        "StandardOutPath": str(log),
        "StandardErrorPath": str(log),
    }))
    # 上一次手動執行留下的同名 job 先清掉(跑完的 job 還會留在 launchd 裡)
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
    subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(plist)], check=True)
    # 記成今天已跑:不然排程時間已過的 job,下一個 tick 會再跑一次(LLM job 等於多花一次錢)
    state_file = HUB / ".state" / "scheduler-last-run.json"
    state = json.loads(state_file.read_text()) if state_file.exists() else {}
    state[name] = datetime.date.today().isoformat()
    state_file.write_text(json.dumps(state, indent=2))
    print(f"已開始執行 {name},輸出寫進 {log}(今天的排程不會再跑它)")


def cmd_models():
    sys.path.insert(0, str(HUB / "bin"))
    import completion
    import llm
    pins = (hubconf.get("llm") or {}).get("points") or {}
    providers = completion.settings() is not None
    for name, spec in llm.points()["points"].items():
        group = spec.get("model_group") or "standard"
        if providers and spec.get("shape") == "completion":
            try:
                t = completion.resolve(name, spec)
                where, model = f"llm.providers.{t['provider']}", t["model"]
            except completion.Refused as e:
                where, model = f"⚠️ {e}", "?"
        else:
            model = llm.model_for(name, spec)
            where = "hub.json llm.points" if (pins.get(name) or {}).get("model") else f"組別 {group}"
        print(f"{name:24} {model or '(工具預設)':16} {where}")
    print("\n改:schedulectl set-model <判斷點|state|index|consolidate> <model|default>")


def cmd_set_model(which, model):
    sys.path.insert(0, str(HUB / "bin"))
    import llm
    known = llm.points()["points"]
    targets = MODEL_ALIASES.get(which) or ([which] if which in known else None)
    if not targets:
        print(f"'{which}' 不是判斷點,也不是 {'、'.join(MODEL_ALIASES)}(判斷點清單:schedulectl models)")
        sys.exit(1)
    f = hubconf.config_file("hub.json")
    d = json.loads(f.read_text())
    pins = d.setdefault("llm", {}).setdefault("points", {})
    for t in targets:
        if model == "default":
            (pins.get(t) or {}).pop("model", None)
            if not pins.get(t):
                pins.pop(t, None)
        else:
            pins.setdefault(t, {})["model"] = model
    if not pins:
        d["llm"].pop("points")
    if not d["llm"]:
        d.pop("llm")
    f.write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")
    commit_hub_file(f, f"schedulectl: {which} → {model}")
    print(f"hub.json llm.points:{'、'.join(targets)} → {model}")


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        sys.exit(1)

    cmd, rest = args[0], args[1:]
    if cmd in ("status", "run", "stop", "start") and hubconf.service_manager() != "launchd":
        print(f"schedulectl {cmd}:{hubconf.NO_SERVICE_MANAGER}")
        sys.exit(2)
    if cmd == "list":
        cmd_list()
    elif cmd == "pause" and rest:
        cmd_pause(rest[0])
    elif cmd == "resume" and rest:
        cmd_resume(rest[0])
    elif cmd == "status":
        cmd_status()
    elif cmd == "logs":
        cmd_logs(*rest)
    elif cmd == "run" and rest:
        cmd_run(rest[0])
    elif cmd == "stop":
        cmd_stop()
    elif cmd == "start":
        cmd_start()
    elif cmd == "models":
        cmd_models()
    elif cmd == "set-model" and len(rest) == 2:
        cmd_set_model(rest[0], rest[1])
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main()
