#!/bin/sh -c exec${IFS}"${0%/*}/py"${IFS}"$0"${IFS}"$@"
"""A small tool for schedule.yaml + the launchd scheduler, so you don't have to remember launchctl syntax or hand-edit yaml.

To add a schedule, just edit schedule.yaml and add a job entry. No need for this tool or for
launchd: the next scheduler.py tick (within 15 minutes) picks it up.
This tool only does what needs a command to remember, or risks breaking the yaml by hand:
pausing/resuming a single job, and turning the whole scheduler on/off and checking its state.

Usage:
  schedulectl list                list every job and its state (enabled/paused, time, command)
  schedulectl pause <name>        pause a job (its settings stay, resume brings it back)
  schedulectl resume <name>       resume a job
  schedulectl status              whether the scheduler itself (launchd) is running + the latest runs
  schedulectl logs [name] [n]     print the last n lines of a log (default scheduler.log; with name, that job's log for today)
  schedulectl run <name>          run a job once now (like Desktop's "Run now") and record it as run today
                                   (an LLM job is then not run again by the schedule the same day). Runs through launchd in
                                   the user's desktop session: under SSH the keychain can't be read and claude is logged out
  schedulectl stop                stop the scheduler completely (launchctl bootout; schedule.yaml untouched)
  schedulectl start               start the scheduler again (launchctl bootstrap)
  schedulectl models               the model each decision point actually uses, and where it comes from (llm.model_for and
                                   hub.json's llm section)
  schedulectl set-model <point|state|index|consolidate> <model|default>
                                   write into hub.json llm.points (default = drop the pin, back to the group's default);
                                   state = the single-project STATE.md points, index = the cross-project index.md and weekly
                                   report, consolidate = the cleanup pass
"""
import datetime
import json
import subprocess
import sys
from pathlib import Path

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parent))
import hubconf  # noqa: E402
import i18n  # noqa: E402

_ = i18n.domain(__file__)

HUB = hubconf.ROOT
SCHEDULE = hubconf.config_file("schedule.yaml")
LOG_DIR = HUB / ".logs"
LABEL = "local.agent-hub-scheduler"
PLIST = Path.home() / "Library/LaunchAgents" / f"{LABEL}.plist"
# set-model 的簡稱 → 判斷點(以前 models.env 的 STATE_MODEL / INDEX_MODEL / CONSOLIDATE_MODEL 管的那幾個)
MODEL_ALIASES = {"state": ["librarian-state", "librarian-todo-format", "librarian-state-edits"],
                 "index": ["librarian-index", "librarian-index-edits", "reflect-week"],
                 "consolidate": ["consolidate"]}


def load_jobs():
    return (yaml.safe_load(SCHEDULE.read_text()) or {}).get("jobs", [])


def all_jobs():
    """schedule.yaml + 專案登錄(跟 scheduler.py 同一份清單)。pause/resume 只管 schedule.yaml 的;
    登錄裡的 job 要改就改 projects/<專案>.yaml。"""
    sys.path.insert(0, str(HUB / "bin"))
    import scheduler
    return scheduler.all_jobs()[0]


def commit_hub_file(path, msg):
    """改了被版控的檔案就當場 commit+push(只 commit 這個檔案),不留給人手動補。"""
    rc = subprocess.run([str(HUB / "bin/commit-hub-files.sh"), msg, path.name]).returncode
    if rc != 0:
        print(_("warning: {file} was written, but the commit/push failed; it needs a manual fix", file=path.name))


def save_jobs(jobs, msg):
    SCHEDULE.write_text(yaml.dump({"jobs": jobs}, allow_unicode=True, sort_keys=False))
    commit_hub_file(SCHEDULE, msg)


def find_job(jobs, name):
    for job in jobs:
        if job["name"] == name:
            return job
    print(_("No job named '{name}'. There are: {jobs}", name=name, jobs=", ".join(j["name"] for j in jobs) or _("(none)")))
    sys.exit(1)


def describe_when(job):
    """跟 scheduler.py 的 runs_today() 用同一組篩選欄位,不然 list 會把每月一次的 job 顯示成每天。"""
    parts = []
    if "months" in job:
        parts.append(_("yearly in {months}", months=",".join(_("month {m}", m=m) for m in job["months"])))
    if "days_of_month" in job:
        days = ",".join(_("day {d}", d=d) for d in job["days_of_month"])
        parts.append(days if parts else _("monthly on {days}", days=days))
    if "days_of_week" in job:
        parts.append(_("weekly on {days}", days=",".join(job["days_of_week"])))
    when = " ".join(parts) or _("daily")
    extra = _(" (at most {n} tries a day)", n=job["max_attempts_per_day"]) if "max_attempts_per_day" in job else ""
    if "end_date" in job:
        extra += _(" (until {date})", date=job["end_date"])
    if "every_minutes" in job:
        at = _("every {n} min ({between})", n=job["every_minutes"], between=job["between"]) if "between" in job else \
            _("every {n} min", n=job["every_minutes"])
    else:
        at = job["time"]
    return f"{when} {at}{extra}"


def cmd_list():
    jobs = all_jobs()
    if not jobs:
        print(_("schedule.yaml has no jobs."))
        return
    for job in jobs:
        state = _("enabled") if job.get("enabled", True) else _("paused")
        print(f"[{state}] {job['name']:20s} {describe_when(job)}  {job['command']}")


def cmd_pause(name):
    jobs = load_jobs()
    job = find_job(jobs, name)
    job["enabled"] = False
    save_jobs(jobs, f"schedulectl: pause {name}")
    print(_("Paused '{name}' (its settings stay; resume brings it back)", name=name))


def cmd_resume(name):
    jobs = load_jobs()
    job = find_job(jobs, name)
    job["enabled"] = True
    save_jobs(jobs, f"schedulectl: resume {name}")
    print(_("Resumed '{name}'", name=name))


def cmd_status():
    if hubconf.service_manager() == "systemd":
        print(_("=== systemd (user) status ==="))
        subprocess.run(["systemctl", "--user", "status", "--no-pager", f"{LABEL}.timer", f"{LABEL}.service"])
    else:
        print(_("=== launchd registration ==="))
        subprocess.run(["launchctl", "print", f"gui/{subprocess.check_output(['id', '-u']).decode().strip()}/{LABEL}"])
    print()
    print(_("=== latest scheduler runs (last 10 lines of scheduler.log) ==="))
    log_file = LOG_DIR / "scheduler.log"
    if log_file.exists():
        print("\n".join(log_file.read_text().splitlines()[-10:]))
    else:
        print(_("(no log yet)"))


def cmd_logs(name=None, n=50):
    if name:
        today_logs = sorted(LOG_DIR.glob(f"{name}-*.log"))
        if not today_logs:
            print(_("No log for '{name}'", name=name))
            return
        log_file = today_logs[-1]
    else:
        log_file = LOG_DIR / "scheduler.log"
    if not log_file.exists():
        print(_("(no log yet)"))
        return
    print(_("--- {file} (last {n} lines) ---", file=log_file.name, n=n))
    print("\n".join(log_file.read_text().splitlines()[-int(n):]))


def cmd_stop():
    if hubconf.service_manager() == "systemd":
        subprocess.run(["systemctl", "--user", "disable", "--now", f"{LABEL}.timer"])
        print(_("Scheduler stopped (schedule.yaml unchanged; start brings it back)"))
        return
    uid = subprocess.check_output(["id", "-u"]).decode().strip()
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{LABEL}"])
    print(_("Scheduler stopped (schedule.yaml unchanged; start brings it back)"))


def cmd_start():
    if hubconf.service_manager() == "systemd":
        subprocess.run(["systemctl", "--user", "enable", "--now", f"{LABEL}.timer"])
        print(_("Scheduler started"))
        return
    uid = subprocess.check_output(["id", "-u"]).decode().strip()
    subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(PLIST)])
    print(_("Scheduler started"))


def cmd_run(name):
    job = next((j for j in all_jobs() if j["name"] == name), None)
    if job is None:
        sys.exit(_("Neither schedule.yaml nor the project registry has '{name}'", name=name))
    uid = subprocess.check_output(["id", "-u"]).decode().strip()
    label = f"local.agent-hub-run-now.{name.replace('/', '.')}"
    log = HUB / ".logs" / f"{name.replace('/', '__')}-{datetime.date.today().isoformat()}.log"
    if hubconf.service_manager() == "systemd":   # 一次性的 user unit(跑完自己收掉)
        subprocess.run(["systemctl", "--user", "reset-failed", f"{label}.service"], capture_output=True)
        subprocess.run(["systemd-run", "--user", "--collect", f"--unit={label}",
                        f"--property=StandardOutput=append:{log}", f"--property=StandardError=append:{log}",
                        f"--setenv=SAFE_PUSH={HUB / 'bin' / 'git-safe-push.sh'}", "/bin/sh", "-lc", job["command"]], check=True)
        _mark_ran_today(name)
        print(_("Started {name}, its output goes to {log} (today's schedule won't run it again)", name=name, log=log))
        return
    plist = Path("/tmp") / f"{label}.plist"
    import plistlib
    plist.write_bytes(plistlib.dumps({
        "Label": label,
        "ProgramArguments": [hubconf.login_shell(), "-lc", job["command"]],
        "EnvironmentVariables": {"SAFE_PUSH": str(HUB / "bin" / "git-safe-push.sh")},
        "RunAtLoad": True,
        "StandardOutPath": str(log),
        "StandardErrorPath": str(log),
    }))
    # 上一次手動執行留下的同名 job 先清掉(跑完的 job 還會留在 launchd 裡)
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
    subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(plist)], check=True)
    _mark_ran_today(name)
    print(_("Started {name}, its output goes to {log} (today's schedule won't run it again)", name=name, log=log))


def _mark_ran_today(name):
    # 記成今天已跑:不然排程時間已過的 job,下一個 tick 會再跑一次(LLM job 等於多花一次錢)
    state_file = HUB / ".state" / "scheduler-last-run.json"
    state = json.loads(state_file.read_text()) if state_file.exists() else {}
    state[name] = datetime.date.today().isoformat()
    state_file.write_text(json.dumps(state, indent=2))


def cmd_models():
    sys.path.insert(0, str(HUB / "bin"))
    import completion
    import llm
    pins = (hubconf.get("llm") or {}).get("points") or {}
    providers = completion.settings() is not None
    for name, spec in llm.points()["points"].items():
        group = spec.get("model_group") or "standard"
        if providers and spec.get("shape") == "completion":
            try:
                t = completion.resolve(name, spec)
                where, model = f"llm.providers.{t['provider']}", t["model"]
            except completion.Refused as e:
                where, model = f"⚠️ {e}", "?"
        else:
            model = llm.model_for(name, spec)
            where = "hub.json llm.points" if (pins.get(name) or {}).get("model") else _("group {group}", group=group)
        print(f"{name:24} {model or _('(tool default)'):16} {where}")
    print(_("\nchange: schedulectl set-model <point|state|index|consolidate> <model|default>"))


def cmd_set_model(which, model):
    sys.path.insert(0, str(HUB / "bin"))
    import llm
    known = llm.points()["points"]
    targets = MODEL_ALIASES.get(which) or ([which] if which in known else None)
    if not targets:
        print(_("'{which}' is neither a decision point nor one of {aliases} (the points: schedulectl models)", which=which,
                aliases=_(", ").join(MODEL_ALIASES)))
        sys.exit(1)
    f = hubconf.config_file("hub.json")
    d = json.loads(f.read_text())
    pins = d.setdefault("llm", {}).setdefault("points", {})
    for t in targets:
        if model == "default":
            (pins.get(t) or {}).pop("model", None)
            if not pins.get(t):
                pins.pop(t, None)
        else:
            pins.setdefault(t, {})["model"] = model
    if not pins:
        d["llm"].pop("points")
    if not d["llm"]:
        d.pop("llm")
    f.write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")
    commit_hub_file(f, f"schedulectl: {which} → {model}")
    print(_("hub.json llm.points: {points} → {model}", points=_(", ").join(targets), model=model))


def main():
    args = sys.argv[1:]
    if not args:
        print(_(__doc__))
        sys.exit(1)

    cmd, rest = args[0], args[1:]
    if cmd in ("status", "run", "stop", "start") and hubconf.service_manager() is None:
        print(_("schedulectl {cmd}: {reason}", cmd=cmd, reason=hubconf.no_service_manager()))
        sys.exit(2)
    if cmd == "list":
        cmd_list()
    elif cmd == "pause" and rest:
        cmd_pause(rest[0])
    elif cmd == "resume" and rest:
        cmd_resume(rest[0])
    elif cmd == "status":
        cmd_status()
    elif cmd == "logs":
        cmd_logs(*rest)
    elif cmd == "run" and rest:
        cmd_run(rest[0])
    elif cmd == "stop":
        cmd_stop()
    elif cmd == "start":
        cmd_start()
    elif cmd == "models":
        cmd_models()
    elif cmd == "set-model" and len(rest) == 2:
        cmd_set_model(rest[0], rest[1])
    else:
        print(_(__doc__))
        sys.exit(1)


if __name__ == "__main__":
    main()
