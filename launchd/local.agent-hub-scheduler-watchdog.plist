<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.agent-hub-scheduler-watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>{{hub}}/bin/scheduler-watchdog.py</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>{{hub}}/.logs/scheduler-watchdog-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>{{hub}}/.logs/scheduler-watchdog-stderr.log</string>
</dict>
</plist>
