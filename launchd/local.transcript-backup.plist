<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.transcript-backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{hub}}/bin/transcript-backup.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{hub}}/.logs/transcript-backup-stderr.log</string>
	<key>StandardOutPath</key>
	<string>{{hub}}/.logs/transcript-backup-stdout.log</string>
	<key>StartInterval</key>
	<integer>3600</integer>
</dict>
</plist>
